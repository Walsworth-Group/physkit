#!/usr/bin/env python3
"""guard_discoveries.py — PreToolUse hook: block a DISCOVERIES write that wasn't independently verified.

Enforces the campaign's #1 hard gate: a finding may not be promoted to results*/DISCOVERIES.md unless
an independent verification ran recently (the verify skill, which spawns a refuter sub-agent). Reads the
PreToolUse hook JSON on stdin (tool_name, tool_input, transcript_path). Allows everything except a
Write/Edit to a DISCOVERIES file with no recent verify event in the session transcript.

FAIL-OPEN by design: any parsing/IO error -> allow (a hook bug must never brick a campaign). Flip
FAIL_OPEN to False for strict mode. Window is configurable via AUTORESEARCH_VERIFY_WINDOW_MIN (default 60).
"""
from __future__ import annotations
import json, os, re, sys, glob
from datetime import datetime, timezone

FAIL_OPEN = True
WINDOW_MIN = int(os.environ.get("AUTORESEARCH_VERIFY_WINDOW_MIN", "60"))
VERIFY_RE = re.compile(r"verif|refut|adversar|independent[- ]?check", re.I)


def _ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def _allow():
    sys.exit(0)


def _deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))
    sys.exit(0)


def recent_verify(transcript_path, now):
    """True if a verify skill or a refuter sub-agent ran within WINDOW_MIN before now."""
    if not transcript_path or not os.path.isfile(transcript_path):
        # try to find the newest jsonl in the same dir
        cands = sorted(glob.glob(os.path.join(os.path.dirname(transcript_path or "."), "*.jsonl")),
                       key=os.path.getmtime) if transcript_path else []
        transcript_path = cands[-1] if cands else None
    if not transcript_path or not os.path.isfile(transcript_path):
        return None  # unknown -> caller decides via FAIL_OPEN
    cutoff = now.timestamp() - WINDOW_MIN * 60
    for line in open(transcript_path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except Exception:
            continue
        ts = _ts(r.get("timestamp"))
        if not ts or ts.timestamp() < cutoff:
            continue
        if r.get("type") == "assistant" and VERIFY_RE.search(str(r.get("attributionSkill", ""))):
            return True
        msg = r.get("message", {})
        if isinstance(msg, dict) and isinstance(msg.get("content"), list):
            for it in msg["content"]:
                if not isinstance(it, dict) or it.get("type") != "tool_use":
                    continue
                name = it.get("name", ""); inp = it.get("input", {}) or {}
                if name == "Skill" and VERIFY_RE.search(str(inp.get("skill", "")) + str(inp.get("command", ""))):
                    return True
                if name in ("Agent", "Task") and VERIFY_RE.search(
                        str(inp.get("subagent_type", "")) + str(inp.get("description", "")) + str(inp.get("prompt", ""))):
                    return True
    return False


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        _allow()
    try:
        if data.get("tool_name") not in ("Write", "Edit", "MultiEdit"):
            _allow()
        fp = str((data.get("tool_input") or {}).get("file_path", ""))
        if "DISCOVER" not in fp.upper():
            _allow()
        now = datetime.now(timezone.utc)
        verified = recent_verify(data.get("transcript_path"), now)
        if verified is True:
            _allow()
        if verified is None and FAIL_OPEN:
            _allow()  # couldn't read transcript; don't brick the campaign
        _deny(
            f"DISCOVERIES gate: no independent verification found in the last {WINDOW_MIN} min. "
            f"Before promoting a finding, run the verify skill (it spawns an independent refuter sub-agent) "
            f"and get CONFIRMED, then write DISCOVERIES.md. See CLAUDE.md hard gate #1."
        )
    except Exception:
        if FAIL_OPEN:
            _allow()
        _deny("DISCOVERIES gate: guard error (strict mode). Run the verify skill, then retry.")


if __name__ == "__main__":
    main()
