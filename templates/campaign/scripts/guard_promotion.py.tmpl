#!/usr/bin/env python3
"""guard_promotion.py - PreToolUse hook: a PROMOTION write must be independently CONFIRMED.

Enforces the campaign's #1 hard gate on every promotion surface. A finding - POSITIVE or NEGATIVE
(steering-negatives promote too) - may not be promoted unless the verify skill's independent
refuter recorded a promotable verdict artifact in results/verdicts/<id>.json:
    {"claim": "...", "exp_id": "...", "verdict": "CONFIRMED", "kill_tier": null,
     "refuter": "<agent/session id>", "utc": "...", "summary": "..."}
For a NEGATIVE (kill-claim) finding, "kill_tier" is "REFUTED" or "EVIDENCE_AGAINST" (an "INCONCLUSIVE"
kill never graduates - it queues a fix-and-rerun unit instead).

Two promotion surfaces, two strictness tiers. The citation rule and the surface/recency rule are
independent and complementary - a write must satisfy both, not either:
  * RECOMMENDED*.json (current-best) writes and scoreboard writes that INTRODUCE a `CONFIRMED` /
    `NEW BEST` token - SUBJECT-MATCHED + FAIL-OPEN-LOGGED: the verdict artifact FOR THE EXPERIMENT
    BEING PROMOTED (matched by the exp id/name the written content carries) must be CONFIRMED with a
    NAMED INDEPENDENT REFUTER and a graduating kill tier if any - hard gate #1's warrant is the
    independent refuter, not merely that a CONFIRMED file exists (a self-authored / refuterless
    verdict does not promote). Per-block verification means every experiment carries its own verdict,
    so the gate no longer accepts "some verdict, recently" (the recency window this replaces could be
    satisfied by any fresh verdict about anything - a residual its own docstring flagged). These
    files are recoverable, so a guard *error* here allows BUT logs to results/gate_failures.log
    (campaign-status hard-fails on a non-empty log); an unmatched or refuterless verdict is a clean,
    recoverable DENY (run verify for that experiment, then retry), not a bypass.
  * the PROJECT ledger <project>/DISCOVERIES.md - SUBJECT-MATCHED + FAIL-CLOSED: promoting a
    system-level finding upward must cite the SOURCE campaign's verdict artifact by name
    (campaigns/<slug>/results/verdicts/<id>.json); the artifact must be CONFIRMED with a named refuter
    and a graduating kill tier, and the source campaign's correctness suite must be an affirmative,
    non-stale GREEN. Any guard error on this surface DENIES - the project ledger is the record that
    survives fork-and-archive, the one unrecoverable write.
The campaign surface also requires an AFFIRMATIVE GREEN correctness suite (results/correctness_state.json,
written by run_campaign) - not merely 'not red'. RED, EMPTY (a freshly-scaffolded all-skip suite: zero
active checks), ERROR, ABSENT, and a never-run (no state file) all block, because none is evidence the
machinery is right - deleting/never-finishing the suite was the trivial silent bypass. ABSENT/EMPTY are
excused only by an explicit tests/CORRECTNESS_NA.md (a recorded N/A decision, never a silent gap). A green
is further rejected if STALE - recorded against a different FROZEN/core hash than the code on disk (the
file set is scripts/frozen_core.py). No finding built on a red/empty/absent suite, or on a green that no
longer matches the code it certified, is trustworthy.

Settled findings are RECORDED in results/JOURNAL.md's Findings section, each citing its verdict - but the
journal is working memory, edited every cycle, and is deliberately NOT a gated surface: the mechanical
authorities downstream trusts are the scoreboard's verified column and RECOMMENDED.json, which are. A
findings entry with no verdict citation is an open thread, not a finding; campaign-status audits that.

A normal scoreboard row append (no promotion token) is recording, not promotion - never gated. Writes
to anything else are always allowed; unparseable stdin is allowed + logged (we cannot even tell what is
being written).

SCOPE (gaps campaign-status backstops): the scoreboard signal is token-based - a promotion phrased
without those tokens slips past (verified-column check is the backstop); the hook only fires if THIS
tree wired it (.claude/settings.json) - campaign-status asserts the wiring - and it is wired per
CAMPAIGN, so a session rooted at the project level writes the project ledger unhooked (the promotion
path runs from inside a campaign, where it is hooked).
"""
from __future__ import annotations
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

VERDICT_REF_RE = re.compile(r"verdicts[/\\]([\w\-.]+\.json)")
SUBJECT_RE = re.compile(r"exp[\w\-]*\d[\w\-]*", re.I)
PROMOTABLE = {"CONFIRMED"}


def _allow():
    sys.exit(0)


def _deny(reason: str):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))
    sys.exit(0)


def _campaign_root(fp: Path) -> Path | None:
    """The dir holding scripts/ + configs/, walking up from the written file."""
    for parent in fp.parents:
        if (parent / "scripts").is_dir() and (parent / "configs").is_dir():
            return parent
    return None


def _env_campaign_root() -> Path | None:
    """The campaign root from CLAUDE_PROJECT_DIR, which Claude Code sets to the tree that wired this hook.

    Used when the written path cannot resolve a root (the unparseable-stdin fail-open has no path at all).
    """
    d = os.environ.get("CLAUDE_PROJECT_DIR", "").strip()
    if not d:
        return None
    p = Path(d)
    return p if (p / "scripts").is_dir() and (p / "configs").is_dir() else None


def _is_project_ledger(fp: Path | None) -> bool:
    """True for the PROJECT-level `DISCOVERIES*.md` - basename-matched, parent must BE a project root
    (PROJECT.md beside the written file; LINEAGE.md is NOT required, because the consolidated layout
    absorbed it into PROJECT.md - ADR-0015).

    New projects no longer scaffold a DISCOVERIES ledger at all (retired by ADR-0015: findings live
    in the campaign that produced them, pointed at from PROJECT.md §Lineage / §Updates from
    discoveries). This surface stays so a LEGACY or imported ledger remains gated rather than
    silently fail-open - and detection must therefore not key on LINEAGE.md, which a consolidated
    project holding an imported old ledger will not have.

    The campaign-level results*/DISCOVERIES.md surface this hook once guarded no longer exists: settled
    findings live in the journal's Findings section, and the file dissolved (V6). What remains
    ledger-shaped is the project record, which the old guard could never validate (its `_campaign_root`
    cannot resolve above a campaign, so every project-level write hit an unsatisfiable deny). This
    predicate knows about project roots, closing that deliberately deferred gap.
    """
    if fp is None or not fp.name.upper().endswith(".MD"):
        return False
    if not fp.name.upper().startswith("DISCOVERIES"):
        return False
    parent = fp.parent
    try:
        return (parent / "PROJECT.md").is_file()
    except OSError:
        return False


def _find_project_verdict(project_root: Path, name: str) -> Path | None:
    """The cited verdict artifact anywhere under the project's campaigns (incl. campaigns/_archive)."""
    hits = sorted(project_root.glob(f"campaigns/**/verdicts/{name}"))
    return hits[0] if hits else None


def _note_bypass(root: Path | None, reason: str):
    """Fail-open must never be silent: record it so campaign-status can hard-fail on it.

    The record MUST land in the campaign that was bypassed. It used to fall back to Path(".") -- the
    process's cwd -- so a bypass with no resolvable root wrote results/gate_failures.log wherever the hook
    happened to be invoked from. campaign-status reads that log INSIDE the campaign, so the one path built
    to keep a fail-open non-silent was the path that could silence it; worse, the stray log makes an
    UNRELATED tree hard-fail on a bypass that never concerned it. So: resolve from CLAUDE_PROJECT_DIR
    before giving up, and if no campaign root can be established, write nothing and say so on stderr.
    """
    root = root or _env_campaign_root()
    if root is None:
        print(f"guard_promotion FAIL-OPEN (no campaign root; not logged): {reason}", file=sys.stderr)
        return
    try:
        log = root / "results" / "gate_failures.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        with open(log, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now(timezone.utc).isoformat()}\tFAIL-OPEN\t{reason}\n")
    except Exception:
        pass


def _edit_chunks(ti):
    """Yield (new_text, old_text) pairs a Write / Edit / MultiEdit introduces."""
    if ti.get("content") is not None:
        yield str(ti.get("content", "")), ""
    if ti.get("new_string") is not None:
        yield str(ti.get("new_string", "")), str(ti.get("old_string", "") or "")
    for e in (ti.get("edits") or []):
        if isinstance(e, dict):
            yield str(e.get("new_string", "")), str(e.get("old_string", "") or "")


def _written_text(ti) -> str:
    return "\n".join(new for new, _ in _edit_chunks(ti))


def _read_correctness(root: Path | None) -> dict | None:
    """The recorded correctness-suite state dict, or None if there is no readable state file."""
    if root is None:
        return None
    state = root / "results" / "correctness_state.json"
    if not state.is_file():
        return None
    try:
        return json.loads(state.read_text(encoding="utf-8"))
    except Exception:
        return None


def _has_na_waiver(root: Path | None) -> bool:
    """A recorded N/A decision: tests/CORRECTNESS_NA.md exists with a non-empty rationale. It excuses ONLY an
    ABSENT or EMPTY suite (a campaign with genuinely no simulator to check) - never RED/ERROR (a real or
    broken suite). Making the gap an explicit, reviewable file is the point: it kills the SILENT bypass
    (delete/never-build the suite), not the possibility of a deliberate, recorded N/A."""
    if root is None:
        return False
    w = root / "tests" / "CORRECTNESS_NA.md"
    try:
        return w.is_file() and bool(w.read_text(encoding="utf-8").strip())
    except Exception:
        return False


def correctness_blocks_promotion(root: Path | None) -> str | None:
    """Deny-reason if the correctness suite does NOT green-light a promotion, else None.

    Promotion requires an AFFIRMATIVE GREEN - not merely 'not red'. A freshly-scaffolded all-skip suite
    (EMPTY), a missing suite (ABSENT), an unreadable/anomalous state (ERROR), and a never-run state (no file)
    all block, because none is evidence the machinery is right; deleting or never-finishing the suite was the
    trivial silent bypass this closes. ABSENT/EMPTY are excused by an explicit tests/CORRECTNESS_NA.md."""
    st = _read_correctness(root)
    status = str((st or {}).get("status", "")).strip().lower() if st is not None else None
    if status == "green":
        return None
    if status in ("absent", "empty", None):
        if _has_na_waiver(root):
            return None
        which = status.upper() if status else "MISSING (run_campaign has not run its FROZEN-infra gates)"
        return (f"the correctness suite is {which} - no active checks guard the machinery, so it cannot "
                "green-light a promotion. Add >=1 real check (correctness-suite skill) and re-run "
                "run_campaign, or record an explicit N/A decision in tests/CORRECTNESS_NA.md (with a "
                "rationale) if this campaign genuinely has no simulator.")
    return (f"the correctness suite is {status.upper()} - a result built on a red/broken suite is not "
            "trustworthy. Fix the suite and re-run run_campaign before promoting.")


def _current_core_hash(root: Path | None) -> str | None:
    """Hash the FROZEN/core files on disk NOW, via the campaign's OWN frozen_core.py (the single source of
    truth for the core-file set - the guard must not fork that list). None if it cannot be determined."""
    if root is None:
        return None
    scripts = root / "scripts"
    if not (scripts / "frozen_core.py").is_file():
        return None
    try:
        if str(scripts) not in sys.path:
            sys.path.insert(0, str(scripts))
        import frozen_core  # campaign-local; existence just confirmed
        return frozen_core.core_hash(root)
    except Exception:
        return None


def green_is_stale(root: Path | None) -> bool:
    """True if the recorded correctness state is GREEN but was recorded against a DIFFERENT core than the code
    on disk now - a stale green must not gate a promotion (edit the FROZEN scorer, then promote an old
    result). Compares correctness_state.json's stored core_hash to a freshly computed one.

    Fail-SAFE: any inability to judge (no state, not green, no stored hash, frozen_core missing/unimportable,
    core unreadable) returns False. Staleness is an ADDED protection layer, so an error degrades to the
    behavior from before the check existed - it never over-blocks a legitimate promotion."""
    if root is None:
        return False
    st = _read_correctness(root)
    if st is None:
        return False
    if str(st.get("status", "")).strip().lower() != "green":
        return False                       # non-green is owned by correctness_blocks_promotion, not staleness
    recorded = st.get("core_hash")
    if not recorded:
        return False                       # an older state carries no hash -> cannot judge staleness
    current = _current_core_hash(root)
    if not current:
        return False                       # cannot hash the core now -> do not enforce
    return recorded != current


def _check_verdict(path: Path, name: str) -> str | None:
    """Deny-reason if the cited verdict artifact does not clear the gate, else None."""
    v = json.loads(path.read_text(encoding="utf-8"))
    verdict = str(v.get("verdict", "")).strip().upper()
    if verdict not in PROMOTABLE:
        return (f"verdicts/{name} has verdict '{verdict or 'MISSING'}' - only CONFIRMED graduates "
                "(PROVISIONAL/QUESTIONABLE stay working results with their caveat inline)")
    tier = v.get("kill_tier")
    if tier:
        # Normalize BOTH separators. The vocabulary is unchanged -- only REFUTED and EVIDENCE_AGAINST
        # graduate -- but the kit spelled the tier three ways and only one parsed: the definition writes
        # "EVIDENCE AGAINST" (space, accepted), the guard's own docstring "EVIDENCE_AGAINST", and
        # PLANNER_PROMPT "EVIDENCE-AGAINST" (hyphen), which this check REJECTED. An agent that copied
        # the wording out of its own prompt had a legitimate kill denied over a typographic dash.
        tier_norm = str(tier).strip().upper().replace(" ", "_").replace("-", "_")
        if tier_norm not in {"REFUTED", "EVIDENCE_AGAINST"}:
            return (f"verdicts/{name} kill_tier '{tier}' cannot graduate - an INCONCLUSIVE kill "
                    "(cause unattributed) queues a fix-and-rerun unit; it does not prune")
    # `or ""` NOT `, ""`: an explicit JSON null ("refuter": null) makes .get return None, and str(None)
    # is the NON-EMPTY string "None" - which passed this check and promoted. That is exactly what a model
    # leaves behind when it copies the verdict stub without filling the field, and it was observed live
    # (a real worker promoted a current-best on refuter:null). Missing key, "", "   ",
    # null, and false must all deny; only a real id promotes.
    if not str(v.get("refuter") or "").strip():
        return (f"verdicts/{name} names no refuter - the verdict must come from an independent "
                "agent, not the generating session")
    return None


def _eid(label: str) -> str:
    """The <NN> id inside an exp label ('exp003_slug' -> '003'). A deliberate, tiny twin of the
    runner's exp_id_for: importing the runner would drag numpy and the FROZEN scorer into a hook that
    must answer in milliseconds on every file write."""
    head = str(label).strip().split("_", 1)[0]
    raw = head[3:] if head.lower().startswith("exp") else head
    return raw.zfill(3) if raw.isdigit() else raw.lower()


def promotion_subject_problem(root: Path | None, ti) -> str | None:
    """Deny-reason unless the experiment THIS WRITE PROMOTES has a promotable verdict, else None.

    Subject-matched: the written content names its experiment (RECOMMENDED.json carries its config
    path; a scoreboard token lands on its experiment's row), and the gate demands THAT experiment's
    verdict - CONFIRMED, graduating kill tier if any, named independent refuter (`_check_verdict`,
    the same bar the project-ledger surface applies). With per-block verification every experiment
    carries its own verdict artifact, so an unmatched subject means the experiment was never
    verified, not that a window expired."""
    if root is None:
        return ("cannot resolve the campaign root for this write - promote from inside the campaign "
                "tree so the gate can find results/verdicts/")
    toks = {t.lower() for t in SUBJECT_RE.findall(_written_text(ti))}
    if not toks:
        return ("cannot tell WHICH experiment this write promotes - the written content names no exp "
                "id. Write the file so it names its experiment (RECOMMENDED.json carries its config "
                "path; a promotion token belongs on its experiment's scoreboard row), then the gate "
                "can match the verdict.")
    ids = {_eid(t) for t in toks}
    vdir = root / "results" / "verdicts"
    problems = []
    if vdir.is_dir():
        for p in sorted(vdir.glob("*.json")):
            try:
                v = json.loads(p.read_text(encoding="utf-8"))
            except Exception:
                continue
            subjects = {_eid(p.stem), _eid(str(v.get("exp_id", "")).strip())}
            if not (subjects & ids):
                continue
            reason = _check_verdict(p, p.name)
            if reason is None:
                return None
            problems.append(reason)
    if problems:
        return " | ".join(problems)
    return (f"no verdict artifact in results/verdicts/ matches the promoted experiment(s) "
            f"{', '.join(sorted(toks))}. A promotion needs THAT experiment's CONFIRMED verdict with a "
            "named independent refuter (hard gate #1) - run the verify skill for it (in supervised "
            "runs the driver's per-block verification writes it), then promote.")


def scoreboard_promotion(ti) -> bool:
    """True if this write INTRODUCES a `CONFIRMED` / `NEW BEST` token into the scoreboard."""
    if "scoreboard" not in str(ti.get("file_path", "")).lower():
        return False
    for new, old in _edit_chunks(ti):
        for tok in ("CONFIRMED", "NEW BEST"):
            if tok in new and tok not in old:
                return True
    return False


def main():
    try:
        data = json.load(sys.stdin)
        tool_name = data.get("tool_name", "")
        ti = data.get("tool_input") or {}
        fp_str = str(ti.get("file_path", ""))
    except Exception:
        _note_bypass(None, "could not parse hook stdin")
        _allow()
        return
    if tool_name not in ("Write", "Edit", "MultiEdit"):
        _allow()
        return
    fp = Path(fp_str) if fp_str else None
    root = _campaign_root(fp) if fp else None

    # ---- surface 1: the PROJECT ledger <project>/DISCOVERIES.md - subject-matched, FAIL-CLOSED ----
    if _is_project_ledger(fp):
        try:
            refs = sorted(set(VERDICT_REF_RE.findall(_written_text(ti))))
            if not refs:
                _deny("project-ledger gate: the entry cites no verdict artifact. Promoting a finding to "
                      "the project DISCOVERIES ledger requires citing the SOURCE campaign's verdict by "
                      "path (campaigns/<slug>/results/verdicts/<id>.json) - run the verify skill in that "
                      "campaign, get CONFIRMED, then cite the file. CLAUDE.md hard gate #1.")
                return
            problems = []
            for name in refs:
                found = _find_project_verdict(fp.parent, name)
                if found is None:
                    problems.append(f"cited verdict artifact not found under campaigns/**/verdicts/: {name}")
                    continue
                reason = _check_verdict(found, name)
                if reason:
                    problems.append(reason)
                    continue
                src_root = found.parent.parent.parent   # <campaign>/results/verdicts/<file>
                suite_reason = correctness_blocks_promotion(src_root)
                if suite_reason:
                    problems.append(f"source campaign '{src_root.name}': {suite_reason}")
                elif green_is_stale(src_root):
                    problems.append(f"source campaign '{src_root.name}': its correctness green was "
                                    "recorded against a DIFFERENT version of its FROZEN/core code than "
                                    "what is on disk now - re-run its suite before promoting the finding "
                                    "upward")
            if problems:
                _deny("project-ledger gate: " + " | ".join(problems))
                return
            _allow()
        except Exception as exc:
            _deny(f"project-ledger gate (fail-closed): could not validate the promotion ({exc}). Fix the "
                  "verdict citation or the guard input and retry; the project ledger is the record that "
                  "survives fork-and-archive - the one unrecoverable write.")
        return

    # ---- surface 2: RECOMMENDED / scoreboard-token writes - recency-checked, FAIL-OPEN-LOGGED ----
    try:
        is_promo = "RECOMMENDED" in fp_str.upper() or scoreboard_promotion(ti)
        if not is_promo:
            _allow()
            return
        suite_reason = correctness_blocks_promotion(root)
        if suite_reason:
            _deny("promotion gate: " + suite_reason)
            return
        if green_is_stale(root):
            _deny("promotion gate: the correctness suite's green was recorded against a DIFFERENT version of "
                  "the FROZEN/core code than what is on disk now (scripts/frozen_core.py) - re-run the suite "
                  "(run_campaign) so it validates the current core before marking a current-best.")
            return
        subject_problem = promotion_subject_problem(root, ti)
        if subject_problem is None:
            _allow()
            return
        _deny("promotion gate: " + subject_problem)
    except Exception as exc:
        _note_bypass(root, f"promotion-surface guard error: {exc}")
        _allow()


if __name__ == "__main__":
    main()
