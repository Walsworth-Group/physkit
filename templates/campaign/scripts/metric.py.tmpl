"""metric.py — the FROZEN scorer for {{CAMPAIGN_TITLE}}.

FROZEN: the scoring math here is the campaign's single source of truth. Do NOT edit it to change a
number. You change what FEEDS the metric (registration, params, preprocessing, decoder, design, …),
never how it is computed. A metric found WRONG is revised as a declared metric epoch (campaign.md
§The ONE metric; roles/REFERENCE.md §Metric epochs): a new metric_version with its entry in
configs/loop.json campaign.metric_epochs, verified evidence, and the retained contenders re-scored.
The runner binds this file's code to its epoch on the first experiment and refuses to run when the
code changes under a version no epoch declares (comments and formatting do not count).

Primary metric: {{PRIMARY_METRIC}}  ({{PRIMARY_DIRECTION}} = better).

The self-test runs **automatically** before every experiment (via run_campaign) and must pass — it gates
experiment 000 and catches a silent convention/sign/units slip. `python scripts/metric.py --selftest` runs
it standalone.
"""
from __future__ import annotations

import argparse
import numpy as np

# Direction of improvement, taken from the campaign metric. Drives every "is this better?" comparison
# below so a lower-is-better metric (residual, chi-square, error) needs no hand-edited asserts.
PRIMARY_DIRECTION = "{{PRIMARY_DIRECTION}}"   # "higher" or "lower" — filled at campaign setup
HIGHER_IS_BETTER = PRIMARY_DIRECTION.strip().lower().startswith("high")


# The PLAUSIBLE RANGE of this metric, in the one form code can act on - fixed ONCE at setup and signed
# off by the user; campaign.md states it in prose with its basis ("Plausible range"), so if you change
# one, change both. A sensible default is the perfect score at one end and the score of a trivial
# predictor (all zeros, the mean, a constant) on the evaluation data at the other: RMSE in [0, RMSE of
# all-zeros]. Anything that better suits the problem is fine, with its basis recorded.
#
# It is a cheap check for IMPLEMENTATION ERRORS, not a prediction of how well anything will do: a score
# outside it is flagged and draws extra scrutiny (results/checks_<NN>.json `plausible_range`). Keep it
# to what no correct pipeline should produce; a range drawn around the result you expect flags honest
# surprises as bugs.
#
# `None` on either side means unbounded that way; `None` for the whole tuple means this campaign has not
# encoded a range, and the runner reports the check `unavailable` rather than inventing a verdict.
#
# This file is FROZEN core, so editing the range changes the core hash and invalidates the recorded
# correctness-suite green. That is intended: the range is part of what the metric means, so a green
# certified under a different range is not evidence about this scorer.
PLAUSIBILITY_BOUNDS = {{PLAUSIBILITY_BOUNDS}}   # (low, high); None on a side = unbounded there


def implausible(score: float) -> str:
    """"" if `score` is inside this metric's plausible range, else the reason it is not.

    A violation is a probable bug, not a bad result: the scorer, the data or the pipeline is likely
    wrong, and no interpretation of the number is worth making until that is ruled out.
    """
    if not PLAUSIBILITY_BOUNDS:
        return ""
    low, high = PLAUSIBILITY_BOUNDS
    if low is not None and score < low:
        return f"{score:.6g} is below the plausible range's lower end {low:g}"
    if high is not None and score > high:
        return f"{score:.6g} is above the plausible range's upper end {high:g}"
    return ""


def _better(a: float, b: float) -> bool:
    """True if score `a` beats score `b` under this metric's direction ({{PRIMARY_DIRECTION}} = better)."""
    return a >= b if HIGHER_IS_BETTER else a <= b


def compute_metric(prediction, target, **kwargs) -> float:
    """Return {{PRIMARY_METRIC}} comparing `prediction` to `target`. {{PRIMARY_DIRECTION}} = better.

    TODO(campaign): implement the FROZEN scoring math. Keep it pure (no I/O, no global state) and
    deterministic. Assert finiteness of the result; a metric computed on a non-finite or
    non-converged input is noise, not data.
    """
    raise NotImplementedError(
        "Implement the FROZEN scoring math in compute_metric(), then make --selftest pass."
    )


def _no_skill_floor(target, **kwargs) -> float:
    """The metric value a scrambled / random prediction should collapse to (the no-skill floor).

    TODO(campaign): define what 'no skill' means for this metric (e.g. predicting the mean, a random
    state, or zeros). Used by the null-control check below.
    """
    raise NotImplementedError("Define the no-skill floor for the null-control self-test.")


def selftest() -> None:
    """Freeze the scorer behind asserted invariants. MUST pass before experiment 000.

    Two universal checks (add domain-specific ones):
      1. PERFECT case — prediction == target scores at the optimal end of the metric.
      2. NULL control — a scrambled / random prediction collapses to the no-skill floor. A 'win' that
         survives scrambling is scoring leakage, not signal.
    """
    rng = np.random.default_rng(0)

    # TODO(campaign): build a small, known (prediction, target) pair for this campaign.
    target = rng.standard_normal((8, 8))
    perfect = target.copy()
    scrambled = rng.standard_normal(target.shape)

    s_perfect = compute_metric(perfect, target)
    assert np.isfinite(s_perfect), "metric returned a non-finite value on the perfect case"

    # 1. Perfect prediction is optimal (direction-aware: set by PRIMARY_DIRECTION above).
    s_scrambled = compute_metric(scrambled, target)
    # A range whose WORSE end excludes the scorer's own perfect case contradicts the scorer and would
    # flag every good experiment forever. Cheapest possible place to catch that: here, before experiment
    # 000. The BETTER end may exclude it on purpose (e.g. an RMSE floor at the measurement noise: a score
    # below it points at leakage).
    if PLAUSIBILITY_BOUNDS:
        low, high = PLAUSIBILITY_BOUNDS
        worse_end = low if HIGHER_IS_BETTER else high
        beyond = worse_end is not None and (s_perfect < worse_end if HIGHER_IS_BETTER else s_perfect > worse_end)
        assert not beyond, (f"PLAUSIBILITY_BOUNDS' worse end {worse_end:g} excludes the metric's own "
                            f"perfect case ({s_perfect:g}). The range contradicts the scorer; fix "
                            "whichever is wrong before running anything.")
    assert _better(s_perfect, s_scrambled), (
        "perfect prediction did not score better than a scrambled one "
        f"(perfect={s_perfect}, scrambled={s_scrambled}) — check the sign/convention"
    )

    # 2. Null control: scrambled input collapses to the no-skill floor (within tolerance).
    floor = _no_skill_floor(target)
    assert abs(s_scrambled - floor) < 0.1 * (abs(floor) + 1.0), (
        f"scrambled input did not collapse to the no-skill floor (got {s_scrambled}, floor {floor}) "
        "— possible scoring leakage"
    )

    print("metric selftest: PASS")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="FROZEN metric for {{CAMPAIGN_TITLE}}")
    ap.add_argument("--selftest", action="store_true", help="run the asserted invariants and exit")
    args = ap.parse_args()
    if args.selftest:
        selftest()
    else:
        ap.print_help()
