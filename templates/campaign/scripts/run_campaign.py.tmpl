def _md_section(path: Path, heading: str) -> str | None:
    """The body of one `## <heading>` section of a Markdown file, or None if file/section is absent."""
    try:
        text = path.read_text(encoding="utf-8-sig")
    except OSError:
        return None
    lines, keep = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            if keep:
                break
            keep = heading.lower() in line.lower()
            continue
        if keep:
            lines.append(line)
    return "\n".join(lines).strip() if lines else None


def _delivered_context() -> str:
    """The living context every spawned agent carries: the project's §Standing constraints
    (PROJECT.md; a pre-consolidation project keeps it in PROJECT_ORIENTATION.md) - the one document
    OUTSIDE the per-cycle read set that must still be guaranteed present.

    Delivered by VALUE, not by pointer: a pointed-at constraint is read only when an agent chooses
    to look, and these are the constraints that must not depend on that choice. (The campaign's own
    landmines and checks need no injection: they live in campaign.md, which the spawn prompt requires
    both roles to re-read every cycle.) The doc is living, so what was delivered can differ between
    experiments - which is why the per-experiment snapshot stamps the spawn prompt's hash (see
    snapshot_experiment).

    A missing section is named LOUDLY in the prompt rather than silently absent, because a constraint
    delivery that degrades to nothing recreates the recorded-but-unread failure this mechanism
    exists to close. Preflight refuses to launch without the constraints section at all.
    """
    src = _orientation_file()
    constraints = _md_section(src, "Standing constraints")
    return (f"\n\n== STANDING CONSTRAINTS (../../{src.name} - the project overview; "
            "equations, methods, instrument and durable decisions live below this section) ==\n"
            + (constraints or f"[MISSING: ../../{src.name} has no '## Standing "
               "constraints' section. Report this in the journal; do not guess the constraints.]"))


def build_prompt(role: str, *, config: str = "<config path>", reasons: str = "<trigger reasons>",
                 notes: str = "", exps: str = "<exp ids>", hypothesis: str = "") -> str:
    """The ONE assembly path for a spawned agent's prompt.

    Both spawn sites AND `--show-prompt` come through here, so what a reviewer inspects is what an
    agent receives, byte for byte. Before this the prompt was assembled inline at each call site,
    which is exactly the shape that lets a preview drift from the real thing — and a setup review
    gate is only worth having if it cannot lie about what it is showing.

    The delivered context and the notes are appended by CONCATENATION after .format(), never through
    it, so braces in doc text or user-written note text cannot crash the driver (see _drain_inbox).

    NOT included: the campaign `CLAUDE.md`, which the agent harness auto-loads on top of this, and
    the files this prompt tells the agent to read (`campaign.md`, the role file). This returns the
    literal spawn string, nothing more — see --show-prompt's own output for that distinction.
    """
    if role == "worker":
        return WORKER_PROMPT.format(config=config) + _delivered_context() + notes
    if role == "planner":
        return PLANNER_PROMPT.format(reasons=reasons) + _delivered_context() + notes
    if role == "verifier":
        # The hypothesis rides in as a format VALUE (never through the template string), so braces in
        # planner-authored text cannot crash the driver - same contract as notes. No inbox notes: user
        # steering goes to judgment agents (worker/planner); the verifier stays isolated from it.
        hyp = ("\nBlock hypothesis (what this batch tests): " + hypothesis) if hypothesis else ""
        return VERIFIER_PROMPT.format(exps=exps, hyp=hyp) + _delivered_context()
    raise ValueError(f"unknown role {role!r} (expected 'worker', 'planner' or 'verifier')")


def _read_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8-sig"))   # BOM-tolerant: Windows editors add one
    except Exception:
        return default


# ---- campaign properties (what kind of campaign this is) ----------------------------------------------
# Two setup-time declarations every mechanical check branches on. They live in one place, configs/loop.json
# "campaign" - because Tier 0 asserts a routing row's leading concept occurs in the file it names, so a
# property split across campaign.md prose and JSON would be a fork with a green check over it.

PREDICTION_MODES = ("range", "direction", "none")
NOISE_MODELS = ("stochastic", "deterministic")
# 'per-block' (default): the driver spawns an independent verification agent after every completed
# unit/block, and a promotion needs that experiment's own verdict. 'promotion-only': verification runs
# only when something is promoted (the pre-verify-after behavior) - requires a recorded reason, the
# same owned-control contract as prediction_mode 'none'.
VERIFICATION_MODES = ("per-block", "promotion-only")


def _campaign_props(loop_cfg: dict | None = None) -> dict:
    """This campaign's two properties + their numeric companions, with code defaults.

    The defaults reproduce the pre-V0 behaviour EXACTLY (a required numeric range; a stochastic campaign),
    so a loop.json written before this block existed keeps working unchanged - the same additive contract
    _driver_knobs() uses for the driver section.

    An unrecognized VALUE is not silently defaulted here: it is normalized to whatever was written and
    rejected by campaign_props_problems(), which both preflight and validate_campaign.py run. A typo'd
    "determinstic" that quietly fell back to "stochastic" would leave a deterministic campaign held to a
    spread test it can never satisfy - and it would fail in the direction that looks like rigor, which is
    the direction nobody investigates.
    """
    if loop_cfg is not None:
        src = loop_cfg
    elif not LOOPCFG.is_file():
        return {"_unreadable": f"configs/loop.json is missing ({LOOPCFG})"}
    else:
        src = _read_json(LOOPCFG, None)
        if src is None:
            return {"_unreadable": "configs/loop.json does not parse as JSON"}
    if not isinstance(src, dict):
        return {"_unreadable": f"configs/loop.json is a {type(src).__name__}, not a JSON object"}
    c = src.get("campaign")
    if c is None:
        c = {}
    elif not isinstance(c, dict):
        return {"_unreadable": f'configs/loop.json "campaign" is a {type(c).__name__}, not an object'}

    bad_nums = []

    def _num(key):
        """Strictly numeric, finite, non-negative - or None (unset). A resolution knob is a magnitude.

        Deliberately NOT coercing: a string "0.05" is a filled-in-wrong field, not a number, and
        accepting it teaches that the schema is advisory. A NEGATIVE value is worse than wrong - it makes
        the noise check pass unconditionally (|delta| > -1 always) and makes "unchanged" unobservable, so
        it fails silently in the direction that looks like a clean result.
        """
        v = c.get(key)
        if v is None:
            return None
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            bad_nums.append(f"campaign.{key} is {v!r}; it must be a JSON number or null, not a "
                            f"{type(v).__name__} (a quoted number is a string, not a number)")
            return None
        v = float(v)
        if not np.isfinite(v) or v < 0:
            bad_nums.append(f"campaign.{key} is {v!r}; a resolution is a finite, non-negative magnitude")
            return None
        return v

    return {
        "prediction_mode": str(c.get("prediction_mode") or "range").strip().lower(),
        "prediction_mode_reason": str(c.get("prediction_mode_reason") or "").strip(),
        "noise_model": str(c.get("noise_model") or "stochastic").strip().lower(),
        "noise_floor": _num("noise_floor"),
        "tolerance": _num("tolerance"),
        "metric_version": str(c.get("metric_version") or "").strip(),
        "data_version": str(c.get("data_version") or "").strip(),
        "verification": str(c.get("verification") or "per-block").strip().lower(),
        "verification_reason": str(c.get("verification_reason") or "").strip(),
        "_bad_nums": bad_nums,
    }


def campaign_props_problems(props: dict) -> list[str]:
    """Every way configs/loop.json "campaign" can be WRONG, as plain-language fixes. Hard failures only.

    Shared by the runner's preflight and by new-campaign's validate_campaign.py so scaffold time and launch
    time cannot disagree about what a legal campaign block is - two copies of one rule drift, and the drift
    shows up as a campaign that validates and then refuses to launch.

    A MISSING noise_floor / tolerance is deliberately NOT a failure: it is unset debt, and the honest
    response is for the checks artifact to report that check `unavailable` naming the knob that would
    supply it, not for the runner to refuse a campaign that has not estimated its spread yet. A missing
    prediction_mode_reason under mode 'none' IS a failure - the recorded reason is the only thing standing
    between "we genuinely cannot bound this" and "bounding it was inconvenient".
    """
    bad = []
    if props.get("_unreadable"):
        # Not defaulted. Running an experiment under properties nobody chose turns a deterministic
        # campaign into a stochastic one with no error: its tolerance vanishes and the noise check goes
        # unavailable, while the run is scored and recorded as though all of that were intended.
        return [props["_unreadable"] + ". Fix: restore it (new-campaign generates it; a "
                "results/snapshots/ copy has the version this campaign last ran under)."]
    bad.extend(props.get("_bad_nums") or [])
    if props["prediction_mode"] not in PREDICTION_MODES:
        bad.append(f"configs/loop.json campaign.prediction_mode is {props['prediction_mode']!r}; expected "
                   f"one of {' | '.join(PREDICTION_MODES)}. Fix: set it to the honest one - 'range' if you "
                   "can bound the answer, 'direction' if you can only say which way, 'none' (with a "
                   "reason) if neither is honest.")
    if props["noise_model"] not in NOISE_MODELS:
        bad.append(f"configs/loop.json campaign.noise_model is {props['noise_model']!r}; expected one of "
                   f"{' | '.join(NOISE_MODELS)}. Fix: 'deterministic' if repeating a run reproduces the "
                   "metric exactly, else 'stochastic'.")
    if props["prediction_mode"] == "none" and not props["prediction_mode_reason"]:
        bad.append("configs/loop.json sets campaign.prediction_mode='none' with an empty "
                   "campaign.prediction_mode_reason. Fix: record WHY this campaign cannot honestly bound "
                   "its answer (exploratory discovery, first-of-kind measurement, unknown landscape). "
                   "Running with no a-priori bound is a real choice; making it without a recorded reason "
                   "is how the control quietly becomes nobody's decision.")
    if props["verification"] not in VERIFICATION_MODES:
        bad.append(f"configs/loop.json campaign.verification is {props['verification']!r}; expected one "
                   f"of {' | '.join(VERIFICATION_MODES)}. Fix: 'per-block' (the default - the driver "
                   "spawns independent verification after every completed unit/block), or "
                   "'promotion-only' with a recorded reason.")
    if props["verification"] == "promotion-only" and not props["verification_reason"]:
        bad.append("configs/loop.json sets campaign.verification='promotion-only' with an empty "
                   "campaign.verification_reason. Fix: record WHY per-block verification is not "
                   "affordable or applicable here. Turning routine verification down is a real choice; "
                   "making it without a recorded reason is how the control quietly becomes nobody's "
                   "decision.")
    return bad


def _halt(msg: str):
    """Hard halt, LOUDLY and ON THE RECORD: the reason goes through stdout (tee'd to the driver log by
    DriverLog), not only stderr - a halt whose reason lives nowhere is a silent halt by morning."""
    print(msg)
    sys.exit(1)


# ---- disk budget --------------------------------------------------------------------------------------
# A campaign that runs out of disk overnight fails in the worst way available: half-written artifacts, a
# save-set gate tripping on I/O errors, and a ledger that disagrees with what is on disk. The per-unit
# footprint is estimated at scaffold time (new-campaign, from the artifact plan) into
# configs/loop.json unit_cost.typical_disk_mb; here it becomes a launch refusal and a loop-top stop.
DISK_FLOOR_UNITS = 3        # refuse to launch / keep running below this many units of headroom
DISK_WARN_UNITS = 20        # short-runway note (not a failure)
DISK_FLOOR_MB = 512         # absolute floor - below this, writes start failing whatever the estimate says


def _free_disk_mb() -> float | None:
    try:
        return shutil.disk_usage(ROOT).free / (1024 * 1024)
    except OSError:
        return None


def _unit_disk_mb(loop_cfg: dict) -> float:
    """Estimated MB one unit adds to results/. 0 or absent = not estimated, which DISABLES the check
    rather than guessing a floor that could refuse a healthy launch (older campaigns lack the field)."""
    try:
        return float((loop_cfg.get("unit_cost") or {}).get("typical_disk_mb", 0) or 0)
    except (TypeError, ValueError):
        return 0.0


def _disk_floor_mb(per_unit: float) -> float:
    return max(DISK_FLOOR_MB, DISK_FLOOR_UNITS * per_unit)


def _mb(x: float) -> str:
    """MB, readable at both ends of the range a campaign can span (0.5 MB analytic -> 40 GB checkpoints)."""
    return f"{x:,.1f}" if x < 10 else f"{x:,.0f}"


def _driver_knobs(loop_cfg: dict) -> dict:
    """Driver-section knobs with code-side defaults: an older loop.json without a "driver" section keeps
    working unchanged (these knobs are additive). The template ships these as literals - no placeholders,
    no setup interview; hand-edit configs/loop.json to change them (the driver hot-reloads it)."""
    d = loop_cfg.get("driver") or {}
    w = loop_cfg.get("worker") or {}
    return {
        "max_consecutive_failures": int(d.get("max_consecutive_failures", 3)),
        "planner_retries": int(d.get("planner_retries", 1)),
        "stream": str(d.get("stream", "auto")).strip().lower(),
        "inbox_max_chars": int(d.get("inbox_max_chars", 20000)),
        "feed_chars": int(d.get("feed_line_chars", 160)),
        "hb_stale_s": float(d.get("heartbeat_stale_min", 5)) * 60,
        "grace_s": float(d.get("detached_grace_min", 60)) * 60,
        "inactivity_s": float(w.get("inactivity_timeout_min", 30)) * 60,
    }


def _stream_on(k: dict) -> bool:
    """Whether spawns get the stream-json flags. "auto" (default) = only for the default claude CLI -
    a custom AUTORESEARCH_AGENT_CMD (e.g. the test stub) must not be handed flags it doesn't understand.
    "on"/"off" override in either direction."""
    if k["stream"] == "on":
        return True
    if k["stream"] == "off":
        return False
    return "AUTORESEARCH_AGENT_CMD" not in os.environ


def _render_stream_event(raw_line: str, label: str, max_chars: int) -> str | None:
    """One agent-stdout line -> one compact feed line for the terminal + driver log, or None to drop.
    stream-json events are summarized (tool name + clipped input, text snippets, the final result);
    anything that isn't JSON (a stub, a plain-output CLI) is echoed verbatim, truncated. Never formats
    or interprets agent/user text - render-only."""
    s = raw_line.rstrip("\r\n")
    if not s.strip():
        return None
    try:
        ev = json.loads(s)
        assert isinstance(ev, dict)
    except Exception:
        return f"[{label}] {s}"[:max_chars]
    etype = ev.get("type")
    if etype == "system":
        # ONLY `init` is a session start. A session emits many other `system` events, and labelling them
        # all identically buried the thing the feed exists to show: one real worker unit produced 253 of
        # these against 7 lines of agent text. The tell was that they printed `model=?` -- an init event
        # carries a model. A feed nobody can read is not a feed.
        if ev.get("subtype") != "init":
            return None
        return f"[{label}] session start (model={ev.get('model', '?')})"[:max_chars]
    if etype == "assistant":
        bits = []
        for blk in (ev.get("message") or {}).get("content") or []:
            if not isinstance(blk, dict):
                continue
            if blk.get("type") == "text" and str(blk.get("text", "")).strip():
                bits.append("text: " + " ".join(str(blk["text"]).split()))
            elif blk.get("type") == "tool_use":
                try:
                    arg = json.dumps(blk.get("input", {}))
                except Exception:
                    arg = "?"
                bits.append(f"tool: {blk.get('name', '?')} {arg[:80]}")
        return "\n".join(f"[{label}] {b}"[:max_chars] for b in bits) if bits else None
    if etype == "result":
        return (f"[{label}] RESULT ok={not ev.get('is_error', False)} "
                f"turns={ev.get('num_turns', '?')} dur={float(ev.get('duration_ms', 0)) / 1000:.0f}s")[:max_chars]
    return None


def _kill_tree(proc: subprocess.Popen) -> None:
    """Kill an agent and its whole process tree (Windows-first: taskkill /T; no POSIX signals)."""
    try:
        if sys.platform == "win32":
            subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                           capture_output=True, timeout=30)
        else:
            proc.terminate()
        proc.wait(timeout=15)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass


def _touch_driver_alive() -> None:
    """Refresh results/.driver_alive. While its mtime is fresh the campaign's Stop hook stands down for
    ATTENDED sessions (the concierge, a user checking in): campaign-level loop persistence is THIS
    process's job while it runs. Removed on driver exit - a crashed driver re-arms the hook within the
    hook's freshness window. Never raises."""
    try:
        DRIVER_ALIVE.write_text(json.dumps({"pid": os.getpid(), "utc": _utc_stamp()}), encoding="utf-8")
    except Exception:
        pass


_LIVE_PROC: dict = {"proc": None}   # the currently-running agent, for Ctrl-C cleanup


def _spawn_agent(prompt: str, model: str, label: str, k: dict, saved_probe=None) -> str:
    """Launch one fresh-context agent from the campaign root and WATCH it to completion.

    Returns "ok" | "exit_nonzero" | "timeout_inactivity" | "timeout_absolute" | "spawn_error".
    Liveness (dead-worker detection ONLY - progress is the ledger's job): the agent counts alive while
    its stdout produces lines OR results/.run_heartbeat's mtime keeps changing; neither for
    k["inactivity_s"] -> kill. An agent with NO liveness source at all (a silent stub) falls back to the
    absolute wall-clock cap alone, by construction. All timing on time.monotonic() (clock-skew-proof;
    the heartbeat is only ever compared to its own previous value).
    POST-EXIT GRACE: if the process exits while the heartbeat is still fresh - a detached/backgrounded
    runner still solving - wait up to k["grace_s"] for
    `saved_probe` to come true or the heartbeat to go stale, instead of instantly failing validation.
    """
    stream = _stream_on(k)
    cmd = (AGENT_CMD + ["--dangerously-skip-permissions"]
           + (["--model", model] if model else []) + (STREAM_FLAGS if stream else []) + [prompt])
    print(f"[supervise] spawning {label} (model={model or 'default'}, cap={k['absolute_s'] / 3600:.1f}h, "
          f"inactivity window={k['inactivity_s'] / 60:.0f}min, stream={'on' if stream else 'off'})")
    HEARTBEAT.unlink(missing_ok=True)   # a stale heartbeat from an earlier run must not fake liveness
    env = dict(os.environ, AUTORESEARCH_SUPERVISED="1")   # Stop hook stands down for spawned agents
    try:
        proc = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, encoding="utf-8",
                                errors="replace", bufsize=1)
    except OSError as exc:
        print(f"[supervise] SPAWN ERROR for {label}: {exc}")
        return "spawn_error"
    _LIVE_PROC["proc"] = proc
    lines: _LineQueue = _LineQueue()

    def _reader():
        try:
            for raw in proc.stdout:
                lines.put(raw)
        except Exception:
            pass

    threading.Thread(target=_reader, daemon=True).start()

    start = time.monotonic()
    last_activity = None          # None until ANY liveness source appears
    last_hb_mtime = None
    last_hb_change = None
    next_alive = 0.0
    status = None
    while status is None:
        if time.monotonic() >= next_alive:                      # keep the Stop-hook stand-down fresh
            _touch_driver_alive()
            next_alive = time.monotonic() + 30
        try:
            raw = lines.get(timeout=1.0)
        except _QEmpty:
            raw = None
        if raw is not None:
            rendered = _render_stream_event(raw, label, k["feed_chars"])
            if rendered:
                try:
                    print(rendered)
                except UnicodeEncodeError:
                    # _make_console_lenient() normally prevents this; if stdout could not be
                    # reconfigured, drop to a transliteration rather than losing the loop.
                    enc = getattr(sys.stdout, "encoding", None) or "ascii"
                    print(rendered.encode(enc, "replace").decode(enc, "replace"))
            last_activity = time.monotonic()
        try:
            hb = HEARTBEAT.stat().st_mtime
        except OSError:
            hb = None
        if hb is not None and hb != last_hb_mtime:              # mtime CHANGE = liveness, never age
            last_hb_mtime = hb
            last_hb_change = time.monotonic()
            last_activity = last_hb_change
        if proc.poll() is not None:
            if raw is None and lines.empty():
                status = "exited"                               # fully drained - judge below
            continue
        now = time.monotonic()
        if now - start > k["absolute_s"]:
            print(f"[supervise] {label} TIMED OUT (absolute cap {k['absolute_s'] / 3600:.1f}h) - "
                  "killing the process tree")
            _kill_tree(proc)
            status = "timeout_absolute"
        elif last_activity is not None and now - last_activity > k["inactivity_s"]:
            print(f"[supervise] {label} INACTIVE for {k['inactivity_s'] / 60:.0f} min (no output, no "
                  "heartbeat) - a dead worker, killing the process tree")
            _kill_tree(proc)
            status = "timeout_inactivity"
    _LIVE_PROC["proc"] = None
    if status != "exited":
        return status
    # ---- POST-EXIT detached-runner grace ----
    if (saved_probe is not None and last_hb_change is not None
            and time.monotonic() - last_hb_change <= k["hb_stale_s"] and not saved_probe()):
        poll_s = max(1.0, min(10.0, k["grace_s"] / 10))
        t0 = time.monotonic()
        deadline = t0 + k["grace_s"]
        print(f"[supervise] {label} exited but the heartbeat is FRESH - a detached runner may still be "
              f"solving; waiting up to {k['grace_s'] / 60:.0f} min for the save-set (grace)")
        while time.monotonic() < deadline:
            if saved_probe():
                break
            try:
                hb = HEARTBEAT.stat().st_mtime
            except OSError:
                hb = None
            if hb is not None and hb != last_hb_mtime:
                last_hb_mtime = hb
                last_hb_change = time.monotonic()
            if time.monotonic() - last_hb_change > k["hb_stale_s"]:
                break
            _touch_driver_alive()
            time.sleep(poll_s)
        print(f"[supervise] detached-runner grace ended after {time.monotonic() - t0:.0f}s "
              f"(resolved={bool(saved_probe())})")
    return "ok" if proc.returncode == 0 else "exit_nonzero"


def _read_queue() -> dict:
    """results/queue.json, strictly: ABSENT -> a fresh empty ledger (first launch); EXISTS-BUT-UNPARSEABLE
    -> HARD HALT (integrity). The ledger is the loop's only memory - a corrupt queue must never be
    mistaken for an empty one (that would silently erase every queued direction and the accept counters).
    """
    default = {"next": [], "shelved": [], "accepted_units": 0,
               "last_accept_utc": None, "units_since_planner": 0, "pending_verification": []}
    if not QUEUE.is_file():
        return default
    try:
        q = json.loads(QUEUE.read_text(encoding="utf-8-sig"))   # BOM-tolerant (hand-edits on Windows)
        assert isinstance(q, dict) and isinstance(q.get("next"), list), "not an object with a 'next' list"
        for key, val in default.items():
            q.setdefault(key, val)
        return q
    except Exception as exc:
        _halt(f"supervise: HALT - results/queue.json exists but cannot be parsed ({exc}). INTEGRITY: "
              "repair the JSON by hand before relaunching; do NOT delete it - it is the queue ledger.")


def _write_queue(q: dict) -> None:
    """The SOLE authoritative write of results/queue.json - the driver is its only writer. Commit through
    a temp file + os.replace so every write is ATOMIC (on POSIX and Windows): a concurrent reader, or a
    detached worker tail, can never observe a half-written ledger, which is the torn read that would
    otherwise trip _read_queue's integrity halt. Agents propose changes via results/queue_drop/ instead of
    editing this file, so there is never a second writer to race with."""
    tmp = QUEUE.parent / f".queue.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(q, indent=2), encoding="utf-8")
    os.replace(tmp, QUEUE)


def _iter_drop_records(obj):
    """Yield well-formed drop records from a parsed drop file, which may be one record or a list of them.
    Forgiving on shape (an agent hand-wrote it) but strict on kind - anything else is ignored, not halted."""
    for it in (obj if isinstance(obj, list) else [obj]):
        if isinstance(it, dict) and it.get("kind") in ("decline", "propose"):
            yield it


def _has_decline_drop(config: str) -> bool:
    """True if an un-drained results/queue_drop/ file declines this unit - the grace probe's decline
    signal, now that the worker drops a file instead of editing queue.json in place. Read-only: the merge
    and archive happen in _drain_queue_drops after the spawn returns."""
    try:
        files = [f for f in DROP.glob("*.json") if f.is_file()]
    except OSError:
        return False
    for f in files:
        for rec in _iter_drop_records(_read_json(f, None)):
            if rec.get("kind") == "decline" and rec.get("config") == config:
                return True
    return False


def _drain_queue_drops(q: dict) -> bool:
    """Merge append-only agent drop files (results/queue_drop/*.json) into the in-memory queue, then
    archive each - the ONE point where worker/verifier changes enter the ledger, keeping the driver the
    sole writer of queue.json. A "decline" appends its reason to the matching queued unit's "declined"
    list; a "propose" appends a unit to "next". Mirrors _drain_inbox's discipline: archive FIRST and only
    then apply, so a file that cannot be archived is deferred (never applied twice). Tolerant by design -
    each drop file is independent, so one malformed file is skipped, not halted (unlike the monolithic
    queue), and read BOM-tolerant like every other reader here. Returns True if the queue changed."""
    try:
        files = sorted((f for f in DROP.glob("*.json") if f.is_file()),
                       key=lambda f: f.stat().st_mtime)
    except OSError:
        return False
    changed = False
    for f in files:
        rec_obj = _read_json(f, None)
        try:                                    # archive BEFORE applying: a record we cannot move out of
            DROP_ARCHIVE.mkdir(parents=True, exist_ok=True)   # the drop dir must not be applied, or it
            f.replace(DROP_ARCHIVE / f"{_utc_stamp()}_{f.name}")   # re-fires and double-applies next pass
        except OSError:
            print(f"[supervise] queue_drop: cannot archive {f.name} - deferring (not applied this pass)")
            continue
        if rec_obj is None:
            print(f"[supervise] queue_drop: {f.name} was not valid JSON - archived and skipped")
            continue
        for rec in _iter_drop_records(rec_obj):
            if rec["kind"] == "decline":
                cfg = rec.get("config")
                reason = (rec.get("reason") or "; ".join(rec.get("reasons", []) or [])
                          or "declined (no reason given)")
                unit = next((u for u in q.get("next", []) if u.get("config") == cfg), None)
                if unit is not None:
                    unit.setdefault("declined", []).append(str(reason))
                    changed = True
                    print(f"[supervise] queue_drop: decline merged for {cfg}")
                else:
                    print(f"[supervise] queue_drop: decline for {cfg!r} matches no queued unit - ignored")
            else:  # propose
                unit = rec.get("unit") if isinstance(rec.get("unit"), dict) else {
                    key: rec[key] for key in ("config", "rationale", "block", "hypothesis", "proposed_by")
                    if key in rec}
                if unit.get("config"):
                    unit.setdefault("proposed_by", "agent")
                    q.setdefault("next", []).append(unit)
                    changed = True
                    print(f"[supervise] queue_drop: proposal merged: {unit.get('config')}")
                else:
                    print("[supervise] queue_drop: proposal without a config - ignored")
    return changed


def _normalize_blocks(q: dict) -> bool:
    """Reorder "next" so units sharing a "block" id are contiguous, WITHOUT moving the head or any block's
    first member: each unit is grouped under the FIRST-occurrence position of its block, and a block-less
    unit is its own group in place. A verifier/planner proposal that tagged an existing block but landed at
    the tail is pulled up beside its block, so the block's verification is not withheld behind unrelated
    units - the consumer rule (_verification_backlog) releases a block only once no queued unit still
    shares its id, so a straggler inverts verification order. Stable and idempotent; True if order changed."""
    nxt = q.get("next", []) or []
    order, buckets = [], {}
    for i, u in enumerate(nxt):
        b = u.get("block")
        key = ("b", b) if b else ("u", i)      # block-less units get a unique per-position key -> stay put
        if key not in buckets:
            buckets[key] = []
            order.append(key)
        buckets[key].append(u)
    new = [u for key in order for u in buckets[key]]
    if new != nxt:
        q["next"] = new
        return True
    return False


def _record_failure(q: dict, config: str, attempt: int, status: str, detail: str) -> None:
    """Append one failure record to the unit's additive "failures" list (queue.json) - the planner and
    the humans read these; the driver itself never interprets them."""
    for u in q.get("next", []):
        if u.get("config") == config:
            u.setdefault("failures", []).append(
                {"utc": _utc_stamp(), "attempt": attempt, "status": status, "detail": detail})
            return


def _shelve_unit(q: dict, config: str, kind: str, reasons: list) -> None:
    """Move a unit out of "next" onto the shelf. kind="declined" is worker judgment working as designed;
    kind="operational" is the driver failing to get the unit executed (degrade-loud). Both are
    revivable by the planner; neither is a silent drop."""
    unit = next((u for u in q.get("next", []) if u.get("config") == config), None)
    q["next"] = [u for u in q.get("next", []) if u.get("config") != config]
    q.setdefault("shelved", []).append({
        "config": config, "kind": kind, "reasons": list(reasons), "utc": _utc_stamp(),
        "failures": (unit or {}).get("failures", []),
    })


def _drain_inbox(max_chars: int) -> str:
    """Collect unarchived user notes (results/inbox/*.md|*.txt) for VERBATIM relay into the next spawn's
    prompt, then archive them to results/inbox/archive/<stamp>_<name>. The driver never parses or acts
    on note content - notes are data relayed to a judgment agent (worker/planner), which must
    acknowledge them in the journal. Oldest first; whole notes only up to the cap (a note that doesn't
    fit is DEFERRED to the next spawn, never truncated across the boundary; a single note larger than
    the cap is injected truncated with an explicit marker - its full text is safe in the archive).
    Injected by string CONCATENATION after .format(), so braces in note text cannot crash the driver."""
    try:
        files = sorted((f for f in list(INBOX.glob("*.md")) + list(INBOX.glob("*.txt")) if f.is_file()),
                       key=lambda f: f.stat().st_mtime)
    except OSError:
        return ""
    blocks, total = [], 0
    for f in files:
        try:
            text = f.read_text(encoding="utf-8-sig", errors="replace")
            received = _dt.datetime.fromtimestamp(f.stat().st_mtime, _dt.timezone.utc).strftime("%Y-%m-%d %H:%MZ")
        except OSError:
            continue
        if blocks and total + len(text) > max_chars:
            break                       # defer the rest to the NEXT spawn - never drop a note
        clipped = text if len(text) <= max_chars else (
            text[:max_chars] + f"\n[driver: truncated at {max_chars} chars - full text in results/inbox/archive/]")
        try:
            INBOX_ARCHIVE.mkdir(parents=True, exist_ok=True)
            f.replace(INBOX_ARCHIVE / f"{_utc_stamp()}_{f.name}")
        except OSError:
            continue                    # cannot archive -> do not inject (it would re-fire every spawn)
        blocks.append(f"--- note: {f.name} (received {received}) ---\n{clipped}")
        total += len(clipped)
        print(f"[supervise] inbox: relaying {f.name} ({len(text)} chars) into the next spawn")
    if not blocks:
        return ""
    return ("\n\n==== USER NOTES relayed by the driver (verbatim; weigh as user input) ====\n"
            + "\n\n".join(blocks)
            + "\n==== end USER NOTES ====")


def preflight(smoke: bool = False) -> list[str]:
    """Launch checks for supervisor mode - run automatically at --supervise start and standalone via
    --preflight. Collects and reports ALL failures (never first-fail); every failure names its fix in
    plain language. Refusing a launch is cheaper than a night of unit-by-unit discovery.
    `smoke` additionally does ONE real agent spawn (costs one model call; opt-in)."""
    fails: list[str] = []

    def ok(msg):
        print(f"preflight OK: {msg}")

    def bad(msg):
        fails.append(msg)
        print(f"preflight FAIL: {msg}")

    # 1. agent CLI resolves and answers
    exe = shutil.which(AGENT_CMD[0])
    if exe is None:
        bad(f"agent CLI '{AGENT_CMD[0]}' not found on PATH. Fix: install the claude CLI (or set "
            "AUTORESEARCH_AGENT_CMD to the command to use).")
    else:
        try:
            proc = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30)
            if proc.returncode == 0:
                out = (proc.stdout or "").strip().splitlines()
                ok(f"agent CLI: {exe} ({out[0] if out else 'responds'})")
            else:
                print(f"preflight note: '{AGENT_CMD[0]} --version' exited {proc.returncode} - a custom "
                      "AUTORESEARCH_AGENT_CMD may not implement it; continuing.")
        except (subprocess.TimeoutExpired, OSError) as exc:
            bad(f"agent CLI '{exe}' did not answer --version ({exc}). Fix: check the install "
                "('claude --version' in a fresh terminal), or set AUTORESEARCH_AGENT_CMD.")

    # 2. loop.json parses and carries every key the driver dereferences without a default
    try:
        raw = LOOPCFG.read_text(encoding="utf-8-sig")
    except OSError as exc:
        raw = None
        bad(f"configs/loop.json unreadable ({exc}). Fix: new-campaign generates it; restore it from a "
            "results/snapshots/ copy or the kit template.")
    if raw is not None:
        if "{{" in raw:
            bad("configs/loop.json still contains {{...}} template placeholders. Fix: fill the loop "
                "knobs for this campaign - each knob's meaning is in the file's own '_doc' field.")
        try:
            lc = json.loads(raw)
            missing = []
            for name, keys in (("worker.iteration_timeout_hours", ("worker", "iteration_timeout_hours")),
                               ("planner.cadence_units", ("planner", "cadence_units")),
                               ("plateau.wall_clock_hours", ("plateau", "wall_clock_hours"))):
                node = lc
                try:
                    for kk in keys:
                        node = node[kk]
                    float(node)
                except Exception:
                    missing.append(name)
            if missing:
                bad("configs/loop.json is missing numeric key(s) the driver requires: "
                    + ", ".join(missing) + ". Fix: add them (the kit template shows the schema).")
            else:
                ok("loop.json: effective driver knobs " + json.dumps(_driver_knobs(lc)))
            props = _campaign_props(lc)
            prop_problems = campaign_props_problems(props)
            for problem in prop_problems:
                bad(problem)
            if not prop_problems:
                note = (f"campaign: prediction_mode={props['prediction_mode']} "
                        f"noise_model={props['noise_model']} "
                        f"verification={props['verification']}")
                if props["noise_model"] == "stochastic" and props["noise_floor"] is None:
                    note += " (noise_floor unset - the noise-floor check reports 'unavailable')"
                if props["noise_model"] == "deterministic" and props["tolerance"] is None:
                    note += " (tolerance unset - the tolerance check reports 'unavailable')"
                ok(note)
        except json.JSONDecodeError as exc:
            bad(f"configs/loop.json is not valid JSON ({exc}). Fix: repair it (check trailing commas).")

    # 3. queue.json parses and is schema-sane (absent is fine - the planner seeds it)
    if QUEUE.is_file():
        try:
            qq = json.loads(QUEUE.read_text(encoding="utf-8-sig"))
            assert isinstance(qq.get("next"), list) and isinstance(qq.get("shelved"), list), \
                "'next'/'shelved' must be lists"
            for u in qq["next"]:
                assert isinstance(u, dict) and isinstance(u.get("config"), str), \
                    "every 'next' entry needs a string 'config'"
            ok(f"queue.json: {len(qq['next'])} queued, {len(qq['shelved'])} shelved")
        except Exception as exc:
            bad(f"results/queue.json is corrupt ({exc}). Fix: repair the JSON by hand - it is the queue "
                "ledger, do not delete it.")
    else:
        print("preflight note: results/queue.json absent - the planner will be spawned to seed it.")

    # 4. the campaign tree this driver assumes
    # The three agent-facing documents are checked SEPARATELY, not as one "the contract" entry: a
    # preflight that passes while roles/worker.md is missing launches a worker with no procedure, and
    # one that passes without roles/planner.md spawns a planner with no strategy rules. Each spawn
    # prompt names the file, so each must exist before the driver may spawn anything.
    for rel, why in (("results", "the ledger root"),
                     ("results/scoreboard.tsv", "the results ledger"),
                     ("campaign.md", "the campaign definition every worker re-reads"),
                     ("roles/worker.md", "the per-unit procedure the spawned worker executes"),
                     ("roles/planner.md", "the strategy rules the spawned planner reads"),
                     ("scripts/metric.py", "the FROZEN scorer"),
                     ("configs", "the experiment-config directory")):
        if not (ROOT / rel).exists():
            bad(f"{rel} is missing ({why}). Fix: launch from the campaign root of a scaffolded campaign "
                "(new-campaign generates this tree).")

    # 4a. the delivered context: every spawn carries the project's Standing constraints by value, so a
    # launch without them would run the whole night on prompts missing the constraints the project
    # recorded - the recorded-but-unread failure, mechanized. Refuse instead.
    if _md_section(_orientation_file(), "Standing constraints") is None:
        bad("../../PROJECT.md is missing or has no '## Standing constraints' section (also tried the "
            "pre-consolidation ../../PROJECT_ORIENTATION.md) - that section is delivered into every "
            "spawned worker/planner prompt. Fix: author it (new-project generates it; an older "
            "project layout migrates via the kit's docs/MIGRATING.md).")

    # 4b. disk budget: a launch that cannot hold a few units of artifacts will fail mid-night
    free_mb = _free_disk_mb()
    per_unit = _unit_disk_mb(_read_json(LOOPCFG, {}) or {})
    if free_mb is None:
        print("preflight note: could not read free disk space - the disk-budget check is inactive.")
    elif per_unit <= 0:
        print(f"preflight note: {free_mb / 1024:.1f} GB free; this campaign has no per-unit footprint "
              "estimate (configs/loop.json unit_cost.typical_disk_mb), so the disk-budget check is "
              "inactive. Set it from the artifact plan (roles/worker.md, 'The save-set') to arm it.")
    elif free_mb < _disk_floor_mb(per_unit):
        bad(f"free disk is {free_mb / 1024:.2f} GB - below this campaign's floor of "
            f"{_disk_floor_mb(per_unit) / 1024:.2f} GB ({DISK_FLOOR_UNITS} units x {_mb(per_unit)} MB/unit). "
            "Fix: free space, move the campaign to a larger volume, or shrink the per-experiment artifact "
            "set (roles/worker.md, 'Retention plan') before launching.")
    else:
        runway = free_mb / per_unit
        line = (f"disk: {free_mb / 1024:.1f} GB free = "
                f"{'999+' if runway > 999 else f'~{runway:.0f}'} more units at {_mb(per_unit)} MB/unit")
        if runway < DISK_WARN_UNITS:
            print(f"preflight note: {line} - a short runway. Decide the retention plan now "
                  "(roles/worker.md, 'Retention plan'), not at 3 a.m. when the disk fills.")
        else:
            ok(line)

    # 5. the FROZEN scorer's self-test (same authority as the per-experiment gate)
    msg = metric_selftest_message()
    if msg:
        bad(msg.replace("\n", " "))
    else:
        ok("metric selftest passes")

    # 5b. the campaign's OWN experiment code. The scorer above is probed; these three were not, so a
    # freshly scaffolded campaign passed preflight and was told it was "ready for --supervise" while every
    # unit was guaranteed to fail. Worse than the wasted launch: N identical failures halt the loop as
    # SYSTEMIC, which blames the environment for code that was simply never written.
    stubs = unimplemented_hooks()
    if stubs:
        bad("campaign hooks are still the generated stubs: "
            + ", ".join(f"{n}()" for n in stubs)
            + ". Fix: implement them in scripts/run_campaign.py - they are this campaign's physics "
              "(the experiment dispatcher, the lever contract, the target loader) - then re-run. "
              "Until they are written every experiment fails identically.")
    else:
        ok("campaign hooks implemented (validate_method, run_experiment, load_target)")

    # 6. correctness suite - informational only (a non-green blocks promotion, not the run)
    if (not (ROOT / "tests" / "correctness_checks.py").is_file()
            and not (ROOT / "tests" / "CORRECTNESS_NA.md").is_file()):
        print("preflight note: no correctness suite and no tests/CORRECTNESS_NA.md - runs proceed, but "
              "promotion stays blocked until one exists.")

    # 7. an unresolved ESCALATE halts the driver immediately - surface it now
    if ESCALATE.is_file():
        bad("results/ESCALATE.md present - the driver halts on it at launch. Fix: resolve the fork it "
            "records, then delete the file.")
    # 7b. a leftover STOP sentinel makes the launch a silent no-op - surface it now
    stop = next((p for p in (RESULTS / "STOP", RESULTS / "STOP.txt") if p.exists()), None)
    if stop is not None:
        bad(f"results/{stop.name} present (the graceful-stop sentinel) - the driver would stop "
            "immediately. Fix: delete the file to run the loop.")

    # 8. opt-in smoke spawn (one real model call)
    if smoke and not fails:
        try:
            cmd = AGENT_CMD + ["--dangerously-skip-permissions", "Reply with exactly OK and end the turn."]
            proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=300,
                                  env=dict(os.environ, AUTORESEARCH_SUPERVISED="1"))
            if proc.returncode == 0:
                ok("smoke spawn completed")
            else:
                bad(f"smoke spawn exited {proc.returncode}. Fix: run the agent CLI by hand from this "
                    "directory and read its output.")
        except Exception as exc:
            bad(f"smoke spawn failed ({exc}). Fix: verify the agent CLI runs headless from this directory.")
    return fails


def supervise(smoke: bool = False):
    """The loop driver. Deterministic; judgment lives in the worker/planner agents it spawns."""
    log = DriverLog(DIAG / f"supervise_{_utc_stamp()}.log")
    sys.stdout = log
    print(f"[supervise] ==== launch {_utc_stamp()} ==== root={ROOT} agent_cmd={' '.join(AGENT_CMD)}")
    try:
        INBOX.mkdir(parents=True, exist_ok=True)   # the steering mailbox exists from launch, visibly
        DROP.mkdir(parents=True, exist_ok=True)     # the agent proposal/decline channel, likewise visible
    except OSError:
        pass
    loop_cfg = _read_json(LOOPCFG, None)
    if not loop_cfg:
        _halt("supervise: HALT - configs/loop.json missing or unreadable - new-campaign generates it; "
              "the loop knobs are per-campaign (unit cost), not defaults.")
    fails = preflight(smoke=smoke)
    if fails:
        _halt(f"supervise: HALT - preflight failed ({len(fails)} issue(s), each with its fix above). "
              "Refusing the launch is cheaper than discovering these unit by unit overnight. "
              "Standalone check: python scripts/run_campaign.py --preflight")
    w, p, plat = loop_cfg["worker"], loop_cfg["planner"], loop_cfg["plateau"]
    k = _driver_knobs(loop_cfg)
    k["absolute_s"] = float(w["iteration_timeout_hours"]) * 3600
    props = _campaign_props(loop_cfg)
    cfg_mtime = LOOPCFG.stat().st_mtime
    consec_fail = 0
    consec_vfail = 0

    try:
        while True:
            _touch_driver_alive()
            stop = next((p for p in (RESULTS / "STOP", RESULTS / "STOP.txt") if p.exists()), None)
            if stop is not None:
                # The human's graceful stop, honoured at the CAMPAIGN level (CLAUDE.md HARD GATE 5).
                # We are at the loop top, so the last unit is fully recorded - exit clean, not an error.
                # Recorded in loop_stops.log too: every stop leaves a record (CORE, "Running unattended").
                try:
                    with open(RESULTS / "loop_stops.log", "a", encoding="utf-8") as f:
                        f.write(f"{_dt.datetime.now(_dt.timezone.utc).isoformat()}\tDRIVER_STOP\t"
                                f"{stop.name}\n")
                except OSError:
                    pass
                print(f"[supervise] STOP - results/{stop.name} present: graceful stop honoured. The "
                      "completed unit is recorded; delete the file and relaunch to resume.")
                return
            if ESCALATE.is_file():
                _halt(f"supervise: HALT - {ESCALATE} present (a genuine fork awaits the user). "
                      "Resolve it, delete the file, and relaunch.")
            free_mb, per_unit = _free_disk_mb(), _unit_disk_mb(loop_cfg)
            if free_mb is not None and per_unit > 0 and free_mb < _disk_floor_mb(per_unit):
                # Stopping cleanly beats writing half an artifact set: a disk that fills mid-unit
                # corrupts the save-set the whole ledger rests on. This is the resource analogue of an
                # integrity halt - the last completed unit is fully recorded.
                _halt(f"supervise: HALT - free disk is down to {free_mb / 1024:.2f} GB, below this "
                      f"campaign's floor of {_disk_floor_mb(per_unit) / 1024:.2f} GB "
                      f"({DISK_FLOOR_UNITS} units x {_mb(per_unit)} MB/unit). Stopping BEFORE a unit "
                      "writes a partial save-set. Free space or apply the retention plan "
                      "(roles/worker.md, 'Retention plan'), then relaunch - the queue resumes where it is.")
            if LOOPCFG.stat().st_mtime != cfg_mtime:
                loop_cfg = _read_json(LOOPCFG, loop_cfg)
                w, p, plat = loop_cfg["worker"], loop_cfg["planner"], loop_cfg["plateau"]
                k = _driver_knobs(loop_cfg)
                k["absolute_s"] = float(w["iteration_timeout_hours"]) * 3600
                props = _campaign_props(loop_cfg)
                cfg_mtime = LOOPCFG.stat().st_mtime
                print("[supervise] configs/loop.json changed - reloaded (logged): " + json.dumps(k))

            q = _read_queue()
            # Merge any agent proposals/declinations dropped since the last pass BEFORE the planner
            # triggers read the queue - a dropped proposal must count toward the low-queue trigger and be
            # visible to the planner it may spawn (the planner rewrites "next" from disk, so an un-merged
            # drop would be lost). Persist so the planner reads the merged ledger.
            if _drain_queue_drops(q):
                _write_queue(q)

            # ---- planner triggers (spawn before popping so the planner can reorder/refill) ----
            reasons = []
            if len(q["next"]) < int(p.get("next_min_units", 2)):
                reasons.append("NEXT queue low/empty")
            if q.get("units_since_planner", 0) >= int(p["cadence_units"]):
                reasons.append(f"cadence: {q['units_since_planner']} units since last planner review")
            if q["next"] and q["next"][0].get("declined"):
                reasons.append("head-of-queue declined: " + "; ".join(q["next"][0]["declined"]))
            last = q.get("last_accept_utc")
            if last:
                idle_h = (_dt.datetime.now(_dt.timezone.utc)
                          - _dt.datetime.fromisoformat(last)).total_seconds() / 3600
                if idle_h > float(plat["wall_clock_hours"]):
                    reasons.append(f"plateau: {idle_h:.1f}h without an accepted result")
            if reasons:
                print("[supervise] planner triggered: " + "; ".join(reasons))   # the decision trace
                notes = _drain_inbox(k["inbox_max_chars"])
                st = "unknown"
                for attempt in range(1 + k["planner_retries"]):
                    st = _spawn_agent(build_prompt("planner", reasons="; ".join(reasons), notes=notes),
                                      p.get("model", ""), "planner", k)
                    if st == "ok":
                        break
                    print(f"[supervise] planner attempt {attempt + 1} failed (status={st})"
                          + (" - retrying" if attempt < k["planner_retries"] else ""))
                else:
                    _halt(f"supervise: HALT - planner failed after retries (last status: {st}). The "
                          "queue cannot be trusted unreviewed - the planner's output IS the queue, so "
                          "its failure is systemic, not unit-scoped. See the driver log, then relaunch.")
                q = _read_queue()
                q["units_since_planner"] = 0

            # ---- shelve twice-declined units; the loop keeps moving ----
            for u in [u for u in q["next"] if len(u.get("declined", [])) >= 2]:
                _shelve_unit(q, u["config"], "declined", u.get("declined", []))
                print(f"[supervise] shelved after two declinations: {u['config']}")
            if not q["next"]:
                _write_queue(q)
                _halt("supervise: HALT - queue empty even after a planner pass. The campaign has run "
                      "out of proposed directions; this is a stopping decision for the user (an "
                      "unfalsified 'done' is INCONCLUSIVE - see CLAUDE.md HARD GATE 5).")

            # Keep each block's units contiguous before popping, so a straggler appended behind unrelated
            # units cannot invert verification order (Issue: a block is verified only once no queued unit
            # still shares its id). Does not move the head or any block's first member.
            if _normalize_blocks(q):
                print("[supervise] queue: reordered 'next' to keep block ids contiguous")

            unit = q["next"][0]
            _write_queue(q)

            # ---- one fresh-context worker per unit; retry, then SHELVE and continue (degrade-loud) ----
            cfg_path = Path(unit["config"])
            notes = _drain_inbox(k["inbox_max_chars"])   # drained ONCE per unit; reused on the retry
            prompt = build_prompt("worker", config=unit["config"], notes=notes)

            def _unit_resolved(u=unit, cp=cfg_path) -> bool:
                """Grace probe: the unit counts resolved once its save-set exists OR the worker declined it
                (a drop file in results/queue_drop/, since the worker no longer edits queue.json)."""
                return _unit_saved(cp) or _has_decline_drop(u["config"])

            declined = done = False
            st = "unknown"
            retries = int(w.get("retries", 1))
            for attempt in range(1 + retries):
                st = _spawn_agent(prompt, w.get("model", ""), f"worker[{unit['config']}]", k,
                                  saved_probe=_unit_resolved)
                q = _read_queue()
                _drain_queue_drops(q)          # merge this worker's declinations + proposals (single-writer)
                head = q["next"][0] if q["next"] else None
                declined = bool(head and head.get("config") == unit["config"] and head.get("declined"))
                done = _unit_saved(cfg_path)
                if declined or done:
                    break                      # the accept/decline block below persists q (merged drops incl.)
                _record_failure(q, unit["config"], attempt + 1, st,
                                "unit neither saved nor declined after this attempt")
                _write_queue(q)
                print(f"[supervise] unit not validated (attempt {attempt + 1}): status={st}, "
                      f"saved={done} - " + ("retrying" if attempt < retries else "out of retries"))

            # ---- accept / decline / shelve bookkeeping (liveness = accepted units per unit time) ----
            # DONE IS TESTED FIRST, and it must stay that way. The save-set on disk is the ground truth for
            # "this unit happened"; `declined` is a PERSISTED list that outlives the pass that wrote it and
            # that nothing ever clears. Testing `declined` first classified a unit that was declined once and
            # EXECUTED on a later pass as still-declined: it never left the head of the queue, never counted
            # toward liveness, and was re-run on every subsequent iteration - an unbounded loop appending a
            # real scoreboard row each time, with accepted_units pinned at 0 and last_accept_utc at None (so
            # the plateau trigger fired forever too). That is the drift-silent failure this driver exists to
            # replace - alive, logging, zero accepted science - and no agent has to misbehave to reach it:
            # declining is sanctioned, one declination is below the shelve-at-two threshold, and a later
            # worker may judge the unit runnable. Accepting drops the unit and its stale declinations with it.
            if done:
                stem = _exp_stem(cfg_path)
                pending_exps = {e.get("exp") for e in (q.get("pending_verification") or [])}
                already_accepted = bool(stem) and stem in pending_exps
                q["next"] = [u for u in q["next"] if u.get("config") != unit["config"]]   # always drop it
                consec_fail = 0
                if already_accepted:
                    # IDEMPOTENT ACCEPT (belt-and-braces). Single-writer already removes the resurrected-
                    # queue-entry race that used to accept one unit twice; this guard means that even if a
                    # unit's save-set is re-validated a second time, the counters and pending_verification
                    # are not double-counted. pending_verification is the correct idempotency key here: it
                    # is appended ONLY at accept (below), so its membership means "already accepted" - unlike
                    # the scoreboard row, which the runner writes DURING the unit, so it exists on the first,
                    # legitimate accept too. (Only per-block campaigns populate it; they are the ones that
                    # own verification, and where the duplicate was observed.)
                    print(f"[supervise] unit {unit['config']} already accepted (stem {stem} pending "
                          "verification) - dropping the duplicate without re-counting (idempotent)")
                else:
                    q["accepted_units"] = int(q.get("accepted_units", 0)) + 1
                    q["last_accept_utc"] = _dt.datetime.now(_dt.timezone.utc).isoformat()
                    print(f"[supervise] accepted unit #{q['accepted_units']}: {unit['config']}")
                    if props["verification"] == "per-block" and stem:
                        # Queue the accepted unit for driver-spawned verification. Its block (a batch of
                        # related units sharing a "block" id) is verified once, when its last unit lands;
                        # a block-less unit is a block of one. Persisted in the queue ledger, so
                        # verification owed by an interrupted run is serviced on relaunch.
                        q.setdefault("pending_verification", []).append(
                            {"config": unit["config"], "exp": stem,
                             "block": unit.get("block"), "hypothesis": unit.get("hypothesis")})
            elif declined:
                consec_fail = 0
                print(f"[supervise] unit declined -> planner will review: {unit['config']}")
            else:
                # OPERATIONAL failure: record + shelve + CONTINUE - degrade-loud. The
                # shelf entry (kind="operational", failure records attached) is the loud part; the
                # planner can revive the unit. Only N-in-a-row escalates to a systemic hard halt.
                consec_fail += 1
                _shelve_unit(q, unit["config"], "operational",
                             [f"driver: not validated after retries (last status: {st})"])
                print(f"[supervise] OPERATIONAL failure #{consec_fail}/{k['max_consecutive_failures']}: "
                      f"shelved {unit['config']} (last status: {st}) - the loop continues; the planner "
                      "can revive it (degrade-loud)")
                if consec_fail >= k["max_consecutive_failures"]:
                    q["consecutive_operational_failures"] = consec_fail
                    _write_queue(q)
                    _halt(f"supervise: HALT - {consec_fail} consecutive operational failures is SYSTEMIC "
                          "(the environment, not the units): check the agent CLI, credentials, and disk; "
                          "read the driver log, then relaunch.")
            q["units_since_planner"] = int(q.get("units_since_planner", 0)) + 1
            q["consecutive_operational_failures"] = consec_fail
            _write_queue(q)

            # ---- verify-after: service completed blocks (also drains backlog left by a mode flip) ----
            if props["verification"] == "per-block" or (q.get("pending_verification") or []):
                consec_vfail = _service_verification(k, p.get("model", ""), consec_vfail)
    except KeyboardInterrupt:
        proc = _LIVE_PROC.get("proc")
        if proc is not None and proc.poll() is None:
            _kill_tree(proc)
        print("[supervise] interrupted (Ctrl-C) - live agent killed; the unit stays at the queue head "
              "(relaunch resumes it). For a graceful end-of-unit stop, create results/STOP instead.")
        sys.exit(130)
    finally:
        DRIVER_ALIVE.unlink(missing_ok=True)   # a crashed/exited driver must re-arm the Stop hook
        sys.stdout = log.close()


def _exp_stem(config_path: Path) -> str:
    """The exp_name a config declares, or "" if unreadable - the stem every artifact is keyed by.
    BOM-tolerant, since a config may have been hand-edited on Windows."""
    try:
        return json.loads((ROOT / config_path).read_text(encoding="utf-8-sig"))["exp_name"]
    except Exception:
        return ""


def _unit_saved(config_path: Path) -> bool:
    """Structural validation of what a worker must leave behind (the checkpoint contract's hard core)."""
    stem = _exp_stem(config_path)
    exp_id = exp_id_for(stem) if stem else ""
    if not exp_id:
        return False                       # an unnameable unit cannot have left a well-named save-set
    return ((RESULTS / f"result_{exp_id}.json").is_file()
            and (SNAPSHOTS / stem).is_dir()
            and stem in LOGBOOK.read_text(encoding="utf-8", errors="replace"))


# ---- per-block verification (the driver spawns the verifier; the worker never grades its own work) ----

def _find_verdict_file(stem: str) -> Path | None:
    """The verdict artifact for one experiment, matched by SUBJECT: the file is named for the exp id or
    slug, or its JSON carries the matching exp_id. Filename first (cheap), content second."""
    eid = exp_id_for(stem)
    if not VERDICTS.is_dir():
        return None
    for p in sorted(VERDICTS.glob("*.json")):
        if p.stem == stem or (eid and exp_id_for(p.stem) == eid):
            return p
    for p in sorted(VERDICTS.glob("*.json")):
        try:
            v = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if eid and exp_id_for(str(v.get("exp_id", "")).strip()) == eid:
            return p
    return None


def _stamp_verified(stem: str) -> None:
    """Fill the scoreboard row's `verified` cell from the verdict artifact - mechanical consumption.

    The artifact is the evidence; the column is the view of it, and leaving the stamp to agent
    diligence is how rows acted as current-best with a blank `verified` (the hygiene failure
    campaign-status flags). Fills a BLANK cell only: an already-recorded value is never overwritten -
    a mismatch between column and artifact is campaign-status's audit to surface, not this function's
    to hide. The `verified` column is the one cell of the append-only ledger DESIGNED to be filled
    after its row ("blank until run"), so this is completion, not history-editing."""
    vf = _find_verdict_file(stem)
    if vf is None:
        return
    try:
        verdict = str(json.loads(vf.read_text(encoding="utf-8")).get("verdict", "")).strip().upper()
    except Exception:
        return
    if not verdict:
        return
    eid = exp_id_for(stem)
    try:
        lines = SCOREBOARD.read_text(encoding="utf-8").splitlines()
        header_i = next(i for i, L in enumerate(lines) if L and not L.startswith("#"))
        cols = lines[header_i].split("\t")
        vcol = next((i for i, c in enumerate(cols) if c.strip().lower() == "verified"), None)
        if vcol is None:
            return
        for i in range(header_i + 1, len(lines)):
            cells = lines[i].split("\t")
            if cells and cells[0].strip() == eid:
                while len(cells) < len(cols):
                    cells.append("")
                if not cells[vcol].strip():
                    cells[vcol] = verdict
                    lines[i] = "\t".join(cells)
                    SCOREBOARD.write_text("\n".join(lines) + "\n", encoding="utf-8")
                    print(f"[supervise] stamped scoreboard verified={verdict} for exp {eid} "
                          f"(from {vf.name})")
                return
    except Exception as exc:
        print(f"[supervise] note: could not stamp verified for {stem} ({exc}) - the verdict artifact "
              "is the record either way")


def _verification_backlog(q: dict) -> list[list[dict]]:
    """Groups from queue.json's pending_verification whose block is COMPLETE - no queued unit still
    shares the block id. Unblocked (block-less) entries are singleton groups, ready immediately."""
    queued_blocks = {u.get("block") for u in q.get("next", []) if u.get("block")}
    groups: dict[str, list] = {}
    ready: list[list[dict]] = []
    for e in q.get("pending_verification") or []:
        b = e.get("block")
        if not b:
            ready.append([e])
        elif b not in queued_blocks:
            groups.setdefault(str(b), []).append(e)
    ready.extend(groups.values())
    return ready


def _service_verification(k: dict, model: str, vfail: int) -> int:
    """Spawn the verifier for every completed block awaiting verification; stamp and clear on success.

    Runs every loop iteration (pending_verification is queue-persisted, so verification owed by a
    crashed or interrupted run is serviced on relaunch - never lost). Verification is control flow,
    not agent virtue: a block is not cleared until every experiment's verdict artifact exists.
    Failures degrade LOUD like worker failures - the entries stay pending and are retried next
    iteration - and N in a row is SYSTEMIC: a campaign that declared per-block verification
    (configs/loop.json campaign.verification) must not keep accumulating unverified science.
    Returns the updated consecutive-verification-failure count."""
    q = _read_queue()
    for group in _verification_backlog(q):
        exps = [e.get("exp", "") for e in group if e.get("exp")]
        if not exps:                                   # unnameable entries cannot be verified; drop them
            bad_cfgs = {e.get("config") for e in group}
            q2 = _read_queue()
            q2["pending_verification"] = [e for e in (q2.get("pending_verification") or [])
                                          if e.get("config") not in bad_cfgs]
            _write_queue(q2)
            continue
        missing = [s for s in exps if _find_verdict_file(s) is None]
        if missing:
            hyp = next((e.get("hypothesis") for e in group if e.get("hypothesis")), "")
            label = "block " + str(group[0].get("block")) if group[0].get("block") else exps[0]
            print(f"[supervise] verification due for {label}: {', '.join(missing)}")
            prompt = build_prompt("verifier", exps=", ".join(missing), hypothesis=str(hyp or ""))

            def _verdicts_probe(ms=tuple(missing)) -> bool:
                return all(_find_verdict_file(s) is not None for s in ms)

            for attempt in range(1 + k["planner_retries"]):
                st = _spawn_agent(prompt, model, f"verifier[{label}]", k, saved_probe=_verdicts_probe)
                missing = [s for s in exps if _find_verdict_file(s) is None]
                if not missing:
                    break
                print(f"[supervise] verifier attempt {attempt + 1} left verdicts missing for "
                      f"{', '.join(missing)} (status={st})"
                      + (" - retrying" if attempt < k["planner_retries"] else ""))
        if missing:
            vfail += 1
            print(f"[supervise] VERIFICATION failure #{vfail}/{k['max_consecutive_failures']}: "
                  f"{', '.join(missing)} still unverified - entries stay in pending_verification and "
                  "are retried next iteration (degrade-loud)")
            if vfail >= k["max_consecutive_failures"]:
                _halt(f"supervise: HALT - {vfail} consecutive verification failures is SYSTEMIC. This "
                      "campaign runs verification per block (configs/loop.json campaign.verification), "
                      "so the loop must not keep producing science nothing verifies: check the agent "
                      "CLI and the driver log, then relaunch - pending verification resumes first.")
            continue
        vfail = 0
        for s in exps:
            _stamp_verified(s)
        done_cfgs = {e.get("config") for e in group}
        q2 = _read_queue()
        q2["pending_verification"] = [e for e in (q2.get("pending_verification") or [])
                                      if e.get("config") not in done_cfgs]
        _write_queue(q2)
        print(f"[supervise] verification complete: {', '.join(exps)} - verdict(s) on record and "
              "stamped; any REFUTED/INCONCLUSIVE follow-ups the verifier dropped are merged at the next "
              "loop top (results/queue_drop/)")
    return vfail


def main():
    _make_console_lenient()   # before ANY print: a model-authored glyph must never end a run
    ap = argparse.ArgumentParser(description="Experiment runner for {{CAMPAIGN_TITLE}}")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--config", type=Path, help="run one experiment from this config")
    g.add_argument("--baseline", action="store_true", help="run experiment 000 (the floor gate)")
    g.add_argument("--supervise", action="store_true",
                   help="run the orchestrated loop: fresh worker agent per queue unit + planner on triggers")
    g.add_argument("--preflight", action="store_true",
                   help="run the supervisor launch checks (agent CLI, loop.json, queue.json, metric "
                        "selftest) and exit - no spend")
    g.add_argument("--show-prompt", choices=("worker", "planner", "verifier"), metavar="ROLE",
                   help="print the literal prompt this driver would spawn ROLE with, plus its size "
                        "and hash, then exit. Reads nothing, spends nothing, changes nothing")
    ap.add_argument("--smoke", action="store_true",
                    help="with --preflight/--supervise: also do ONE real agent spawn (costs a model call)")
    ap.add_argument("--selftest", action="store_true",
                    help="(deprecated: the metric self-test + correctness suite now run automatically before every experiment)")
    args = ap.parse_args()

    if args.show_prompt:
        # The prompt to STDOUT and the metadata to STDERR, so the setup review gate can capture one
        # without the other. Size is REPORTED, never capped: the plan is explicit that capacity was
        # never the binding constraint here, so growth should be visible rather than enforced.
        text = build_prompt(args.show_prompt)
        print(text)
        digest = _hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
        print(f"\n--- {args.show_prompt} prompt: {len(text)} chars ({len(text)/1024:.1f} KB) "
              f"· sha256:{digest} ---", file=sys.stderr)
        print("--- this is the literal spawn string. CLAUDE.md auto-loads on top of it, and the "
              "files it names (campaign.md, the role file) are read by the agent, not included here."
              " ---", file=sys.stderr)
        return

    if args.preflight:
        fails = preflight(smoke=args.smoke)
        if fails:
            sys.exit(f"preflight: {len(fails)} issue(s) found - each line above names its fix.")
        print("preflight: all checks passed - ready for --supervise.")
        return

    if args.supervise:
        supervise(smoke=args.smoke)   # the driver only orchestrates; each worker's run fires the gates below
        return

    # FROZEN-infrastructure gates, automatic before every experiment (no longer opt-in via --selftest):
    # Cheapest refusal first: a typo in a campaign property is a string comparison, and it must not cost
    # the correctness suite's 600 s timeout to discover.
    props = _campaign_props()              # what KIND of campaign this is (configs/loop.json "campaign")
    problems = campaign_props_problems(props)
    if problems:
        sys.exit("CAMPAIGN PROPERTIES: configs/loop.json is not usable as written:\n  - "
                 + "\n  - ".join(problems))

    require_metric_selftest()      # hard-fail unless the scorer passes its self-test
    check_correctness_suite()      # run + record; only an affirmative GREEN green-lights promotion
    _beat("gates")                 # liveness trace begins (dead-worker detection; progress = the ledger)

    if args.baseline:
        # TODO(campaign): the simplest defensible baseline (see campaign.md, 'Baseline gate'). It also
        # validates the data/scoring chain end-to-end. Expected floor is in campaign.md.
        cfg = {"exp_name": "exp000_baseline", "_comment": "baseline gate"}
    else:
        cfg = load_config(args.config)

    stem = cfg["exp_name"]
    sys.stdout = _Tee(DIAG / f"{stem}_{_utc_stamp()}.log")
    print(f"=== {stem} :: {{CAMPAIGN_TITLE}} ===")

    apriori = check_prediction_gate(cfg, props)   # SPEND GATE: no run without a written prediction

    snapshot_experiment(cfg, args.config if not args.baseline else None, props)
    pred_file = PREDICTIONS / f"{stem}.json"
    if pred_file.is_file():                # the prediction is part of the reproducible record
        shutil.copy2(pred_file, SNAPSHOTS / stem / "prediction.json")
    print(f"snapshot -> results/snapshots/{stem}/")
    _beat("snapshot")

    validate_method(cfg)   # hard-fail before spending an evaluation on an unwired/unrecognized lever
    target = load_target(cfg)
    _beat("solve_start")
    ticker = _HeartbeatTicker()   # beats every HB_TICK_S so a long solve doesn't look dead mid-run
    ticker.start()
    try:
        prediction = run_experiment(cfg)
    finally:
        ticker.stop()
    _beat("solve_done")
    evaluate_and_record(cfg, prediction, target, apriori, props)


if __name__ == "__main__":
    main()
