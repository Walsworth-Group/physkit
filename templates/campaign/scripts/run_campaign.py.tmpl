class _Tee:
    """Mirror stdout to a per-run log so a result never lives only in the console."""

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "w", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):  # noqa: D401
        self._stdout.write(s)
        try:
            self._stdout.flush()     # flush per write: a killed or hung solve never exits, so a
        except Exception:            # buffered tee'd log would be empty for exactly the run that needs it
            pass
        try:
            self._log.write(s)
            self._log.flush()
        except Exception:
            pass                     # the console wins; a full disk must not kill the run

    def flush(self):
        self._stdout.flush()
        try:
            self._log.flush()
        except Exception:
            pass


class DriverLog:
    """Append-mode tee for the DRIVER process (supervisor mode) - one file per --supervise launch:
    results/diagnostics/supervise_<UTCstamp>.log. Every driver decision and rendered worker-feed line
    lands in both the console and the log. Doctrine: log every scheduling decision to an append-only run
    log as it is made - post-hoc diagnosis of an unattended system is impossible without the decision
    trace (the physkit plugin's docs/reference/hardware-in-the-loop.md, "Monitor the science").
    Distinct from _Tee above, which is the per-EXPERIMENT runner log (mode "w", one per run).
    """

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "a", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):
        self._stdout.write(s)
        # FLUSH PER WRITE. --supervise is normally launched backgrounded, so stdout is a pipe (block-
        # buffered, not line-buffered as it is on a TTY) and the log file was never line-buffered. Without
        # this, the driver's decision trace stays empty for the whole life of a running loop - and the
        # worst case, an unattended run that HANGS, never exits to flush, so the one trace that most needs
        # reading is 0 bytes. print() never passes flush=True, so the flush must live here.
        try:
            self._stdout.flush()
        except Exception:
            pass
        try:
            self._log.write(s)
            self._log.flush()
        except Exception:
            pass  # the console wins; a full disk must not kill the loop

    def flush(self):
        self._stdout.flush()
        try:
            self._log.flush()
        except Exception:
            pass

    def close(self):
        try:
            self._log.close()
        except Exception:
            pass
        return self._stdout


def _make_console_lenient() -> None:
    """Never let an unencodable CHARACTER end a run.

    The driver relays a live agent's output to this console. That output is arbitrary text written by a
    model, and on a stock Windows console (cp1252) a single checkmark, arrow, curly quote or emoji makes
    print() raise UnicodeEncodeError -- from the watch loop, mid-unit, killing an overnight loop over a
    decoration. The subprocess pipe already reads with errors="replace"; this extends the same tolerance
    to the write side, so an unencodable glyph degrades to "?" instead of ending the campaign.

    Deliberately NOT a switch to UTF-8: that would fix the exception and produce mojibake in a console
    that cannot render it. Replacement is honest about what the terminal can show. The driver's own log
    file is opened utf-8 separately, so the full text is still preserved on disk.
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")     # py3.7+; no-op if already lenient
        except Exception:
            pass                                     # a redirected/wrapped stream may not support it


def _utc_stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


# ---- runner liveness heartbeat (dead-worker detection only) --------------------------------------------
# The runner touches results/.run_heartbeat at stage transitions (and every HB_TICK_S during the solve).
# The supervisor driver reads only the file's mtime-change, never the stage, to tell a live solve from a
# dead worker; PROGRESS is judged by the ledger, never by this file (CORE: monitor progress, not liveness).
# Written unconditionally (supervised or not): an interactive run leaves the same trace, at no cost.

HEARTBEAT = RESULTS / ".run_heartbeat"
HB_TICK_S = 60


def _beat(stage: str) -> None:
    """Touch the heartbeat file. Never raises - a liveness bug must never fail a run."""
    try:
        HEARTBEAT.parent.mkdir(parents=True, exist_ok=True)
        HEARTBEAT.write_text(json.dumps({"stage": stage, "utc": _utc_stamp(), "pid": os.getpid()}),
                             encoding="utf-8")
    except Exception:
        pass


class _HeartbeatTicker:
    """Daemon thread beating every HB_TICK_S while a solve is in flight, so a 2 h run_experiment()
    doesn't look dead between stage transitions."""

    def __init__(self):
        self._stop = threading.Event()
        self._thread = None

    def start(self, stage: str = "solve") -> None:
        def _tick():
            while not self._stop.wait(HB_TICK_S):
                _beat(stage)
        try:
            self._stop.clear()
            self._thread = threading.Thread(target=_tick, daemon=True)
            self._thread.start()
        except Exception:
            pass

    def stop(self) -> None:
        try:
            self._stop.set()
        except Exception:
            pass


def load_config(path: Path) -> dict:
    """Load and lightly validate an experiment config (the reproducible record)."""
    cfg = json.loads(Path(path).read_text(encoding="utf-8"))
    assert "exp_name" in cfg, "config is missing 'exp_name'"
    return cfg


def snapshot_experiment(cfg: dict, config_path: Path | None = None, props: dict | None = None) -> Path:
    """Preserve everything needed to reproduce this experiment even after the code/config later change.

    BASELINE requirement, every experiment (see roles/worker.md, 'The save-set'): copy the mutable code
    (scripts/) and the config into results/snapshots/<exp_name>/, plus a manifest with the command line
    and key library versions. A shared script edited later would otherwise make this experiment
    irreproducible.
    """
    dst = SNAPSHOTS / cfg["exp_name"]
    dst.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / "scripts", dst / "scripts",
                    ignore=shutil.ignore_patterns("__pycache__"), dirs_exist_ok=True)
    if config_path is not None:
        shutil.copy2(config_path, dst / "config.json")
    else:
        (dst / "config.json").write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    props = props or {}
    # The campaign PROPERTIES this experiment ran under. configs/loop.json is user-owned and hot-reloaded
    # mid-run, so the config alone cannot answer "what was this scored against?" for a PAST experiment -
    # stamping them here makes a mid-campaign flip visible in the frozen record instead of only in a
    # mutable file, which is the same reason core_hash is stamped beside them.
    prop_lines = "".join(f"{k}: {props.get(k)}\n" for k in
                         ("prediction_mode", "noise_model", "noise_floor", "tolerance",
                          "metric_version", "data_version", "metric_revision") if k in props)
    vr = _verify_rows(_read_json(LOOPCFG, {}) or {})
    prop_lines += f"verify_preset: {vr['preset'] or vr['source']}\n"   # how much verification this ran under
    # The delivered context (the project overview's Standing constraints + the landmines table) is a
    # LIVING document pulled into every spawned prompt, so two experiments in one campaign can run
    # under different constraints. Hashing the assembled worker prompt here answers "what did this
    # experiment run under" from the frozen record. Recomputed at snapshot time (inbox notes, which
    # vary per spawn and steer rather than constrain, are not part of the hash).
    # The driver exports the hash of the prompt it DELIVERED (the brief carries the journal window,
    # which the worker edits mid-unit, so a rebuild here would hash a different text); an attended
    # run has no driver and rebuilds it.
    spawn_hash = os.environ.get("PHYSKIT_SPAWN_PROMPT_SHA256", "").strip()
    if not spawn_hash:
        spawn_prompt = build_prompt("worker", config=str(config_path or "<config path>"))
        spawn_hash = _hashlib.sha256((_codex_backend.adapt_prompt(spawn_prompt) if os.environ.get("AUTORESEARCH_ACTIVE_BACKEND") == "codex" else spawn_prompt).encode("utf-8")).hexdigest()
    (dst / "manifest.txt").write_text(
        f"argv: {' '.join(sys.argv)}\npython: {sys.version.split()[0]}\nnumpy: {np.__version__}\n"
        f"core_hash: {frozen_core.core_hash(ROOT)}\n"   # WHICH FROZEN/core code this experiment ran against
        f"kit_version: {KIT_VERSION}\n"   # WHICH kit machinery (run_campaign.py is kit-owned, not core-hashed)
        f"spawn_prompt_sha256: {spawn_hash}\n"
        f"utc: {_utc_stamp()}\n" + prop_lines,
        encoding="utf-8",
    )
    return dst


def check_prediction_gate(cfg: dict, props: dict) -> dict:
    """SPEND GATE: refuse to run without an a-priori prediction written BEFORE the solve.

    WHAT counts as a prediction is this campaign's `prediction_mode` (configs/loop.json, "campaign"),
    because not every campaign can honestly bound its answer and a FABRICATED range is a fake control -
    worse than an honest absence. The FILE is required in every mode; only the bound it must carry changes:

        range      (default)  {"exp_name": "...", "predicted": {"low": <num>, "high": <num>},
                              "rationale": "<why>"}
        direction             {"exp_name": "...", "predicted": {"direction": "higher"|"lower"|"unchanged",
                              "vs": "<exp_name>"|"baseline"}, "rationale": "<why>"}
        none                  {"exp_name": "...", "rationale": "<why no bound is honest here>"}

    Mode `none` relaxes the BOUND, never the requirement to write something down before spending - a solve
    with no recorded expectation at all is a fishing trip in every mode (roles/worker.md, loop step 1).

    FAIL-CLOSED, deliberately, and this is the one gate where that is right: every refusal below is a
    VIOLATION (no file, no rationale, a bound that does not match the declared mode), and an unreadable
    file is one too - a spend gate cannot certify a prediction it could not read, and proceeding would
    spend the very evaluation this gate exists to protect. Each arm names its own cause instead of
    collapsing into one "malformed" message, so a refusal says which rule was broken.

    Whether the result actually MET this prediction is judged after the solve and recorded mechanically in
    results/checks_<NN>.json - this gate controls SPEND, the checks artifact controls the RECORD.
    """
    mode = props.get("prediction_mode", "range")
    p = PREDICTIONS / f"{cfg['exp_name']}.json"
    shapes = {
        "range": '{"exp_name": "%s", "predicted": {"low": <num>, "high": <num>}, "rationale": "<why>"}',
        "direction": ('{"exp_name": "%s", "predicted": {"direction": "higher|lower|unchanged", '
                      '"vs": "<exp_name>|baseline"}, "rationale": "<why>"}'),
        "none": '{"exp_name": "%s", "rationale": "<why no bound is honest here>"}',
    }
    if not p.is_file():
        sys.exit(
            f"PREDICTION GATE: {p} not found. Write the a-priori prediction BEFORE the run.\n"
            f"  This campaign's prediction_mode is '{mode}', so the file must look like:\n"
            f"    {shapes.get(mode, shapes['range']) % cfg['exp_name']}\n"
            "A solve without a written prediction is a fishing trip (roles/worker.md, loop step 1;\n"
            "the rule is campaign.md, 'Bound expectations BEFORE you run')."
        )
    try:
        pred = json.loads(p.read_text(encoding="utf-8-sig"))
    except Exception as exc:
        sys.exit(f"PREDICTION GATE: {p} could not be read as JSON ({exc}). Repair it - a spend gate "
                 "cannot certify a prediction it cannot read.")
    if not isinstance(pred, dict):
        sys.exit(f"PREDICTION GATE: {p} parsed, but it is a {type(pred).__name__}, not a JSON object. "
                 "It must be an object carrying at least a \"rationale\".")
    expected_subject = str(cfg["exp_name"])
    actual_subject = str(pred.get("exp_name", ""))
    if actual_subject != expected_subject:
        sys.exit(f"PREDICTION GATE: {p} has exp_name={actual_subject!r}; expected "
                 f"{expected_subject!r}. Fix the pre-run artifact; do not relabel it after the solve.")
    if not str(pred.get("rationale", "")).strip():
        sys.exit(f"PREDICTION GATE: {p} has no non-empty \"rationale\". Every mode requires one: the "
                 "reasoning IS the control, and a bound with no basis is a guess wearing a number.")
    predicted = pred.get("predicted") or {}

    if mode == "range":
        try:
            lo, hi = float(predicted["low"]), float(predicted["high"])
        except Exception:
            sys.exit(f"PREDICTION GATE: {p} carries no numeric \"predicted\": {{\"low\": ..., "
                     f"\"high\": ...}} range, which prediction_mode 'range' requires. Either write one, "
                     "or - if this campaign genuinely cannot bound the answer - set prediction_mode to "
                     "'direction' or 'none' in configs/loop.json, with a recorded reason. Do NOT invent a "
                     "range to satisfy this gate: a fabricated range is a fake control, which is worse "
                     "than an honest absence.")
        if not (np.isfinite(lo) and np.isfinite(hi) and lo < hi):
            sys.exit(f"PREDICTION GATE: {p} is not falsifiable - require finite low < high. An unbounded "
                     f"or inverted range gates nothing (got low={lo!r}, high={hi!r}).")
        print(f"prediction gate OK [range]: {{PRIMARY_METRIC}} in [{lo:g}, {hi:g}] - "
              f"{pred.get('rationale', '')[:100]}")
    elif mode == "direction":
        d = str(predicted.get("direction", "")).strip().lower()
        vs = str(predicted.get("vs", "")).strip()
        if d not in ("higher", "lower", "unchanged"):
            sys.exit(f"PREDICTION GATE: {p} needs \"predicted\": {{\"direction\": "
                     f"\"higher|lower|unchanged\", ...}}, which prediction_mode 'direction' requires "
                     f"(got {d!r}).")
        if not vs:
            sys.exit(f"PREDICTION GATE: {p} needs \"predicted\": {{..., \"vs\": \"<exp_name>\"}} - "
                     "the experiment this one is predicted to move AGAINST (or \"baseline\"). A "
                     "direction with no reference point is not checkable, and an uncheckable prediction "
                     "gates nothing.")
        print(f"prediction gate OK [direction]: {{PRIMARY_METRIC}} {d} vs {vs} - "
              f"{pred.get('rationale', '')[:100]}")
    else:
        print("prediction gate OK [none]: this campaign records no numeric bound - "
              f"{pred.get('rationale', '')[:100]}")
    return pred


def exp_id_for(label: str) -> str:
    """The <NN> in result_<NN>.json / checks_<NN>.json / the scoreboard row, derived from exp_name.

    ONE parser, because this rule was written out twice (here and in the driver's _unit_saved) and two
    copies of a naming rule drift into two different answers about which file a unit should have left.

    Returns "" when no id can be derived. That case used to fall back to "000" -- so an exp_name like
    `exp_foo` (an underscore straight after `exp`) silently claimed the BASELINE's id and overwrote
    results/result_000.json. Callers decide what to do about "": the runner refuses before scoring, the
    driver reports the unit unsaved.
    """
    head = str(label).split("_", 1)[0]
    raw = head[3:] if head.startswith("exp") else head
    if not raw:
        return ""
    return raw.zfill(3) if raw.isdigit() else raw


def assert_save_set(exp_id: str, label: str, fig: Path) -> None:
    """RECORD GATE (hard gate 4 as code): refuse the scoreboard row until the full save-set exists.

    A result is not "saved" until result_<NN>.json, its figure, AND its snapshot are on disk - a row
    appended without them is a number with no record behind it. This also means save_figure() must
    actually write the figure before the first experiment can be recorded - implement it, don't stub it.
    """
    missing = [str(p) for p in (RESULTS / f"result_{exp_id}.json", fig, SNAPSHOTS / label)
               if not p.exists()]
    if missing:
        sys.exit("SAVE-SET GATE: refusing the scoreboard row - missing artifacts:\n  "
                 + "\n  ".join(missing)
                 + "\nWrite them first (result JSON + figure + snapshot); see roles/worker.md, 'The save-set'.")


# ---- the campaign's own code: scripts/experiment.py -------------------------------------------------
# The five experiment hooks (validate_method / run_experiment / load_target / guardrail / save_figure)
# and the optional seams (residual / campaign_scoreboard_fields / campaign_checks / baseline_config)
# live in scripts/experiment.py - the one script a campaign edits. THIS file is the kit's machinery:
# gates, checks, the snapshot, the driver, the prompts - replaced wholesale on a kit upgrade and never
# edited per campaign. Motivation (a colleague's audit, 2026-09): with the hooks inside this file it was
# Read 64 times in one campaign, and every worker wrote a bespoke module rather than find them. The
# import is deferred to first use so `--help` / `--show-prompt` work while experiment.py is mid-edit,
# and preflight names an import error instead of a traceback.
_EXPERIMENT = None


def _exp():
    """The campaign's experiment module (scripts/experiment.py), imported once, on first use."""
    global _EXPERIMENT
    if _EXPERIMENT is None:
        import experiment
        _EXPERIMENT = experiment
    return _EXPERIMENT


def _seam(name: str, default):
    """An OPTIONAL function in experiment.py: the campaign's, if it defines one, else `default`."""
    fn = getattr(_exp(), name, None)
    return fn if callable(fn) else default


def scoreboard_exp_ids() -> set:
    """Every exp_id already on the scoreboard. Cheap, and the ledger is the authority on what has run."""
    ids = set()
    header_seen = False
    for line in SCOREBOARD.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line or line.startswith("#"):
            continue
        if not header_seen:                      # the first non-comment line is the header
            header_seen = True
            continue
        ids.add(line.split("\t", 1)[0].strip())
    return ids


def append_scoreboard_row(row: dict) -> None:
    """Append ONE tab-separated row to results/scoreboard.tsv, in the header's column order.

    Append-only; never delete or rename a column mid-campaign. A column missing from `row` is written
    blank rather than shifting the schema.

    ONE ROW PER exp_id, enforced here. Re-running a config whose row already exists appended a second
    one; because the ledger is append-only, nothing downstream could remove the duplicate, so it was
    permanent. The only remaining cleanup was to edit the append-only file, which the ledger's own rule
    forbids. The runner must not produce a state whose only repair breaks a rule.

    A genuine re-run wants a NEW exp_id: a second row under the same id claims two different numbers
    are the same experiment, and if the code changed between them, the comparability tags cannot say so.
    """
    exp_id = str(row.get("exp_id", "")).strip()
    if exp_id and exp_id in scoreboard_exp_ids():
        print(f"LEDGER: results/scoreboard.tsv already has a row for exp_id {exp_id} - NOT appending a "
              "second one. The scoreboard is append-only, so a duplicate here would be permanent.\n"
              "  If this is a retry, the earlier row is the record and nothing is lost (the row is "
              "written last, behind the save-set gate, so a row means the artifacts existed).\n"
              "  If you are deliberately re-running with changed code or data, give it a NEW exp_name - "
              "two rows under one id claim that two different numbers are the same experiment.\n"
              "  Do NOT hand-edit the scoreboard to resolve this.")
        return
    header_line = None
    for line in SCOREBOARD.read_text(encoding="utf-8").splitlines():
        if line and not line.startswith("#"):
            header_line = line
            break
    assert header_line, "scoreboard.tsv has no header row"
    cols = header_line.split("\t")
    with open(SCOREBOARD, "a", encoding="utf-8") as f:
        f.write("\t".join(str(row.get(c, "")) for c in cols) + "\n")


def _expected_vs_found(score: float, apriori: dict | None, props: dict, exp_id: str) -> str:
    """One judgement, three readers: the checks artifact (`prediction`), the logbook line and the ledger
    cell all carry this string, computed once from the same inputs so they can never disagree."""
    try:
        pc = check_prediction_outcome(score, apriori or {}, props, _prior_results(exp_id))
        return ({"pass": "met - ", "fail": "MISSED - ", "unavailable": "no bound - "}
                .get(pc.get("status"), "") + str(pc.get("detail", "")))
    except Exception as exc:                        # the narrative must never cost the experiment
        return f"(not computed: {type(exc).__name__}: {exc})"


def append_logbook(cfg: dict, exp_id: str, label: str, score: float, diags: dict,
                   apriori: dict | None = None, expected_vs_found: str | None = None) -> None:
    """Append this experiment's entry to the append-only logbook (results/logbook.md).

    The FACTS are filled automatically: metric, guardrail, artifact paths, the hypothesis and the levers
    from the config, the prediction from the prediction artifact, the expected-vs-found judgement (the
    SAME one results/checks_<NN>.json records under `prediction`, computed from the same inputs so the
    two never disagree), and a Verification line that starts `pending` and is raised by the artifacts
    (the self-check, then the verdict stamp). The agent owes two slots afterward: Analysis and NEXT.
    Append-only: this never edits or reads the rest of the file.
    """
    if apriori:
        # Mode-aware. A campaign that honestly declined to bound its answer must not have a bound-shaped
        # "[None, None]" written into its permanent record on its behalf - that is the fabricated-control
        # failure the modes exist to prevent, reappearing in the narrative instead of the gate.
        rng = apriori.get("predicted") or {}
        why = apriori.get("rationale", "")
        src = f"(predictions/{cfg['exp_name']}.json)"
        if rng.get("low") is not None and rng.get("high") is not None:
            predicted_line = f"[{rng.get('low')}, {rng.get('high')}] - {why} {src}"
        elif rng.get("direction"):
            predicted_line = f"{rng.get('direction')} than {rng.get('vs', '?')} - {why} {src}"
        else:
            predicted_line = f"no numeric bound (prediction_mode) - {why} {src}"
    else:
        predicted_line = "(missing - the prediction gate should have caught this)"
    props = _campaign_props()
    # The epoch label travels with the narrative too: the row's metric_version is what this result
    # means, and a later reader of the logbook must not have to cross-reference the scoreboard for it.
    mv = str(props.get("metric_version") or "")
    # One judgement, two readers: the checks artifact for machines, this line for the narrative. The
    # agent used to write this line by hand from the same two numbers; it is the runner's.
    if expected_vs_found is None:
        expected_vs_found = _expected_vs_found(score, apriori, props, exp_id)
    levers = cfg.get("_levers")
    levers_line = (", ".join(str(x) for x in levers) if isinstance(levers, list) and levers
                   else "(none declared - list the levers this config moves in the config's _levers)")
    # One bold-labelled field per line, as a Markdown bullet list, so fields render on separate lines
    # (a single newline renders as a space in Markdown, which would collapse them into one paragraph).
    entry = (
        f"\n## {exp_id} - {label} - {_utc_stamp()}\n"
        f"- **Hypothesis**: {cfg.get('_hypothesis', '(set _hypothesis in the config)')}\n"
        f"- **Predicted**: {predicted_line}\n"
        f"- **Levers**: {levers_line}\n"
        f"- **Change**: {cfg.get('_comment', '')}\n"
        f"- **Result**: {{PRIMARY_METRIC}} = {score:.4f}; {{GUARDRAIL_METRIC}} = {diags}"
        + (f" (metric epoch {mv})" if mv else "") + "\n"
        f"- **Expected vs found**: {expected_vs_found}\n"
        f"- **Analysis**: \n"
        f"- **Verification**: pending - label unverified (results/checks_{exp_id}.json)\n"
        f"- **Excluded data**: none\n"
        f"- **Disputes & responses**: \n"
        f"- **Status**: open\n"
        f"- **Artifacts**: results/result_{exp_id}.json . results/checks_{exp_id}.json . "
        f"results/images/{label}_* . results/snapshots/{label}/\n"
        f"- **NEXT**: \n"
    )
    if f"## {exp_id} - {label} " in LOGBOOK.read_text(encoding="utf-8", errors="replace"):
        print(f"LEDGER: results/logbook.md already has an entry for {exp_id} - {label} - NOT appending a "
              "second one. Complete the existing entry's narrative slots instead of starting a new one.")
        return
    with open(LOGBOOK, "a", encoding="utf-8") as f:
        f.write(entry)


def _logbook_field(text: str, exp_id: str, field: str) -> str | None:
    """The value of one bold-labelled field in the entry headed `## <exp_id> - ...`, or None when the
    entry or the field is absent (an entry written before the field existed is not judged on it)."""
    head, key, in_section = f"## {exp_id} - ", f"- **{field}**:", False
    for line in text.splitlines():
        if line.startswith("## "):
            in_section = line.startswith(head)
            continue
        if in_section and line.startswith(key):
            return line[len(key):].strip()
    return None


def _set_logbook_field(exp: str, field: str, text: str, only_if_prefix: tuple | None = ("",)) -> bool:
    """Set one bold-labelled field of the entry headed `## <id> - ...` for `exp` (a stem or an id) - and
    only while its present value starts with one of `only_if_prefix`, so a runner-owned line
    (Verification: pending -> self-checked -> <verdict>) is raised by the artifacts and never overwrites
    what a verifier or the agent wrote by hand. `only_if_prefix=None` sets the line unconditionally (the
    worker's own slots through --record, which re-run replaces). Every byte outside that one line is
    preserved, newline style included. Returns whether a line changed."""
    eid = exp_id_for(exp)
    if not eid or not LOGBOOK.is_file():
        return False
    try:
        with open(LOGBOOK, encoding="utf-8", errors="replace", newline="") as f:
            lines = f.read().splitlines(keepends=True)
    except OSError:
        return False
    head, key, in_section = f"## {eid} - ", f"- **{field}**:", False
    for i, line in enumerate(lines):
        if line.startswith("## "):
            in_section = line.startswith(head)
            continue
        if in_section and line.startswith(key):
            current = line[len(key):].strip()
            # "" in only_if_prefix means "a blank line may be set" - never "anything matches".
            if only_if_prefix is not None and not any(
                    (current == "") if pfx == "" else current.startswith(pfx) for pfx in only_if_prefix):
                return False
            nl = "\r\n" if line.endswith("\r\n") else ("\n" if line.endswith("\n") else "")
            lines[i] = f"{key} {text}{nl}"
            try:
                with open(LOGBOOK, "w", encoding="utf-8", newline="") as f:
                    f.write("".join(lines))
            except OSError:
                return False
            return True
    return False


def _scoreboard_lines() -> tuple[list[str], int, list[str]]:
    """(the ledger's lines with their endings, the header's index, the header's columns)."""
    with open(SCOREBOARD, encoding="utf-8", errors="replace", newline="") as f:
        lines = f.read().splitlines(keepends=True)
    for i, L in enumerate(lines):
        if L.strip() and not L.startswith("#"):
            return lines, i, L.rstrip("\r\n").split("\t")
    raise ValueError("scoreboard.tsv has no header row")


def _column(cols: list, names: tuple) -> str | None:
    """The header column for the first of `names` present, matched case-insensitively (a field ledger
    spells its metric column in lower case while the result JSON key is upper case)."""
    for n in names:
        for c in cols:
            if c.lower() == str(n).lower():
                return c
    return None


def _set_scoreboard_cell(exp_id: str, names: tuple, text: str) -> str:
    """Set ONE cell of the row for `exp_id`: the column is the first of `names` the header has (the
    current spelling first, an older one second). The ledger is append-only in ROWS; a narrative cell
    the runner owns (note, finding, verified) is stamped in place with every other byte preserved.
    Returns the column written, or "" after printing why not."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError) as exc:
        print(f"ledger: cannot read results/scoreboard.tsv ({exc})")
        return ""
    col = _column(cols, names)
    if col is None:
        print(f"ledger: results/scoreboard.tsv has no {' / '.join(names)} column - the header predates this "
              "kit; `upgrade_campaign.py --ledger-columns` adds it (the cell was NOT written)")
        return ""
    ci = cols.index(col)
    cell = " ".join(str(text).replace("\t", " ").split())
    for i in range(hi + 1, len(lines)):
        L = lines[i]
        if L.startswith("#") or not L.strip():
            continue
        cells = L.rstrip("\r\n").split("\t")
        if cells[0].strip() != exp_id:
            continue
        nl = "\r\n" if L.endswith("\r\n") else ("\n" if L.endswith("\n") else "")
        while len(cells) < len(cols):
            cells.append("")
        cells[ci] = cell
        lines[i] = "\t".join(cells) + nl
        with open(SCOREBOARD, "w", encoding="utf-8", newline="") as f:
            f.write("".join(lines))
        return col
    print(f"ledger: no scoreboard row for exp_id {exp_id} - the run writes the row; record the experiment first")
    return ""


def _scoreboard_cell(exp_id: str, names: tuple) -> str | None:
    """The current text of one narrative cell, or None when the column or the row is absent."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError):
        return None
    col = _column(cols, names)
    if col is None:
        return None
    ci = cols.index(col)
    for L in lines[hi + 1:]:
        if L.startswith("#") or not L.strip():
            continue
        cells = L.rstrip("\r\n").split("\t")
        if cells[0].strip() == exp_id:
            return cells[ci] if ci < len(cells) else ""
    return None


# The ledger's narrative columns, in the order the brief shows them; the second name is the older spelling.
_PROJECTION_COLS = (("exp_id",), ("tier",), ("{{PRIMARY_METRIC}}", "{{PRIMARY_METRIC_COL}}"),
                    ("what", "description"), ("expected_vs_found",), ("verified",), ("note", "notes"),
                    ("finding",))


def _ledger_projection(n_rows: int) -> tuple[str, int]:
    """The ledger's last n rows as a Markdown table of its NARRATIVE columns - id, tier, the primary
    metric, what, expected vs found, label, note, finding - every cell clipped at BRIEF_CELL_CAP. This is
    the one-line-per-experiment timeline; the numeric columns stay on disk and a reader who needs them
    opens the row by id. Returns (text, rows dropped)."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError):
        return "[MISSING: results/scoreboard.tsv has no header row]", 0
    picks = [(names[0], _column(cols, names)) for names in _PROJECTION_COLS]
    picks = [(t, c) for t, c in picks if c]
    rows = [L.rstrip("\r\n").split("\t") for L in lines[hi + 1:] if L.strip() and not L.startswith("#")]
    dropped = max(0, len(rows) - n_rows) if n_rows > 0 else 0
    rows = rows[-n_rows:] if n_rows > 0 else rows

    def cell(r: list, col: str) -> str:
        ci = cols.index(col)
        v = " ".join((r[ci] if ci < len(r) else "").split()).replace("|", "/")
        return v if len(v) <= BRIEF_CELL_CAP else v[:BRIEF_CELL_CAP] + "..."
    out = ["| " + " | ".join(t for t, _ in picks) + " |", "|" + "---|" * len(picks)]
    out += ["| " + " | ".join(cell(r, c) for _, c in picks) + " |" for r in rows]
    return "\n".join(out), dropped


def _archive_journal(clear: bool = False) -> Path | None:
    """Copy results/JOURNAL.md into results/journal_archive/ before a spawn: the reasoning history the
    rolling document would otherwise overwrite (skipped when the newest copy already matches). With
    `clear`, the working file is then REMOVED: the brief (built first) carries the previous JOURNAL, and
    the worker writes the new one as a fresh file - one Write, no read-before-write, no splice."""
    if not JOURNAL.is_file():
        return None
    try:
        text = JOURNAL.read_bytes()
        JOURNAL_ARCHIVE.mkdir(parents=True, exist_ok=True)
        prev = sorted(JOURNAL_ARCHIVE.glob("journal_*.md"))
        dst = prev[-1] if prev and prev[-1].read_bytes() == text else JOURNAL_ARCHIVE / f"journal_{_utc_stamp()}.md"
        if dst not in prev:
            dst.write_bytes(text)
        if clear:
            JOURNAL.unlink()
        return dst
    except OSError:
        return None


def _newest_journal_archive() -> Path | None:
    prev = sorted(JOURNAL_ARCHIVE.glob("journal_*.md")) if JOURNAL_ARCHIVE.is_dir() else []
    return prev[-1] if prev else None


def _restore_journal() -> bool:
    """No new JOURNAL after a spawn: put the archived one back so the campaign keeps its working memory
    (the unit is still incomplete - the gate named the missing file)."""
    if JOURNAL.is_file():
        return False
    src = _newest_journal_archive()
    if src is None:
        return False
    try:
        JOURNAL.write_bytes(src.read_bytes())
        return True
    except OSError:
        return False


def _journal_updated_since(ts: float) -> bool:
    """Whether results/JOURNAL.md was written after `ts` (the spawn's start) and carries its NEXT line -
    the record is owed like the save-set: a unit that left no new working memory did not report."""
    try:
        if JOURNAL.stat().st_mtime < ts - 1.0:
            return False
        return "**NEXT:**" in JOURNAL.read_text(encoding="utf-8-sig", errors="replace")
    except OSError:
        return False


# ---- mechanical checks (results/checks_<NN>.json) -----------------------------------------------------
# Every experiment gets one machine-readable verdict file, written with no agent involved. Its job is to
# stop the runner discarding what it already knows: an out-of-range score sets a flag in the result JSON
# and prints a RED FLAG, and without this artifact nothing downstream reads either one.
#
# Three-valued on purpose. `pass` and `fail` are judgements; `unavailable` means this campaign has not
# supplied what the check needs, and it carries a `needs` string naming what would supply it. A check
# that cannot run must report `unavailable`. Reporting `pass` for an unrunnable check turns a green into
# evidence for something nobody measured, and a hardcoded null turns a written artifact into a record
# that is not a gate.

def _check(status: str, detail: str, needs: str = "", **extra) -> dict:
    out = {"status": status, "detail": detail}
    if needs:
        out["needs"] = needs
    out.update(extra)
    return out


def _prior_results(exclude_id: str) -> list[dict]:
    """Every previous experiment's recorded result, for the checks that need a reference point.

    Reads results/result_<NN>.json rather than the scoreboard: the JSON is written by this runner with
    key names it owns, while the scoreboard's columns are campaign-specific placeholders, so parsing
    that here would couple the runner to a header it does not control.
    """
    out = []
    for f in sorted(RESULTS.glob("result_*.json")):
        if f.stem == f"result_{exclude_id}":
            continue
        d = _read_json(f, None)
        if not isinstance(d, dict):
            continue
        try:
            score = float(d["{{PRIMARY_METRIC}}"])
        except (KeyError, TypeError, ValueError):
            continue
        if not np.isfinite(score):
            continue
        out.append({"exp_name": d.get("exp_name", f.stem), "id": f.stem.replace("result_", ""),
                    "score": score, "metric_version": str(d.get("metric_version", "")),
                    "data_version": str(d.get("data_version", "")), "guardrail": d.get("guardrail")})
    return out


def _incumbent(priors: list[dict], props: dict | None = None) -> dict | None:
    """The best prior result under THIS metric's direction, using the frozen scorer's own comparator so
    a lower-is-better campaign needs no separate branch here.

    With `props`, only rows scored under the CURRENT (metric_version, data_version) compete: a row from
    another metric epoch is not an incumbent it makes sense to beat (the metric-epoch design), and ranking across the
    boundary is the silent merge the epoch ledger exists to prevent. check_comparability reports how
    many rows were set aside. Blank tags (a campaign that predates them) keep the old behaviour.
    """
    tags = ((str(props.get("metric_version") or ""), str(props.get("data_version") or ""))
            if props else ("", ""))
    best = None
    for r in priors:
        if all(tags) and (r["metric_version"], r["data_version"]) != tags:
            continue
        if best is None or metric._better(r["score"], best["score"]):
            best = r
    return best


def check_prediction_outcome(score: float, apriori: dict, props: dict, priors: list[dict]) -> dict:
    """Did the result meet the prediction the spend gate accepted? Judged per prediction_mode."""
    mode = props.get("prediction_mode", "range")
    pred = (apriori or {}).get("predicted") or {}
    if mode == "range":
        try:
            lo, hi = float(pred["low"]), float(pred["high"])
        except (KeyError, TypeError, ValueError):
            return _check("unavailable", "prediction_mode is 'range' but the prediction artifact carries "
                                         "no numeric range (the gate should have refused this run)",
                          needs="a well-formed predictions/<exp_name>.json")
        inside = lo <= score <= hi
        return _check("pass" if inside else "fail",
                      f"{score:.6g} {'is inside' if inside else 'is OUTSIDE'} the predicted range "
                      f"[{lo:g}, {hi:g}]"
                      + ("" if inside else " - a bug or a discovery; explain it before moving on"),
                      predicted={"low": lo, "high": hi}, observed=score)
    if mode == "direction":
        want = str(pred.get("direction", "")).strip().lower()
        vs = str(pred.get("vs", "")).strip()
        ref = next((r for r in priors if vs in (r["exp_name"], r["id"])), None)
        if ref is None and vs.lower() == "baseline":
            ref = next((r for r in priors if r["id"] == "000"), None)
        if ref is None:
            return _check("unavailable",
                          f"the prediction is 'move {want} vs {vs}', but no results/result_*.json for "
                          f"{vs} exists to compare against",
                          needs=f"a completed experiment {vs} (or a corrected 'vs' in the prediction)")
        delta = score - ref["score"]
        # SAME selector as check_noise_floor: the resolution below which "higher" is not observable is a
        # property of the campaign's noise model, not of whichever knob happens to be filled. `is None`,
        # not `or` - a tolerance of exactly 0 is a legitimate declaration of bit-reproducibility.
        eps = props.get("tolerance" if props.get("noise_model") == "deterministic" else "noise_floor")
        eps = 0.0 if eps is None else eps
        got = "unchanged" if abs(delta) <= eps else ("higher" if delta > 0 else "lower")
        ok = (got == want)
        return _check("pass" if ok else "fail",
                      f"predicted {want} vs {ref['exp_name']}; observed {got} "
                      f"(delta {delta:+.6g}, resolution {eps:g})",
                      predicted={"direction": want, "vs": ref["exp_name"]}, observed=got, delta=delta)
    return _check("unavailable",
                  "this campaign records no a-priori bound (prediction_mode='none'): "
                  + (props.get("prediction_mode_reason") or "no reason recorded"),
                  needs="prediction_mode 'range' or 'direction' in configs/loop.json, if the answer has "
                        "become boundable since setup")


def check_noise_floor(score: float, props: dict, incumbent: dict | None,
                     comparable: bool = True, excluded: int = 0) -> dict:
    """Is the change against the incumbent larger than this campaign's own resolution?

    A change smaller than the noise floor (stochastic) or the tolerance (deterministic) is not a result -
    it is the same number twice. This reports that; it does not decide what to do about it. `excluded`
    is how many prior rows _incumbent set aside for being scored under another version, so "no
    incumbent" can say whether the campaign is at its first result or at an epoch boundary.
    """
    deterministic = props.get("noise_model") == "deterministic"
    knob = "tolerance" if deterministic else "noise_floor"
    eps = props.get(knob)
    if incumbent is None:
        if excluded:
            return _check("unavailable",
                          f"no prior result under the current (metric_version, data_version) to compare "
                          f"against; {excluded} prior row(s) under other versions set aside",
                          needs="re-score the retained contenders under the current version (the epoch "
                                "re-baseline) before any delta is a measurement")
        return _check("unavailable", "no prior experiment to compare against (this is the first result)",
                      needs="a second experiment")
    if not comparable:
        # A delta between two numbers the comparability check just called incomparable is not a delta.
        return _check("unavailable",
                      f"the incumbent {incumbent['exp_name']} is not comparable to this run, so the "
                      "difference between them is not a measurement",
                      needs=f"re-score {incumbent['exp_name']} under the current "
                            "(metric_version, data_version)")
    delta = score - incumbent["score"]
    if eps is None:
        return _check("unavailable",
                      f"this campaign is {props.get('noise_model')} but campaign.{knob} is unset, so "
                      "'larger than noise' has no numeric meaning here",
                      needs=f"campaign.{knob} in configs/loop.json"
                            + ("" if deterministic else " - estimate the replicate spread once "
                                                        "(verify, 'Clear the noise floor') and record it"),
                      delta=delta, incumbent=incumbent["exp_name"])
    resolvable = abs(delta) > eps
    better = metric._better(score, incumbent["score"]) if resolvable else None
    # What earns a flag here is a resolvable regression: a real move in the wrong direction, which the
    # analysis owes an explanation for. A change smaller than the campaign's own resolution is not a
    # defect. It is the honest answer "these are the same number", and it is what a replicate produces.
    # Flagging it would red-flag the procedure `verify` prescribes for estimating this threshold, and a
    # red flag raised on every correct run stops being read.
    if not resolvable:
        return _check("pass",
                      f"delta vs {incumbent['exp_name']} is {delta:+.6g}, within the {knob} {eps:g} - "
                      "indistinguishable from no change, so it supports no win claim either way",
                      delta=delta, incumbent=incumbent["exp_name"], resolvable=False,
                      threshold=eps, threshold_name=knob)
    return _check("pass" if better else "fail",
                  f"delta vs {incumbent['exp_name']} is {delta:+.6g}, exceeding the {knob} {eps:g}"
                  + (" - a real improvement" if better else
                     " - a real REGRESSION against the incumbent; explain it before moving on"),
                  delta=delta, incumbent=incumbent["exp_name"], resolvable=True, better=bool(better),
                  threshold=eps, threshold_name=knob)


def check_comparability(props: dict, incumbent: dict | None, priors: list[dict] | None = None) -> dict:
    """A ranking claim is valid ONLY WITHIN one (metric_version, data_version) pair.

    `priors` lets the check SURFACE an epoch boundary rather than hide it: rows scored under another
    version are set aside by _incumbent, and this reports how many, so a discontinuity in the record is
    named in the checks artifact instead of disappearing into a merged ranking (the metric-epoch design).
    """
    mine = (str(props.get("metric_version") or ""), str(props.get("data_version") or ""))
    if not all(mine):
        return _check("unavailable",
                      f"this campaign supplies no comparability tags (metric_version={mine[0]!r} "
                      f"data_version={mine[1]!r}), so no ranking against another row can be certified",
                      needs="campaign.metric_version / campaign.data_version in configs/loop.json - a "
                            "campaign scaffolded before these existed sets them once, and never has to "
                            "answer this again")
    others = [r for r in (priors or []) if (r["metric_version"], r["data_version"]) != mine]
    other_tags = ", ".join(sorted({f"({r['metric_version'] or '?'}, {r['data_version'] or '?'})"
                                   for r in others}))
    if incumbent is None:
        if others:
            return _check("unavailable",
                          f"no prior result is scored under ({mine[0]}, {mine[1]}); {len(others)} prior "
                          f"row(s) under {other_tags} cannot rank against this run - a metric/data "
                          "version boundary (an epoch) sits between them",
                          needs="re-score the retained contenders under the current version (the epoch "
                                "re-baseline) before any ranking claim crosses the boundary",
                          metric_version=mine[0], data_version=mine[1], excluded=len(others))
        return _check("unavailable", "no prior experiment to compare tags against",
                      needs="a second experiment", metric_version=mine[0], data_version=mine[1])
    theirs = (incumbent["metric_version"], incumbent["data_version"])
    if not all(theirs):
        return _check("unavailable",
                      f"the incumbent {incumbent['exp_name']} carries no comparability tags, so this "
                      "delta cannot be certified comparable",
                      needs=f"re-score {incumbent['exp_name']} under the current version")
    same = mine == theirs
    detail = (f"this run is ({mine[0]}, {mine[1]}); the incumbent {incumbent['exp_name']} is "
              f"({theirs[0]}, {theirs[1]})"
              + ("" if same else " - these numbers are NOT comparable. Re-score the incumbent under "
                                 "the current version before ranking them"))
    if same and others:
        detail += (f" ({len(others)} prior row(s) under {other_tags} set aside - not ranked against "
                   "this run)")
    return _check("pass" if same else "fail", detail,
                  metric_version=mine[0], data_version=mine[1], excluded=len(others))


def check_correctness_state() -> dict:
    """Is the standing correctness suite green, and was that green recorded against the code on disk NOW?

    Re-read from disk rather than threaded through: check_correctness_suite() runs before the solve and
    discards its return value, and the state file is guaranteed written by the time this runs.
    """
    st = _read_json(CORRECTNESS_STATE, None)
    if not isinstance(st, dict):
        return _check("unavailable", "results/correctness_state.json is absent or unreadable",
                      needs="one run of scripts/run_campaign.py, which records it")
    status = st.get("status")
    if status != "green":
        return _check("fail", f"the correctness suite is {status!r}, not green - nothing built on this "
                              "code is guarded, and promotion is blocked", suite_status=status)
    recorded, current = st.get("core_hash"), frozen_core.core_hash(ROOT)
    if recorded and current and recorded != current:
        return _check("fail", "the recorded green is STALE - certified against a different FROZEN/core "
                              "than the code on disk now. Re-run the suite", suite_status=status)
    return _check("pass", "correctness suite green, certified against the core on disk",
                  suite_status=status)


# ---- metric epochs (the metric-epoch design) -------------------------------------------------------------
# A metric epoch is one metric_version: WHO opened it, on WHAT evidence, its expected direction, and its
# ratification STANDING (pending | ratified | rolled-back). The declarations live in configs/loop.json
# beside metric_version, as campaign.metric_epochs keyed by version - and that block exists only once a
# campaign has revised its metric: with no block, the current metric_version IS the co-designed first epoch
# (ratified). The one runner-owned fact - the hash of the FROZEN scorer each epoch was bound to - lives with
# the runner's other state in results/correctness_state.json (scorer_hash_by_version), bound on the first
# experiment under the epoch and never rewritten. Declarations are hook-guarded (scripts/guard_promotion.py,
# its loop.json surface): append-only, evidence-checked, ratification attended-only.

EPOCH_KINDS = ("mechanics", "semantics")
EPOCH_STATUSES = ("pending", "ratified", "rolled-back")
IMPLICIT_EPOCH = {"kind": "semantics", "status": "ratified", "implicit": True}


def _epoch_declaration(props: dict) -> dict | None:
    """The CURRENT epoch's declaration: the campaign.metric_epochs entry for metric_version; the implicit
    first epoch when the campaign has declared none, or when the version has no entry but the runner
    already bound it (only the first epoch can be bound without an entry - a new version is refused by
    epoch_gate before its suite run could bind it); None when the block names no such version and nothing
    bound it (an undeclared bump)."""
    mv = str(props.get("metric_version") or "")
    block = props.get("metric_epochs") or {}
    if not isinstance(block, dict) or not block:
        return dict(IMPLICIT_EPOCH, id=mv)
    e = block.get(mv)
    if isinstance(e, dict):
        return dict(e, id=mv)
    return dict(IMPLICIT_EPOCH, id=mv) if _scorer_bindings().get(mv) else None


def _scorer_bindings() -> dict:
    """metric_version -> the scorer hash it was bound to, from the runner's own state file."""
    st = _read_json(CORRECTNESS_STATE, None)
    b = st.get("scorer_hash_by_version") if isinstance(st, dict) else None
    return b if isinstance(b, dict) else {}


def _bind_scorer_hash(state: dict, metric_version: str, scorer_hash: str | None) -> dict:
    """Record the scorer hash the epoch `metric_version` is bound to, if it is not bound yet. Called by
    check_correctness_suite - the state file's only writer - AFTER the selftest passed, so only a scorer
    that passed its self-test is ever bound. A bound hash is never rewritten."""
    bindings = dict(state.get("scorer_hash_by_version") or {})
    if metric_version and scorer_hash and not bindings.get(metric_version):
        bindings[metric_version] = scorer_hash
        print(f"[epoch] {metric_version} bound to the FROZEN scorer on disk (scorer_hash {scorer_hash[:12]}...) "
              "- from here on, a scorer change under this epoch is an undeclared metric change")
    state["scorer_hash_by_version"] = bindings
    return state


def epoch_gate(props: dict) -> list[str]:
    """The FROZEN scorer on disk must be the one the CURRENT metric epoch was bound to.

    Returns plain-language failures (empty = clear). This is what makes a metric change impossible to
    do QUIETLY: a scorer edit with no new epoch declaring it is refused before an evaluation is spent.
    An epoch not yet bound is clear here and binds in check_correctness_suite. The correctness suite is
    deliberately NOT part of the bound hash (frozen_core.scorer_hash): adding a regression check is not a
    metric change. A blank metric_version is not enforced (the comparability check already reports it).
    """
    mv = str(props.get("metric_version") or "")
    if not mv:
        return []
    decl = _epoch_declaration(props)
    if decl is None:
        declared = ", ".join(str(k) for k in (props.get("metric_epochs") or {})) or "none"
        return [f"configs/loop.json campaign.metric_version is {mv!r}, but campaign.metric_epochs declares no "
                f"epoch with that id (declared: {declared}). A metric_version bump IS a metric epoch: add its "
                "entry (kind, evidence, expected_direction, status 'pending') to campaign.metric_epochs "
                "before running under it."]
    if str(decl.get("status", "")) == "rolled-back":
        return [f"the current metric epoch {mv!r} is ROLLED-BACK in campaign.metric_epochs. Fix: point "
                "campaign.metric_version at the epoch the campaign reverted to, or open the next epoch."]
    current = frozen_core.scorer_hash(ROOT)
    recorded = _scorer_bindings().get(mv)
    if current is None or not recorded:
        return []                    # cannot hash, or not bound yet: nothing to enforce, never a false halt
    if recorded != current:
        return [f"the FROZEN scorer on disk (scorer_hash {current[:12]}...) is NOT the one metric epoch "
                f"{mv!r} was bound to ({recorded[:12]}...), and no new epoch declares the change. This is an "
                "UNDECLARED metric change - the one thing the epoch record exists to make impossible to do "
                "quietly. Fix: if the change is deliberate, open the next epoch (bump campaign.metric_version "
                "and add its entry, with evidence, to campaign.metric_epochs in configs/loop.json); if it is "
                "not, restore scripts/metric.py from results/snapshots/<last experiment>/scripts/."]
    return []


def check_epoch(props: dict) -> dict:
    """Which metric epoch this run was scored under, its standing, and whether the scorer on disk is the
    one that epoch was bound to. The row's metric_version is the label; the declaration carries the
    standing (implicit first epoch = ratified)."""
    mv = str(props.get("metric_version") or "")
    if not mv:
        return _check("unavailable", "campaign.metric_version is blank, so no epoch can be named",
                      needs="campaign.metric_version in configs/loop.json")
    problems = epoch_gate(props)
    if problems:
        return _check("fail", problems[0])
    decl = _epoch_declaration(props) or {}
    bound = bool(_scorer_bindings().get(mv))
    return _check("pass",
                  f"scored under metric epoch {mv} ({decl.get('kind', '?')}, standing {decl.get('status', '?')}"
                  + (", the implicit first epoch" if decl.get("implicit") else "") + "); "
                  + ("the scorer on disk matches the hash the epoch is bound to" if bound
                     else "the epoch's scorer hash is not bound yet (binds with this experiment's suite run)"),
                  epoch=mv, kind=decl.get("kind"), standing=decl.get("status"),
                  expected_direction=decl.get("expected_direction"), implicit=bool(decl.get("implicit")))


def check_guardrail(diags: dict) -> dict:
    """Report the co-tracked guardrail. No kit-wide threshold for 'materially worse' exists, so this
    records the values for the reviewer instead of pretending to a judgement it cannot make."""
    if not diags:
        return _check("unavailable", "guardrail() returned nothing for this experiment",
                      needs="an implemented guardrail() in scripts/experiment.py")
    return _check("unavailable",
                  "guardrail values recorded; no numeric 'materially worse' threshold is defined for "
                  "this campaign, so this check reports rather than judges",
                  needs="a numeric guardrail threshold in campaign.md's promotion rule",
                  values=diags)


def check_levers(declared, changes: dict) -> dict:
    """HARD GATE 2 as data: does the config's `_levers` list name every config key this experiment moved
    (the change manifest's `config_keys`, against the unit it is compared to)? A moved-but-undeclared
    key is the silent multi-lever move nothing downstream can attribute; a declared-but-unmoved lever
    is only noted. A name matches a key when either contains the other (a lever may span keys)."""
    if not isinstance(declared, list) or not declared:
        return _check("unavailable", "the config declares no _levers list",
                      needs="a `_levers` list in the config naming the levers this experiment moves "
                            "(CLAUDE.md HARD GATE 2)")
    names = [str(d) for d in declared]
    moved = [str(c.get("key")) for c in (changes.get("config_keys") or [])]

    def _covered(key: str) -> bool:
        return any(n == key or n in key or key in n for n in names)

    undeclared = [k for k in moved if not _covered(k)]
    unmoved = [n for n in names if not any(n == k or n in k or k in n for k in moved)]
    if undeclared:
        return _check("fail", "moved but not declared in _levers: " + ", ".join(undeclared)
                      + f" (declared: {', '.join(names)})", declared=names, moved=moved,
                      undeclared=undeclared)
    if changes.get("since") is None:
        return _check("pass", f"declared: {', '.join(names)}; no prior unit to diff against "
                              f"({changes.get('since_reason') or 'first result'})",
                      declared=names, moved=moved)
    return _check("pass", f"declared: {', '.join(names)}; every moved key is declared"
                          + (f"; declared but unmoved: {', '.join(unmoved)}" if unmoved else ""),
                  declared=names, moved=moved)


def check_hard_bounds(score: float) -> dict:
    """Is the score physically possible at all? Reads metric.PLAUSIBILITY_BOUNDS, the encoded form of
    the hard bounds campaign.md states in prose.

    FLAGS rather than refuses, deliberately. Refusing would lose the artifact you need to DEBUG the
    violation, and it would put quiet pressure on the next person to widen the bounds until their run
    goes through - which is the fabricated-range failure wearing different clothes. A violation is
    recorded loudly and the record is kept.
    """
    bounds = getattr(metric, "PLAUSIBILITY_BOUNDS", None)
    if not bounds:
        return _check("unavailable",
                      "this campaign encodes no hard bounds, so 'physically possible' has no "
                      "machine-readable meaning here",
                      needs="metric.PLAUSIBILITY_BOUNDS in scripts/metric.py - encode only what is true "
                            "BY CONSTRUCTION (a correlation cannot exceed 1), never the range you hope "
                            "for; that is the a-priori prediction and it lives elsewhere")
    why = metric.implausible(float(score))
    if why:
        return _check("fail", f"{why} - this is a BUG in the scorer, the data or the pipeline, not a "
                              "disappointing result; no reading of this number is worth making until "
                              "it is found", bounds=list(bounds))
    return _check("pass", f"within the metric's hard bounds {tuple(bounds)}", bounds=list(bounds))


RE_EXECUTION_MAX_FRACTION = 0.25   # a unit is cheap enough to re-execute when its solve is under this
#                                    fraction of the worker's iteration cap (a runner constant, not a knob)


def _re_execution_eligibility(solve_s, loop_cfg: dict, props: dict) -> dict:
    """Is an independent RE-EXECUTION of this unit affordable and meaningful? Computed, not configured.

    Two facts decide it: the unit's MEASURED solve time against the worker's iteration cap, and whether
    the campaign declares its units reproducible from their configs (seeded; not one-shot, not
    hardware-in-the-loop). The verify skill used to read an absolute threshold fixed at scaffold time;
    in the one campaign measured it sat above nine of ten units' solve times, so full re-execution was
    the de-facto default whatever the units cost. A legacy verify.full_reproduction_threshold_s still
    present in loop.json is honoured as an additional cap, never ignored silently."""
    w = loop_cfg.get("worker") or {}
    v = loop_cfg.get("verify") or {}
    try:
        cap_s = float(w.get("iteration_timeout_hours") or 0) * 3600
    except (TypeError, ValueError):
        cap_s = 0.0
    ceiling = RE_EXECUTION_MAX_FRACTION * cap_s if cap_s > 0 else None
    legacy = v.get("full_reproduction_threshold_s") if isinstance(v, dict) else None
    try:
        legacy = float(legacy) if legacy not in (None, "") else None
    except (TypeError, ValueError):
        legacy = None
    if legacy is not None and legacy > 0:
        ceiling = legacy if ceiling is None else min(ceiling, legacy)
    out = {"solve_wall_clock_s": solve_s, "ceiling_s": ceiling,
           "reproducible": bool(props.get("reproducible", True)),
           "max_fraction": RE_EXECUTION_MAX_FRACTION, "legacy_threshold_s": legacy}
    if solve_s is None:
        out.update(eligible=False, eligibility="solve time not measured for this unit")
    elif not out["reproducible"]:
        out.update(eligible=False, eligibility="campaign.reproducible is false (one-shot, "
                                               "hardware-in-the-loop, or unseeded units)")
    elif ceiling is None:
        out.update(eligible=True, eligibility=f"solve {solve_s:.0f}s; no worker.iteration_timeout_hours "
                                              "to measure against")
    elif solve_s <= ceiling:
        out.update(eligible=True, eligibility=f"solve {solve_s:.0f}s within the {ceiling:.0f}s ceiling "
                                              f"({RE_EXECUTION_MAX_FRACTION:g} x worker.iteration_timeout_hours"
                                              + (f", capped by the legacy threshold {legacy:.0f}s"
                                                 if legacy is not None and legacy == ceiling else "") + ")")
    else:
        out.update(eligible=False, eligibility=f"solve {solve_s:.0f}s exceeds the {ceiling:.0f}s ceiling "
                                               f"({RE_EXECUTION_MAX_FRACTION:g} x worker.iteration_timeout_hours"
                                               + (f", capped by the legacy threshold {legacy:.0f}s"
                                                  if legacy is not None and legacy == ceiling else "")
                                               + ") - review from the frozen record instead")
    return out


def _short(v) -> str:
    s = json.dumps(v, sort_keys=True, default=str)
    return s if len(s) <= 80 else s[:77] + "..."


def _change_manifest(exp_id: str, label: str, props: dict) -> dict:
    """What THIS experiment changed relative to the last verified unit - the mechanical record a
    verifier starts from (verify the delta and its interaction with the unchanged parts) and a worker's
    self-check is directed at. Nobody guesses it: it is read from the frozen snapshots.

    Baseline: the most recent experiment with a CONFIRMED verdict under the current metric_version, else
    the incumbent, else the campaign baseline (exp 000), else nothing (the first experiment). Files are
    compared as CODE (frozen_core._normalized_source: comments, docstrings and formatting do not count),
    config keys by value (underscore-prefixed commentary keys ignored), the version tags by name.
    `python scripts/run_campaign.py --diff <exp>` prints the full diff from the same two snapshots."""
    priors = _prior_results(exp_id)
    mv = str(props.get("metric_version") or "")
    confirmed = []
    for r in priors:
        if mv and r["metric_version"] != mv:
            continue
        vf = _find_verdict_file(r["exp_name"])
        if vf is None:
            continue
        v = _read_json(vf, {}) or {}
        if str(v.get("verdict", "")).strip().upper() == "CONFIRMED":
            confirmed.append(r)
    since, why = None, "first experiment"
    if confirmed:
        since = max(confirmed, key=lambda r: r["id"])
        why = f"last CONFIRMED verdict under metric_version {mv or '(untagged)'}"
    else:
        inc = _incumbent(priors, props)
        if inc is not None:
            since, why = inc, "the incumbent (no CONFIRMED verdict yet under this metric_version)"
        else:
            base = next((r for r in priors if r["id"] == "000"), None)
            if base is not None:
                since, why = base, "the campaign baseline"
    out = {"since": since["exp_name"] if since else None, "since_reason": why,
           "files": [], "config_keys": [], "versions": {}}
    if since is None:
        return out
    mine, theirs = SNAPSHOTS / label, SNAPSHOTS / since["exp_name"]

    def _tree(d: Path) -> dict:
        m = {}
        for p in (d / "scripts").rglob("*"):
            if p.is_file() and "__pycache__" not in p.parts:
                m[p.relative_to(d).as_posix()] = _hashlib.sha256(
                    frozen_core._normalized_source(p) or b"").hexdigest()
        return m

    a, b = _tree(theirs), _tree(mine)
    for rel in sorted(set(a) | set(b)):
        if rel not in a:
            out["files"].append({"path": rel, "kind": "added"})
        elif rel not in b:
            out["files"].append({"path": rel, "kind": "removed"})
        elif a[rel] != b[rel]:
            out["files"].append({"path": rel, "kind": "modified"})
    ca = _read_json(theirs / "config.json", {}) or {}
    cb = _read_json(mine / "config.json", {}) or {}
    for key in sorted(set(ca) | set(cb)):
        if key.startswith("_") or key == "exp_name":
            continue
        va, vb = ca.get(key), cb.get(key)
        if json.dumps(va, sort_keys=True, default=str) != json.dumps(vb, sort_keys=True, default=str):
            out["config_keys"].append({"key": key, "old": _short(va), "new": _short(vb)})
    for tag in ("metric_version", "data_version"):
        old, new = str(since.get(tag) or ""), str(props.get(tag) or "")
        if old != new:
            out["versions"][tag] = [old, new]
    return out


def _changes_summary(exps: str) -> str:
    """The verifier's starting point, one line per experiment, read from results/checks_<NN>.json
    (`changes`): what moved since the last verified unit, and the command for the full diff."""
    lines = []
    for stem in [s.strip() for s in exps.split(",") if s.strip()]:
        eid = exp_id_for(stem)
        ck = _read_json(CHECKS / f"checks_{eid}.json", None) if eid else None
        ch = (ck or {}).get("changes") if isinstance(ck, dict) else None
        if not isinstance(ch, dict):
            lines.append(f"  {stem}: no change record (predates the manifest) - diff the snapshot yourself")
            continue
        if not ch.get("since"):
            lines.append(f"  {stem}: {ch.get('since_reason', 'first experiment')} - nothing to diff against;"
                         " verify it whole")
            continue
        files = ", ".join(f"{f['path']} ({f['kind']})" for f in ch.get("files") or []) or "none"
        keys = ", ".join(f"{c['key']} {c['old']} -> {c['new']}" for c in ch.get("config_keys") or []) or "none"
        vers = ", ".join(f"{k} {v[0]} -> {v[1]}" for k, v in (ch.get("versions") or {}).items())
        lines.append(f"  {stem}: since {ch['since']} ({ch.get('since_reason', '')}); code changed: {files}; "
                     f"config keys changed: {keys}" + (f"; versions: {vers}" if vers else "")
                     + f"; full diff: python scripts/run_campaign.py --diff {stem}")
    return "\n".join(lines)


def write_checks(exp_id: str, label: str, score: float, diags: dict, apriori: dict | None,
                 props: dict, timing: dict | None = None) -> dict:
    """Compute every mechanical check for this experiment and write results/checks_<NN>.json.

    Written LAST, after the logbook entry, so `save_set` reports the complete contract rather than the
    part that happens to exist at scoring time. `timing` (the runner's measured breakdown) is recorded
    under `run` so the unit's cost sits beside its verdicts.
    """
    priors = _prior_results(exp_id)
    inc = _incumbent(priors, props)
    comparability = check_comparability(props, inc, priors)
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    vrows = _verify_rows(loop_cfg)
    # What this experiment changed since the last verified unit - where verification starts, and the
    # record the levers check reads. Computed first; it must never cost the experiment.
    try:
        changes = _change_manifest(exp_id, label, props)
    except Exception as exc:
        changes = {"since": None, "since_reason": f"manifest failed: {type(exc).__name__}: {exc}",
                   "files": [], "config_keys": [], "versions": {}}
    declared = ((_read_json(RESULTS / f"result_{exp_id}.json", {}) or {}).get("config") or {}).get("_levers")
    checks = {
        "prediction": check_prediction_outcome(score, apriori or {}, props, priors),
        "levers": check_levers(declared, changes),
        "noise_floor": check_noise_floor(score, props, inc,
                                         comparable=comparability["status"] != "fail",
                                         excluded=int(comparability.get("excluded") or 0)),
        "comparability": comparability,
        "hard_bounds": check_hard_bounds(score),
        "guardrail": check_guardrail(diags),
        "correctness_suite": check_correctness_state(),
        "epoch": check_epoch(props),
        "save_set": None,   # filled below
    }
    # The campaign's own checks (experiment.py campaign_checks - a seam): merged under their own names,
    # never over a kit check, and only in the three-valued shape every reader of this artifact expects.
    cfg_now = (_read_json(RESULTS / f"result_{exp_id}.json", {}) or {}).get("config") or {}
    for name, c in (_seam("campaign_checks", lambda *a: {})(exp_id, label, score, diags, cfg_now) or {}).items():
        if name not in checks and isinstance(c, dict) and c.get("status") in ("pass", "fail", "unavailable"):
            checks[name] = c
    # Re-verified HERE, at record time, over all four artifacts - including the figure, which
    # assert_save_set checked before the row was written and which nothing has re-checked since. The
    # three that gate preceded this are re-read rather than assumed: a check that cannot fail is not a
    # check, and this file must never carry a status nobody measured.
    present = {
        "result JSON": (RESULTS / f"result_{exp_id}.json").is_file(),
        "figure": any(IMAGES.glob(f"{label}_*")),
        "snapshot": (SNAPSHOTS / label).is_dir(),
        "logbook entry": label in LOGBOOK.read_text(encoding="utf-8", errors="replace"),
    }
    # POST-solve invocation: the per-result gates, and whatever the preset holds back for a promotion
    # candidate, run now that there is a result to gate - and only for a candidate where the preset
    # says so. Their outcome lands in this artifact's correctness_suite check.
    candidate = _is_candidate(checks)
    post = _due_checks(_read_json(CORRECTNESS_STATE, None), vrows["rows"], props,
                       candidate=candidate, core_moved=False)
    _SUITE_LAST["candidate"] = dict(post, candidate=candidate)
    if post["due"]:
        print(_suite_line("candidate", post, len(post["due"]) + len(post["skipped"])))
        check_correctness_suite(str(props.get("metric_version") or ""), select=",".join(post["due"]),
                                ran_for=label, why="candidate", props=props)
        checks["correctness_suite"] = check_correctness_state()
    missing = sorted(n for n, ok in present.items() if not ok)
    checks["save_set"] = (
        _check("fail", "missing from the save-set at record time: " + ", ".join(missing), present=present)
        if missing else
        _check("pass", "re-verified on disk: result JSON, figure, snapshot, logbook entry",
               present=present))
    payload = {
        "exp_id": exp_id, "exp_name": label, "utc": _utc_stamp(),
        "metric": {"name": "{{PRIMARY_METRIC}}", "value": float(score),
                   "higher_is_better": bool(metric.HIGHER_IS_BETTER)},
        "campaign": {k: props.get(k) for k in ("prediction_mode", "noise_model", "noise_floor",
                                               "tolerance", "metric_version", "data_version",
                                               "metric_revision")},
        "checks": checks,
        "flags": sorted(n for n, c in checks.items() if c["status"] == "fail"),
        "unavailable": sorted(n for n, c in checks.items() if c["status"] == "unavailable"),
        "run": {"solve_wall_clock_s": (timing or {}).get("solve_s"),
                "timing": {k: v for k, v in (timing or {}).items() if k != "t_run"}},
        # The verification this unit ran under (the preset and its resolved table) and what it can
        # afford (re-execution, decided from its own measured cost) - the verifier reads this rather
        # than a scaffold-time threshold, and the label every claim carries is built from it.
        "verification": dict(
            {k: vrows[k] for k in ("preset", "source", "rows")},
            re_execution=_re_execution_eligibility((timing or {}).get("solve_s"), loop_cfg, props),
            # Which checks the preset made due for this unit and why the rest were not: the record
            # behind the label, per invocation (before the solve; after it, for a candidate).
            suite={"experiment": _SUITE_LAST.get("experiment"), "candidate": _SUITE_LAST.get("candidate"),
                   "budget": _SUITE_LAST.get("budget")}),
        # The worker's own checks land here via `--self-check` (absent until then; off under a preset
        # that does not record them); the label is what every exported claim carries - honest, and
        # raised only by artifacts: a recorded self-check, then an independent verdict.
        "self_check": {"status": "off" if vrows["rows"].get("self_check") == "off" else "absent"},
        "label": "unverified",
    }
    payload["changes"] = changes
    (CHECKS / f"checks_{exp_id}.json").write_text(json.dumps(payload, indent=2), encoding="utf-8")
    n_pass = len(checks) - len(payload["flags"]) - len(payload["unavailable"])
    if payload["flags"]:
        print(f"RED FLAG: {len(payload['flags'])} mechanical check(s) FAILED for {label}: "
              + "; ".join(f"{n} - {checks[n]['detail']}" for n in payload["flags"]))
        print("  Each is a bug or a discovery. Explain every one in the logbook Analysis slot before "
              "moving on (roles/worker.md, loop step 7) - an unexplained flag is not a passed check.")
    if payload["unavailable"]:
        print(f"checks: {len(payload['unavailable'])} not runnable for this campaign "
              f"({', '.join(payload['unavailable'])}); each names what it needs, in "
              f"results/checks_{exp_id}.json.")
    print(f"mechanical checks -> results/checks_{exp_id}.json "
          f"({n_pass} pass, {len(payload['flags'])} fail, {len(payload['unavailable'])} unavailable)")
    return payload


def evaluate_and_record(cfg: dict, prediction, target, apriori: dict | None = None,
                        props: dict | None = None, timing: dict | None = None) -> dict:
    """Score with the FROZEN metric, run the guardrail, and write result_<NN>.json (+ figure).

    The scoreboard row is appended LAST, behind the save-set gate - a row exists only for a fully-saved
    result. The a-priori range is echoed into the result JSON so an out-of-envelope score is visible in
    the record, not only in the analysis narrative. `timing` is the runner's own measured breakdown
    (gates / suite / snapshot / solve); the solve time travels with the result as the unit's cost.
    """
    _beat("scoring")
    t_record = time.monotonic()
    timing = dict(timing or {})
    score = metric.compute_metric(prediction, target)
    assert np.isfinite(score), "primary metric is non-finite - refuse to record a noise result"
    diags = _exp().guardrail(prediction, cfg)

    label = cfg["exp_name"]
    residual = _seam("residual", lambda p, t: None)(prediction, target)
    fig = _exp().save_figure(label, prediction, target, residual)

    props = props or {}
    result = {
        "exp_name": label,
        "{{PRIMARY_METRIC}}": float(score),
        "guardrail": diags,
        "utc": _utc_stamp(),
        # The comparability tags travel WITH the number, not only on the scoreboard row: a later
        # comparison reads these result files, and a delta between two differently-versioned scores is
        # not a delta. Blank tags are a hygiene failure the checks artifact reports.
        "metric_version": str(props.get("metric_version") or ""),
        "data_version": str(props.get("data_version") or ""),
        # The measured solve time IS the unit's cost - what verification depth is decided against.
        "solve_wall_clock_s": timing.get("solve_s"),
        "config": cfg,
    }
    if apriori:
        result["apriori"] = apriori.get("predicted")
        # Mode-safe: only a `range` prediction has a numeric envelope to fall outside of. The full
        # judgement for every mode is computed by write_checks() below and recorded in
        # results/checks_<NN>.json - this key is kept because the result JSON has carried it since the
        # prediction gate shipped, and something may still read it.
        rng = apriori.get("predicted") or {}
        try:
            lo, hi = float(rng["low"]), float(rng["high"])
        except (KeyError, TypeError, ValueError):
            lo = hi = None
        if lo is not None and not (lo <= float(score) <= hi):
            result["outside_apriori_range"] = True
    exp_id = exp_id_for(label)
    if not exp_id:
        sys.exit(f"NAMING: cannot derive an experiment id from exp_name {label!r}. The runner names "
                 "result_<NN>.json, checks_<NN>.json and the scoreboard row from it, and an id it "
                 "cannot derive used to fall back to 000 - silently overwriting the BASELINE's record.\n"
                 "  Use exp<NN>_<slug> (e.g. exp007_rigid), or exp<NN><letter>_<slug> for a sub-run "
                 "(exp007a_rigid).")
    # Refuse to write over a DIFFERENT experiment's record. Two exp_names can map to one id
    # (exp001_a and exp001_b both give 001), and the loser used to be overwritten without a word -
    # its result JSON, its checks artifact, and the provenance linking them to the row on the
    # scoreboard. The ledger is only trustworthy if one id means one experiment.
    prior = _read_json(RESULTS / f"result_{exp_id}.json", None)
    if isinstance(prior, dict) and prior.get("exp_name") not in (None, label):
        sys.exit(f"NAMING COLLISION: results/result_{exp_id}.json already belongs to "
                 f"{prior['exp_name']!r}, but this run is {label!r} - both derive the id {exp_id}.\n"
                 "  Writing it would destroy that experiment's record while leaving its scoreboard row "
                 "pointing at yours. Rename this experiment so its id is its own; for a deliberate "
                 "sub-run of an existing one, use the letter form (exp<NN><letter>_<slug>).")
    (RESULTS / f"result_{exp_id}.json").write_text(json.dumps(result, indent=2), encoding="utf-8")

    assert_save_set(exp_id, label, fig)   # RECORD GATE: no row until the save-set exists on disk

    evf = _expected_vs_found(score, apriori, props, exp_id)
    append_scoreboard_row({
        "exp_id": exp_id,
        "timestamp": result["utc"],
        # COMPARABILITY (scoreboard.tsv, "the most common silent landmine"): every row must carry both
        # tags, and `tier` must be on every row or cap-compliance stops being machine-auditable. These
        # are filled here rather than left to the campaign: a rule no code writes is not enforced, and a
        # row emitted without the tags carries blanks no later reader can resolve.
        "metric_version": result["metric_version"],
        "data_version": result["data_version"],
        "tier": cfg.get("_tier", "Baseline" if exp_id == "000" else ""),
        # The narrative cells - the ledger IS the one-line timeline (the JOURNAL keeps no copy of it):
        # `what` (the config's one-line comment), `expected_vs_found` (the same judgement the logbook
        # line carries), an optional `note` (--record --ledger-note, capped) and `finding` (--record
        # --finding, one line citing its verdict). `description` / `notes` are the older spellings.
        "what": cfg.get("_comment", ""), "description": cfg.get("_comment", ""),
        "expected_vs_found": evf,
        "{{PRIMARY_METRIC}}": f"{score:.4f}",
        # The campaign's own columns (levers, guardrail values, run numerics) come from experiment.py's
        # campaign_scoreboard_fields(cfg, diags, score) - a seam, so the kit-owned row stays kit-owned.
        **_seam("campaign_scoreboard_fields", lambda cfg, diags, score: {})(cfg, diags, score),
        "note": "", "notes": "", "finding": "",
    })
    append_logbook(cfg, exp_id, label, score, diags, apriori, expected_vs_found=evf)
    timing["record_s"] = round(time.monotonic() - t_record, 3)
    # Last, so save_set can report the complete contract (the logbook entry lands one line above).
    try:
        write_checks(exp_id, label, score, diags, apriori, props, timing=timing)
    except Exception as exc:                      # never lose the experiment over its own verdict file
        print(f"WARNING: the mechanical checks could not be computed ({type(exc).__name__}: {exc}). "
              f"Recording that failure to results/checks_{exp_id}.json rather than leaving no verdict - "
              "an absent checks file is indistinguishable from a run that predates the artifact.")
        try:
            (CHECKS / f"checks_{exp_id}.json").write_text(json.dumps({
                "exp_id": exp_id, "exp_name": label, "utc": _utc_stamp(),
                "checks": {"_runner": {"status": "fail",
                                       "detail": f"write_checks raised {type(exc).__name__}: {exc}"}},
                "flags": ["_runner"], "unavailable": [],
            }, indent=2), encoding="utf-8")
        except Exception:
            pass
    _append_timing_row(exp_id, label, timing)
    _beat("record")
    print(f"[{label}] {{PRIMARY_METRIC}} = {score:.4f}  (figure: {fig.name}; logged to logbook.md)")
    return result


def metric_selftest_message() -> str | None:
    """The metric self-test as a message: None = pass, else the human-readable failure. Shared seam for
    the per-experiment gate (require_metric_selftest) and the supervisor preflight - one authority."""
    try:
        metric.selftest()
    except NotImplementedError as exc:
        return (f"metric selftest NOT RUNNABLE: {exc}\n"
                "  -> implement compute_metric() and _no_skill_floor() in scripts/metric.py, then re-run. "
                "The self-test (perfect case + scrambled-input null control) gates every experiment.")
    except AssertionError as exc:
        return (f"metric selftest FAILED: {exc}\n"
                "  -> the FROZEN scorer has a sign/convention/leakage bug. Fix it before running any "
                "experiment; a ranking from a scorer that fails its self-test is noise.")
    return None


def unimplemented_hooks() -> list[str]:
    """Which campaign hooks are still the generated `raise NotImplementedError` stub.

    Detected from SOURCE, never by calling them: `run_experiment()` runs an experiment, so probing by
    invocation would spend (or corrupt) a unit to answer a question about setup. A hook whose source
    cannot be read is reported as implemented -- silence is better than a false accusation that sends
    someone editing code that is already fine.
    """
    import ast
    import inspect
    import textwrap

    out = []
    try:
        mod = _exp()
    except Exception as exc:                        # a syntax/import error is a setup failure, named
        return [f"scripts/experiment.py does not import ({type(exc).__name__}: {exc})"]
    for name in ("validate_method", "run_experiment", "load_target"):
        fn = getattr(mod, name, None)
        if not callable(fn):
            out.append(name + " MISSING")            # worse than a stub: nothing to call at all
            continue
        try:
            body = ast.parse(textwrap.dedent(inspect.getsource(fn))).body[0].body
        except (OSError, TypeError, SyntaxError, IndexError):
            continue
        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):
            body = body[1:]                                    # drop the docstring
        if len(body) == 1 and isinstance(body[0], ast.Raise):
            exc = body[0].exc
            if getattr(getattr(exc, "func", exc), "id", None) == "NotImplementedError":
                out.append(name)
    return out


def require_metric_selftest() -> None:
    """HARD-FAIL unless the FROZEN scorer passes its self-test. Runs automatically before every experiment
    (was opt-in via --selftest). Doctrine: don't trust a ranking until the self-test passes - it gates
    experiment 000. A campaign that hasn't implemented compute_metric()/_no_skill_floor() yet fails here with
    a pointer to fix, not a raw traceback; a scorer that fails its null control fails here too.
    """
    msg = metric_selftest_message()
    if msg:
        sys.exit(msg)


SUITE_ROWS = ("invariants", "machinery", "gates")
SUITE_META_DEFAULT = {"row": "invariants", "depends_on": (), "every": ""}


def _suite_worker(select: str, report: str, exp: str) -> int:
    """`--suite-worker`: run tests/correctness_checks.py's CHECKS in THIS process, one at a time, timed,
    traced, and reported - the protocol behind check_correctness_suite.

    The suite used to run as `python tests/correctness_checks.py`: an exit code and nothing else - no
    check names, no per-check cost, no way to run a subset. Hosting the worker here (the suite module is
    imported; its own main() never runs) gives the runner all three without a new file in the campaign
    tree, and a suite with a flat CHECKS list and no declarations keeps working exactly as before (an
    undeclared check is row 'invariants'). A suite without CHECKS at all falls back to the old exit-code
    run. select: comma-separated check names, or ''/'all'. report: the JSON path to write. exp: the
    experiment a 'gates' check (one that takes an argument) is given, or ''."""
    import importlib.util
    import inspect
    suite = ROOT / "tests" / "correctness_checks.py"
    sys.path.insert(0, str(ROOT / "scripts"))
    spec = importlib.util.spec_from_file_location("correctness_checks", suite)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    checks = list(getattr(mod, "CHECKS", None) or [])
    wanted = ({s.strip() for s in select.split(",") if s.strip()}
              if select and select.strip().lower() != "all" else None)
    rows_out, t_all = [], time.monotonic()
    root_r = ROOT.resolve()
    prefixes = (str(root_r).lower(), str(root_r.parent.parent).lower())
    for fn in checks:
        name = getattr(fn, "__name__", str(fn))
        if wanted is not None and name not in wanted:
            continue
        meta = dict(SUITE_META_DEFAULT, **(getattr(fn, "physkit_check", None) or {}))
        declared = getattr(fn, "physkit_check", None) is not None
        traced: set = set()

        def _tracer(frame, event, arg):
            # Call events only (returning None never traces lines): which of OUR files a check
            # executes is the on-change fingerprint's input; the cost is a function-call hook.
            if event == "call":
                f = frame.f_code.co_filename
                if f.lower().startswith(prefixes):
                    try:
                        traced.add(Path(f).resolve().relative_to(root_r).as_posix())
                    except ValueError:
                        traced.add(Path(f).resolve().as_posix())
            return None

        takes_arg = bool(inspect.signature(fn).parameters)
        t0 = time.monotonic()
        sys.settrace(_tracer)
        try:
            if takes_arg and not exp:
                status = "skip: needs a result (a gates check runs with the experiment it gates)"
            else:
                status = (fn(exp) if takes_arg else fn()) or "pass"
        except Exception as exc:               # a raising check is a FAILURE, never a silent pass
            status = f"fail: {type(exc).__name__}: {exc}"
        finally:
            sys.settrace(None)
        status = str(status)
        kind = "pass" if status == "pass" else ("fail" if status.startswith("fail") else "skip")
        rows_out.append({"name": name, "row": meta["row"] if meta["row"] in SUITE_ROWS else "invariants",
                         "depends_on": [str(d) for d in meta["depends_on"]], "every": str(meta["every"] or ""),
                         "declared": declared, "takes_arg": takes_arg, "status": kind, "detail": status,
                         "wall_s": round(time.monotonic() - t0, 6), "traced": sorted(traced)})
        mark = {"pass": "PASS", "fail": "FAIL"}.get(kind, "skip")
        print(f"  [{mark}] {name}: {status}"
              + (f"  ({rows_out[-1]['wall_s']:.2f}s)" if rows_out[-1]["wall_s"] >= 0.5 else ""))
    n_fail = sum(1 for r in rows_out if r["status"] == "fail")
    n_pass = sum(1 for r in rows_out if r["status"] == "pass")
    print(f"correctness suite: {n_pass} pass | {n_fail} fail | {len(rows_out) - n_fail - n_pass} skip"
          + (f" (selected {len(rows_out)} of {len(checks)})" if wanted is not None else ""))
    payload = {"protocol": 1, "checks": rows_out, "wall_s": round(time.monotonic() - t_all, 6),
               "selected": sorted(wanted) if wanted is not None else None, "n_checks": len(checks)}
    if report:
        Path(report).write_text(json.dumps(payload, indent=2), encoding="utf-8")
    if n_fail:
        return 1
    if n_pass == 0 and wanted is None:
        return 2
    return 0


def _check_fingerprint(entry: dict, props: dict) -> str | None:
    """What a check's outcome depended on, as one hash: the CODE of the files it executed last time
    (frozen_core._normalized_source - comments, docstrings and formatting do not count) plus anything it
    declared in depends_on, the campaign's data_version, and the interpreter. A check with no trace and
    no declaration hashes every Python file under scripts/ and tests/: it over-runs, never wrongly
    skips. None when a file cannot be read (then the check is due)."""
    files = []
    for rel in list(entry.get("traced") or []) + list(entry.get("depends_on") or []):
        p = Path(rel) if Path(rel).is_absolute() else (ROOT / rel)
        if p.is_file():
            files.append(p)
    if not files:
        files = [p for d in ("scripts", "tests") for p in sorted((ROOT / d).rglob("*.py"))
                 if "__pycache__" not in p.parts]
    files = sorted(set(files))
    h = frozen_core._hash_files(ROOT, files, frozen_core._normalized_source)
    if h is None:
        return None
    return _hashlib.sha256((h + "\0" + str(props.get("data_version") or "") + "\0"
                            + sys.version.split()[0] + "\0" + np.__version__).encode("utf-8")).hexdigest()


def _due_checks(state: dict | None, rows: dict, props: dict, *, candidate, core_moved: bool) -> dict:
    """Which checks the preset makes due for THIS invocation, and why each other one is not.

    candidate=None is the PRE-solve invocation (invariants and machinery); True/False is the POST-solve
    one (gates, and whatever waits for a promotion candidate). Returns {due, why, skipped, first}."""
    checks = (state or {}).get("checks") or {}
    if not checks or (state or {}).get("protocol") != 1:
        return {"due": [], "why": {}, "skipped": {}, "first": True}   # nothing known yet: run everything
    due, why, skipped = [], {}, {}
    post = candidate is not None
    demoted = set(((state or {}).get("demotions") or {}).keys())
    for name, e in checks.items():
        row = e.get("row") or "invariants"
        trig = "every" if e.get("every") else str(rows.get(row) or "every")
        if name in demoted:
            trig = "promotion"      # metered out of the every-set; still runs for every candidate
        gate = row == "gates" or bool(e.get("takes_arg"))
        if gate and not post:
            skipped[name] = "gate: runs with the result, after the solve"
            continue
        if not gate and post and trig != "promotion":
            skipped[name] = "decided before the solve"
            continue
        if core_moved:
            due.append(name)
            why[name] = "the FROZEN core changed: every check is due"
        elif trig == "off":
            skipped[name] = f"row {row} is off under this preset"
        elif trig == "every":
            due.append(name)
            why[name] = "every"
        elif trig == "setup":
            if e.get("last_status") is None:
                due.append(name)
                why[name] = "setup: never run"
            else:
                skipped[name] = f"setup: recorded {e.get('last_status')} at {e.get('last_run_utc', '?')}"
        elif trig == "on-change":
            fp = _check_fingerprint(e, props)
            if fp is None or fp != e.get("fingerprint"):
                due.append(name)
                why[name] = "on-change: its code moved" if e.get("fingerprint") else "on-change: no fingerprint yet"
            else:
                skipped[name] = f"on-change: unchanged since {e.get('ran_for') or e.get('last_run_utc', '?')}"
        elif trig == "promotion":
            if post and candidate:
                due.append(name)
                why[name] = "promotion: this unit is a candidate"
            else:
                skipped[name] = "promotion: not a candidate" if post else "promotion: decided after the solve"
        else:
            due.append(name)
            why[name] = f"unknown trigger {trig!r}: run it"
    return {"due": due, "why": why, "skipped": skipped, "first": False}


def _is_candidate(checks: dict) -> bool:
    """A unit worth the expensive checks: it beats the incumbent, or it is the first result under this
    metric epoch (what everything after it is compared against)."""
    nf = checks.get("noise_floor") or {}
    if nf.get("better") is True:
        return True
    return nf.get("status") == "unavailable" and "first result" in str(nf.get("detail", ""))


def _suite_line(why: str, d: dict, known: int) -> str:
    head = (f"correctness suite [{why}]: first run - every check"
            if d["first"] else f"correctness suite [{why}]: {len(d['due'])} of {known} due")
    if d["why"]:
        head += " (" + "; ".join(f"{n}: {r}" for n, r in list(d["why"].items())[:6]) + ")"
    if d["skipped"]:
        head += "; skipped: " + "; ".join(f"{n} ({r})" for n, r in list(d["skipped"].items())[:6])
        if len(d["skipped"]) > 6:
            head += f"; +{len(d['skipped']) - 6} more"
    return head


SUITE_BUDGET_FRACTION = 0.10   # of the campaign's measured unit cost, for everything scripted that fires per unit
SUITE_BUDGET_FLOOR_S = 30.0    # so a campaign of one-second units still gets a few checks per unit


def _suite_budget_s(loop_cfg: dict) -> float:
    """The per-unit budget for scripted checks: a fraction of unit_cost.typical_wall_clock_s, never below
    a small floor. Runner constants, not knobs (the floor is env-overridable, PHYSKIT_SUITE_BUDGET_FLOOR_S,
    so the deterministic tests can exercise the mechanism on a one-second toy)."""
    try:
        typical = float((loop_cfg.get("unit_cost") or {}).get("typical_wall_clock_s") or 0)
    except (TypeError, ValueError):
        typical = 0.0
    try:
        floor = float(os.environ.get("PHYSKIT_SUITE_BUDGET_FLOOR_S", SUITE_BUDGET_FLOOR_S))
    except ValueError:
        floor = SUITE_BUDGET_FLOOR_S
    return max(floor, SUITE_BUDGET_FRACTION * typical)


def _every_cost(state: dict | None, rows: dict) -> tuple[float, list]:
    """The MEASURED cost of everything that fires per unit under the preset (the every-set), from the
    per-check state: total seconds and the members, slowest first."""
    checks = (state or {}).get("checks") or {}
    demoted = set(((state or {}).get("demotions") or {}).keys())
    members = []
    for name, e in checks.items():
        if name in demoted:
            continue
        row = e.get("row") or "invariants"
        trig = "every" if e.get("every") else str(rows.get(row) or "every")
        if trig == "every":
            members.append((name, float(e.get("wall_s") or 0.0)))
    members.sort(key=lambda t: -t[1])
    return sum(w for _, w in members), members


def _meter_suite(rows: dict, loop_cfg: dict) -> dict:
    """Mid-campaign metering: when the every-set's MEASURED cost exceeds the budget, demote its slowest
    members to promotion-time - loudly, and persisted under `demotions` in results/correctness_state.json.
    Never a silent skip: a demoted check still runs for every promotion candidate, the line says how to
    restore it, and the driver logs the change at its next loop top. The guardrail the light presets
    rest on: a suite that grows slow cannot quietly make the lightest mode heavy."""
    st = _read_json(CORRECTNESS_STATE, None)
    budget = _suite_budget_s(loop_cfg)
    if not isinstance(st, dict) or st.get("protocol") != 1:
        return {"budget_s": budget, "every_cost_s": None, "demoted": [], "standing_demotions": []}
    cost, members = _every_cost(st, rows)
    demoted_now = []
    if cost > budget and members:
        demotions = dict(st.get("demotions") or {})
        remaining = cost
        for name, w in members:
            if remaining <= budget:
                break
            demotions[name] = {"from": "every", "to": "promotion", "utc": _utc_stamp(), "wall_s": w,
                               "budget_s": budget, "every_cost_s": cost}
            demoted_now.append((name, w))
            remaining -= w
        st["demotions"] = demotions
        try:
            CORRECTNESS_STATE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass
        print(f"SUITE BUDGET: the every-set took {cost:.1f}s against a {budget:.1f}s budget "
              f"({SUITE_BUDGET_FRACTION:g} x unit_cost.typical_wall_clock_s, floor {SUITE_BUDGET_FLOOR_S:g}s) - "
              "DEMOTED " + ", ".join(f"{n} ({w:.1f}s)" for n, w in demoted_now)
              + " from every to promotion. Each still runs for every promotion candidate. Restore one after "
                "making it cheaper by deleting its entry under demotions in results/correctness_state.json; "
                "declare it @check(row='machinery') or 'gates' if it never belonged in the every-set.")
    return {"budget_s": budget, "every_cost_s": cost, "demoted": [n for n, _ in demoted_now],
            "standing_demotions": sorted((st.get("demotions") or {}).keys())}


_SUITE_LAST: dict = {}     # why -> the due/skipped decision of the last invocation, for the checks artifact
_SUITE_TIMING: dict = {}   # the last suite run's measured wall time, for the per-unit timing record


def _append_timing_row(exp_id: str, label: str, timing: dict) -> None:
    """results/timing.tsv - one row per recorded experiment: where the runner's own time went (gates,
    suite, snapshot, solve, record). The evidence a slowness audit needs and could not get from the
    logs. Append-only; a write failure never touches the record."""
    try:
        p = RESULTS / "timing.tsv"
        cols = ["exp_id", "label", "start_iso", "end_iso", "dur_s", "launched_by", "mode",
                "gates_s", "suite_s", "snapshot_s", "solve_s", "record_s"]
        if not p.is_file():
            p.write_text("\t".join(cols) + "\n", encoding="utf-8")
        t_run = timing.get("t_run")
        total = (time.monotonic() - t_run) if t_run is not None else None

        def _f(v) -> str:
            return "" if v is None else f"{float(v):.3f}"

        row = [exp_id, label, str(timing.get("start_iso") or ""),
               _dt.datetime.now(_dt.timezone.utc).isoformat(), _f(total),
               os.environ.get("PHYSKIT_ROLE") or "attended",
               "supervised" if os.environ.get("AUTORESEARCH_SUPERVISED") else "attended"]
        row += [_f(timing.get(k)) for k in ("gates_s", "suite_s", "snapshot_s", "solve_s", "record_s")]
        with p.open("a", encoding="utf-8") as fh:
            fh.write("\t".join(row) + "\n")
    except Exception:
        pass


def check_correctness_suite(metric_version: str = "", select: str = "", ran_for: str = "",
                            why: str = "experiment", props: dict | None = None) -> str:
    """Run the standing correctness suite (if present), RECORD its status to results/correctness_state.json,
    and WARN on anything that is not green. Returns "green" / "red" / "empty" / "error" / "absent". Runs on
    every experiment. Also the one place a metric epoch's scorer hash is BOUND (scorer_hash_by_version in
    the same state file): the first suite run under `metric_version` records the FROZEN scorer's hash, and
    epoch_gate refuses to spend when a later scorer no longer matches it.

    Non-blocking for the run itself (so you can still iterate mid-fix) - but only an AFFIRMATIVE GREEN
    green-lights a promotion. guard_promotion refuses a promotion unless the suite is green: RED (a
    check failed), EMPTY (zero active checks - the freshly-scaffolded all-skip suite), ERROR, and ABSENT all
    block, because none of them is evidence the machinery is right; a genuinely-no-simulator campaign records
    an explicit tests/CORRECTNESS_NA.md instead (doctrine: no finding built on an unguarded machine is
    trustworthy). The state also records a hash of the FROZEN/core files
    (scripts/frozen_core.py); guard_promotion rejects a promotion whose green was recorded against a
    DIFFERENT core than the code on disk now - a green does not survive an edit to the code it
    certified. The suite runs on every experiment, so the recorded green is fresh at experiment time; the
    hash closes the promote-without-a-new-experiment path (edit the scorer, then promote an old result).
    """
    suite = ROOT / "tests" / "correctness_checks.py"
    status = "absent"
    rc = None
    wall_s = None       # measured, never assumed: the suite's cost was previously known only by its cap
    report, protocol = None, None
    t0 = time.monotonic()
    if not suite.is_file():
        print("WARNING: no correctness suite at tests/correctness_checks.py - the simulator is unguarded, so "
              "promotion is BLOCKED (status=absent). Build one with the correctness-suite skill, or "
              "record an explicit N/A in tests/CORRECTNESS_NA.md (with a rationale) if there is genuinely "
              "no simulator to check.")
    elif select == "-":
        # Nothing due under the preset: no subprocess, but the state is re-stamped (and the epoch's
        # scorer hash bound) so the record shows a decision, not an absence.
        prior0 = _read_json(CORRECTNESS_STATE, None)
        prior0 = prior0 if isinstance(prior0, dict) else {}
        protocol, status, wall_s = prior0.get("protocol"), str(prior0.get("status") or "error"), 0.0
        print(f"correctness suite: nothing due under the preset - status={status} carried from the last "
              f"run [{why}]")
    else:
        try:
            suite_text = suite.read_text(encoding="utf-8", errors="replace")
            has_checks = any(ln.startswith("CHECKS") for ln in suite_text.splitlines())
            if has_checks:
                # The protocol: the runner's own worker imports the suite, runs the selection, and
                # reports per check (name, row, status, cost, the files it executed).
                DIAG.mkdir(parents=True, exist_ok=True)
                rep_path = DIAG / f".suite_report_{os.getpid()}.json"
                env = dict(os.environ, PHYSKIT_SUITE_SELECT=select or "", PHYSKIT_SUITE_REPORT=str(rep_path),
                           PHYSKIT_SUITE_EXP=ran_for or "")
                proc = subprocess.run([sys.executable, str(Path(__file__).resolve()), "--suite-worker"],
                                      capture_output=True, text=True, timeout=600, env=env, cwd=str(ROOT))
                wall_s = time.monotonic() - t0
                rc = proc.returncode
                if proc.stdout:
                    print(proc.stdout.rstrip())
                report = _read_json(rep_path, None)
                rep_path.unlink(missing_ok=True)
                if isinstance(report, dict) and report.get("protocol") == 1:
                    protocol = 1
                    status = {0: "green", 1: "red", 2: "empty"}.get(rc, "error")   # 2 = zero active checks
                else:
                    status = "error"
                    print("WARNING: the suite worker wrote no report (did tests/correctness_checks.py fail "
                          "to import?) - recording status=error (BLOCKS PROMOTION). Worker output:\n"
                          + (proc.stderr or "")[-1500:])
            else:
                # A suite with its own runner and no CHECKS list: the previous kit's exit-code run.
                proc = subprocess.run([sys.executable, str(suite)], capture_output=True, text=True, timeout=600)
                wall_s = time.monotonic() - t0
                rc = proc.returncode
                if proc.stdout:
                    print(proc.stdout.rstrip())
                protocol = "legacy"
                status = {0: "green", 1: "red", 2: "empty"}.get(rc, "error")
            print(f"correctness suite: status={status} wall={wall_s:.1f}s (cap 600s)"
                  + (" [legacy suite: exit code only]" if protocol == "legacy" else "")
                  + (f" [{why}]" if why != "experiment" else ""))
            if status == "red":
                print("WARNING: correctness suite is RED - a check FAILED. This result is recorded, but a RED "
                      "suite BLOCKS PROMOTION (guard_promotion refuses the current-best/verdict write until "
                      "it is green). Fix the suite before promoting anything built on this code.")
            elif status == "empty":
                print("WARNING: correctness suite has 0 ACTIVE checks (EMPTY) - the machinery is unguarded, so "
                      "it BLOCKS PROMOTION, same as RED. Add >=1 real check (correctness-suite skill), "
                      "or record tests/CORRECTNESS_NA.md if this campaign has no simulator to check.")
            elif status == "error":
                print(f"WARNING: correctness suite exited {rc} (unexpected) - recording status=error, which "
                      "BLOCKS PROMOTION. Investigate the suite.")
        except Exception as exc:  # a broken/slow suite must warn, never block the run
            wall_s = time.monotonic() - t0
            print(f"WARNING: could not run the correctness suite ({exc}); recording status=error "
                  f"(BLOCKS PROMOTION) after {wall_s:.1f}s.")
            status = "error"
    _SUITE_TIMING["wall_s"] = None if wall_s is None else round(wall_s, 3)
    try:
        prior = _read_json(CORRECTNESS_STATE, None)
        prior = prior if isinstance(prior, dict) else {}
        # Per-check state (the protocol): a check not selected this run keeps its last recorded
        # outcome; the aggregate status is over every check the suite currently holds, so a green
        # still certifies the whole suite when only part of it had to run.
        checks_state = dict(prior.get("checks") or {}) if protocol == 1 else {}
        if protocol == 1 and isinstance(report, dict):
            now = _utc_stamp()
            for r in report["checks"]:
                entry = dict(checks_state.get(r["name"]) or {})
                entry.update(row=r["row"], depends_on=r["depends_on"], every=r["every"],
                             declared=r["declared"], takes_arg=r["takes_arg"], last_status=r["status"],
                             detail=r["detail"], last_run_utc=now, wall_s=r["wall_s"], traced=r["traced"],
                             ran_for=ran_for or entry.get("ran_for", ""), why=why)
                # The on-change trigger compares against this: the code the check just executed.
                entry["fingerprint"] = _check_fingerprint(entry, props or {})
                checks_state[r["name"]] = entry
            if report.get("selected") is None:      # a full run: checks removed from the suite drop out
                names = {r["name"] for r in report["checks"]}
                checks_state = {k: v for k, v in checks_state.items() if k in names}
            if status != "error":
                if any(v.get("last_status") == "fail" for v in checks_state.values()):
                    status = "red"
                elif any(v.get("last_status") == "pass" for v in checks_state.values()):
                    status = "green"
                else:
                    status = "empty"
        state = {"status": status, "returncode": rc, "utc": _utc_stamp(),
                 "wall_s": _SUITE_TIMING["wall_s"], "protocol": protocol, "why": why,
                 "selected": select or "all", "checks": checks_state,
                 # metering decisions survive every rewrite, like the epoch bindings below
                 "demotions": dict(prior.get("demotions") or {}) if protocol == 1 else {},
                 "core_hash": frozen_core.core_hash(ROOT),
                 # bindings survive every rewrite: a bound epoch stays bound
                 "scorer_hash_by_version": dict(prior.get("scorer_hash_by_version") or {})}
        _bind_scorer_hash(state, metric_version, frozen_core.scorer_hash(ROOT))
        CORRECTNESS_STATE.write_text(json.dumps(state, indent=2), encoding="utf-8")
    except Exception:
        pass
    return status


# ======================================================================================================
# SUPERVISOR MODE (the loop driver) - code at the joints, LLM judgment at the nodes.
#
# `--supervise` runs the campaign as an orchestrated loop: a dumb, deterministic driver pops units from
# results/queue.json, enforces the artifact gates, spawns a FRESH-context worker agent per unit (cwd =
# campaign root, so the frozen CLAUDE.md spine auto-loads and the prompt names campaign.md +
# roles/worker.md, which do not), and validates what the worker left
# behind. Judgment lives at the edges: workers steer by proposing queue units; a bounded planner agent
# replans on triggers. The driver follows the queue and the gates and adds nothing of its own.
# Failures split by kind:
#   * INTEGRITY (ESCALATE present · queue empty after a planner pass · corrupt queue.json · preflight /
#     metric-selftest failure · an UNDECLARED change to the FROZEN scorer (the epoch gate) · planner
#     failure after retry) -> HALT LOUD. These the driver must never route around.
#   * OPERATIONAL (worker spawn error / timeout / unit unvalidated after retries) -> record the failure
#     on the unit, SHELVE it (kind="operational"), and CONTINUE - degrade-loud. A whole overnight loop
#     must not die for one casualty; the shelf entry is the loud part, and the planner can revive it.
#   * SYSTEMIC (N consecutive operational failures, driver.max_consecutive_failures) -> HALT LOUD:
#     N different units failing the same way is the environment, not the units.
#   * RESOURCE (free disk below this campaign's floor, from unit_cost.typical_disk_mb) -> HALT LOUD at
#     the loop top: stopping cleanly beats letting a unit write half a save-set onto a full disk.
#
# Liveness (dead-worker detection only; progress is judged by the ledger): the watch loop counts a
# worker alive while its stdout stream produces lines OR results/.run_heartbeat's mtime keeps changing;
# a worker with neither for worker.inactivity_timeout_min is killed. After a worker exits with a fresh
# heartbeat (a detached or backgrounded runner still solving), the
# driver waits up to driver.detached_grace_min for the save-set or heartbeat staleness before judging.
#
# Channels: results/inbox/*.md = INBOUND user notes, relayed verbatim into the next worker/planner
# prompt, then archived (the driver never parses them). results/queue_drop/*.json = append-only proposals
# and declinations from the worker/verifier (the driver merges them at the loop top - see
# _drain_queue_drops). results/ESCALATE.md stays the loud OUTBOUND halt.
# results/diagnostics/supervise_<ts>.log = the append-only decision trace for this launch.
# results/.driver_alive = the running driver's sentinel (the Stop hook stands down while it is fresh).
#
# SINGLE WRITER: the DRIVER is the sole writer of results/queue.json (via _write_queue, atomic os.replace).
# Agents never edit it in place - the worker and verifier drop proposals/declinations into
# results/queue_drop/ and the driver merges them; only the planner authors "next" ordering, and it does
# so fully awaited (no overlap). This removes by construction the read-modify-write race that two
# concurrent writers to one file otherwise create (silent lost updates; a torn read tripping the halt).
#
# results/queue.json:
#   {"next":    [{"config": "configs/exp<NN>_<slug>.json", "rationale": "...", "proposed_by": "...",
#                 "declined": [], "failures": [{"utc","attempt","status","detail"}, ...]}, ...],
#    "shelved": [{"config": "...", "kind": "declined"|"operational", "reasons": [...], "utc": "...",
#                 "failures": [...]}, ...],
#    "accepted_units": 0, "last_accept_utc": null, "units_since_planner": 0,
#    "consecutive_operational_failures": 0}
# Workers may PROPOSE units and DECLINE the head (both via results/queue_drop/, merged by the driver);
# only the planner reorders "next". Two declinations shelve a unit (revivable by the planner) - the loop
# keeps moving, no human halt.
# ======================================================================================================

QUEUE = RESULTS / "queue.json"
ESCALATE = RESULTS / "ESCALATE.md"
LOOPCFG = ROOT / "configs" / "loop.json"
INBOX = RESULTS / "inbox"                    # user notes -> injected into the next spawn, then archived
INBOX_ARCHIVE = INBOX / "archive"
DROP = RESULTS / "queue_drop"                # agent proposals/declinations -> merged into queue.json, then archived
DROP_ARCHIVE = DROP / "archive"
DRIVER_ALIVE = RESULTS / ".driver_alive"     # fresh mtime = a driver owns the loop (Stop hook stands down)
# THE BRIEF - what the driver compiles INTO every worker/planner prompt so the agent orients from the
# prompt, never from the tree. Motivation (photophysics10, three launches, 2026-08): per spawn, workers
# re-read campaign.md 3-9 times in chunks, roles/worker.md up to 5 times, a 2 000-line JOURNAL up to
# 7 times, and the runner's own source up to 15 times, at 30-300 turns per unit - most of a unit's
# tokens went to re-orientation the driver could have delivered once. A pointed-at file is read only
# when the agent chooses (and re-read when it forgets); a delivered one is read exactly once and its
# hash is stamped into the snapshot. Sizes are REPORTED at preflight and every spawn, never silently
# capped: a truncated section is a loud marker in the prompt, and the fix is the journal consolidation.
BRIEF_SECTION_CAP = 24_000      # chars per delivered section before the truncation marker
BRIEF_JOURNAL_CAP = 16_000      # chars: the JOURNAL is working memory, bounded by construction (~120 dense lines)
BRIEF_CELL_CAP = 240            # chars per cell of the ledger projection (a cell is a line, not an essay)
BRIEF_WARN_CHARS = 200_000      # preflight WARNs above this total (~50k tokens per spawn)
BRIEF_RECENT_ROWS = {"worker": 15, "planner": 40}   # ledger rows delivered (the projection)
BRIEF_OMIT_SECTIONS = ("Decision record",)          # campaign.md sections that are a record, not the contract
_LAST_BRIEF: dict = {}          # role -> [(section, chars, truncated)] from the last _brief() - the feed line


def _md_split(text: str) -> list[tuple[str, str]]:
    """A Markdown file as [(heading, body)] on `## ` boundaries; the preamble has heading ''."""
    out, head, buf = [], "", []
    for line in text.splitlines():
        if line.startswith("## "):
            out.append((head, "\n".join(buf).strip()))
            head, buf = line[3:].strip(), []
        else:
            buf.append(line)
    out.append((head, "\n".join(buf).strip()))
    return out


def _clip(text: str, cap: int, where: str) -> tuple[str, bool]:
    if len(text) <= cap:
        return text, False
    return (text[:cap] + f"\n[driver: truncated at {cap} chars - the rest is on disk in {where}. "
            "Bring it under the cap: a delivered document is read every spawn.]"), True


def _tail_rows(body: str, n: int) -> tuple[str, int]:
    """Keep every non-row line (rules, the header, the separator) and only the LAST n table rows of a
    Markdown or TSV table body. Returns the text and the number of rows dropped."""
    lines = body.splitlines()
    is_row = [bool(L.strip()) and not L.startswith("#")
              and ((L.startswith("|") and not set(L.strip()) <= set("|-: ")) or ("\t" in L)) for L in lines]
    rows = [i for i, r in enumerate(is_row) if r]
    header = rows[:1] if rows and not lines[rows[0]].startswith("|") else []   # a TSV header row stays
    keep_rows = set(header) | set(rows[-n:]) if len(rows) - len(header) > n else set(rows)
    kept = [L for i, L in enumerate(lines) if not is_row[i] or i in keep_rows]
    return "\n".join(kept), len(rows) - len(keep_rows)


def _brief(role: str, config: str = "<config path>") -> str:
    """Compile the brief for one spawn: the documents the role must have read, delivered by value."""
    parts, stats = [], []
    n_rows = BRIEF_RECENT_ROWS.get(role, 15)

    def add(title: str, where: str, text: str | None, truncated: bool = False):
        if text is None:
            text = f"[MISSING: {where} not found - report this in the journal; do not guess its content.]"
        parts.append(f"\n\n== {title} ({where}) ==\n{text}")
        stats.append((title, len(text), truncated))

    def read(rel: str) -> str | None:
        try:
            return (ROOT / rel).read_text(encoding="utf-8-sig")
        except OSError:
            return None

    # 1. the campaign definition, minus its append-only record sections (a record, not the contract)
    camp = read("campaign.md")
    if camp is not None:
        kept, omitted = [], []
        for head, body in _md_split(camp):
            if any(head.lower().startswith(o.lower()) for o in BRIEF_OMIT_SECTIONS):
                omitted.append(head)
                continue
            kept.append(body if not head else f"## {head}\n{body}")
        camp = "\n\n".join(k for k in kept if k)
        if omitted:
            camp += ("\n\n[driver: omitted from this brief, on disk in campaign.md: "
                     + " · ".join(f"§{o}" for o in omitted) + " - a record, not the contract]")
    add("CAMPAIGN DEFINITION", "campaign.md", camp)

    # 2. the role file
    add(f"{role.upper()} ROLE", f"roles/{role}.md", read(f"roles/{role}.md"))

    # 3. the JOURNAL, whole: the campaign's working memory (where we stand, live hypotheses, what to try
    #    next and why, traps, open questions), bounded by construction - the worker brings it up to
    #    date each unit; the ledger and the logbook hold the record it used to copy.
    journal, jwhere = read("results/JOURNAL.md"), "results/JOURNAL.md"
    if journal is None:                      # mid-unit: the driver archived and removed it; deliver the archive
        arch = _newest_journal_archive()
        if arch is not None:
            journal, jwhere = read(str(arch.relative_to(ROOT))), str(arch.relative_to(ROOT)).replace("\\", "/")
    if journal is not None:
        journal, t = _clip(journal, BRIEF_JOURNAL_CAP, jwhere)
        add("JOURNAL (the previous unit's - write results/JOURNAL.md anew)", jwhere, journal, t)
    else:
        add("JOURNAL (the previous unit's - write results/JOURNAL.md anew)", "results/JOURNAL.md", None)

    # 4. the worker's unit: its queue entry (rationale, block, hypothesis, failures) + the config itself
    if role == "worker":
        if config and config != "<config path>":
            q = _read_json(QUEUE, {}) or {}
            entry = next((u for u in (q.get("next") or []) if str(u.get("config")) == str(config)), None)
            cfg_text = read(config)
            t = False
            if cfg_text is not None:
                cfg_text, t = _clip(cfg_text, 8_000, config)
            unit = ("queue entry:\n" + (json.dumps(entry, indent=1) if entry else "[driver: not in queue 'next']")
                    + f"\n\nconfig {config}:\n" + (cfg_text if cfg_text is not None else "[MISSING: config file not found]"))
            add("YOUR UNIT", config, unit, t)
        else:
            add("YOUR UNIT", "<config path>", "[preview: the unit's queue entry and config are delivered at spawn]")
        code = read("scripts/experiment.py")
        t = False
        if code is not None:
            code, t = _clip(code, BRIEF_SECTION_CAP, "scripts/experiment.py")
        add("YOUR CODE", "scripts/experiment.py", code, t)

    # 5. the ledger projection: the last rows' narrative columns (what, expected vs found, label, note,
    #    finding) - the one-line timeline; the numeric columns stay on disk, opened by id when needed
    if (ROOT / "results" / "scoreboard.tsv").is_file():
        board, dropped = _ledger_projection(n_rows)
        if dropped:
            board += (f"\n[driver: {dropped} older row(s) not delivered - the full ledger is "
                      "results/scoreboard.tsv; open a row by id]")
        add("LEDGER (last rows)", "results/scoreboard.tsv", board)
    else:
        add("LEDGER (last rows)", "results/scoreboard.tsv", None)

    # 6. planner-only: the queue it reorders, and the literature roadmap where the campaign keeps one
    if role == "planner":
        qtext = read("results/queue.json")
        t = False
        if qtext is not None:
            qtext, t = _clip(qtext, BRIEF_SECTION_CAP, "results/queue.json")
        add("QUEUE", "results/queue.json", qtext, t)
        lit = read("LITERATURE.md")
        if lit is not None:
            lit, t = _clip(lit, BRIEF_SECTION_CAP, "LITERATURE.md")
            add("LITERATURE", "LITERATURE.md", lit, t)

    _LAST_BRIEF[role] = stats
    return "".join(parts)


def _brief_line(role: str) -> str:
    """One feed line: the brief's total and per-section sizes, naming any truncation."""
    stats = _LAST_BRIEF.get(role) or []
    total = sum(n for _, n, _ in stats)
    bits = " · ".join(f"{t.lower()} {n / 1024:.1f}" + (" (TRUNCATED)" if tr else "") for t, n, tr in stats)
    return f"brief[{role}]: {total / 1024:.1f} KB ({bits})"
# Override with e.g. AUTORESEARCH_AGENT_CMD="claude -p" if the CLI lives elsewhere on this machine.
# Quote-aware split, not str.split: a Windows interpreter path like "C:\Program Files\...\python.exe"
# must stay one token when quoted, or a naive split breaks every such setup at spawn time.
def _parse_agent_cmd(s: str) -> list[str]:
    import shlex
    return [t.strip('"') for t in shlex.split(s, posix=False)]


AGENT_CMD = _parse_agent_cmd(os.environ.get("AUTORESEARCH_AGENT_CMD") or "claude -p")
STREAM_FLAGS = ["--output-format", "stream-json", "--verbose"]   # only added per driver.stream policy
_AGENT_BACKEND = None
_LAST_CODEX_OBSERVER = None


def _permission_flags(mode: str) -> list[str]:
    """`--permission-mode <mode>` for spawned worker/planner agents (default 'auto' - see _driver_knobs).
    Passed ONLY to the default claude CLI: a custom AUTORESEARCH_AGENT_CMD (e.g. the test stub) is handed
    no permission flag it may not understand. An empty mode disables the flag entirely."""
    if not mode or "AUTORESEARCH_AGENT_CMD" in os.environ:
        return []
    return ["--permission-mode", mode]


SPAWN_LISTING_SETTINGS = '{"skillListingBudgetFraction":0.0001}'


def _listing_flags(mode: str) -> list[str]:
    """`--settings` that lists every skill by NAME ONLY inside a spawn (driver.skill_listing, default
    'names'; 'full' keeps the harness's own listing; env override AUTORESEARCH_SKILL_LISTING). The
    campaign's files name the skill to use, and the descriptions cost about 7k tokens of every turn on
    a 1M-context model (the harness lists skills under a budget of 1 % of the context window; this
    drives it to ~0). It hides EVERY installed plugin's descriptions inside the spawn, not only
    physkit's - a campaign that wants a third-party skill names it, or sets 'full'. Passed ONLY to the
    default claude CLI, like the permission flag. `--settings` merges on top of the campaign's own
    .claude/settings.json, so the hooks (the promotion guard, the heartbeat) still run; an interactive
    session opened in the campaign directory is untouched."""
    if (mode or "names").strip().lower() == "full" or "AUTORESEARCH_AGENT_CMD" in os.environ:
        return []
    return ["--settings", SPAWN_LISTING_SETTINGS]

WORKER_PROMPT = """You are the iteration worker for the autoresearch campaign in this directory.
Your assignment is ONE unit: {config}. CLAUDE.md auto-loads on top of this prompt. Everything else you
need to orient is compiled INTO this prompt by the driver, below: campaign.md (the campaign definition -
mission, the FROZEN metric, the levers, the caps, promotion), roles/worker.md ('The Experiment Loop' -
you execute the loop steps for this single unit; and 'The iteration contract' - what you must persist
before you finish, the ledger is the loop's only memory; work you do not record did not happen), the
project's standing constraints, the JOURNAL (the campaign's working memory), your unit's queue entry and
config, the ledger's last rows, and your code - scripts/experiment.py, the five hooks and the seams, the one script
you edit (scripts/run_campaign.py is the kit's machinery: not yours to read or edit). Orient from the
brief, never from the tree: do not re-read those files, and do not read ../../PROJECT.md below its
constraints, the logbook, another campaign, or any script's source to learn what this prompt already
says. The reads a unit makes outside the brief, and the only ones: (a) the result CARD the runner
prints at the end of your run (`--card <exp>` prints it again) - never rebuild it from the artifacts
with one-liners; (b) results/checks_<NN>.json for YOUR unit, only when a card line is not enough;
(c) ../../PROJECT.md below §Standing constraints only when a result needs physics the brief does not
carry; (d) `python scripts/run_campaign.py --help` for a flag; (e) `--show <exp>` for one old logbook
entry. Never open the logbook or the scoreboard to read or to write: the runner writes both, and the
record you owe goes through `--record`.
THE RECORD YOU OWE per unit, and its size: a one-sentence prediction rationale (the number and its one
basis); the config's `_levers` list plus a one-line `_comment` and `_hypothesis`; after the run, the
the WHOLE record as ONE file and ONE command: write results/record_<NN>.json with the Write tool -
{{"self_check": {{"ran": ["name=pass|fail|skip:detail", ...], "changes": ["what=>expected=>observed", ...],
"estimate": X, "note": "..."}}, "analysis": "<one paragraph: every failed check answered by name, then what
