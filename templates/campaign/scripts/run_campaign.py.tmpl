class _Tee:
    """Mirror stdout to a per-run log so a result never lives only in the console."""

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "w", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):  # noqa: D401
        self._stdout.write(s)
        self._log.write(s)

    def flush(self):
        self._stdout.flush()
        self._log.flush()


def _utc_stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def load_config(path: Path) -> dict:
    """Load and lightly validate an experiment config (the reproducible record)."""
    cfg = json.loads(Path(path).read_text(encoding="utf-8"))
    assert "exp_name" in cfg, "config is missing 'exp_name'"
    return cfg


def snapshot_experiment(cfg: dict, config_path: Path | None = None) -> Path:
    """Preserve everything needed to reproduce this experiment even after the code/config later change.

    BASELINE requirement, every experiment (see docs/protocols/artifacts.md): copy the mutable code
    (scripts/) and the config into results/snapshots/<exp_name>/, plus a manifest with the command line
    and key library versions. A shared script edited later would otherwise make this experiment
    irreproducible.
    """
    dst = SNAPSHOTS / cfg["exp_name"]
    dst.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / "scripts", dst / "scripts",
                    ignore=shutil.ignore_patterns("__pycache__"), dirs_exist_ok=True)
    if config_path is not None:
        shutil.copy2(config_path, dst / "config.json")
    else:
        (dst / "config.json").write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    (dst / "manifest.txt").write_text(
        f"argv: {' '.join(sys.argv)}\npython: {sys.version.split()[0]}\nnumpy: {np.__version__}\n"
        f"core_hash: {frozen_core.core_hash(ROOT)}\n"   # WHICH FROZEN/core code this experiment ran against (EH-8)
        f"utc: {_utc_stamp()}\n",
        encoding="utf-8",
    )
    return dst


def check_prediction_gate(cfg: dict) -> dict:
    """SPEND GATE: refuse to run without a falsifiable a-priori prediction written BEFORE the solve.

    predictions/<exp_name>.json must exist and contain:
        {"exp_name": "...", "predicted": {"low": <num>, "high": <num>}, "rationale": "<why, from units /
         physical bounds / prior runs>"}
    The prediction is the control on your bias (charter loop step 1); a result landing OUTSIDE [low, high]
    is a red flag the analysis must explain before moving on. Violations refuse loudly. An unexpected
    internal error warns and proceeds (fail-open, per the promote-path-only fail-closed rule) - but a
    MISSING file is a violation, never an internal error.
    """
    p = PREDICTIONS / f"{cfg['exp_name']}.json"
    if not p.is_file():
        sys.exit(
            f"PREDICTION GATE: {p} not found. Write the a-priori prediction BEFORE the run:\n"
            '  {"exp_name": "%s", "predicted": {"low": <num>, "high": <num>}, "rationale": "<why>"}\n'
            "A solve without a written prediction is a fishing trip (docs/charter.md, loop step 1)."
            % cfg["exp_name"]
        )
    try:
        pred = json.loads(p.read_text(encoding="utf-8"))
        lo, hi = float(pred["predicted"]["low"]), float(pred["predicted"]["high"])
        falsifiable = np.isfinite(lo) and np.isfinite(hi) and lo < hi and str(pred.get("rationale", "")).strip()
    except Exception as exc:
        sys.exit(f"PREDICTION GATE: {p} is malformed ({exc}). It must carry a numeric "
                 '{"predicted": {"low": ..., "high": ...}} range and a non-empty "rationale".')
    if not falsifiable:
        sys.exit(f"PREDICTION GATE: {p} is not falsifiable - require finite low < high and a rationale. "
                 "An unbounded or empty prediction gates nothing.")
    print(f"prediction gate OK: {{PRIMARY_METRIC}} in [{lo:g}, {hi:g}] - {pred.get('rationale', '')[:100]}")
    return pred


def assert_save_set(exp_id: str, label: str, fig: Path) -> None:
    """RECORD GATE (hard gate 4 as code): refuse the scoreboard row until the full save-set exists.

    A result is not "saved" until result_<NN>.json, its figure, AND its snapshot are on disk - a row
    appended without them is a number with no record behind it. This also means save_figure() must
    actually write the figure before the first experiment can be recorded - implement it, don't stub it.
    """
    missing = [str(p) for p in (RESULTS / f"result_{exp_id}.json", fig, SNAPSHOTS / label)
               if not p.exists()]
    if missing:
        sys.exit("SAVE-SET GATE: refusing the scoreboard row - missing artifacts:\n  "
                 + "\n  ".join(missing)
                 + "\nWrite them first (result JSON + figure + snapshot); see docs/protocols/artifacts.md.")


