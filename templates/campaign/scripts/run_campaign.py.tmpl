class _Tee:
    """Mirror stdout to a per-run log so a result never lives only in the console."""

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "w", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):  # noqa: D401
        self._stdout.write(s)
        try:
            self._stdout.flush()     # flush per write: a killed or hung solve never exits, so a
        except Exception:            # buffered tee'd log would be empty for exactly the run that needs it
            pass
        try:
            self._log.write(s)
            self._log.flush()
        except Exception:
            pass                     # the console wins; a full disk must not kill the run

    def flush(self):
        self._stdout.flush()
        try:
            self._log.flush()
        except Exception:
            pass


class DriverLog:
    """Append-mode tee for the DRIVER process (supervisor mode) - one file per --supervise launch:
    results/diagnostics/supervise_<UTCstamp>.log. Every driver decision and rendered worker-feed line
    lands in both the console and the log. Doctrine: log every scheduling decision to an append-only run
    log as it is made - post-hoc diagnosis of an unattended system is impossible without the decision
    trace (the physkit plugin's docs/reference/hardware-in-the-loop.md, "Monitor the science").
    Distinct from _Tee above, which is the per-EXPERIMENT runner log (mode "w", one per run).
    """

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "a", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):
        self._stdout.write(s)
        # FLUSH PER WRITE. --supervise is normally launched backgrounded, so stdout is a pipe (block-
        # buffered, not line-buffered as it is on a TTY) and the log file was never line-buffered. Without
        # this, the driver's decision trace stays empty for the whole life of a running loop - and the
        # worst case, an unattended run that HANGS, never exits to flush, so the one trace that most needs
        # reading is 0 bytes. print() never passes flush=True, so the flush must live here.
        try:
            self._stdout.flush()
        except Exception:
            pass
        try:
            self._log.write(s)
            self._log.flush()
        except Exception:
            pass  # the console wins; a full disk must not kill the loop

    def flush(self):
        self._stdout.flush()
        try:
            self._log.flush()
        except Exception:
            pass

    def close(self):
        try:
            self._log.close()
        except Exception:
            pass
        return self._stdout


def _make_console_lenient() -> None:
    """Never let an unencodable CHARACTER end a run.

    The driver relays a live agent's output to this console. That output is arbitrary text written by a
    model, and on a stock Windows console (cp1252) a single checkmark, arrow, curly quote or emoji makes
    print() raise UnicodeEncodeError -- from the watch loop, mid-unit, killing an overnight loop over a
    decoration. The subprocess pipe already reads with errors="replace"; this extends the same tolerance
    to the write side, so an unencodable glyph degrades to "?" instead of ending the campaign.

    Deliberately NOT a switch to UTF-8: that would fix the exception and produce mojibake in a console
    that cannot render it. Replacement is honest about what the terminal can show. The driver's own log
    file is opened utf-8 separately, so the full text is still preserved on disk.
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")     # py3.7+; no-op if already lenient
        except Exception:
            pass                                     # a redirected/wrapped stream may not support it


def _utc_stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


# ---- runner liveness heartbeat (dead-worker detection only) --------------------------------------------
# The runner touches results/.run_heartbeat at stage transitions (and every HB_TICK_S during the solve).
# The supervisor driver reads only the file's mtime-change, never the stage, to tell a live solve from a
# dead worker; PROGRESS is judged by the ledger, never by this file (CORE: monitor progress, not liveness).
# Written unconditionally (supervised or not): an interactive run leaves the same trace, at no cost.

HEARTBEAT = RESULTS / ".run_heartbeat"
HB_TICK_S = 60


def _beat(stage: str) -> None:
    """Touch the heartbeat file. Never raises - a liveness bug must never fail a run."""
    try:
        HEARTBEAT.parent.mkdir(parents=True, exist_ok=True)
        HEARTBEAT.write_text(json.dumps({"stage": stage, "utc": _utc_stamp(), "pid": os.getpid()}),
                             encoding="utf-8")
    except Exception:
        pass


class _HeartbeatTicker:
    """Daemon thread beating every HB_TICK_S while a solve is in flight, so a 2 h run_experiment()
    doesn't look dead between stage transitions."""

    def __init__(self):
        self._stop = threading.Event()
        self._thread = None

    def start(self, stage: str = "solve") -> None:
        def _tick():
            while not self._stop.wait(HB_TICK_S):
                _beat(stage)
        try:
            self._stop.clear()
            self._thread = threading.Thread(target=_tick, daemon=True)
            self._thread.start()
        except Exception:
            pass

    def stop(self) -> None:
        try:
            self._stop.set()
        except Exception:
            pass


def load_config(path: Path) -> dict:
    """Load and lightly validate an experiment config (the reproducible record)."""
    cfg = json.loads(Path(path).read_text(encoding="utf-8"))
    assert "exp_name" in cfg, "config is missing 'exp_name'"
    return cfg


def snapshot_experiment(cfg: dict, config_path: Path | None = None, props: dict | None = None) -> Path:
    """Preserve everything needed to reproduce this experiment even after the code/config later change.

    BASELINE requirement, every experiment (see roles/worker.md, 'The save-set'): copy the mutable code
    (scripts/) and the config into results/snapshots/<exp_name>/, plus a manifest with the command line
    and key library versions. A shared script edited later would otherwise make this experiment
    irreproducible.
    """
    dst = SNAPSHOTS / cfg["exp_name"]
    dst.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / "scripts", dst / "scripts",
                    ignore=shutil.ignore_patterns("__pycache__"), dirs_exist_ok=True)
    if config_path is not None:
        shutil.copy2(config_path, dst / "config.json")
    else:
        (dst / "config.json").write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    props = props or {}
    # The campaign PROPERTIES this experiment ran under. configs/loop.json is user-owned and hot-reloaded
    # mid-run, so the config alone cannot answer "what was this scored against?" for a PAST experiment -
    # stamping them here makes a mid-campaign flip visible in the frozen record instead of only in a
    # mutable file, which is the same reason core_hash is stamped beside them.
    prop_lines = "".join(f"{k}: {props.get(k)}\n" for k in
                         ("noise_model", "noise_floor", "tolerance",
                          "metric_version", "data_version", "metric_revision") if k in props)
    vr = _verify_rows(_read_json(LOOPCFG, {}) or {})
    prop_lines += f"verify_preset: {vr['preset'] or vr['source']}\n"   # how much verification this ran under
    # The delivered context (the project overview's Standing constraints + the landmines table) is a
    # LIVING document pulled into every spawned prompt, so two experiments in one campaign can run
    # under different constraints. Hashing the assembled worker prompt here answers "what did this
    # experiment run under" from the frozen record. Recomputed at snapshot time (inbox notes, which
    # vary per spawn and steer rather than constrain, are not part of the hash).
    # The driver exports the hash of the prompt it DELIVERED (the brief carries the journal window,
    # which the worker edits mid-unit, so a rebuild here would hash a different text); an attended
    # run has no driver and rebuilds it.
    spawn_hash = os.environ.get("PHYSKIT_SPAWN_PROMPT_SHA256", "").strip()
    if not spawn_hash:
        spawn_prompt = build_prompt("worker")
        spawn_hash = _hashlib.sha256((_codex_backend.adapt_prompt(spawn_prompt) if os.environ.get("AUTORESEARCH_ACTIVE_BACKEND") == "codex" else spawn_prompt).encode("utf-8")).hexdigest()
    (dst / "manifest.txt").write_text(
        f"argv: {' '.join(sys.argv)}\npython: {sys.version.split()[0]}\nnumpy: {np.__version__}\n"
        f"core_hash: {frozen_core.core_hash(ROOT)}\n"   # WHICH FROZEN/core code this experiment ran against
        f"kit_version: {KIT_VERSION}\n"   # WHICH kit machinery (run_campaign.py is kit-owned, not core-hashed)
        f"spawn_prompt_sha256: {spawn_hash}\n"
        f"utc: {_utc_stamp()}\n" + prop_lines,
        encoding="utf-8",
    )
    return dst


def check_deliverable_gate(cfg: dict) -> str | None:
    """SPEND GATE for a ZERO-EVALUATION unit (its config `mode` is in experiment.py's
    ZERO_EVALUATION_MODES): refuse to run unless the config names, in `_deliverable`, what will exist on
    disk afterwards that does not exist now. A unit that records no number still owes a commitment it
    can be held to; results/checks_<NN>.json records it under `deliverable_named`. A scored unit passes
    through - its sanity check is the plausible range, judged after the run (check_plausible_range).

    FAIL-CLOSED: a missing or empty `_deliverable` refuses, because the run would spend effort with
    nothing named to judge it against.
    """
    if not _zero_evaluation(cfg):
        return None
    deliverable = str(cfg.get("_deliverable") or "").strip()
    if not deliverable:
        sys.exit(f"DELIVERABLE GATE: {cfg['exp_name']} is a ZERO-EVALUATION unit (mode={cfg.get('mode')!r} "
                 "is in experiment.py's ZERO_EVALUATION_MODES), so its config must carry "
                 "\"_deliverable\": \"<what will exist on disk afterwards that does not exist now>\". "
                 "Add it BEFORE the run; a unit that records no number is held to what it named.")
    print(f"deliverable gate OK: {deliverable[:140]}")
    return deliverable


def exp_id_for(label: str) -> str:
    """The <NN> in result_<NN>.json / checks_<NN>.json / the scoreboard row, derived from exp_name.

    ONE parser, because this rule was written out twice (here and in the driver's _unit_saved) and two
    copies of a naming rule drift into two different answers about which file a unit should have left.

    Returns "" when no id can be derived. That case used to fall back to "000" -- so an exp_name like
    `exp_foo` (an underscore straight after `exp`) silently claimed the BASELINE's id and overwrote
    results/result_000.json. Callers decide what to do about "": the runner refuses before scoring, the
    driver reports the unit unsaved.
    """
    head = str(label).split("_", 1)[0]
    raw = head[3:] if head.startswith("exp") else head
    if not raw:
        return ""
    return raw.zfill(3) if raw.isdigit() else raw


def assert_save_set(exp_id: str, label: str, fig: Path) -> None:
    """RECORD GATE (hard gate 4 as code): refuse the scoreboard row until the full save-set exists.

    A result is not "saved" until result_<NN>.json, its figure, AND its snapshot are on disk - a row
    appended without them is a number with no record behind it. This also means save_figure() must
    actually write the figure before the first experiment can be recorded - implement it, don't stub it.
    """
    missing = [str(p) for p in (RESULTS / f"result_{exp_id}.json", fig, SNAPSHOTS / label)
               if not p.exists()]
    if missing:
        sys.exit("SAVE-SET GATE: refusing the scoreboard row - missing artifacts:\n  "
                 + "\n  ".join(missing)
                 + "\nWrite them first (result JSON + figure + snapshot); see roles/worker.md, 'The save-set'.")


# ---- the campaign's own code: scripts/experiment.py -------------------------------------------------
# The five experiment hooks (validate_method / run_experiment / load_target / guardrail / save_figure)
# and the optional seams (residual / campaign_scoreboard_fields / campaign_result_fields /
# campaign_checks / campaign_card_fields / campaign_comparand / baseline_config; the
# ZERO_EVALUATION_MODES constant)
# live in scripts/experiment.py - the one script a campaign edits. THIS file is the kit's machinery:
# gates, checks, the snapshot, the driver, the prompts - replaced wholesale on a kit upgrade and never
# edited per campaign. Motivation (a colleague's audit, 2026-09): with the hooks inside this file it was
# Read 64 times in one campaign, and every worker wrote a bespoke module rather than find them. The
# import is deferred to first use so `--help` / `--show-prompt` work while experiment.py is mid-edit,
# and preflight names an import error instead of a traceback.
_EXPERIMENT = None


def _exp():
    """The campaign's experiment module (scripts/experiment.py), imported once, on first use."""
    global _EXPERIMENT
    if _EXPERIMENT is None:
        import experiment
        _EXPERIMENT = experiment
    return _EXPERIMENT


def _seam(name: str, default):
    """An OPTIONAL function in experiment.py: the campaign's, if it defines one, else `default`."""
    fn = getattr(_exp(), name, None)
    return fn if callable(fn) else default


def _seam_call(name: str, default, *args, **optional):
    """Call a seam with `args` plus whichever of `optional` its signature accepts, so a seam can gain a
    keyword (`prediction`, the run_experiment payload) without every campaign's older definition
    breaking: a three-argument campaign_scoreboard_fields keeps working, a four-argument one sees the
    payload."""
    fn = _seam(name, default)
    try:
        params = inspect.signature(fn).parameters
    except (TypeError, ValueError):
        return fn(*args)
    if any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params.values()):
        return fn(*args, **optional)
    return fn(*args, **{k: v for k, v in optional.items() if k in params})


def _zero_evaluation(cfg: dict) -> bool:
    """Does this unit record NO score? True when the config's `mode` is one the campaign lists in
    experiment.py's ZERO_EVALUATION_MODES - a unit whose deliverable is a decision-record entry, a
    documented procedure, a corrected threshold, not a number. Its primary metric is null on disk
    (never 0), the deliverable gate asks its config for a `_deliverable`, every numeric check reports `unavailable`,
    and the row is never a comparand. The campaign's validate_method guards the mode: a real experiment
    wearing its name would skip the save-set, which is the hole this must not open."""
    modes = getattr(_exp(), "ZERO_EVALUATION_MODES", None) or ()
    return str(cfg.get("mode") or "") in {str(m) for m in modes}


def _json_default(o):
    """json.dumps fallback for the campaign's own result keys (campaign_result_fields): numpy scalars
    and arrays, paths and sets become plain JSON; anything else its string, never a lost record."""
    if isinstance(o, np.generic):
        return o.item()
    if isinstance(o, np.ndarray):
        return o.tolist()
    if isinstance(o, (set, frozenset)):
        return sorted(o, key=str)
    return str(o)


def scoreboard_exp_ids() -> set:
    """Every exp_id already on the scoreboard. Cheap, and the ledger is the authority on what has run."""
    ids = set()
    header_seen = False
    for line in SCOREBOARD.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line or line.startswith("#"):
            continue
        if not header_seen:                      # the first non-comment line is the header
            header_seen = True
            continue
        ids.add(line.split("\t", 1)[0].strip())
    return ids


def append_scoreboard_row(row: dict) -> None:
    """Append ONE tab-separated row to results/scoreboard.tsv, in the header's column order.

    Append-only; never delete or rename a column mid-campaign. A column missing from `row` is written
    blank rather than shifting the schema.

    ONE ROW PER exp_id, enforced here. Re-running a config whose row already exists appended a second
    one; because the ledger is append-only, nothing downstream could remove the duplicate, so it was
    permanent. The only remaining cleanup was to edit the append-only file, which the ledger's own rule
    forbids. The runner must not produce a state whose only repair breaks a rule.

    A genuine re-run wants a NEW exp_id: a second row under the same id claims two different numbers
    are the same experiment, and if the code changed between them, the comparability tags cannot say so.
    """
    exp_id = str(row.get("exp_id", "")).strip()
    if exp_id and exp_id in scoreboard_exp_ids():
        print(f"LEDGER: results/scoreboard.tsv already has a row for exp_id {exp_id} - NOT appending a "
              "second one. The scoreboard is append-only, so a duplicate here would be permanent.\n"
              "  If this is a retry, the earlier row is the record and nothing is lost (the row is "
              "written last, behind the save-set gate, so a row means the artifacts existed).\n"
              "  If you are deliberately re-running with changed code or data, give it a NEW exp_name - "
              "two rows under one id claim that two different numbers are the same experiment.\n"
              "  Do NOT hand-edit the scoreboard to resolve this.")
        return
    header_line = None
    for line in SCOREBOARD.read_text(encoding="utf-8").splitlines():
        if line and not line.startswith("#"):
            header_line = line
            break
    assert header_line, "scoreboard.tsv has no header row"
    cols = header_line.split("\t")
    # Matched CASE-INSENSITIVELY: the runner keys the primary metric by the frozen scorer's spelling
    # and a campaign's header may declare the column in another case (photophysics10: WSSR_PAPER
    # against wssr_paper). An exact match wrote the PRIMARY column blank on every row - a ledger that
    # recorded no score at all, with no error (the campaign's own ledger_writer check caught it).
    lowered = {str(k).lower(): v for k, v in row.items()}
    with open(SCOREBOARD, "a", encoding="utf-8") as f:
        f.write("\t".join(str(row[c] if c in row else lowered.get(c.lower(), "")) for c in cols) + "\n")


def _plausible_cell(score, cfg: dict) -> str:
    """One judgement, three readers: the checks artifact (`plausible_range`, or `deliverable_named` for a
    zero-evaluation unit), the logbook line and the ledger cell all carry this string, computed once from
    the same inputs so they can never disagree."""
    try:
        if score is None:
            pc = check_deliverable(cfg)
            tag = {"pass": "named - "}
        else:
            pc = check_plausible_range(score)
            tag = {"pass": "inside - "}
        tag.update({"fail": "FLAGGED - ", "unavailable": "no range - "})
        return tag.get(pc.get("status"), "") + str(pc.get("detail", ""))
    except Exception as exc:                        # the narrative must never cost the experiment
        return f"(not computed: {type(exc).__name__}: {exc})"


def append_logbook(cfg: dict, exp_id: str, label: str, score: float, diags: dict,
                   plausible: str | None = None) -> None:
    """Append this experiment's entry to the append-only logbook (results/logbook.md).

    The FACTS are filled automatically: metric, guardrail, artifact paths, the hypothesis and the levers
    from the config, the plausible-range judgement (the SAME one results/checks_<NN>.json records,
    computed from the same inputs so the two never disagree), and a Verification line that starts
    `pending` and is raised by the artifacts (the self-check, then the verdict stamp). The agent owes two
    slots afterward: Analysis and NEXT. Append-only: this never edits or reads the rest of the file.
    """
    props = _campaign_props()
    # The epoch label travels with the narrative too: the row's metric_version is what this result
    # means, and a later reader of the logbook must not have to cross-reference the scoreboard for it.
    mv = str(props.get("metric_version") or "")
    # One judgement, two readers: the checks artifact for machines, this line for the narrative.
    if plausible is None:
        plausible = _plausible_cell(score, cfg)
    shown = "none (a zero-evaluation unit: no score is recorded)" if score is None else f"{score:.4f}"
    levers = cfg.get("_levers")
    levers_line = (", ".join(str(x) for x in levers) if isinstance(levers, list) and levers
                   else "(none declared - list the levers this config moves in the config's _levers)")
    # One bold-labelled field per line, as a Markdown bullet list, so fields render on separate lines
    # (a single newline renders as a space in Markdown, which would collapse them into one paragraph).
    entry = (
        f"\n## {exp_id} - {label} - {_utc_stamp()}\n"
        f"- **Hypothesis**: {cfg.get('_hypothesis', '(set _hypothesis in the config)')}\n"
        f"- **Levers**: {levers_line}\n"
        f"- **Change**: {cfg.get('_comment', '')}\n"
        f"- **Result**: {{PRIMARY_METRIC}} = {shown}; {{GUARDRAIL_METRIC}} = {diags}"
        + (f" (metric epoch {mv})" if mv else "") + "\n"
        f"- **Plausible range**: {plausible}\n"
        f"- **Analysis**: \n"
        f"- **Verification**: pending - label unverified (results/checks_{exp_id}.json)\n"
        f"- **Excluded data**: none\n"
        f"- **Disputes & responses**: \n"
        f"- **Status**: open\n"
        f"- **Artifacts**: results/result_{exp_id}.json . results/checks_{exp_id}.json . "
        f"results/images/{label}_* . results/snapshots/{label}/\n"
        f"- **NEXT**: \n"
    )
    if f"## {exp_id} - {label} " in LOGBOOK.read_text(encoding="utf-8", errors="replace"):
        print(f"LEDGER: results/logbook.md already has an entry for {exp_id} - {label} - NOT appending a "
              "second one. Complete the existing entry's narrative slots instead of starting a new one.")
        return
    with open(LOGBOOK, "a", encoding="utf-8") as f:
        f.write(entry)


def _logbook_field(text: str, exp_id: str, field: str) -> str | None:
    """The value of one bold-labelled field in the entry headed `## <exp_id> - ...`, or None when the
    entry or the field is absent (an entry written before the field existed is not judged on it)."""
    head, key, in_section = f"## {exp_id} - ", f"- **{field}**:", False
    for line in text.splitlines():
        if line.startswith("## "):
            in_section = line.startswith(head)
            continue
        if in_section and line.startswith(key):
            return line[len(key):].strip()
    return None


def _set_logbook_field(exp: str, field: str, text: str, only_if_prefix: tuple | None = ("",)) -> bool:
    """Set one bold-labelled field of the entry headed `## <id> - ...` for `exp` (a stem or an id) - and
    only while its present value starts with one of `only_if_prefix`, so a runner-owned line
    (Verification: pending -> self-checked -> <verdict>) is raised by the artifacts and never overwrites
    what a verifier or the agent wrote by hand. `only_if_prefix=None` sets the line unconditionally (the
    worker's own slots through --record, which re-run replaces). Every byte outside that one line is
    preserved, newline style included. Returns whether a line changed."""
    eid = exp_id_for(exp)
    if not eid or not LOGBOOK.is_file():
        return False
    try:
        with open(LOGBOOK, encoding="utf-8", errors="replace", newline="") as f:
            lines = f.read().splitlines(keepends=True)
    except OSError:
        return False
    head, key, in_section = f"## {eid} - ", f"- **{field}**:", False
    for i, line in enumerate(lines):
        if line.startswith("## "):
            in_section = line.startswith(head)
            continue
        if in_section and line.startswith(key):
            current = line[len(key):].strip()
            # "" in only_if_prefix means "a blank line may be set" - never "anything matches".
            if only_if_prefix is not None and not any(
                    (current == "") if pfx == "" else current.startswith(pfx) for pfx in only_if_prefix):
                return False
            nl = "\r\n" if line.endswith("\r\n") else ("\n" if line.endswith("\n") else "")
            lines[i] = f"{key} {text}{nl}"
            try:
                with open(LOGBOOK, "w", encoding="utf-8", newline="") as f:
                    f.write("".join(lines))
            except OSError:
                return False
            return True
    return False


def _scoreboard_lines() -> tuple[list[str], int, list[str]]:
    """(the ledger's lines with their endings, the header's index, the header's columns)."""
    with open(SCOREBOARD, encoding="utf-8", errors="replace", newline="") as f:
        lines = f.read().splitlines(keepends=True)
    for i, L in enumerate(lines):
        if L.strip() and not L.startswith("#"):
            return lines, i, L.rstrip("\r\n").split("\t")
    raise ValueError("scoreboard.tsv has no header row")


def _column(cols: list, names: tuple) -> str | None:
    """The header column for the first of `names` present, matched case-insensitively (a field ledger
    spells its metric column in lower case while the result JSON key is upper case)."""
    for n in names:
        for c in cols:
            if c.lower() == str(n).lower():
                return c
    return None


def _set_scoreboard_cell(exp_id: str, names: tuple, text: str) -> str:
    """Set ONE cell of the row for `exp_id`: the column is the first of `names` the header has (the
    current spelling first, an older one second). The ledger is append-only in ROWS; a narrative cell
    the runner owns (note, finding, verified) is stamped in place with every other byte preserved.
    Returns the column written, or "" after printing why not."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError) as exc:
        print(f"ledger: cannot read results/scoreboard.tsv ({exc})")
        return ""
    col = _column(cols, names)
    if col is None:
        print(f"ledger: results/scoreboard.tsv has no {' / '.join(names)} column - the header predates this "
              "kit; `upgrade_campaign.py --ledger-columns` adds it (the cell was NOT written)")
        return ""
    ci = cols.index(col)
    cell = " ".join(str(text).replace("\t", " ").split())
    for i in range(hi + 1, len(lines)):
        L = lines[i]
        if L.startswith("#") or not L.strip():
            continue
        cells = L.rstrip("\r\n").split("\t")
        if cells[0].strip() != exp_id:
            continue
        nl = "\r\n" if L.endswith("\r\n") else ("\n" if L.endswith("\n") else "")
        while len(cells) < len(cols):
            cells.append("")
        cells[ci] = cell
        lines[i] = "\t".join(cells) + nl
        with open(SCOREBOARD, "w", encoding="utf-8", newline="") as f:
            f.write("".join(lines))
        return col
    print(f"ledger: no scoreboard row for exp_id {exp_id} - the run writes the row; record the experiment first")
    return ""


def _scoreboard_cell(exp_id: str, names: tuple) -> str | None:
    """The current text of one narrative cell, or None when the column or the row is absent."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError):
        return None
    col = _column(cols, names)
    if col is None:
        return None
    ci = cols.index(col)
    for L in lines[hi + 1:]:
        if L.startswith("#") or not L.strip():
            continue
        cells = L.rstrip("\r\n").split("\t")
        if cells[0].strip() == exp_id:
            return cells[ci] if ci < len(cells) else ""
    return None


# The ledger's narrative columns, in the order the brief shows them; the second name is the older spelling.
_PROJECTION_COLS = (("exp_id",), ("tier",), ("{{PRIMARY_METRIC}}", "{{PRIMARY_METRIC_COL}}"),
                    ("what", "description"), ("plausible", "expected_vs_found"), ("verified",), ("note", "notes"),
                    ("finding",))


def _ledger_projection(n_rows: int) -> tuple[str, int]:
    """The ledger's last n rows as a Markdown table of its NARRATIVE columns - id, tier, the primary
    metric, what, plausible, label, note, finding - every cell clipped at BRIEF_CELL_CAP. This is
    the one-line-per-experiment timeline; the numeric columns stay on disk and a reader who needs them
    opens the row by id. Returns (text, rows dropped)."""
    try:
        lines, hi, cols = _scoreboard_lines()
    except (OSError, ValueError):
        return "[MISSING: results/scoreboard.tsv has no header row]", 0
    picks = [(names[0], _column(cols, names)) for names in _PROJECTION_COLS]
    picks = [(t, c) for t, c in picks if c]
    rows = [L.rstrip("\r\n").split("\t") for L in lines[hi + 1:] if L.strip() and not L.startswith("#")]
    dropped = max(0, len(rows) - n_rows) if n_rows > 0 else 0
    rows = rows[-n_rows:] if n_rows > 0 else rows

    def cell(r: list, col: str) -> str:
        ci = cols.index(col)
        v = " ".join((r[ci] if ci < len(r) else "").split()).replace("|", "/")
        return v if len(v) <= BRIEF_CELL_CAP else v[:BRIEF_CELL_CAP] + "..."
    out = ["| " + " | ".join(t for t, _ in picks) + " |", "|" + "---|" * len(picks)]
    out += ["| " + " | ".join(cell(r, c) for _, c in picks) + " |" for r in rows]
    return "\n".join(out), dropped


def _archive_journal(clear: bool = False) -> Path | None:
    """Copy results/JOURNAL.md into results/journal_archive/ before a spawn: the reasoning history the
    rolling document would otherwise overwrite (skipped when the newest copy already matches). With
    `clear`, the working file is then REMOVED: the brief (built first) carries the previous JOURNAL, and
    the worker writes the new one as a fresh file - one Write, no read-before-write, no splice."""
    if not JOURNAL.is_file():
        return None
    try:
        text = JOURNAL.read_bytes()
        JOURNAL_ARCHIVE.mkdir(parents=True, exist_ok=True)
        prev = sorted(JOURNAL_ARCHIVE.glob("journal_*.md"))
        dst = prev[-1] if prev and prev[-1].read_bytes() == text else JOURNAL_ARCHIVE / f"journal_{_utc_stamp()}.md"
        if dst not in prev:
            dst.write_bytes(text)
        if clear:
            JOURNAL.unlink()
        return dst
    except OSError:
        return None


def _newest_journal_archive() -> Path | None:
    prev = sorted(JOURNAL_ARCHIVE.glob("journal_*.md")) if JOURNAL_ARCHIVE.is_dir() else []
    return prev[-1] if prev else None


def _restore_journal() -> bool:
    """No new JOURNAL after a spawn: put the archived one back so the campaign keeps its working memory
    (the unit is still incomplete - the gate named the missing file)."""
    if JOURNAL.is_file():
        return False
    src = _newest_journal_archive()
    if src is None:
        return False
    try:
        JOURNAL.write_bytes(src.read_bytes())
        return True
    except OSError:
        return False


def _journal_updated_since(ts: float) -> bool:
    """Whether results/JOURNAL.md was written after `ts` (the spawn's start) and carries its NEXT line -
    the record is owed like the save-set: a unit that left no new working memory did not report."""
    try:
        if JOURNAL.stat().st_mtime < ts - 1.0:
            return False
        return "**NEXT:**" in JOURNAL.read_text(encoding="utf-8-sig", errors="replace")
    except OSError:
        return False


# ---- mechanical checks (results/checks_<NN>.json) -----------------------------------------------------
# Every experiment gets one machine-readable verdict file, written with no agent involved. Its job is to
# stop the runner discarding what it already knows: a score outside the plausible range prints a RED FLAG,
# and without this artifact nothing downstream reads it.
#
# Three-valued on purpose. `pass` and `fail` are judgements; `unavailable` means this campaign has not
# supplied what the check needs, and it carries a `needs` string naming what would supply it. A check
# that cannot run must report `unavailable`. Reporting `pass` for an unrunnable check turns a green into
# evidence for something nobody measured, and a hardcoded null turns a written artifact into a record
# that is not a gate.

def _check(status: str, detail: str, needs: str = "", **extra) -> dict:
    out = {"status": status, "detail": detail}
    if needs:
        out["needs"] = needs
    out.update(extra)
    return out


def _comparand(result: dict) -> bool:
    """May this recorded row become the incumbent? Not a ZERO-EVALUATION unit (no score); not a row whose
    payload said `comparand: false` (a measured noise floor, a calibration - a score that is not a
    model's); and not one the campaign's own rule excludes - experiment.py's optional
    campaign_comparand(result) -> bool, for rows recorded before the flag existed. Left in, a floor row
    becomes the incumbent by construction - nothing beats the data's own noise - and every later correct
    result is reported as a regression, which is how a flag stops being read."""
    if result.get("is_evaluation") is False or result.get("comparand") is False:
        return False
    try:
        return bool(_seam("campaign_comparand", lambda r: True)(result))
    except Exception:
        return True


def _prior_results(exclude_id: str) -> list[dict]:
    """Every previous experiment's recorded result, for the checks that need a reference point.

    Reads results/result_<NN>.json rather than the scoreboard: the JSON is written by this runner with
    key names it owns, while the scoreboard's columns are campaign-specific placeholders, so parsing
    that here would couple the runner to a header it does not control.
    """
    out = []
    for f in sorted(RESULTS.glob("result_*.json")):
        if f.stem == f"result_{exclude_id}":
            continue
        d = _read_json(f, None)
        if not isinstance(d, dict):
            continue
        if not _comparand(d):
            continue
        try:
            score = float(d["{{PRIMARY_METRIC}}"])
        except (KeyError, TypeError, ValueError):
            continue
        if not np.isfinite(score):
            continue
        rid = f.stem.replace("result_", "")
        out.append({"exp_name": d.get("exp_name", f.stem), "id": rid,
                    "score": score, "metric_version": str(d.get("metric_version", "")),
                    "data_version": str(d.get("data_version", "")), "guardrail": d.get("guardrail"),
                    "label": _label_for_id(rid)})
    return out


# The verification labels. Non-independent: unverified · self-checked · self-verified ·
# self-refuted. Independent: <VERDICT>/peer · <VERDICT>/verifier · <VERDICT>/audit; /review and
# /re-execution are labels from the earlier preset table and read as /verifier.
INDEPENDENT_KINDS = ("peer", "verifier", "audit", "review", "re-execution")


def _label_for_id(eid: str) -> str:
    ck = _read_json(CHECKS / f"checks_{eid}.json", None)
    return str((ck or {}).get("label") or "unverified") if isinstance(ck, dict) else "unverified"


def _is_refuted(label: str) -> bool:
    return str(label).upper().startswith("REFUTED/") or str(label) == "self-refuted"


def _counts_as_check(label: str, kind: str) -> bool:
    """Does this label mark a result checked by a check of `kind` - 'independent' (a CONFIRMED peer,
    verifier or audit verdict), or 'any' (those, or a self-verify that held)?"""
    head, _, tail = str(label).partition("/")
    independent = head.upper() == "CONFIRMED" and tail.lower() in INDEPENDENT_KINDS
    return independent if kind == "independent" else (independent or str(label) == "self-verified")


def _incumbent(priors: list[dict], props: dict | None = None) -> dict | None:
    """The best prior result under THIS metric's direction, using the frozen scorer's own comparator so
    a lower-is-better campaign needs no separate branch here.

    With `props`, only rows scored under the CURRENT (metric_version, data_version) compete: a row from
    another metric epoch is not an incumbent it makes sense to beat (the metric-epoch design), and ranking across the
    boundary is the silent merge the epoch ledger exists to prevent. check_comparability reports how
    many rows were set aside. Blank tags (a campaign that predates them) keep the old behaviour.
    """
    tags = ((str(props.get("metric_version") or ""), str(props.get("data_version") or ""))
            if props else ("", ""))
    best = None
    for r in priors:
        if all(tags) and (r["metric_version"], r["data_version"]) != tags:
            continue
        if _is_refuted(r.get("label") or ""):
            continue                    # a refuted result is no one's best
        if best is None or metric._better(r["score"], best["score"]):
            best = r
    return best


def check_deliverable(cfg: dict) -> dict:
    """A ZERO-EVALUATION unit's commitment: the `_deliverable` its config named before the run (the
    deliverable gate refuses a run without one). Whether the deliverable is on disk is the campaign's
    check (campaign_checks receives the payload)."""
    deliverable = str(cfg.get("_deliverable") or "").strip()
    if not deliverable:
        return _check("fail", "this unit recorded no score and its config names no _deliverable - there is "
                              "nothing it can be held to (the deliverable gate should have refused this run)",
                      needs='"_deliverable": "..." in configs/<exp_name>.json')
    return _check("pass", "deliverable named before the run: " + deliverable[:200], deliverable=deliverable)


def check_noise_floor(score: float, props: dict, incumbent: dict | None,
                     comparable: bool = True, excluded: int = 0) -> dict:
    """Is the change against the incumbent larger than this campaign's own resolution?

    A change smaller than the noise floor (stochastic) or the tolerance (deterministic) is not a result -
    it is the same number twice. This reports that; it does not decide what to do about it. `excluded`
    is how many prior rows _incumbent set aside for being scored under another version, so "no
    incumbent" can say whether the campaign is at its first result or at an epoch boundary.
    """
    deterministic = props.get("noise_model") == "deterministic"
    knob = "tolerance" if deterministic else "noise_floor"
    eps = props.get(knob)
    if score is None:
        return _check("unavailable", "this unit records no score, so there is no delta against the "
                                     "incumbent to resolve against the campaign's resolution",
                      needs="a unit that scores {{PRIMARY_METRIC}}")
    if incumbent is None:
        if excluded:
            return _check("unavailable",
                          f"no prior result under the current (metric_version, data_version) to compare "
                          f"against; {excluded} prior row(s) under other versions set aside",
                          needs="re-score the retained contenders under the current version (the epoch "
                                "re-baseline) before any delta is a measurement")
        return _check("unavailable", "no prior experiment to compare against (this is the first result)",
                      needs="a second experiment")
    if not comparable:
        # A delta between two numbers the comparability check just called incomparable is not a delta.
        return _check("unavailable",
                      f"the incumbent {incumbent['exp_name']} is not comparable to this run, so the "
                      "difference between them is not a measurement",
                      needs=f"re-score {incumbent['exp_name']} under the current "
                            "(metric_version, data_version)")
    delta = score - incumbent["score"]
    if eps is None:
        return _check("unavailable",
                      f"this campaign is {props.get('noise_model')} but campaign.{knob} is unset, so "
                      "'larger than noise' has no numeric meaning here",
                      needs=f"campaign.{knob} in configs/loop.json"
                            + ("" if deterministic else " - estimate the replicate spread once "
                                                        "(verify, 'Clear the noise floor') and record it"),
                      delta=delta, incumbent=incumbent["exp_name"])
    resolvable = abs(delta) > eps
    better = metric._better(score, incumbent["score"]) if resolvable else None
    # What earns a flag here is a resolvable regression: a real move in the wrong direction, which the
    # analysis owes an explanation for. A change smaller than the campaign's own resolution is not a
    # defect. It is the honest answer "these are the same number", and it is what a replicate produces.
    # Flagging it would red-flag the procedure `verify` prescribes for estimating this threshold, and a
    # red flag raised on every correct run stops being read.
    if not resolvable:
        return _check("pass",
                      f"delta vs {incumbent['exp_name']} is {delta:+.6g}, within the {knob} {eps:g} - "
                      "indistinguishable from no change, so it supports no win claim either way",
                      delta=delta, incumbent=incumbent["exp_name"], resolvable=False,
                      threshold=eps, threshold_name=knob)
    return _check("pass" if better else "fail",
                  f"delta vs {incumbent['exp_name']} is {delta:+.6g}, exceeding the {knob} {eps:g}"
                  + (" - a real improvement" if better else
                     " - a real REGRESSION against the incumbent; explain it before moving on"),
                  delta=delta, incumbent=incumbent["exp_name"], resolvable=True, better=bool(better),
                  threshold=eps, threshold_name=knob)


def check_comparability(props: dict, incumbent: dict | None, priors: list[dict] | None = None) -> dict:
    """A ranking claim is valid ONLY WITHIN one (metric_version, data_version) pair.

    `priors` lets the check SURFACE an epoch boundary rather than hide it: rows scored under another
    version are set aside by _incumbent, and this reports how many, so a discontinuity in the record is
    named in the checks artifact instead of disappearing into a merged ranking (the metric-epoch design).
    """
    mine = (str(props.get("metric_version") or ""), str(props.get("data_version") or ""))
    if not all(mine):
        return _check("unavailable",
                      f"this campaign supplies no comparability tags (metric_version={mine[0]!r} "
                      f"data_version={mine[1]!r}), so no ranking against another row can be certified",
                      needs="campaign.metric_version / campaign.data_version in configs/loop.json - a "
                            "campaign scaffolded before these existed sets them once, and never has to "
                            "answer this again")
    others = [r for r in (priors or []) if (r["metric_version"], r["data_version"]) != mine]
    other_tags = ", ".join(sorted({f"({r['metric_version'] or '?'}, {r['data_version'] or '?'})"
                                   for r in others}))
    if incumbent is None:
        if others:
            return _check("unavailable",
                          f"no prior result is scored under ({mine[0]}, {mine[1]}); {len(others)} prior "
                          f"row(s) under {other_tags} cannot rank against this run - a metric/data "
                          "version boundary (an epoch) sits between them",
                          needs="re-score the retained contenders under the current version (the epoch "
                                "re-baseline) before any ranking claim crosses the boundary",
                          metric_version=mine[0], data_version=mine[1], excluded=len(others))
        return _check("unavailable", "no prior experiment to compare tags against",
                      needs="a second experiment", metric_version=mine[0], data_version=mine[1])
    theirs = (incumbent["metric_version"], incumbent["data_version"])
    if not all(theirs):
        return _check("unavailable",
                      f"the incumbent {incumbent['exp_name']} carries no comparability tags, so this "
                      "delta cannot be certified comparable",
                      needs=f"re-score {incumbent['exp_name']} under the current version")
    same = mine == theirs
    detail = (f"this run is ({mine[0]}, {mine[1]}); the incumbent {incumbent['exp_name']} is "
              f"({theirs[0]}, {theirs[1]})"
              + ("" if same else " - these numbers are NOT comparable. Re-score the incumbent under "
                                 "the current version before ranking them"))
    if same and others:
        detail += (f" ({len(others)} prior row(s) under {other_tags} set aside - not ranked against "
                   "this run)")
    return _check("pass" if same else "fail", detail,
                  metric_version=mine[0], data_version=mine[1], excluded=len(others))


def check_correctness_state() -> dict:
    """Is the standing correctness suite green, and was that green recorded against the code on disk NOW?

    Re-read from disk rather than threaded through: check_correctness_suite() runs before the solve and
    discards its return value, and the state file is guaranteed written by the time this runs.
    """
    st = _read_json(CORRECTNESS_STATE, None)
    if not isinstance(st, dict):
        return _check("unavailable", "results/correctness_state.json is absent or unreadable",
                      needs="one run of scripts/run_campaign.py, which records it")
    status = st.get("status")
    if status != "green":
        return _check("fail", f"the correctness suite is {status!r}, not green - nothing built on this "
                              "code is guarded, and promotion is blocked", suite_status=status)
    recorded, current = st.get("core_hash"), frozen_core.core_hash(ROOT)
    if recorded and current and recorded != current:
        return _check("fail", "the recorded green is STALE - certified against a different FROZEN/core "
                              "than the code on disk now. Re-run the suite", suite_status=status)
    return _check("pass", "correctness suite green, certified against the core on disk",
                  suite_status=status)


# ---- metric epochs (the metric-epoch design) -------------------------------------------------------------
# A metric epoch is one metric_version: WHO opened it, on WHAT evidence, its expected direction, and its
# ratification STANDING (pending | ratified | rolled-back). The declarations live in configs/loop.json
# beside metric_version, as campaign.metric_epochs keyed by version - and that block exists only once a
# campaign has revised its metric: with no block, the current metric_version IS the co-designed first epoch
# (ratified). The one runner-owned fact - the hash of the FROZEN scorer each epoch was bound to - lives with
# the runner's other state in results/correctness_state.json (scorer_hash_by_version), bound on the first
# experiment under the epoch and never rewritten. Declarations are hook-guarded (scripts/guard_promotion.py,
# its loop.json surface): append-only, evidence-checked, ratification attended-only.

EPOCH_KINDS = ("mechanics", "semantics")
EPOCH_STATUSES = ("pending", "ratified", "rolled-back")
IMPLICIT_EPOCH = {"kind": "semantics", "status": "ratified", "implicit": True}


def _epoch_declaration(props: dict) -> dict | None:
    """The CURRENT epoch's declaration: the campaign.metric_epochs entry for metric_version; the implicit
    first epoch when the campaign has declared none, or when the version has no entry but the runner
    already bound it (only the first epoch can be bound without an entry - a new version is refused by
    epoch_gate before its suite run could bind it); None when the block names no such version and nothing
    bound it (an undeclared bump)."""
    mv = str(props.get("metric_version") or "")
    block = props.get("metric_epochs") or {}
    if not isinstance(block, dict) or not block:
        return dict(IMPLICIT_EPOCH, id=mv)
    e = block.get(mv)
    if isinstance(e, dict):
        return dict(e, id=mv)
    return dict(IMPLICIT_EPOCH, id=mv) if _scorer_bindings().get(mv) else None


def _scorer_bindings() -> dict:
    """metric_version -> the scorer hash it was bound to, from the runner's own state file."""
    st = _read_json(CORRECTNESS_STATE, None)
    b = st.get("scorer_hash_by_version") if isinstance(st, dict) else None
    return b if isinstance(b, dict) else {}


def _bind_scorer_hash(state: dict, metric_version: str, scorer_hash: str | None) -> dict:
    """Record the scorer hash the epoch `metric_version` is bound to, if it is not bound yet. Called by
    check_correctness_suite - the state file's only writer - AFTER the selftest passed, so only a scorer
    that passed its self-test is ever bound. A bound hash is never rewritten."""
    bindings = dict(state.get("scorer_hash_by_version") or {})
    if metric_version and scorer_hash and not bindings.get(metric_version):
        bindings[metric_version] = scorer_hash
        print(f"[epoch] {metric_version} bound to the FROZEN scorer on disk (scorer_hash {scorer_hash[:12]}...) "
              "- from here on, a scorer change under this epoch is an undeclared metric change")
    state["scorer_hash_by_version"] = bindings
    return state


def epoch_gate(props: dict) -> list[str]:
    """The FROZEN scorer on disk must be the one the CURRENT metric epoch was bound to.

    Returns plain-language failures (empty = clear). This is what makes a metric change impossible to
    do QUIETLY: a scorer edit with no new epoch declaring it is refused before an evaluation is spent.
    An epoch not yet bound is clear here and binds in check_correctness_suite. The correctness suite is
    deliberately NOT part of the bound hash (frozen_core.scorer_hash): adding a regression check is not a
    metric change. A blank metric_version is not enforced (the comparability check already reports it).
    """
    mv = str(props.get("metric_version") or "")
    if not mv:
        return []
    decl = _epoch_declaration(props)
    if decl is None:
        declared = ", ".join(str(k) for k in (props.get("metric_epochs") or {})) or "none"
        return [f"configs/loop.json campaign.metric_version is {mv!r}, but campaign.metric_epochs declares no "
                f"epoch with that id (declared: {declared}). A metric_version bump IS a metric epoch: add its "
                "entry (kind, evidence, expected_direction, status 'pending') to campaign.metric_epochs "
                "before running under it."]
    if str(decl.get("status", "")) == "rolled-back":
        return [f"the current metric epoch {mv!r} is ROLLED-BACK in campaign.metric_epochs. Fix: point "
                "campaign.metric_version at the epoch the campaign reverted to, or open the next epoch."]
    current = frozen_core.scorer_hash(ROOT)
    recorded = _scorer_bindings().get(mv)
    if current is None or not recorded:
        return []                    # cannot hash, or not bound yet: nothing to enforce, never a false halt
    if recorded != current:
        return [f"the FROZEN scorer on disk (scorer_hash {current[:12]}...) is NOT the one metric epoch "
                f"{mv!r} was bound to ({recorded[:12]}...), and no new epoch declares the change. This is an "
                "UNDECLARED metric change - the one thing the epoch record exists to make impossible to do "
                "quietly. Fix: if the change is deliberate, open the next epoch (bump campaign.metric_version "
                "and add its entry, with evidence, to campaign.metric_epochs in configs/loop.json); if it is "
                "not, restore scripts/metric.py from results/snapshots/<last experiment>/scripts/."]
    return []


def check_epoch(props: dict) -> dict:
    """Which metric epoch this run was scored under, its standing, and whether the scorer on disk is the
    one that epoch was bound to. The row's metric_version is the label; the declaration carries the
    standing (implicit first epoch = ratified)."""
    mv = str(props.get("metric_version") or "")
    if not mv:
        return _check("unavailable", "campaign.metric_version is blank, so no epoch can be named",
                      needs="campaign.metric_version in configs/loop.json")
    problems = epoch_gate(props)
    if problems:
        return _check("fail", problems[0])
    decl = _epoch_declaration(props) or {}
    bound = bool(_scorer_bindings().get(mv))
    return _check("pass",
                  f"scored under metric epoch {mv} ({decl.get('kind', '?')}, standing {decl.get('status', '?')}"
                  + (", the implicit first epoch" if decl.get("implicit") else "") + "); "
                  + ("the scorer on disk matches the hash the epoch is bound to" if bound
                     else "the epoch's scorer hash is not bound yet (binds with this experiment's suite run)"),
                  epoch=mv, kind=decl.get("kind"), standing=decl.get("status"),
                  expected_direction=decl.get("expected_direction"), implicit=bool(decl.get("implicit")))


def check_guardrail(diags: dict) -> dict:
    """Report the co-tracked guardrail. No kit-wide threshold for 'materially worse' exists, so this
    records the values for the reviewer instead of pretending to a judgement it cannot make."""
    if not diags:
        return _check("unavailable", "guardrail() returned nothing for this experiment",
                      needs="an implemented guardrail() in scripts/experiment.py")
    return _check("unavailable",
                  "guardrail values recorded; no numeric 'materially worse' threshold is defined for "
                  "this campaign, so this check reports rather than judges",
                  needs="a numeric guardrail threshold in campaign.md's promotion rule",
                  values=diags)


def check_levers(declared, changes: dict) -> dict:
    """HARD GATE 2 as data: does the config's `_levers` list name every config key this experiment moved
    (the change manifest's `config_keys`, against the unit it is compared to)? A moved-but-undeclared
    key is the silent multi-lever move nothing downstream can attribute; a declared-but-unmoved lever
    is only noted. A name matches a key when either contains the other (a lever may span keys)."""
    if not isinstance(declared, list) or not declared:
        return _check("unavailable", "the config declares no _levers list",
                      needs="a `_levers` list in the config naming the levers this experiment moves "
                            "(CLAUDE.md HARD GATE 2)")
    names = [str(d) for d in declared]
    moved = [str(c.get("key")) for c in (changes.get("config_keys") or [])]

    def _covered(key: str) -> bool:
        return any(n == key or n in key or key in n for n in names)

    undeclared = [k for k in moved if not _covered(k)]
    unmoved = [n for n in names if not any(n == k or n in k or k in n for k in moved)]
    if undeclared:
        return _check("fail", "moved but not declared in _levers: " + ", ".join(undeclared)
                      + f" (declared: {', '.join(names)})", declared=names, moved=moved,
                      undeclared=undeclared)
    if changes.get("since") is None:
        return _check("pass", f"declared: {', '.join(names)}; no prior unit to diff against "
                              f"({changes.get('since_reason') or 'first result'})",
                      declared=names, moved=moved)
    return _check("pass", f"declared: {', '.join(names)}; every moved key is declared"
                          + (f"; declared but unmoved: {', '.join(unmoved)}" if unmoved else ""),
                  declared=names, moved=moved)


def check_plausible_range(score: float) -> dict:
    """Is the score inside the campaign's PLAUSIBLE RANGE - metric.PLAUSIBILITY_BOUNDS, fixed once at
    setup and signed off by the user (typically the perfect score to the trivial-predictor score)? This
    is a cheap implementation-error check, not a test of anyone's prediction: a score outside the range
    points at the scorer, the data or the pipeline, and it triggers extra scrutiny.

    FLAGS rather than refuses, deliberately. Refusing would lose the artifact you need to DEBUG the
    violation, and it would put quiet pressure on the next worker to widen the range until their run
    goes through. A violation is recorded loudly and the record is kept.
    """
    if score is None:
        return _check("unavailable", "no score to bound - a zero-evaluation unit records null, and "
                                     "'inside the plausible range' has no meaning for null",
                      needs="a unit that scores {{PRIMARY_METRIC}}")
    bounds = getattr(metric, "PLAUSIBILITY_BOUNDS", None)
    if not bounds:
        return _check("unavailable",
                      "this campaign encodes no plausible range, so a probable implementation error has "
                      "no machine-readable meaning here",
                      needs="metric.PLAUSIBILITY_BOUNDS in scripts/metric.py - the range set at setup "
                            "(e.g. the perfect score to the score of a trivial predictor)")
    why = metric.implausible(float(score))
    if why:
        return _check("fail", f"{why} - outside the plausible range: probably an implementation error in "
                              "the scorer, the data or the pipeline; find it before reading the number",
                      bounds=list(bounds))
    return _check("pass", f"inside the plausible range {tuple(bounds)}", bounds=list(bounds))


def _new_best(score, props: dict, incumbent: dict | None, comparable: bool = True) -> tuple[bool, str]:
    """Is this result a NEW BEST - does it beat the incumbent by more than the campaign's own resolution
    (the tolerance, deterministic; the noise floor, stochastic; 0 when unset), under the same metric
    version? The one fact the one-check-per-result rule turns on: a new best waits for its
    survivor check; anything else gets the preset's self-verify rule. The first scored result under a
    metric version is its best by definition."""
    if score is None:
        return False, "no score (a zero-evaluation unit)"
    if not comparable:
        return False, "not comparable to the incumbent (another metric or data version)"
    if incumbent is None:
        return True, "the first scored result under this metric version"
    knob = "tolerance" if props.get("noise_model") == "deterministic" else "noise_floor"
    eps = props.get(knob)
    eps = 0.0 if eps is None else float(eps)
    delta = float(score) - float(incumbent["score"])
    if abs(delta) <= eps:
        return False, f"within the {knob} ({eps:g}) of the incumbent {incumbent['exp_name']}"
    if metric._better(float(score), float(incumbent["score"])):
        return True, f"beats the incumbent {incumbent['exp_name']} by {delta:+.6g} (beyond the {knob} {eps:g})"
    return False, f"does not beat the incumbent {incumbent['exp_name']} ({delta:+.6g})"


def _owed_check(rows: dict, new_best: bool, checks: dict, props: dict) -> dict:
    """The ONE check the preset owes this result, decided at record time: an independent check
    when the preset checks every result, or checks a new best once it survives; otherwise the preset's
    self-verify rule; otherwise nothing. Returns {check: self-verify | peer | verifier | None, when: now |
    survival | "", why}."""
    ind = str(rows.get("independent") or "off")
    sv = str(rows.get("self_verify") or "off")
    kind = ind.split(":", 1)[1] if ":" in ind else ""
    if ind.startswith("every:"):
        return {"check": kind, "when": "now", "why": "this preset checks every result independently"}
    if ind.startswith("survivor:") and new_best:
        return {"check": kind, "when": "survival",
                "why": "a new best - checked once the next unit has not beaten it, by "
                       + ("the next worker (a peer check)" if kind == "peer" else "a verifier the driver spawns")}
    # Outside the PLAUSIBLE RANGE fixed at setup - a probable implementation error, never a missed guess.
    # `hard_bounds` is the key checks artifacts carried before the range was renamed.
    pr = checks.get("plausible_range") or checks.get("hard_bounds") or {}
    outside = pr.get("status") == "fail"
    if sv == "every":
        return {"check": "self-verify", "when": "now",
                "why": "this preset self-verifies every result it does not check independently"}
    if sv == "out-of-range" and outside:
        return {"check": "self-verify", "when": "now",
                "why": "outside the plausible range - " + str(pr.get("detail") or "")[:160]}
    return {"check": None, "when": "", "why": "nothing owed under this preset"
            + (" (a new best: none of this preset's checks applies)" if new_best else "")}


def _short(v) -> str:
    s = json.dumps(v, sort_keys=True, default=str)
    return s if len(s) <= 80 else s[:77] + "..."


def _change_manifest(exp_id: str, label: str, props: dict, kind: str = "any") -> dict:
    """What THIS experiment changed relative to the last CHECKED unit - the mechanical record every check
    starts from (verify the delta and its interaction with the unchanged parts). Nobody guesses it: it is
    read from the frozen snapshots.

    Baseline: the most recent experiment under the current metric_version whose label shows
    a check of this `kind` - 'independent' (a CONFIRMED peer, verifier or audit verdict: an independent
    label never rests on code only a self-verify saw) or 'any' (those, or a self-verify that held) - else
    the incumbent, else the campaign baseline (exp 000), else nothing (the first experiment). Files are
    compared as CODE (frozen_core._normalized_source: comments, docstrings and formatting do not count),
    config keys by value (underscore-prefixed commentary keys ignored), the version tags by name.
    `python scripts/run_campaign.py --diff <exp>` prints the full diff from the same two snapshots."""
    priors = _prior_results(exp_id)
    mv = str(props.get("metric_version") or "")
    checked = [r for r in priors if not (mv and r["metric_version"] != mv)
               and _counts_as_check(r.get("label") or "", kind)]
    since, why = None, "first experiment"
    what = "independent check" if kind == "independent" else "check"
    if checked:
        since = max(checked, key=lambda r: r["id"])
        why = f"last {what} ({since.get('label')}) under metric_version {mv or '(untagged)'}"
    else:
        inc = _incumbent(priors, props)
        if inc is not None:
            since, why = inc, f"the incumbent (no {what} yet under this metric_version)"
        else:
            base = next((r for r in priors if r["id"] == "000"), None)
            if base is not None:
                since, why = base, "the campaign baseline"
    out = {"since": since["exp_name"] if since else None, "since_reason": why,
           "files": [], "config_keys": [], "versions": {}}
    if since is None:
        return out
    mine, theirs = SNAPSHOTS / label, SNAPSHOTS / since["exp_name"]

    def _tree(d: Path) -> dict:
        m = {}
        for p in (d / "scripts").rglob("*"):
            if p.is_file() and "__pycache__" not in p.parts:
                m[p.relative_to(d).as_posix()] = _hashlib.sha256(
                    frozen_core._normalized_source(p) or b"").hexdigest()
        return m

    a, b = _tree(theirs), _tree(mine)
    for rel in sorted(set(a) | set(b)):
        if rel not in a:
            out["files"].append({"path": rel, "kind": "added"})
        elif rel not in b:
            out["files"].append({"path": rel, "kind": "removed"})
        elif a[rel] != b[rel]:
            out["files"].append({"path": rel, "kind": "modified"})
    ca = _read_json(theirs / "config.json", {}) or {}
    cb = _read_json(mine / "config.json", {}) or {}
    for key in sorted(set(ca) | set(cb)):
        if key.startswith("_") or key == "exp_name":
            continue
        va, vb = ca.get(key), cb.get(key)
        if json.dumps(va, sort_keys=True, default=str) != json.dumps(vb, sort_keys=True, default=str):
            out["config_keys"].append({"key": key, "old": _short(va), "new": _short(vb)})
    for tag in ("metric_version", "data_version"):
        old, new = str(since.get(tag) or ""), str(props.get(tag) or "")
        if old != new:
            out["versions"][tag] = [old, new]
    return out


def _diff_text(exp: str, since: str | None = None) -> str:
    """The unified diff behind results/checks_<NN>.json `changes`: the two frozen snapshots' scripts plus
    the config keys that moved, as text. Read-only; used to inline the delta into the verifier's brief and
    by the `--diff` CLI."""
    import difflib
    eid = exp_id_for(exp)
    ck = _read_json(CHECKS / f"checks_{eid}.json", None) if eid else None
    mine_name = (ck or {}).get("exp_name") if isinstance(ck, dict) else None
    mine = SNAPSHOTS / (mine_name or exp)
    if not mine.is_dir():
        return f"(no snapshot for {exp!r} - results/snapshots/{mine.name}/)"
    if not since:
        ch = (ck or {}).get("changes") if isinstance(ck, dict) else None
        since = (ch or {}).get("since") if isinstance(ch, dict) else None
        if not since:
            return f"(nothing to diff against: {(ch or {}).get('since_reason', 'no change record')})"
    theirs = SNAPSHOTS / since
    if not theirs.is_dir():
        sid = exp_id_for(since)
        sck = _read_json(CHECKS / f"checks_{sid}.json", None) if sid else None
        theirs = SNAPSHOTS / str((sck or {}).get("exp_name") or since)
        if not theirs.is_dir():
            return f"(no snapshot for {since!r})"
    out = [f"=== {mine.name} vs {theirs.name} (frozen snapshots) ===\n"]
    rels = sorted({p.relative_to(d).as_posix() for d in (mine, theirs) for p in (d / "scripts").rglob("*")
                   if p.is_file() and "__pycache__" not in p.parts})
    n = 0
    for rel in rels:
        a, b = theirs / rel, mine / rel
        ta = a.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True) if a.is_file() else []
        tb = b.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True) if b.is_file() else []
        if ta == tb:
            continue
        n += 1
        out.extend(difflib.unified_diff(ta, tb, fromfile=f"{theirs.name}/{rel}", tofile=f"{mine.name}/{rel}"))
    ca = _read_json(theirs / "config.json", {}) or {}
    cb = _read_json(mine / "config.json", {}) or {}
    keys = [k for k in sorted(set(ca) | set(cb))
            if json.dumps(ca.get(k), sort_keys=True, default=str) != json.dumps(cb.get(k), sort_keys=True, default=str)]
    out.append(f"--- config: {len(keys)} key(s) differ ---\n")
    for k in keys:
        out.append(f"  {k}: {_short(ca.get(k))} -> {_short(cb.get(k))}\n")
    out.append(f"--- {n} script file(s) differ textually (the checks artifact counts CODE changes only) ---\n")
    return "".join(out)


def _changes_summary(exps: str) -> str:
    """An independent check's starting point (the verifier's VALUES, the peer's, the capstone's): per
    experiment, one summary line of what moved since the last INDEPENDENT check (results/checks_<NN>.json
    `changes_independent`, else `changes`), then the full snapshot diff INLINED - the delta by value, so
    the checker reads the change here rather than reconstructing it from disk."""
    lines, diffs = [], []
    for stem in [s.strip() for s in exps.split(",") if s.strip()]:
        eid = exp_id_for(stem)
        ck = _read_json(CHECKS / f"checks_{eid}.json", None) if eid else None
        ch = None
        if isinstance(ck, dict):
            ch = ck.get("changes_independent") if isinstance(ck.get("changes_independent"), dict) else ck.get("changes")
        if not isinstance(ch, dict):
            lines.append(f"  {stem}: no change record (predates the manifest) - diff the snapshot yourself")
            continue
        if not ch.get("since"):
            lines.append(f"  {stem}: {ch.get('since_reason', 'first experiment')} - nothing to diff against;"
                         " verify it whole")
            continue
        files = ", ".join(f"{f['path']} ({f['kind']})" for f in ch.get("files") or []) or "none"
        keys = ", ".join(f"{c['key']} {c['old']} -> {c['new']}" for c in ch.get("config_keys") or []) or "none"
        vers = ", ".join(f"{k} {v[0]} -> {v[1]}" for k, v in (ch.get("versions") or {}).items())
        lines.append(f"  {stem}: since {ch['since']} ({ch.get('since_reason', '')}); code changed: {files}; "
                     f"config keys changed: {keys}" + (f"; versions: {vers}" if vers else ""))
        diffs.append(_diff_text(stem, ch["since"]))
    body = "\n".join(lines)
    if diffs:
        joined = "\n\n".join(diffs)
        clipped, tr = _clip(joined, BRIEF_DIFF_CAP, "the snapshot diff",
                            "the rest is `python scripts/run_campaign.py --diff <exp>`")
        body += "\n\n-- the delta in full (the two snapshots' unified diff) --\n" + clipped
    return body


def write_checks(exp_id: str, label: str, score: float, diags: dict, cfg: dict,
                 props: dict, timing: dict | None = None, prediction=None) -> dict:
    """Compute every mechanical check for this experiment and write results/checks_<NN>.json.

    Written LAST, after the logbook entry, so `save_set` reports the complete contract rather than the
    part that happens to exist at scoring time. `timing` (the runner's measured breakdown) is recorded
    under `run` so the unit's cost sits beside its verdicts.
    """
    priors = _prior_results(exp_id)
    inc = _incumbent(priors, props)
    comparability = check_comparability(props, inc, priors)
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    vrows = _verify_rows(loop_cfg)
    # What this experiment changed since the last checked unit - where every check starts, and the
    # record the levers check reads. Computed first; it must never cost the experiment.
    try:
        changes = _change_manifest(exp_id, label, props)
    except Exception as exc:
        changes = {"since": None, "since_reason": f"manifest failed: {type(exc).__name__}: {exc}",
                   "files": [], "config_keys": [], "versions": {}}
    declared = ((_read_json(RESULTS / f"result_{exp_id}.json", {}) or {}).get("config") or {}).get("_levers")
    # A ZERO-EVALUATION unit (score None): every check that needs a number reports `unavailable` with
    # what it would need - never `pass` (a green on something nobody measured) and never `fail` (a flag
    # for correctly declining to produce a score); `deliverable_named` judges the one its config named
    # (the campaign's own campaign_checks may add a `deliverable` check of what is actually on disk).
    checks = {
        "plausible_range": check_plausible_range(score),
        "levers": check_levers(declared, changes),
        "noise_floor": check_noise_floor(score, props, inc,
                                         comparable=comparability["status"] != "fail",
                                         excluded=int(comparability.get("excluded") or 0)),
        "comparability": comparability,
        "guardrail": check_guardrail(diags),
        "correctness_suite": check_correctness_state(),
        "epoch": check_epoch(props),
        "save_set": None,   # filled below
    }
    if score is None:
        checks["deliverable_named"] = check_deliverable(cfg or {})
    # The campaign's own checks (experiment.py campaign_checks - a seam): merged under their own names,
    # never over a kit check, and only in the three-valued shape every reader of this artifact expects.
    cfg_now = (_read_json(RESULTS / f"result_{exp_id}.json", {}) or {}).get("config") or {}
    for name, c in (_seam_call("campaign_checks", lambda *a, **k: {}, exp_id, label, score, diags, cfg_now,
                               prediction=prediction) or {}).items():
        if name not in checks and isinstance(c, dict) and c.get("status") in ("pass", "fail", "unavailable"):
            checks[name] = c
    # Re-verified HERE, at record time, over all four artifacts - including the figure, which
    # assert_save_set checked before the row was written and which nothing has re-checked since. The
    # three that gate preceded this are re-read rather than assumed: a check that cannot fail is not a
    # check, and this file must never carry a status nobody measured.
    present = {
        "result JSON": (RESULTS / f"result_{exp_id}.json").is_file(),
        "figure": any(IMAGES.glob(f"{label}_*")),
        "snapshot": (SNAPSHOTS / label).is_dir(),
        "logbook entry": label in LOGBOOK.read_text(encoding="utf-8", errors="replace"),
    }
    # Is it a NEW BEST? The fact the one check it is owed turns on, and what the per-result
    # gates wait for. Then the POST-solve invocation: the gates, and whatever the preset holds back for a
    # new best, run now that there is a result to gate. Their outcome lands in correctness_suite.
    new_best, new_best_why = _new_best(score, props, inc, comparable=comparability["status"] != "fail")
    owed = _owed_check(vrows["rows"], new_best, checks, props)
    candidate = new_best
    post = _due_checks(_read_json(CORRECTNESS_STATE, None), vrows["rows"], props,
                       candidate=candidate, core_moved=False)
    _SUITE_LAST["candidate"] = dict(post, candidate=candidate)
    if post["due"]:
        print(_suite_line("candidate", post, len(post["due"]) + len(post["skipped"])))
        check_correctness_suite(str(props.get("metric_version") or ""), select=",".join(post["due"]),
                                ran_for=label, why="candidate", props=props)
        checks["correctness_suite"] = check_correctness_state()
    missing = sorted(n for n, ok in present.items() if not ok)
    checks["save_set"] = (
        _check("fail", "missing from the save-set at record time: " + ", ".join(missing), present=present)
        if missing else
        _check("pass", "re-verified on disk: result JSON, figure, snapshot, logbook entry",
               present=present))
    payload = {
        "exp_id": exp_id, "exp_name": label, "utc": _utc_stamp(),
        "metric": {"name": "{{PRIMARY_METRIC}}", "value": None if score is None else float(score),
                   "is_evaluation": score is not None,
                   "higher_is_better": bool(metric.HIGHER_IS_BETTER)},
        "campaign": {k: props.get(k) for k in ("noise_model", "noise_floor",
                                               "tolerance", "metric_version", "data_version",
                                               "metric_revision")},
        "checks": checks,
        "flags": sorted(n for n, c in checks.items() if c["status"] == "fail"),
        "unavailable": sorted(n for n, c in checks.items() if c["status"] == "unavailable"),
        "run": {"solve_wall_clock_s": (timing or {}).get("solve_s"),
                "timing": {k: v for k, v in (timing or {}).items() if k != "t_run"}},
        # The verification this unit ran under (the preset and its resolved table), whether it is a new
        # best, and the ONE check it is owed - the driver schedules from this, the worker's
        # record is held to it, and the label every claim carries is built from what then happened.
        "verification": dict(
            {k: vrows[k] for k in ("preset", "source", "rows")},
            new_best=new_best, new_best_why=new_best_why, owed=owed,
            # Which checks the preset made due for this unit and why the rest were not: the record
            # behind the label, per invocation (before the solve; after it, for a new best).
            suite={"experiment": _SUITE_LAST.get("experiment"), "candidate": _SUITE_LAST.get("candidate"),
                   "budget": _SUITE_LAST.get("budget")}),
        # The worker's own checks land here via the record file (absent until then; off under a preset
        # that does not record them), and its self-verify when this result is owed one; the label is what
        # every exported claim carries - honest, and raised only by artifacts.
        "self_check": {"status": "off" if vrows["rows"].get("self_check") == "off" else "absent"},
        "self_verify": {"status": "owed" if owed["check"] == "self-verify" else "not owed"},
        "label": "unverified",
    }
    payload["changes"] = changes
    if owed["check"] in ("peer", "verifier"):
        # The delta an independent check starts from: since the last INDEPENDENT check.
        try:
            payload["changes_independent"] = _change_manifest(exp_id, label, props, kind="independent")
        except Exception as exc:
            payload["changes_independent"] = {"since": None, "since_reason": f"manifest failed: {exc}",
                                              "files": [], "config_keys": [], "versions": {}}
    (CHECKS / f"checks_{exp_id}.json").write_text(json.dumps(payload, indent=2), encoding="utf-8")
    n_pass = len(checks) - len(payload["flags"]) - len(payload["unavailable"])
    if payload["flags"]:
        print(f"RED FLAG: {len(payload['flags'])} mechanical check(s) FAILED for {label}: "
              + "; ".join(f"{n} - {checks[n]['detail']}" for n in payload["flags"]))
        print("  Each is a bug or a discovery. Explain every one in the logbook Analysis slot before "
              "moving on (roles/worker.md, loop step 7) - an unexplained flag is not a passed check.")
    if payload["unavailable"]:
        print(f"checks: {len(payload['unavailable'])} not runnable for this campaign "
              f"({', '.join(payload['unavailable'])}); each names what it needs, in "
              f"results/checks_{exp_id}.json.")
    print(f"mechanical checks -> results/checks_{exp_id}.json "
          f"({n_pass} pass, {len(payload['flags'])} fail, {len(payload['unavailable'])} unavailable)")
    print(f"verification owed (preset {vrows['preset']}): "
          + (f"{owed['check']} ({owed['when']}) - {owed['why']}" if owed["check"] else owed["why"])
          + f"; new best: {'yes' if new_best else 'no'} - {new_best_why}")
    return payload


def evaluate_and_record(cfg: dict, prediction, target,
                        props: dict | None = None, timing: dict | None = None) -> dict:
    """Score with the FROZEN metric, run the guardrail, and write result_<NN>.json (+ figure).

    The scoreboard row is appended LAST, behind the save-set gate - a row exists only for a fully-saved
    result. Whether the score is inside the plausible range is judged by write_checks() and recorded in
    results/checks_<NN>.json, the ledger and the logbook. `timing` is the runner's own measured breakdown
    (gates / suite / snapshot / solve); the solve time travels with the result as the unit's cost.
    """
    _beat("scoring")
    t_record = time.monotonic()
    timing = dict(timing or {})
    zero = _zero_evaluation(cfg)
    if zero:
        # A ZERO-EVALUATION unit records something other than a model's score. Its primary metric stays
        # None all the way to disk and is NEVER 0: a 0 ranks, would become the incumbent by construction
        # in a lower-is-better campaign, and would report every later correct run as a regression.
        score = None
    else:
        score = metric.compute_metric(prediction, target)
        assert np.isfinite(score), "primary metric is non-finite - refuse to record a noise result"
    diags = _exp().guardrail(prediction, cfg)

    label = cfg["exp_name"]
    residual = None if zero else _seam("residual", lambda p, t: None)(prediction, target)
    fig = _exp().save_figure(label, prediction, target, residual)   # a zero-evaluation unit still owes one

    props = props or {}
    payload = prediction if isinstance(prediction, dict) else {}
    result = {
        "exp_name": label,
        "{{PRIMARY_METRIC}}": None if zero else float(score),
        # Two flags a later reader (and _prior_results) needs and could not otherwise recover: whether
        # this row is a SCORE at all, and whether it is a model's score that may become the incumbent
        # (a payload `comparand: false` marks a measured floor or a calibration row). `runner_produced`
        # says the runner wrote it - a hand-written result JSON is what the zero-evaluation path exists
        # so that nobody has to produce.
        "is_evaluation": not zero,
        "comparand": (not zero) and payload.get("comparand", True) is not False,
        "runner_produced": True,
        "guardrail": diags,
        "utc": _utc_stamp(),
        # The comparability tags travel WITH the number, not only on the scoreboard row: a later
        # comparison reads these result files, and a delta between two differently-versioned scores is
        # not a delta. Blank tags are a hygiene failure the checks artifact reports.
        "metric_version": str(props.get("metric_version") or ""),
        "data_version": str(props.get("data_version") or ""),
        # The measured solve time IS the unit's cost - what verification depth is decided against.
        "solve_wall_clock_s": timing.get("solve_s"),
        "config": cfg,
    }
    # The evidence behind the number - the campaign's own keys of the result JSON (fitted parameters,
    # per-condition splits, a census, a deliverable's on-disk state): experiment.py's
    # campaign_result_fields(cfg, prediction, diags, score), a seam. Never over a kit key, and never
    # allowed to cost the experiment its record.
    try:
        extra = _seam_call("campaign_result_fields", lambda *a, **k: {}, cfg, prediction, diags, score) or {}
    except Exception as exc:
        print(f"WARNING: campaign_result_fields raised {type(exc).__name__}: {exc} - the campaign's keys "
              "are absent from this result JSON.")
        extra = {}
    for k, v in (extra.items() if isinstance(extra, dict) else ()):
        if str(k) not in result:
            result[str(k)] = v
    exp_id = exp_id_for(label)
    if not exp_id:
        sys.exit(f"NAMING: cannot derive an experiment id from exp_name {label!r}. The runner names "
                 "result_<NN>.json, checks_<NN>.json and the scoreboard row from it, and an id it "
                 "cannot derive used to fall back to 000 - silently overwriting the BASELINE's record.\n"
                 "  Use exp<NN>_<slug> (e.g. exp007_rigid), or exp<NN><letter>_<slug> for a sub-run "
                 "(exp007a_rigid).")
    # Refuse to write over a DIFFERENT experiment's record. Two exp_names can map to one id
    # (exp001_a and exp001_b both give 001), and the loser used to be overwritten without a word -
    # its result JSON, its checks artifact, and the provenance linking them to the row on the
    # scoreboard. The ledger is only trustworthy if one id means one experiment.
    prior = _read_json(RESULTS / f"result_{exp_id}.json", None)
    if isinstance(prior, dict) and prior.get("exp_name") not in (None, label):
        sys.exit(f"NAMING COLLISION: results/result_{exp_id}.json already belongs to "
                 f"{prior['exp_name']!r}, but this run is {label!r} - both derive the id {exp_id}.\n"
                 "  Writing it would destroy that experiment's record while leaving its scoreboard row "
                 "pointing at yours. Rename this experiment so its id is its own; for a deliberate "
                 "sub-run of an existing one, use the letter form (exp<NN><letter>_<slug>).")
    (RESULTS / f"result_{exp_id}.json").write_text(json.dumps(result, indent=2, default=_json_default),
                                                   encoding="utf-8")

    assert_save_set(exp_id, label, fig)   # RECORD GATE: no row until the save-set exists on disk

    plaus = _plausible_cell(score, cfg)
    append_scoreboard_row({
        "exp_id": exp_id,
        "timestamp": result["utc"],
        # COMPARABILITY (scoreboard.tsv, "the most common silent landmine"): every row must carry both
        # tags, and `tier` must be on every row or cap-compliance stops being machine-auditable. These
        # are filled here rather than left to the campaign: a rule no code writes is not enforced, and a
        # row emitted without the tags carries blanks no later reader can resolve.
        "metric_version": result["metric_version"],
        "data_version": result["data_version"],
        "tier": cfg.get("_tier", "Baseline" if exp_id == "000" else ""),
        # The narrative cells - the ledger IS the one-line timeline (the JOURNAL keeps no copy of it):
        # `what` (the config's one-line comment), `plausible` (the same judgement the logbook line
        # carries; an older ledger's `expected_vs_found` column is prediction history, left blank), an
        # optional `note` (--record --ledger-note, capped) and `finding` (--record --finding, one line
        # citing its verdict). `description` / `notes` are the older spellings.
        "what": cfg.get("_comment", ""), "description": cfg.get("_comment", ""),
        "plausible": plaus,
        # BLANK, not "0.0000", for a zero-evaluation unit: a blank cell records nothing, which is the
        # truth here; a 0 is a number every later comparison would have to be defended against.
        "{{PRIMARY_METRIC}}": "" if zero else f"{score:.4f}",
        # The campaign's own columns (levers, guardrail values, run numerics) come from experiment.py's
        # campaign_scoreboard_fields(cfg, diags, score, prediction=...) - a seam, so the kit-owned row
        # stays kit-owned; the payload travels so a column computed from the fit needs no read-back.
        **(_seam_call("campaign_scoreboard_fields", lambda cfg, diags, score, **k: {}, cfg, diags, score,
                      prediction=prediction) or {}),
        "note": "", "notes": "", "finding": "",
    })
    append_logbook(cfg, exp_id, label, score, diags, plausible=plaus)
    timing["record_s"] = round(time.monotonic() - t_record, 3)
    # Last, so save_set can report the complete contract (the logbook entry lands one line above).
    try:
        write_checks(exp_id, label, score, diags, cfg, props, timing=timing, prediction=prediction)
    except Exception as exc:                      # never lose the experiment over its own verdict file
        print(f"WARNING: the mechanical checks could not be computed ({type(exc).__name__}: {exc}). "
              f"Recording that failure to results/checks_{exp_id}.json rather than leaving no verdict - "
              "an absent checks file is indistinguishable from a run that predates the artifact.")
        try:
            (CHECKS / f"checks_{exp_id}.json").write_text(json.dumps({
                "exp_id": exp_id, "exp_name": label, "utc": _utc_stamp(),
                "checks": {"_runner": {"status": "fail",
                                       "detail": f"write_checks raised {type(exc).__name__}: {exc}"}},
                "flags": ["_runner"], "unavailable": [],
            }, indent=2), encoding="utf-8")
        except Exception:
            pass
    _append_timing_row(exp_id, label, timing)
    _beat("record")
    shown = "null (a zero-evaluation unit: no score is recorded)" if zero else f"{score:.4f}"
    print(f"[{label}] {{PRIMARY_METRIC}} = {shown}  (figure: {fig.name}; logged to logbook.md)")
    return result


def metric_selftest_message() -> str | None:
    """The metric self-test as a message: None = pass, else the human-readable failure. Shared seam for
    the per-experiment gate (require_metric_selftest) and the supervisor preflight - one authority."""
    try:
        metric.selftest()
    except NotImplementedError as exc:
        return (f"metric selftest NOT RUNNABLE: {exc}\n"
                "  -> implement compute_metric() and _no_skill_floor() in scripts/metric.py, then re-run. "
                "The self-test (perfect case + scrambled-input null control) gates every experiment.")
    except AssertionError as exc:
        return (f"metric selftest FAILED: {exc}\n"
                "  -> the FROZEN scorer has a sign/convention/leakage bug. Fix it before running any "
                "experiment; a ranking from a scorer that fails its self-test is noise.")
    return None


def unimplemented_hooks() -> list[str]:
    """Which campaign hooks are still the generated `raise NotImplementedError` stub.

    Detected from SOURCE, never by calling them: `run_experiment()` runs an experiment, so probing by
    invocation would spend (or corrupt) a unit to answer a question about setup. A hook whose source
    cannot be read is reported as implemented -- silence is better than a false accusation that sends
    someone editing code that is already fine.
    """
    import ast
    import inspect
    import textwrap

    out = []
    try:
        mod = _exp()
    except Exception as exc:                        # a syntax/import error is a setup failure, named
        return [f"scripts/experiment.py does not import ({type(exc).__name__}: {exc})"]
    for name in ("validate_method", "run_experiment", "load_target"):
        fn = getattr(mod, name, None)
        if not callable(fn):
            out.append(name + " MISSING")            # worse than a stub: nothing to call at all
            continue
        try:
            body = ast.parse(textwrap.dedent(inspect.getsource(fn))).body[0].body
        except (OSError, TypeError, SyntaxError, IndexError):
            continue
        if body and isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):
            body = body[1:]                                    # drop the docstring
        if len(body) == 1 and isinstance(body[0], ast.Raise):
            exc = body[0].exc
            if getattr(getattr(exc, "func", exc), "id", None) == "NotImplementedError":
                out.append(name)
    return out


def require_metric_selftest() -> None:
    """HARD-FAIL unless the FROZEN scorer passes its self-test. Runs automatically before every experiment
    (was opt-in via --selftest). Doctrine: don't trust a ranking until the self-test passes - it gates
    experiment 000. A campaign that hasn't implemented compute_metric()/_no_skill_floor() yet fails here with
    a pointer to fix, not a raw traceback; a scorer that fails its null control fails here too.
    """
    msg = metric_selftest_message()
    if msg:
        sys.exit(msg)


SUITE_ROWS = ("invariants", "machinery", "gates")
SUITE_META_DEFAULT = {"row": "invariants", "depends_on": (), "every": ""}


def _suite_worker(select: str, report: str, exp: str) -> int:
    """`--suite-worker`: run tests/correctness_checks.py's CHECKS in THIS process, one at a time, timed,
    traced, and reported - the protocol behind check_correctness_suite.

    The suite used to run as `python tests/correctness_checks.py`: an exit code and nothing else - no
    check names, no per-check cost, no way to run a subset. Hosting the worker here (the suite module is
    imported; its own main() never runs) gives the runner all three without a new file in the campaign
    tree, and a suite with a flat CHECKS list and no declarations keeps working exactly as before (an
    undeclared check is row 'invariants'). A suite without CHECKS at all falls back to the old exit-code
    run. select: comma-separated check names, or ''/'all'. report: the JSON path to write. exp: the
    experiment a 'gates' check (one that takes an argument) is given, or ''."""
    import importlib.util
    import inspect
    suite = ROOT / "tests" / "correctness_checks.py"
    sys.path.insert(0, str(ROOT / "scripts"))
    spec = importlib.util.spec_from_file_location("correctness_checks", suite)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    checks = list(getattr(mod, "CHECKS", None) or [])
    wanted = ({s.strip() for s in select.split(",") if s.strip()}
              if select and select.strip().lower() != "all" else None)
    rows_out, t_all = [], time.monotonic()
    root_r = ROOT.resolve()
    prefixes = (str(root_r).lower(), str(root_r.parent.parent).lower())
    for fn in checks:
        name = getattr(fn, "__name__", str(fn))
        if wanted is not None and name not in wanted:
            continue
        meta = dict(SUITE_META_DEFAULT, **(getattr(fn, "physkit_check", None) or {}))
        declared = getattr(fn, "physkit_check", None) is not None
        traced: set = set()

        def _tracer(frame, event, arg):
            # Call events only (returning None never traces lines): which of OUR files a check
            # executes is the on-change fingerprint's input; the cost is a function-call hook.
            if event == "call":
                f = frame.f_code.co_filename
                if f.lower().startswith(prefixes):
                    try:
                        traced.add(Path(f).resolve().relative_to(root_r).as_posix())
                    except ValueError:
                        traced.add(Path(f).resolve().as_posix())
            return None

        takes_arg = bool(inspect.signature(fn).parameters)
        t0 = time.monotonic()
        sys.settrace(_tracer)
        try:
            if takes_arg and not exp:
                status = "skip: needs a result (a gates check runs with the experiment it gates)"
            else:
                status = (fn(exp) if takes_arg else fn()) or "pass"
        except Exception as exc:               # a raising check is a FAILURE, never a silent pass
            status = f"fail: {type(exc).__name__}: {exc}"
        finally:
            sys.settrace(None)
        status = str(status)
        kind = "pass" if status == "pass" else ("fail" if status.startswith("fail") else "skip")
        rows_out.append({"name": name, "row": meta["row"] if meta["row"] in SUITE_ROWS else "invariants",
                         "depends_on": [str(d) for d in meta["depends_on"]], "every": str(meta["every"] or ""),
                         "declared": declared, "takes_arg": takes_arg, "status": kind, "detail": status,
                         "wall_s": round(time.monotonic() - t0, 6), "traced": sorted(traced)})
        mark = {"pass": "PASS", "fail": "FAIL"}.get(kind, "skip")
        print(f"  [{mark}] {name}: {status}"
              + (f"  ({rows_out[-1]['wall_s']:.2f}s)" if rows_out[-1]["wall_s"] >= 0.5 else ""))
    n_fail = sum(1 for r in rows_out if r["status"] == "fail")
    n_pass = sum(1 for r in rows_out if r["status"] == "pass")
    print(f"correctness suite: {n_pass} pass | {n_fail} fail | {len(rows_out) - n_fail - n_pass} skip"
          + (f" (selected {len(rows_out)} of {len(checks)})" if wanted is not None else ""))
    payload = {"protocol": 1, "checks": rows_out, "wall_s": round(time.monotonic() - t_all, 6),
               "selected": sorted(wanted) if wanted is not None else None, "n_checks": len(checks)}
    if report:
        Path(report).write_text(json.dumps(payload, indent=2), encoding="utf-8")
    if n_fail:
        return 1
    if n_pass == 0 and wanted is None:
        return 2
    return 0


def _check_fingerprint(entry: dict, props: dict) -> str | None:
    """What a check's outcome depended on, as one hash: the CODE of the files it executed last time
    (frozen_core._normalized_source - comments, docstrings and formatting do not count) plus anything it
    declared in depends_on, the campaign's data_version, and the interpreter. A check with no trace and
    no declaration hashes every Python file under scripts/ and tests/: it over-runs, never wrongly
    skips. None when a file cannot be read (then the check is due)."""
    files = []
    for rel in list(entry.get("traced") or []) + list(entry.get("depends_on") or []):
        p = Path(rel) if Path(rel).is_absolute() else (ROOT / rel)
        if p.is_file():
            files.append(p)
    if not files:
        files = [p for d in ("scripts", "tests") for p in sorted((ROOT / d).rglob("*.py"))
                 if "__pycache__" not in p.parts]
    files = sorted(set(files))
    h = frozen_core._hash_files(ROOT, files, frozen_core._normalized_source)
    if h is None:
        return None
    return _hashlib.sha256((h + "\0" + str(props.get("data_version") or "") + "\0"
                            + sys.version.split()[0] + "\0" + np.__version__).encode("utf-8")).hexdigest()


def _due_checks(state: dict | None, rows: dict, props: dict, *, candidate, core_moved: bool) -> dict:
    """Which checks the preset makes due for THIS invocation, and why each other one is not.

    candidate=None is the PRE-solve invocation (invariants and machinery); True/False is the POST-solve
    one (gates, and whatever waits for a promotion candidate). Returns {due, why, skipped, first}."""
    checks = (state or {}).get("checks") or {}
    if not checks or (state or {}).get("protocol") != 1:
        return {"due": [], "why": {}, "skipped": {}, "first": True}   # nothing known yet: run everything
    due, why, skipped = [], {}, {}
    post = candidate is not None
    demoted = set(((state or {}).get("demotions") or {}).keys())
    for name, e in checks.items():
        row = e.get("row") or "invariants"
        trig = "every" if e.get("every") else str(rows.get(row) or "every")
        if name in demoted:
            trig = "promotion"      # metered out of the every-set; still runs for every candidate
        gate = row == "gates" or bool(e.get("takes_arg"))
        if gate and not post:
            skipped[name] = "gate: runs with the result, after the solve"
            continue
        if not gate and post and trig != "promotion":
            skipped[name] = "decided before the solve"
            continue
        if core_moved:
            due.append(name)
            why[name] = "the FROZEN core changed: every check is due"
        elif trig == "off":
            skipped[name] = f"row {row} is off under this preset"
        elif trig == "every":
            due.append(name)
            why[name] = "every"
        elif trig == "setup":
            if e.get("last_status") is None:
                due.append(name)
                why[name] = "setup: never run"
            else:
                skipped[name] = f"setup: recorded {e.get('last_status')} at {e.get('last_run_utc', '?')}"
        elif trig == "on-change":
            fp = _check_fingerprint(e, props)
            if fp is None or fp != e.get("fingerprint"):
                due.append(name)
                why[name] = "on-change: its code moved" if e.get("fingerprint") else "on-change: no fingerprint yet"
            else:
                skipped[name] = f"on-change: unchanged since {e.get('ran_for') or e.get('last_run_utc', '?')}"
        elif trig == "promotion":
            if post and candidate:
                due.append(name)
                why[name] = "promotion: this unit is a candidate"
            else:
                skipped[name] = "promotion: not a candidate" if post else "promotion: decided after the solve"
        else:
            due.append(name)
            why[name] = f"unknown trigger {trig!r}: run it"
    return {"due": due, "why": why, "skipped": skipped, "first": False}


def _suite_line(why: str, d: dict, known: int) -> str:
    head = (f"correctness suite [{why}]: first run - every check"
            if d["first"] else f"correctness suite [{why}]: {len(d['due'])} of {known} due")
    if d["why"]:
        head += " (" + "; ".join(f"{n}: {r}" for n, r in list(d["why"].items())[:6]) + ")"
    if d["skipped"]:
        head += "; skipped: " + "; ".join(f"{n} ({r})" for n, r in list(d["skipped"].items())[:6])
        if len(d["skipped"]) > 6:
            head += f"; +{len(d['skipped']) - 6} more"
    return head


SUITE_BUDGET_FRACTION = 0.10   # of the campaign's measured unit cost, for everything scripted that fires per unit
SUITE_BUDGET_FLOOR_S = 30.0    # so a campaign of one-second units still gets a few checks per unit


def _suite_budget_s(loop_cfg: dict) -> float:
    """The per-unit budget for scripted checks: a fraction of unit_cost.typical_wall_clock_s, never below
    a small floor. Runner constants, not knobs (the floor is env-overridable, PHYSKIT_SUITE_BUDGET_FLOOR_S,
    so the deterministic tests can exercise the mechanism on a one-second toy)."""
    try:
        typical = float((loop_cfg.get("unit_cost") or {}).get("typical_wall_clock_s") or 0)
    except (TypeError, ValueError):
        typical = 0.0
    try:
        floor = float(os.environ.get("PHYSKIT_SUITE_BUDGET_FLOOR_S", SUITE_BUDGET_FLOOR_S))
    except ValueError:
        floor = SUITE_BUDGET_FLOOR_S
    return max(floor, SUITE_BUDGET_FRACTION * typical)


def _every_cost(state: dict | None, rows: dict) -> tuple[float, list]:
    """The MEASURED cost of everything that fires per unit under the preset (the every-set), from the
    per-check state: total seconds and the members, slowest first."""
    checks = (state or {}).get("checks") or {}
    demoted = set(((state or {}).get("demotions") or {}).keys())
    members = []
    for name, e in checks.items():
        if name in demoted:
            continue
        row = e.get("row") or "invariants"
        trig = "every" if e.get("every") else str(rows.get(row) or "every")
        if trig == "every":
            members.append((name, float(e.get("wall_s") or 0.0)))
    members.sort(key=lambda t: -t[1])
    return sum(w for _, w in members), members


def _meter_suite(rows: dict, loop_cfg: dict) -> dict:
    """Mid-campaign metering: when the every-set's MEASURED cost exceeds the budget, demote its slowest
    members to promotion-time - loudly, and persisted under `demotions` in results/correctness_state.json.
    Never a silent skip: a demoted check still runs for every promotion candidate, the line says how to
    restore it, and the driver logs the change at its next loop top. The guardrail the light presets
    rest on: a suite that grows slow cannot quietly make the lightest mode heavy."""
    st = _read_json(CORRECTNESS_STATE, None)
    budget = _suite_budget_s(loop_cfg)
    if not isinstance(st, dict) or st.get("protocol") != 1:
        return {"budget_s": budget, "every_cost_s": None, "demoted": [], "standing_demotions": []}
    cost, members = _every_cost(st, rows)
    demoted_now = []
    if cost > budget and members:
        demotions = dict(st.get("demotions") or {})
        remaining = cost
        for name, w in members:
            if remaining <= budget:
                break
            demotions[name] = {"from": "every", "to": "promotion", "utc": _utc_stamp(), "wall_s": w,
                               "budget_s": budget, "every_cost_s": cost}
            demoted_now.append((name, w))
            remaining -= w
        st["demotions"] = demotions
        try:
            CORRECTNESS_STATE.write_text(json.dumps(st, indent=2), encoding="utf-8")
        except Exception:
            pass
        print(f"SUITE BUDGET: the every-set took {cost:.1f}s against a {budget:.1f}s budget "
              f"({SUITE_BUDGET_FRACTION:g} x unit_cost.typical_wall_clock_s, floor {SUITE_BUDGET_FLOOR_S:g}s) - "
              "DEMOTED " + ", ".join(f"{n} ({w:.1f}s)" for n, w in demoted_now)
              + " from every to promotion. Each still runs for every promotion candidate. Restore one after "
                "making it cheaper by deleting its entry under demotions in results/correctness_state.json; "
                "declare it @check(row='machinery') or 'gates' if it never belonged in the every-set.")
    return {"budget_s": budget, "every_cost_s": cost, "demoted": [n for n, _ in demoted_now],
            "standing_demotions": sorted((st.get("demotions") or {}).keys())}


_SUITE_LAST: dict = {}     # why -> the due/skipped decision of the last invocation, for the checks artifact
_SUITE_TIMING: dict = {}   # the last suite run's measured wall time, for the per-unit timing record


def _append_timing_row(exp_id: str, label: str, timing: dict) -> None:
    """results/timing.tsv - one row per recorded experiment: where the runner's own time went (gates,
    suite, snapshot, solve, record). The evidence a slowness audit needs and could not get from the
    logs. Append-only; a write failure never touches the record."""
    try:
        p = RESULTS / "timing.tsv"
        cols = ["exp_id", "label", "start_iso", "end_iso", "dur_s", "launched_by", "mode",
                "gates_s", "suite_s", "snapshot_s", "solve_s", "record_s"]
        if not p.is_file():
            p.write_text("\t".join(cols) + "\n", encoding="utf-8")
        t_run = timing.get("t_run")
        total = (time.monotonic() - t_run) if t_run is not None else None

        def _f(v) -> str:
            return "" if v is None else f"{float(v):.3f}"

        row = [exp_id, label, str(timing.get("start_iso") or ""),
               _dt.datetime.now(_dt.timezone.utc).isoformat(), _f(total),
               os.environ.get("PHYSKIT_ROLE") or "attended",
               "supervised" if os.environ.get("AUTORESEARCH_SUPERVISED") else "attended"]
        row += [_f(timing.get(k)) for k in ("gates_s", "suite_s", "snapshot_s", "solve_s", "record_s")]
        with p.open("a", encoding="utf-8") as fh:
            fh.write("\t".join(row) + "\n")
    except Exception:
        pass


def check_correctness_suite(metric_version: str = "", select: str = "", ran_for: str = "",
                            why: str = "experiment", props: dict | None = None) -> str:
    """Run the standing correctness suite (if present), RECORD its status to results/correctness_state.json,
    and WARN on anything that is not green. Returns "green" / "red" / "empty" / "error" / "absent". Runs on
    every experiment. Also the one place a metric epoch's scorer hash is BOUND (scorer_hash_by_version in
    the same state file): the first suite run under `metric_version` records the FROZEN scorer's hash, and
    epoch_gate refuses to spend when a later scorer no longer matches it.

    Non-blocking for the run itself (so you can still iterate mid-fix) - but only an AFFIRMATIVE GREEN
    green-lights a promotion. guard_promotion refuses a promotion unless the suite is green: RED (a
    check failed), EMPTY (zero active checks - the freshly-scaffolded all-skip suite), ERROR, and ABSENT all
    block, because none of them is evidence the machinery is right; a genuinely-no-simulator campaign records
    an explicit tests/CORRECTNESS_NA.md instead (doctrine: no finding built on an unguarded machine is
    trustworthy). The state also records a hash of the FROZEN/core files
    (scripts/frozen_core.py); guard_promotion rejects a promotion whose green was recorded against a
    DIFFERENT core than the code on disk now - a green does not survive an edit to the code it
    certified. The suite runs on every experiment, so the recorded green is fresh at experiment time; the
    hash closes the promote-without-a-new-experiment path (edit the scorer, then promote an old result).
    """
    suite = ROOT / "tests" / "correctness_checks.py"
    status = "absent"
    rc = None
    wall_s = None       # measured, never assumed: the suite's cost was previously known only by its cap
    report, protocol = None, None
    t0 = time.monotonic()
    if not suite.is_file():
        print("WARNING: no correctness suite at tests/correctness_checks.py - the simulator is unguarded, so "
              "promotion is BLOCKED (status=absent). Build one with the correctness-suite skill, or "
              "record an explicit N/A in tests/CORRECTNESS_NA.md (with a rationale) if there is genuinely "
              "no simulator to check.")
    elif select == "-":
        # Nothing due under the preset: no subprocess, but the state is re-stamped (and the epoch's
        # scorer hash bound) so the record shows a decision, not an absence.
        prior0 = _read_json(CORRECTNESS_STATE, None)
        prior0 = prior0 if isinstance(prior0, dict) else {}
        protocol, status, wall_s = prior0.get("protocol"), str(prior0.get("status") or "error"), 0.0
        print(f"correctness suite: nothing due under the preset - status={status} carried from the last "
              f"run [{why}]")
    else:
        try:
            suite_text = suite.read_text(encoding="utf-8", errors="replace")
            has_checks = any(ln.startswith("CHECKS") for ln in suite_text.splitlines())
            if has_checks:
                # The protocol: the runner's own worker imports the suite, runs the selection, and
                # reports per check (name, row, status, cost, the files it executed).
                DIAG.mkdir(parents=True, exist_ok=True)
                rep_path = DIAG / f".suite_report_{os.getpid()}.json"
                env = dict(os.environ, PHYSKIT_SUITE_SELECT=select or "", PHYSKIT_SUITE_REPORT=str(rep_path),
                           PHYSKIT_SUITE_EXP=ran_for or "")
                proc = subprocess.run([sys.executable, str(Path(__file__).resolve()), "--suite-worker"],
                                      capture_output=True, text=True, timeout=600, env=env, cwd=str(ROOT))
                wall_s = time.monotonic() - t0
                rc = proc.returncode
                if proc.stdout:
                    print(proc.stdout.rstrip())
                report = _read_json(rep_path, None)
                rep_path.unlink(missing_ok=True)
                if isinstance(report, dict) and report.get("protocol") == 1:
                    protocol = 1
                    status = {0: "green", 1: "red", 2: "empty"}.get(rc, "error")   # 2 = zero active checks
                else:
                    status = "error"
                    print("WARNING: the suite worker wrote no report (did tests/correctness_checks.py fail "
                          "to import?) - recording status=error (BLOCKS PROMOTION). Worker output:\n"
                          + (proc.stderr or "")[-1500:])
            else:
                # A suite with its own runner and no CHECKS list: the previous kit's exit-code run.
                proc = subprocess.run([sys.executable, str(suite)], capture_output=True, text=True, timeout=600)
                wall_s = time.monotonic() - t0
                rc = proc.returncode
                if proc.stdout:
                    print(proc.stdout.rstrip())
                protocol = "legacy"
                status = {0: "green", 1: "red", 2: "empty"}.get(rc, "error")
            print(f"correctness suite: status={status} wall={wall_s:.1f}s (cap 600s)"
                  + (" [legacy suite: exit code only]" if protocol == "legacy" else "")
                  + (f" [{why}]" if why != "experiment" else ""))
            if status == "red":
                print("WARNING: correctness suite is RED - a check FAILED. This result is recorded, but a RED "
                      "suite BLOCKS PROMOTION (guard_promotion refuses the current-best/verdict write until "
                      "it is green). Fix the suite before promoting anything built on this code.")
            elif status == "empty":
                print("WARNING: correctness suite has 0 ACTIVE checks (EMPTY) - the machinery is unguarded, so "
                      "it BLOCKS PROMOTION, same as RED. Add >=1 real check (correctness-suite skill), "
                      "or record tests/CORRECTNESS_NA.md if this campaign has no simulator to check.")
            elif status == "error":
                print(f"WARNING: correctness suite exited {rc} (unexpected) - recording status=error, which "
                      "BLOCKS PROMOTION. Investigate the suite.")
        except Exception as exc:  # a broken/slow suite must warn, never block the run
            wall_s = time.monotonic() - t0
            print(f"WARNING: could not run the correctness suite ({exc}); recording status=error "
                  f"(BLOCKS PROMOTION) after {wall_s:.1f}s.")
            status = "error"
    _SUITE_TIMING["wall_s"] = None if wall_s is None else round(wall_s, 3)
    try:
        prior = _read_json(CORRECTNESS_STATE, None)
        prior = prior if isinstance(prior, dict) else {}
        # Per-check state (the protocol): a check not selected this run keeps its last recorded
        # outcome; the aggregate status is over every check the suite currently holds, so a green
        # still certifies the whole suite when only part of it had to run.
        checks_state = dict(prior.get("checks") or {}) if protocol == 1 else {}
        if protocol == 1 and isinstance(report, dict):
            now = _utc_stamp()
            for r in report["checks"]:
                entry = dict(checks_state.get(r["name"]) or {})
                entry.update(row=r["row"], depends_on=r["depends_on"], every=r["every"],
                             declared=r["declared"], takes_arg=r["takes_arg"], last_status=r["status"],
                             detail=r["detail"], last_run_utc=now, wall_s=r["wall_s"], traced=r["traced"],
                             ran_for=ran_for or entry.get("ran_for", ""), why=why)
                # The on-change trigger compares against this: the code the check just executed.
                entry["fingerprint"] = _check_fingerprint(entry, props or {})
                checks_state[r["name"]] = entry
            if report.get("selected") is None:      # a full run: checks removed from the suite drop out
                names = {r["name"] for r in report["checks"]}
                checks_state = {k: v for k, v in checks_state.items() if k in names}
            if status != "error":
                if any(v.get("last_status") == "fail" for v in checks_state.values()):
                    status = "red"
                elif any(v.get("last_status") == "pass" for v in checks_state.values()):
                    status = "green"
                else:
                    status = "empty"
        state = {"status": status, "returncode": rc, "utc": _utc_stamp(),
                 "wall_s": _SUITE_TIMING["wall_s"], "protocol": protocol, "why": why,
                 "selected": select or "all", "checks": checks_state,
                 # metering decisions survive every rewrite, like the epoch bindings below
                 "demotions": dict(prior.get("demotions") or {}) if protocol == 1 else {},
                 "core_hash": frozen_core.core_hash(ROOT),
                 # bindings survive every rewrite: a bound epoch stays bound
                 "scorer_hash_by_version": dict(prior.get("scorer_hash_by_version") or {})}
        _bind_scorer_hash(state, metric_version, frozen_core.scorer_hash(ROOT))
        CORRECTNESS_STATE.write_text(json.dumps(state, indent=2), encoding="utf-8")
    except Exception:
        pass
    return status


# ======================================================================================================
# SUPERVISOR MODE (the loop driver) - code at the joints, LLM judgment at the nodes.
#
# `--supervise` runs the campaign as an orchestrated loop: a dumb, deterministic driver spawns a
# FRESH-context worker agent per unit (cwd = campaign root, so the frozen CLAUDE.md spine auto-loads and
# the brief carries campaign.md + roles/worker.md), enforces the artifact gates, and validates what the
# worker left behind. There is no queue and no planner (MIGRATING: the loop without a queue): the worker chooses and
# authors its own unit from the JOURNAL (the working memory the previous worker wrote) and the ledger's
# last rows, and the record it owes is the same as before. The driver follows the gates and adds nothing
# of its own. Failures split by kind:
#   * INTEGRITY (ESCALATE present · corrupt results/driver_state.json · preflight / metric-selftest failure
#     · an UNDECLARED change to the FROZEN scorer (the epoch gate)) -> HALT LOUD. Never routed around.
#   * OPERATIONAL (worker spawn error / timeout / no unit saved after retries) -> counted and CONTINUE -
#     degrade-loud. A whole overnight loop must not die for one casualty.
#   * SYSTEMIC (N consecutive operational failures, driver.max_consecutive_failures) -> HALT LOUD:
#     N spawns failing the same way is the environment, not the units.
#   * RESOURCE (free disk below this campaign's floor, from unit_cost.typical_disk_mb) -> HALT LOUD at
#     the loop top: stopping cleanly beats letting a unit write half a save-set onto a full disk.
#   * DONE (the worker wrote `**NEXT:** STOP - <why>` in the JOURNAL: it judged the campaign's question
#     answered, or no unit worth running) -> the claim audit, then HALT: a stopping decision for the user.
#
# Liveness (dead-worker detection only; progress is judged by the ledger): the watch loop counts a
# worker alive while its stdout stream produces lines OR results/.run_heartbeat's mtime keeps changing;
# a worker with neither for worker.inactivity_timeout_min is killed. After a worker exits with a fresh
# heartbeat (a detached or backgrounded runner still solving), the driver waits up to
# driver.detached_grace_min for the save-set or heartbeat staleness before judging.
#
# Channels: results/inbox/*.md = INBOUND notes, relayed verbatim into the next worker prompt, then
# archived (the driver never parses them; the user writes them, and the driver itself leaves one when a
# verdict comes back REFUTED or INCONCLUSIVE with a follow-up). results/ESCALATE.md stays the loud
# OUTBOUND halt. results/diagnostics/supervise_<ts>.log = the append-only decision trace for this launch.
# results/.driver_alive = the running driver's sentinel (the Stop hook stands down while it is fresh).
#
# results/driver_state.json (driver-only, atomic writes): {"accepted_units": 0, "last_accept_utc": null,
#   "accepted": ["<exp_name>", ...], "pending_verification": [...], "consecutive_operational_failures": 0}.
# A campaign upgraded from the queue era keeps its counters: the first launch seeds them from the
# archived results/queue.json if no state file exists yet.
# ======================================================================================================

STATE = RESULTS / "driver_state.json"            # the driver's counters (no queue)
QUEUE_LEGACY = RESULTS / "queue.json"          # the retired queue: read once to seed the state, never written
ESCALATE = RESULTS / "ESCALATE.md"
LOOPCFG = ROOT / "configs" / "loop.json"
INBOX = RESULTS / "inbox"                    # user notes -> injected into the next spawn, then archived
INBOX_ARCHIVE = INBOX / "archive"
DRIVER_ALIVE = RESULTS / ".driver_alive"     # fresh mtime = a driver owns the loop (Stop hook stands down)
# THE BRIEF - what the driver compiles INTO every worker prompt so the agent orients from the
# prompt, never from the tree. Motivation (photophysics10, three launches, 2026-08): per spawn, workers
# re-read campaign.md 3-9 times in chunks, roles/worker.md up to 5 times, a 2 000-line JOURNAL up to
# 7 times, and the runner's own source up to 15 times, at 30-300 turns per unit - most of a unit's
# tokens went to re-orientation the driver could have delivered once. A pointed-at file is read only
# when the agent chooses (and re-read when it forgets); a delivered one is read exactly once and its
# hash is stamped into the snapshot. Sizes are REPORTED at preflight and every spawn, never silently
# capped: a truncated section is a loud marker in the prompt. The JOURNAL is never truncated - it is the
# loop's only memory, and a cap the worker trimmed toward cost it turns (TA-4: one unit spent eleven
# calls counting lines); its size is reported to the user instead, flagged past the warn line.
BRIEF_JOURNAL_WARN_CHARS = 24_000  # the feed and preflight flag a JOURNAL past this; nothing is cut (~2x a field one)
BRIEF_DIFF_CAP = 24_000         # chars: the snapshot diff inlined into the verifier's brief (the delta, by value)
BRIEF_CONFIG_CAP = 8_000        # chars: the config template the worker writes its unit from
BRIEF_ROLE_WARN_CHARS = 24_000  # preflight WARNs when a role file (the contract, delivered whole) grows past this
BRIEF_CELL_CAP = 240            # chars per cell of the ledger projection (a cell is a line, not an essay)
BRIEF_WARN_CHARS = 200_000      # preflight WARNs above this total (~50k tokens per spawn)
BRIEF_RECENT_ROWS = {"worker": 15}   # ledger rows delivered (the projection)
BRIEF_OMIT_SECTIONS = ("Decision record",)          # campaign.md sections that are a record, not the contract
_LAST_BRIEF: dict = {}          # role -> [(section, chars, truncated)] from the last _brief() - the feed line


def _md_split(text: str) -> list[tuple[str, str]]:
    """A Markdown file as [(heading, body)] on `## ` boundaries; the preamble has heading ''."""
    out, head, buf = [], "", []
    for line in text.splitlines():
        if line.startswith("## "):
            out.append((head, "\n".join(buf).strip()))
            head, buf = line[3:].strip(), []
        else:
            buf.append(line)
    out.append((head, "\n".join(buf).strip()))
    return out


def _clip(text: str, cap: int, where: str, advice: str) -> tuple[str, bool]:
    """A head clip with a loud marker that says what to do about it - per document, because the right
    advice differs (a template is kept short). The JOURNAL is never clipped."""
    if len(text) <= cap:
        return text, False
    return (text[:cap] + f"\n[driver: truncated at {cap} chars - the rest is on disk in {where}. {advice}]"), True


PRESET_SECTION = "## verification at your level"


def _role_for_preset(text: str, preset: str) -> str:
    """The worker role with only THIS preset's `### <preset>` subsection of §Verification at your level
    kept, and a driver line naming the preset. A preset the role has no subsection for keeps the section
    whole - the contract is never cut to nothing."""
    import re as _re
    lines = text.splitlines(keepends=True)
    names = []
    in_sec = False
    for L in lines:
        if L.startswith("## "):
            in_sec = L.strip().lower().startswith(PRESET_SECTION)
        elif in_sec and L.startswith("### "):
            m = _re.search(r"`([a-z-]+)`", L)
            names.append(m.group(1) if m else "")
    if preset not in names:
        return text
    out, in_sec, keep = [], False, True
    for L in lines:
        if L.startswith("## "):
            in_sec, keep = L.strip().lower().startswith(PRESET_SECTION), True
            out.append(L)
            if in_sec:
                out.append(f"[driver: this campaign runs verify.preset `{preset}`]\n")
            continue
        if in_sec and L.startswith("### "):
            m = _re.search(r"`([a-z-]+)`", L)
            keep = bool(m) and m.group(1) == preset
        if keep:
            out.append(L)
    return "".join(out)


def _brief(role: str) -> str:
    """Compile the brief for one spawn: the documents the role must have read, delivered by value, the
    CONTRACT first. The role file is the contract: every instruction the spawned agent must
    act on lives in roles/<role>.md, frozen and provenance-stamped with the campaign; the runner's own
    prompt is one opening line and the per-spawn values. Then the project's standing constraints; for
    the worker, the campaign definition, the JOURNAL, the config template it writes its unit from, and
    the ledger projection; for the verifier, this campaign's ONE metric by value (the delta itself, with
    the full snapshot diff, rides in the VALUES). The code is NOT delivered to the
    worker: most units are config-only, and the contract's read list says to open it by line range or
    grep, never whole."""
    parts, stats = [], []
    n_rows = BRIEF_RECENT_ROWS.get(role, 15)

    def add(title: str, where: str, text: str | None, truncated: bool = False):
        if text is None:
            text = f"[MISSING: {where} not found - report this in the journal; do not guess its content.]"
        parts.append(f"\n\n== {title} ({where}) ==\n{text}")
        stats.append((title, len(text), truncated))

    def read(rel: str) -> str | None:
        try:
            return (ROOT / rel).read_text(encoding="utf-8-sig")
        except OSError:
            return None

    # 1. the contract - whole, uncapped (a truncated contract is worse than a long one; preflight WARNs
    #    past BRIEF_ROLE_WARN_CHARS so growth is seen, never silently clipped) - save that the worker gets
    #    only its own preset's verification section
    contract = read(f"roles/{role}.md")
    if role == "worker" and contract is not None:
        contract = _role_for_preset(contract, _verify_rows(_read_json(LOOPCFG, {}) or {})["preset"])
    add(f"{role.upper()} ROLE", f"roles/{role}.md", contract)

    # 2. the project's standing constraints, by value
    ctx = _delivered_context()
    parts.append(ctx)
    stats.append(("standing constraints", len(ctx), False))

    if role == "worker":
        # 3. the campaign definition, minus its append-only record sections (a record, not the contract)
        camp = read("campaign.md")
        if camp is not None:
            kept, omitted = [], []
            for head, body in _md_split(camp):
                if any(head.lower().startswith(o.lower()) for o in BRIEF_OMIT_SECTIONS):
                    omitted.append(head)
                    continue
                kept.append(body if not head else f"## {head}\n{body}")
            camp = "\n\n".join(k for k in kept if k)
            if omitted:
                camp += ("\n\n[driver: omitted from this brief, on disk in campaign.md: "
                         + " · ".join(f"§{o}" for o in omitted) + " - a record, not the contract]")
        add("CAMPAIGN DEFINITION", "campaign.md", camp)

        # 4. the JOURNAL, whole and never clipped: the campaign's working memory - the worker rewrites it
        #    each unit, briefly; the ledger and the logbook hold the record it used to copy.
        journal, jwhere = read("results/JOURNAL.md"), "results/JOURNAL.md"
        if journal is None:                      # mid-unit: the driver archived and removed it; deliver the archive
            arch = _newest_journal_archive()
            if arch is not None:
                journal, jwhere = read(str(arch.relative_to(ROOT))), str(arch.relative_to(ROOT)).replace("\\", "/")
        if journal is not None:
            add("JOURNAL (the previous unit's - write results/JOURNAL.md anew)", jwhere, journal)
        else:
            add("JOURNAL (the previous unit's - write results/JOURNAL.md anew)", "results/JOURNAL.md", None)

        # 5. the config template: the schema the worker writes its unit to - delivered so it is never opened
        tmpl = read("configs/_template.json")
        tr = False
        if tmpl is not None:
            tmpl, tr = _clip(tmpl, BRIEF_CONFIG_CAP, "configs/_template.json",
                             "A template is a schema, not a document: keep it short.")
        add("CONFIG TEMPLATE (write configs/<exp_name>.json from it)", "configs/_template.json", tmpl, tr)

        # 6. the ledger projection: the last rows' narrative columns (what, expected vs found, label, note,
        #    finding) - the one-line timeline; the numeric columns stay on disk, opened by id when needed
        if (ROOT / "results" / "scoreboard.tsv").is_file():
            board, dropped = _ledger_projection(n_rows)
            if dropped:
                board += (f"\n[driver: {dropped} older row(s) not delivered - the full ledger is "
                          "results/scoreboard.tsv; open a row by id]")
            add("LEDGER (last rows)", "results/scoreboard.tsv", board)
        else:
            add("LEDGER (last rows)", "results/scoreboard.tsv", None)

        # 7. the previous units' artifacts, by SHAPE (TA-1): what each file holds, so a worker building on
        #    the last units opens a file only for the values it needs - never to print its keys
        units = _recent_units(2)
        if units:
            text = []
            for eid, label in units:
                text.append(f"-- {label} --")
                text += _digest_lines(eid, label)
            dig = "\n".join(text)
            if len(dig) > DIGEST_BRIEF_CAP:
                dig = (dig[:DIGEST_BRIEF_CAP].rsplit("\n", 1)[0]
                       + "\n[driver: digest cut here - `python scripts/run_campaign.py --digest <exp>` prints one "
                         "unit's whole digest]")
            add("PREVIOUS UNITS' ARTIFACTS (the shape of each file; open one only for its values)",
                "results/", dig)

    elif role == "verifier":
        # the verifier verifies the DELTA (in the VALUES). From campaign.md it needs the metric definition,
        # delivered by value here so it never opens campaign.md; the JOURNAL (the worker's plan /
        # what-to-try-next) is deliberately NOT delivered - exploration is the worker's job, the verifier
        # checks the claim as recorded. (§Verification is not delivered by value: it names the verify skill
        # by a harness-specific slug, and the verifier's own verify skill covers the methodology.)
        camp = read("campaign.md")
        if camp is not None:
            kept = [f"## {head}\n{body}" for head, body in _md_split(camp)
                    if head and head.lower().startswith("the one metric")]
            add("METRIC (from campaign.md, by value)", "campaign.md §The ONE metric",
                "\n\n".join(kept) if kept else None)

    _LAST_BRIEF[role] = stats
    return "".join(parts)


def _brief_line(role: str) -> str:
    """One feed line: the brief's total and per-section sizes, naming any truncation and a JOURNAL past
    its warn line (reported to the user, never cut)."""
    stats = _LAST_BRIEF.get(role) or []
    total = sum(n for _, n, _ in stats)
    bits = " · ".join(f"{t.lower()} {n / 1024:.1f}" + (" (TRUNCATED)" if tr else "")
                      + (" (LARGE)" if t.startswith("JOURNAL") and n > BRIEF_JOURNAL_WARN_CHARS else "")
                      for t, n, tr in stats)
    return f"brief[{role}]: {total / 1024:.1f} KB ({bits})"
# Override with e.g. AUTORESEARCH_AGENT_CMD="claude -p" if the CLI lives elsewhere on this machine.
# Quote-aware split, not str.split: a Windows interpreter path like "C:\Program Files\...\python.exe"
# must stay one token when quoted, or a naive split breaks every such setup at spawn time.
def _parse_agent_cmd(s: str) -> list[str]:
    import shlex
    return [t.strip('"') for t in shlex.split(s, posix=False)]


AGENT_CMD = _parse_agent_cmd(os.environ.get("AUTORESEARCH_AGENT_CMD") or "claude -p")
STREAM_FLAGS = ["--output-format", "stream-json", "--verbose"]   # only added per driver.stream policy
_AGENT_BACKEND = None
_LAST_CODEX_OBSERVER = None


def _permission_flags(mode: str) -> list[str]:
    """`--permission-mode <mode>` for spawned agents (default 'auto' - see _driver_knobs).
    Passed ONLY to the default claude CLI: a custom AUTORESEARCH_AGENT_CMD (e.g. the test stub) is handed
    no permission flag it may not understand. An empty mode disables the flag entirely."""
    if not mode or "AUTORESEARCH_AGENT_CMD" in os.environ:
        return []
    return ["--permission-mode", mode]


SPAWN_LISTING_SETTING = {"skillListingBudgetFraction": 0.0001}   # driver.skill_listing = names (default)
SPAWN_MEMORY_SETTING = {"autoMemoryEnabled": False}              # driver.auto_memory = off (default)


def _settings_flags(listing: str, memory: str) -> list[str]:
    """ONE `--settings` for the spawn (the CLI takes one), merged on top of the campaign's own
    .claude/settings.json - so the hooks (the promotion guard, the heartbeat) still run; an interactive
    session opened in the campaign directory is untouched. Passed ONLY to the default claude CLI, like
    the permission flag.
    - driver.skill_listing (default 'names'; 'full' keeps the harness's own listing; env
      AUTORESEARCH_SKILL_LISTING): every skill listed by NAME ONLY. The campaign's files name the skill
      to use, and the descriptions cost about 7k tokens of every turn on a 1M-context model. It hides
      EVERY installed plugin's descriptions inside the spawn, not only physkit's.
    - driver.auto_memory (default 'off'; 'on' keeps it; env AUTORESEARCH_AUTO_MEMORY): the harness's
      per-directory memory folder (~/.claude/projects/<dir>/memory/), loaded into every later session in
      the directory. Off because what one worker leaves there for the next is in no record of the
      campaign - not the JOURNAL, the ledger or a snapshot - and lives on one machine; a note worth
      passing on goes in the JOURNAL's Traps and tooling. Evidence: the Peng-96 chain arm's workers kept
      two notes there across four spawns (case-studies/spawn_overhead_probe_2026-09-25.md)."""
    if "AUTORESEARCH_AGENT_CMD" in os.environ:
        return []
    settings = {}
    if (listing or "names").strip().lower() != "full":
        settings.update(SPAWN_LISTING_SETTING)
    if (memory or "off").strip().lower() != "on":
        settings.update(SPAWN_MEMORY_SETTING)
    return ["--settings", json.dumps(settings, separators=(",", ":"))] if settings else []


def _mcp_flags(mode: str) -> list[str]:
    """The MCP servers a spawn may use (driver.mcp_servers; env AUTORESEARCH_MCP_SERVERS):
    'none' (default) - `--strict-mcp-config` with no config, so the spawn gets NO MCP server: not the
    user's, not a project .mcp.json, not the claude.ai account's connectors. A spawn runs unattended, and
    the connectors attach nondeterministically (the overhead probe saw two appear in one run of three,
    moving the context ~8k tokens). 'inherit' - whatever the harness would load. A path (relative to the
    campaign) - exactly the servers in that MCP config file, e.g. an instrument a campaign drives through
    MCP. Passed ONLY to the default claude CLI."""
    if "AUTORESEARCH_AGENT_CMD" in os.environ:
        return []
    m = (mode or "none").strip()
    if m.lower() == "inherit":
        return []
    if m.lower() == "none":
        return ["--strict-mcp-config"]
    return ["--strict-mcp-config", "--mcp-config", str((ROOT / m).resolve())]


def _spawn_isolation_problems(k: dict) -> list[str]:
    """Preflight's check of the two spawn-isolation knobs: a typo would otherwise change every spawn
    silently, and a missing MCP config file would fail every spawn at launch."""
    problems = []
    if k.get("auto_memory", "off") not in ("off", "on"):
        problems.append(f"driver.auto_memory is {k['auto_memory']!r} - use 'off' (the default) or 'on'. "
                        "Fix: correct configs/loop.json (or AUTORESEARCH_AUTO_MEMORY).")
    m = str(k.get("mcp_servers", "none")).strip()
    if m.lower() not in ("none", "inherit") and not (ROOT / m).is_file():
        problems.append(f"driver.mcp_servers names {m!r}, which is not a file in the campaign - use 'none' "
                        "(the default), 'inherit', or the path of an MCP config file relative to the "
                        "campaign. Fix: correct configs/loop.json (or AUTORESEARCH_MCP_SERVERS).")
    return problems

# The runner's own prompt is ONE opening line per role (the stub and the harness read the role from it)
# plus, for the verifier and the capstone, the per-spawn VALUES the driver fills. Every instruction the
# agent must act on lives in roles/<role>.md - the contract, delivered first in the brief, frozen and
# provenance-stamped with the campaign, readable and editable by the researcher. A prompt
# string the runner rewrote on upgrade was the one instruction surface that broke the kit's
# freeze-and-stamp rule; a stale role costs a fix-up turn (the runner's refusals and --help carry the
# current shapes), which is the trade the decision made.
WORKER_OPENING = ("You are the iteration worker for the autoresearch campaign in this directory. Your "
                  "contract is the WORKER ROLE below; CLAUDE.md auto-loads on top of this prompt; everything "
                  "else you need is compiled into it, in the order you need it.")
VERIFIER_OPENING = ("You are the verification agent for the autoresearch campaign in this directory, spawned "
                    "to independently verify completed experiment(s): {exps}. Verify the DELTA - what changed "
                    "since the last independent check, and the claim it produced - both in the per-spawn VALUES "
                    "below (the change summary, the full snapshot diff, this campaign's ONE metric). The "
                    "unchanged parts carry their prior independent verdict; do not "
                    "re-orient on the whole campaign. Your contract is the VERIFIER ROLE below; CLAUDE.md "
                    "auto-loads on top of this prompt.")
CAPSTONE_OPENING = ("You are the claim-audit agent for the autoresearch campaign in this directory, spawned by "
                    "the driver at the end of the loop ({reason}) because the campaign's verification preset asks "
                    "for the claim audit at level {level}; it re-checks the final best once more. Your contract "
                    "is the CAPSTONE ROLE below; CLAUDE.md auto-loads on top of this prompt.")


def _service_capstone(k: dict, model: str, effort: str, reason: str) -> None:
    """At the end of the loop (a graceful STOP, or the worker's STOP judgement): spawn the claim audit the
    preset asks for, once per stretch of new results. The audit is the counterweight to a light
    preset - the campaign-scale checks no per-unit verifier runs - so the loop's end is where it belongs,
    before the record is read as finished. Skipped when the preset's capstone row is off, when nothing
    was accepted, or when an audit artifact already postdates the last accepted unit."""
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    vr = _verify_rows(loop_cfg)
    level = str(vr["rows"].get("capstone") or "default")
    q0 = _read_state()
    waiting = [e.get("exp") for e in (q0.get("awaiting_survival") or []) + (q0.get("peer_due") or [])]
    if waiting:
        # A best still waiting for its survivor check at the loop's end: the capstone re-checks the final
        # best; the entries stay on record, so a relaunch still services them.
        print(f"[supervise] checks still owed at {reason}: {', '.join(waiting)} - the claim audit re-checks the "
              f"final best; the entries stay for a relaunch utc={_utc_stamp()}")
    if level == "off":
        print(f"[supervise] capstone: the preset's capstone row is off - no claim audit at {reason} "
              f"utc={_utc_stamp()}")
        return
    q = _read_state()
    last = str(q.get("last_accept_utc") or "")
    if not int(q.get("accepted_units", 0) or 0) or not last:
        print(f"[supervise] capstone: nothing accepted yet - no claim audit at {reason} utc={_utc_stamp()}")
        return
    try:
        last_ts = _dt.datetime.fromisoformat(last).timestamp()
    except ValueError:
        last_ts = 0.0
    audits = sorted(VERDICTS.glob("audit_*.json")) if VERDICTS.is_dir() else []
    if audits and audits[-1].stat().st_mtime >= last_ts:
        print(f"[supervise] capstone: {audits[-1].name} already postdates the last accepted unit - no "
              f"new claim audit at {reason} utc={_utc_stamp()}")
        return
    print(f"[supervise] capstone: spawning the claim audit (level={level}) at {reason} utc={_utc_stamp()}")
    st = _spawn_with_backoff(build_prompt("capstone", reasons=reason, capstone_level=level), model, "capstone", k,
                      saved_probe=lambda: bool(list(VERDICTS.glob("audit_*.json"))
                                               and sorted(VERDICTS.glob("audit_*.json"))[-1].stat().st_mtime >= last_ts),
                      effort=effort)
    done = sorted(VERDICTS.glob("audit_*.json")) if VERDICTS.is_dir() else []
    if done and done[-1].stat().st_mtime >= last_ts:
        print(f"[supervise] capstone: claim audit on record - {done[-1].name} utc={_utc_stamp()}")
    else:
        print(f"[supervise] capstone: the claim audit left no artifact (status={st}) - run "
              f"/physkit:claim-audit yourself before reading the record as finished utc={_utc_stamp()}")


def _md_section(path: Path, heading: str) -> str | None:
    """The body of one `## <heading>` section of a Markdown file, or None if file/section is absent."""
    try:
        text = path.read_text(encoding="utf-8-sig")
    except OSError:
        return None
    lines, keep = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            if keep:
                break
            keep = heading.lower() in line.lower()
            continue
        if keep:
            lines.append(line)
    return "\n".join(lines).strip() if lines else None


def _delivered_context() -> str:
    """The living context every spawned agent carries: the project's §Standing constraints
    (PROJECT.md; a pre-consolidation project keeps it in PROJECT_ORIENTATION.md) - the one document
    OUTSIDE the per-cycle read set that must still be guaranteed present.

    Delivered by VALUE, not by pointer: a pointed-at constraint is read only when an agent chooses
    to look, and these are the constraints that must not depend on that choice. (The campaign's own
    landmines and checks need no injection: they live in campaign.md, delivered in the worker's brief
    every cycle.) The doc is living, so what was delivered can differ between
    experiments - which is why the per-experiment snapshot stamps the spawn prompt's hash (see
    snapshot_experiment).

    A missing section is named LOUDLY in the prompt rather than silently absent, because a constraint
    delivery that degrades to nothing recreates the recorded-but-unread failure this mechanism
    exists to close. Preflight refuses to launch without the constraints section at all.
    """
    src = _orientation_file()
    constraints = _md_section(src, "Standing constraints")
    return (f"\n\n== STANDING CONSTRAINTS (../../{src.name} - the project overview; "
            "equations, methods, instrument and durable decisions live below this section) ==\n"
            + (constraints or f"[MISSING: ../../{src.name} has no '## Standing "
               "constraints' section. Report this in the journal; do not guess the constraints.]"))


def build_prompt(role: str, *, reasons: str = "<trigger reasons>",
                 notes: str = "", exps: str = "<exp ids>", hypothesis: str = "",
                 retry_note: str = "", mode: str = "", capstone_level: str = "default",
                 peer: list | None = None) -> str:
    """The ONE assembly path for a spawned agent's prompt.

    Both spawn sites AND `--show-prompt` come through here, so what a reviewer inspects is what an
    agent receives, byte for byte. The prompt is: one opening line; for the verifier and the capstone
    the per-spawn VALUES (experiments, hypothesis, mode, the change manifest and full snapshot diff, a
    retry note; the reason and the level) - values, never instructions; then the brief (see _brief): the
    role file FIRST (the contract), the standing constraints, and for the worker the campaign definition,
    the JOURNAL, the config template and the ledger projection, for the verifier this campaign's ONE
    metric; then the user notes. Every authored text is appended by
    CONCATENATION, never through .format(), so braces in doc text or notes cannot crash the driver.
    NOT included: the campaign `CLAUDE.md`, which the agent harness auto-loads on top of this. This
    returns the literal spawn string, nothing more.
    """
    if role == "worker":
        values = ""
        if peer:
            # The peer checks this worker owes first.
            stems = [str(e.get("exp")) for e in peer]
            values = ("\n\n== VALUES (this spawn) ==\npeer check owed first: "
                      + "; ".join(f"{e.get('exp')} ({e.get('why') or 'survived'})" for e in peer)
                      + "\nthe delta since the last independent check (change summary + the full snapshot diff, "
                        "by value):\n" + _changes_summary(", ".join(stems)))
        return WORKER_OPENING + values + _brief("worker") + notes
    if role == "verifier":
        # The values ride in as VALUES (never through a template string): braces in authored text
        # cannot crash the driver. No inbox notes: user steering goes to the judgment agent (the
        # worker); the verifier stays isolated from it.
        changes = _changes_summary(exps) if exps and exps != "<exp ids>" else "  (per-experiment change record)"
        check_line = mode.strip() or "(the result's one independent check)"
        values = ("\n\n== VALUES (this spawn) ==\nexperiments: " + exps
                  + ("\nhypothesis (what the unit tests): " + hypothesis if hypothesis else "")
                  + "\ncheck: " + check_line
                  + "\nthe delta since the last independent check (change summary + the full snapshot diff, by value):\n" + changes
                  + (("\nRETRY: the previous " + retry_note + ". Produce those artifacts in THIS turn: run the "
                      "refuter in the foreground and stay until each file exists.") if retry_note else ""))
        return VERIFIER_OPENING.format(exps=exps) + values + _brief("verifier")
    if role == "capstone":
        # The end-of-loop claim audit: no inbox notes (it is a check, not a steering agent). It re-checks the
        # final best once more - named here with its label and the delta since the last
        # independent check, by value.
        values = f"\n\n== VALUES (this spawn) ==\nreason: {reasons}\nlevel: {capstone_level}"
        try:
            best = _incumbent(_prior_results(""), _campaign_props())
        except Exception:
            best = None
        if best is not None:
            values += (f"\nthe final best (re-checked here, once): {best['exp_name']} = {best['score']:.6g}, "
                       f"label {best.get('label') or 'unverified'}\nits delta since the last independent check "
                       "(by value):\n" + _changes_summary(best["exp_name"]))
        return CAPSTONE_OPENING.format(reason=reasons, level=capstone_level) + values + _brief("capstone")
    raise ValueError(f"unknown role {role!r} (expected 'worker', 'verifier' or 'capstone')")


def _read_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8-sig"))   # BOM-tolerant: Windows editors add one
    except Exception:
        return default


# ---- campaign properties (what kind of campaign this is) ----------------------------------------------
# Two setup-time declarations every mechanical check branches on. They live in one place, configs/loop.json
# "campaign" - because Tier 0 asserts a routing row's leading concept occurs in the file it names, so a
# property split across campaign.md prose and JSON would be a fork with a green check over it.

NOISE_MODELS = ("stochastic", "deterministic")
# The verification PRESET (configs/loop.json verify.preset) - the one user-facing choice of how much
# verification a campaign buys, and of what kind. Each preset is a FIXED table of rows x
# triggers that the runner resolves, prints at preflight, and stamps into every checks artifact; the table
# is the runner's implementation of the preset, never a config surface (the physkit plugin's docs/reference/verification-presets.md
# is the single source of what each preset means).
# Rows: invariants (cheap authored output checks), machinery (the code's own fixed-input checks), gates
# (expensive per-result gates) - triggers every | promotion (a new best) | on-change | setup | off;
# self_check (the worker's recorded checks) - every | off; self_verify (the verify protocol, run by the
# worker in its own session on its own result) - every | out-of-range (outside the plausible range) | off; independent (a context other
# than the one that produced the result) - survivor:peer (a new best, checked by the next worker once the
# next unit has not beaten it) | survivor:verifier (the same, by a driver-spawned verifier) |
# every:verifier | off; capstone (the end-of-campaign claim audit, which re-checks the final best) -
# default | off. ONE CHECK PER RESULT: a result owed an independent check is never also self-verified.
VERIFY_PRESETS = ("none", "minimal", "light", "heavy", "intensive")
VERIFY_ROWS = ("invariants", "machinery", "gates", "self_check", "self_verify", "independent", "capstone")
VERIFY_PRESET_ROWS = {
    "none":      {"invariants": "off",   "machinery": "off",       "gates": "off",       "self_check": "off",
                  "self_verify": "off",          "independent": "off",               "capstone": "off"},
    "minimal":   {"invariants": "every", "machinery": "off",       "gates": "off",       "self_check": "every",
                  "self_verify": "out-of-range", "independent": "off",               "capstone": "default"},
    "light":     {"invariants": "every", "machinery": "setup",     "gates": "promotion", "self_check": "every",
                  "self_verify": "out-of-range", "independent": "survivor:peer",     "capstone": "default"},
    "heavy":     {"invariants": "every", "machinery": "on-change", "gates": "promotion", "self_check": "every",
                  "self_verify": "every",        "independent": "survivor:verifier", "capstone": "default"},
    "intensive": {"invariants": "every", "machinery": "every",     "gates": "every",     "self_check": "every",
                  "self_verify": "off",          "independent": "every:verifier",    "capstone": "default"},
}
VERIFY_PRESET_EXTRAS = {"intensive": {"blinded": True}}
VERIFY_PRESET_DEFAULT = "minimal"
# Names a loop.json may still carry, refused with what replaced them (no campaign ran them for
# its result, so there is no silent mapping).
VERIFY_PRESET_RENAMED = {"moderate": "heavy"}


def _verify_rows(loop_cfg: dict) -> dict:
    """The resolved verification table for this campaign: verify.preset, else the default preset (said
    at preflight). Returns {preset, source, rows, extras}."""
    v = loop_cfg.get("verify") if isinstance(loop_cfg.get("verify"), dict) else {}
    preset = str(v.get("preset") or "").strip().lower()
    source = "preset"
    if not preset:
        preset, source = VERIFY_PRESET_DEFAULT, "default"
    return {"preset": preset, "source": source, "rows": dict(VERIFY_PRESET_ROWS.get(preset) or {}),
            "extras": dict(VERIFY_PRESET_EXTRAS.get(preset) or {})}


def _rows_line(r: dict) -> str:
    """One line a reader can act on: the preset and the resolved table."""
    table = " ".join(f"{row}={r['rows'].get(row, '?')}" for row in VERIFY_ROWS)
    extras = "".join(f" {k}" for k, on in r["extras"].items() if on)
    return (f"preset={r['preset']}" + (" (the default - no verify.preset)" if r["source"] == "default" else "")
            + f" ({table}{extras})")


def verify_problems(loop_cfg: dict) -> tuple[list[str], list[str]]:
    """Every way configs/loop.json 'verify' can be WRONG (hard failures), and the notes worth a line.
    An unknown preset is refused, never defaulted: a misspelt preset that silently became 'light'
    would be a control nobody chose."""
    problems, notes = [], []
    if loop_cfg.get("verify") is not None and not isinstance(loop_cfg.get("verify"), dict):
        return ["configs/loop.json verify must be an object"], notes
    r = _verify_rows(loop_cfg)
    c = loop_cfg.get("campaign") if isinstance(loop_cfg.get("campaign"), dict) else {}
    if c.get("verification"):
        problems.append(f"configs/loop.json campaign.verification={c.get('verification')!r} is retired - set "
                        "verify.preset (" + " | ".join(VERIFY_PRESETS) + ") and delete the old key "
                        "(docs/MIGRATING.md)")
    if r["preset"] in VERIFY_PRESET_RENAMED:
        problems.append(f"configs/loop.json verify.preset {r['preset']!r} was renamed "
                        f"{VERIFY_PRESET_RENAMED[r['preset']]!r} - set the new name")
    elif r["preset"] not in VERIFY_PRESETS:
        problems.append(f"configs/loop.json verify.preset is {r['preset']!r}; expected one of "
                        + " | ".join(VERIFY_PRESETS) + " (the physkit plugin's docs/reference/verification-presets.md). "
                        "No default is substituted for a misspelt preset.")
    elif r["preset"] in ("none", "minimal"):
        notes.append(f"verify.preset={r['preset']} - NO independent check runs in the loop; every result is "
                     "labelled by what was actually checked" + (" (the claim audit still runs at the end)"
                                                                if r["preset"] == "minimal" else
                                                                ", no claim audit runs, and a shareable report "
                                                                "waits for one") + ". Exploration only.")
    if r["source"] == "default":
        notes.append(f"configs/loop.json names no verify.preset - running the default {VERIFY_PRESET_DEFAULT!r}")
    return problems, notes
# WHO may revise the FROZEN metric mid-campaign (the metric-epoch design). 'cautious' (default): a revision the loop's
# agents want raises results/ESCALATE.md and waits for the user. 'autonomous': the agents enact a VERIFIED
# revision themselves as a pending epoch in campaign.metric_epochs and continue; the user ratifies after.
# The dial is the user's: only an attended session may set it (the config guard refuses a spawned role).
METRIC_REVISION_MODES = ("cautious", "autonomous")
METRIC_REVISION_RESERVED = ("semi-autonomous",)   # named in the design, rules not yet defined: refused, not defaulted


def _campaign_props(loop_cfg: dict | None = None) -> dict:
    """This campaign's two properties + their numeric companions, with code defaults.

    The defaults reproduce the pre-V0 behaviour EXACTLY (a required numeric range; a stochastic campaign),
    so a loop.json written before this block existed keeps working unchanged - the same additive contract
    _driver_knobs() uses for the driver section.

    An unrecognized VALUE is not silently defaulted here: it is normalized to whatever was written and
    rejected by campaign_props_problems(), which both preflight and validate_campaign.py run. A typo'd
    "determinstic" that quietly fell back to "stochastic" would leave a deterministic campaign held to a
    spread test it can never satisfy - and it would fail in the direction that looks like rigor, which is
    the direction nobody investigates.
    """
    if loop_cfg is not None:
        src = loop_cfg
    elif not LOOPCFG.is_file():
        return {"_unreadable": f"configs/loop.json is missing ({LOOPCFG})"}
    else:
        src = _read_json(LOOPCFG, None)
        if src is None:
            return {"_unreadable": "configs/loop.json does not parse as JSON"}
    if not isinstance(src, dict):
        return {"_unreadable": f"configs/loop.json is a {type(src).__name__}, not a JSON object"}
    c = src.get("campaign")
    if c is None:
        c = {}
    elif not isinstance(c, dict):
        return {"_unreadable": f'configs/loop.json "campaign" is a {type(c).__name__}, not an object'}

    bad_nums = []

    def _num(key):
        """Strictly numeric, finite, non-negative - or None (unset). A resolution knob is a magnitude.

        Deliberately NOT coercing: a string "0.05" is a filled-in-wrong field, not a number, and
        accepting it teaches that the schema is advisory. A NEGATIVE value is worse than wrong - it makes
        the noise check pass unconditionally (|delta| > -1 always) and makes "unchanged" unobservable, so
        it fails silently in the direction that looks like a clean result.
        """
        v = c.get(key)
        if v is None:
            return None
        if isinstance(v, bool) or not isinstance(v, (int, float)):
            bad_nums.append(f"campaign.{key} is {v!r}; it must be a JSON number or null, not a "
                            f"{type(v).__name__} (a quoted number is a string, not a number)")
            return None
        v = float(v)
        if not np.isfinite(v) or v < 0:
            bad_nums.append(f"campaign.{key} is {v!r}; a resolution is a finite, non-negative magnitude")
            return None
        return v

    return {
        "noise_model": str(c.get("noise_model") or "stochastic").strip().lower(),
        "noise_floor": _num("noise_floor"),
        "tolerance": _num("tolerance"),
        "metric_version": str(c.get("metric_version") or "").strip(),
        "data_version": str(c.get("data_version") or "").strip(),
        # Absent (an older loop.json): a hardware-in-the-loop campaign (configs/instrument.json) is
        # not re-executable from a config; anything else is assumed to be. A fact the verifier reads when
        # it chooses how to refute, not a trigger.
        "reproducible": (bool(c["reproducible"]) if isinstance(c.get("reproducible"), bool)
                         else not (ROOT / "configs" / "instrument.json").is_file()),
        "metric_revision": str(c.get("metric_revision") or "cautious").strip().lower(),
        # absent = the campaign is still on its co-designed first metric (the implicit epoch)
        "metric_epochs": {} if c.get("metric_epochs") is None else c.get("metric_epochs"),
        "_bad_nums": bad_nums,
    }


def campaign_props_problems(props: dict) -> list[str]:
    """Every way configs/loop.json "campaign" can be WRONG, as plain-language fixes. Hard failures only.

    Shared by the runner's preflight and by new-campaign's validate_campaign.py so scaffold time and launch
    time cannot disagree about what a legal campaign block is - two copies of one rule drift, and the drift
    shows up as a campaign that validates and then refuses to launch.

    A MISSING noise_floor / tolerance is deliberately NOT a failure: it is unset debt, and the honest
    response is for the checks artifact to report that check `unavailable` naming the knob that would
    supply it, not for the runner to refuse a campaign that has not estimated its spread yet.
    """
    bad = []
    if props.get("_unreadable"):
        # Not defaulted. Running an experiment under properties nobody chose turns a deterministic
        # campaign into a stochastic one with no error: its tolerance vanishes and the noise check goes
        # unavailable, while the run is scored and recorded as though all of that were intended.
        return [props["_unreadable"] + ". Fix: restore it (new-campaign generates it; a "
                "results/snapshots/ copy has the version this campaign last ran under)."]
    bad.extend(props.get("_bad_nums") or [])
    if props["noise_model"] not in NOISE_MODELS:
        bad.append(f"configs/loop.json campaign.noise_model is {props['noise_model']!r}; expected one of "
                   f"{' | '.join(NOISE_MODELS)}. Fix: 'deterministic' if repeating a run reproduces the "
                   "metric exactly, else 'stochastic'.")
    if props["metric_revision"] not in METRIC_REVISION_MODES:
        if props["metric_revision"] in METRIC_REVISION_RESERVED:
            bad.append(f"configs/loop.json campaign.metric_revision is {props['metric_revision']!r}, which is "
                       "RESERVED: its rules are not defined yet, so it is refused rather "
                       "than silently treated as something else. Fix: 'cautious' (a metric revision asks the "
                       "user first) or 'autonomous' (the loop enacts a verified revision as a pending epoch; "
                       "the user ratifies after).")
        else:
            bad.append(f"configs/loop.json campaign.metric_revision is {props['metric_revision']!r}; expected "
                       f"one of {' | '.join(METRIC_REVISION_MODES)}. Fix: 'cautious' (the default - a metric "
                       "revision raises results/ESCALATE.md and waits for you) or 'autonomous' (the loop "
                       "enacts a verified revision as a pending epoch in campaign.metric_epochs and continues; "
                       "you ratify after).")
    epochs = props.get("metric_epochs")
    if not isinstance(epochs, dict):
        bad.append("configs/loop.json campaign.metric_epochs must be a JSON object keyed by metric_version "
                   "(one entry per revised epoch: kind, status, evidence, expected_direction), or absent while "
                   "the campaign is still on its first metric.")
    else:
        for vid, e in epochs.items():
            if (not isinstance(e, dict) or str(e.get("kind", "")) not in EPOCH_KINDS
                    or str(e.get("status", "")) not in EPOCH_STATUSES):
                bad.append(f"configs/loop.json campaign.metric_epochs[{vid!r}] must be an object with kind "
                           f"({' | '.join(EPOCH_KINDS)}) and status ({' | '.join(EPOCH_STATUSES)}).")
                break
    return bad


def _halt(msg: str):
    """Hard halt, LOUDLY and ON THE RECORD: the reason goes through stdout (tee'd to the driver log by
    DriverLog), not only stderr - a halt whose reason lives nowhere is a silent halt by morning. Stamped,
    so the idle time a halt costs is measurable from the log alone."""
    print(f"{msg} utc={_utc_stamp()}")
    sys.exit(1)


# ---- disk budget --------------------------------------------------------------------------------------
# A campaign that runs out of disk overnight fails in the worst way available: half-written artifacts, a
# save-set gate tripping on I/O errors, and a ledger that disagrees with what is on disk. The per-unit
# footprint is estimated at scaffold time (new-campaign, from the artifact plan) into
# configs/loop.json unit_cost.typical_disk_mb; here it becomes a launch refusal and a loop-top stop.
DISK_FLOOR_UNITS = 3        # refuse to launch / keep running below this many units of headroom
DISK_WARN_UNITS = 20        # short-runway note (not a failure)
DISK_FLOOR_MB = 512         # absolute floor - below this, writes start failing whatever the estimate says


def _free_disk_mb() -> float | None:
    try:
        return shutil.disk_usage(ROOT).free / (1024 * 1024)
    except OSError:
        return None


def _unit_disk_mb(loop_cfg: dict) -> float:
    """Estimated MB one unit adds to results/. 0 or absent = not estimated, which DISABLES the check
    rather than guessing a floor that could refuse a healthy launch (older campaigns lack the field)."""
    try:
        return float((loop_cfg.get("unit_cost") or {}).get("typical_disk_mb", 0) or 0)
    except (TypeError, ValueError):
        return 0.0


def _disk_floor_mb(per_unit: float) -> float:
    return max(DISK_FLOOR_MB, DISK_FLOOR_UNITS * per_unit)


def _mb(x: float) -> str:
    """MB, readable at both ends of the range a campaign can span (0.5 MB analytic -> 40 GB checkpoints)."""
    return f"{x:,.1f}" if x < 10 else f"{x:,.0f}"


def _verifier_section(loop_cfg: dict) -> dict:
    """The loop.json block whose model/effort drive the verifier and the capstone: "verifier" (the
    template since the planner's retirement), else the retired "planner" block an older file still
    carries, else the worker's."""
    for key in ("verifier", "planner", "worker"):
        sec = loop_cfg.get(key)
        if isinstance(sec, dict) and sec:
            return sec
    return {}


def _driver_knobs(loop_cfg: dict) -> dict:
    """Driver-section knobs with code-side defaults: an older loop.json without a "driver" section keeps
    working unchanged (these knobs are additive). The template ships these as literals - no placeholders,
    no setup interview; hand-edit configs/loop.json to change them (the driver hot-reloads it)."""
    d = loop_cfg.get("driver") or {}
    w = loop_cfg.get("worker") or {}
    return {
        "max_consecutive_failures": int(d.get("max_consecutive_failures", 3)),
        # A verifier that returns ok having written no artifact is retried on its own count; an older
        # loop.json without the key inherits planner_retries, which is what governed it before.
        "verifier_retries": int(d.get("verifier_retries", d.get("planner_retries", 1))),
        "stream": str(d.get("stream", "auto")).strip().lower(),
        "inbox_max_chars": int(d.get("inbox_max_chars", 20000)),
        "feed_chars": int(d.get("feed_line_chars", 160)),
        "hb_stale_s": float(d.get("heartbeat_stale_min", 5)) * 60,
        "grace_s": float(d.get("detached_grace_min", 60)) * 60,
        "inactivity_s": float(w.get("inactivity_timeout_min", 30)) * 60,
        # The spawned roles' permission mode. Default "auto" - the standard classifier: it ALLOWS local file
        # ops in project scope, reads, and killing a subprocess THIS session created by its tracked PID,
        # and DENIES (cleanly, no prompt in a headless spawn - verified) the dangerous ones: killing a
        # process it did not create, secret writes, exfiltration, spawning bypass agents. Set
        # "bypassPermissions" for a campaign that genuinely needs a soft-denied action (an irreversible
        # overwrite of a pre-existing untracked file, a cross-session kill, a force-push). Env override:
        # AUTORESEARCH_PERMISSION_MODE. Choices are the claude CLI's: auto, bypassPermissions, acceptEdits,
        # dontAsk, manual, plan.
        "permission_mode": (os.environ.get("AUTORESEARCH_PERMISSION_MODE")
                            or str(d.get("permission_mode", "auto"))).strip() or "auto",
        # names (default): spawns list every skill by name only; full: the harness's own listing.
        "skill_listing": (os.environ.get("AUTORESEARCH_SKILL_LISTING")
                          or str(d.get("skill_listing", "names"))).strip().lower() or "names",
        # off (default): the harness's auto-memory is off inside spawns; on: kept (_settings_flags).
        "auto_memory": (os.environ.get("AUTORESEARCH_AUTO_MEMORY")
                        or str(d.get("auto_memory", "off"))).strip().lower() or "off",
        # none (default) | inherit | a campaign-relative MCP config path (_mcp_flags).
        "mcp_servers": (os.environ.get("AUTORESEARCH_MCP_SERVERS")
                        or str(d.get("mcp_servers", "none"))).strip() or "none",
        # A spawn that dies in its first turn within seconds is the model's usage/rate limit, not the
        # unit: the driver waits (doubling from limit_wait_first_s, up to limit_wait_max_min in total)
        # and relaunches instead of spending a retry and halting SYSTEMIC. Evidence: three of three
        # halts in one field campaign, one of four in another, were one-second deaths counted as
        # failures. AUTORESEARCH_LIMIT_WAIT_FIRST_S shortens the first wait (tests).
        "limit_wait_max_s": float(d.get("limit_wait_max_min", 90)) * 60,
        "limit_wait_first_s": float(os.environ.get("AUTORESEARCH_LIMIT_WAIT_FIRST_S") or 300),
        "limit_death_s": 15.0,
    }


def _stream_on(k: dict) -> bool:
    """Whether spawns get the stream-json flags. "auto" (default) = only for the default claude CLI -
    a custom AUTORESEARCH_AGENT_CMD (e.g. the test stub) must not be handed flags it doesn't understand.
    "on"/"off" override in either direction."""
    if k["stream"] == "on":
        return True
    if k["stream"] == "off":
        return False
    return "AUTORESEARCH_AGENT_CMD" not in os.environ


_LAST_RESULT: dict = {}   # label -> {turns, dur_s} from the agent's own result event, for the spawn ledger


def _render_stream_event(raw_line: str, label: str, max_chars: int) -> str | None:
    """One agent-stdout line -> one compact feed line for the terminal + driver log, or None to drop.
    stream-json events are summarized (tool name + clipped input, text snippets, the final result);
    anything that isn't JSON (a stub, a plain-output CLI) is echoed verbatim, truncated. Never formats
    or interprets agent/user text - render-only."""
    s = raw_line.rstrip("\r\n")
    if not s.strip():
        return None
    try:
        ev = json.loads(s)
        assert isinstance(ev, dict)
    except Exception:
        return f"[{label}] {s}"[:max_chars]
    etype = ev.get("type")
    if etype == "system":
        # ONLY `init` is a session start. A session emits many other `system` events, and labelling them
        # all identically buried the thing the feed exists to show: one real worker unit produced 253 of
        # these against 7 lines of agent text. The tell was that they printed `model=?` -- an init event
        # carries a model. A feed nobody can read is not a feed.
        if ev.get("subtype") != "init":
            return None
        return f"[{label}] session start (model={ev.get('model', '?')})"[:max_chars]
    if etype == "assistant":
        # The FIRST assistant message's usage is the context the spawn started with (system prompt +
        # tools + CLAUDE.md + the prompt): what every later turn re-reads. Kept for the spawn ledger.
        u = (ev.get("message") or {}).get("usage") or {}
        if isinstance(u, dict) and u:
            rec = globals().setdefault("_LAST_RESULT", {}).setdefault(label, {})
            rec.setdefault("ctx0", int(u.get("input_tokens", 0) or 0) + int(u.get("cache_creation_input_tokens", 0) or 0)
                           + int(u.get("cache_read_input_tokens", 0) or 0))
        bits = []
        for blk in (ev.get("message") or {}).get("content") or []:
            if not isinstance(blk, dict):
                continue
            if blk.get("type") == "text" and str(blk.get("text", "")).strip():
                bits.append("text: " + " ".join(str(blk["text"]).split()))
            elif blk.get("type") == "tool_use":
                try:
                    arg = json.dumps(blk.get("input", {}))
                except Exception:
                    arg = "?"
                bits.append(f"tool: {blk.get('name', '?')} {arg[:80]}")
        return "\n".join(f"[{label}] {b}"[:max_chars] for b in bits) if bits else None
    if etype == "result":
        dur_s = f"{float(ev.get('duration_ms', 0)) / 1000:.0f}"
        # For the spawn ledger. Via globals() so the function also runs standalone (the fixture
        # contracts exec this renderer on its own, outside the module).
        u = ev.get("usage") or {}
        rec = globals().setdefault("_LAST_RESULT", {}).setdefault(label, {})
        rec.update({
            "turns": ev.get("num_turns", "?"), "dur_s": dur_s, "error": bool(ev.get("is_error", False)),
            "text": str(ev.get("result") or ev.get("error") or "")[:300],
            # The spawn's cost and token accounting, from the CLI's own result event (the probe's numbers,
            # now on the driver's ledger too): what a campaign's dollars went to is otherwise unrecoverable.
            "cost_usd": ev.get("total_cost_usd"),
            # Tool calls the permission mode DENIED (the CLI lists them): a spawn that was refused its
            # Write or Bash cannot do a unit, and the driver must say so instead of counting failures.
            "denied": sorted({str(d.get("tool_name")) for d in (ev.get("permission_denials") or [])
                              if isinstance(d, dict)}),
            "in_tokens": (u or {}).get("input_tokens"), "cache_read": (u or {}).get("cache_read_input_tokens"),
            "cache_create": (u or {}).get("cache_creation_input_tokens"), "out_tokens": (u or {}).get("output_tokens")})
        cost = ev.get("total_cost_usd")
        return (f"[{label}] RESULT ok={not ev.get('is_error', False)} "
                f"turns={ev.get('num_turns', '?')} dur={dur_s}s"
                + (f" cost=${float(cost):.2f}" if isinstance(cost, (int, float)) else ""))[:max_chars]
    return None


def _kill_tree(proc: subprocess.Popen) -> None:
    """Kill an agent and its whole process tree (Windows-first: taskkill /T; no POSIX signals)."""
    try:
        if sys.platform == "win32":
            subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                           capture_output=True, timeout=30)
        else:
            proc.terminate()
        proc.wait(timeout=15)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass


def _touch_driver_alive() -> None:
    """Refresh results/.driver_alive. While its mtime is fresh the campaign's Stop hook stands down for
    ATTENDED sessions (the concierge, a user checking in): campaign-level loop persistence is THIS
    process's job while it runs. Removed on driver exit - a crashed driver re-arms the hook within the
    hook's freshness window. Never raises."""
    try:
        DRIVER_ALIVE.write_text(json.dumps({"pid": os.getpid(), "utc": _utc_stamp()}), encoding="utf-8")
    except Exception:
        pass


_LIVE_PROC: dict = {"proc": None}   # the currently-running agent, for Ctrl-C cleanup


def _role_of(label: str) -> str:
    """The spawned role, from the driver's own label ('worker', 'verifier[exp001_x]', 'capstone').

    Exported to the agent as PHYSKIT_ROLE. The config guard keys on it - a driver-spawned role may not move
    campaign.metric_revision, and may not ratify a metric epoch: those are the user's, made from an
    attended session, which is exactly a session with NO role marker (the metric-epoch rules)."""
    head = label.split("[", 1)[0].strip().lower()
    return head if head in ("worker", "verifier", "repair", "capstone") else "agent"


def _append_spawn_row(start_utc: str, end_utc: str, label: str, status: str, elapsed_s: float,
                      res: dict, g: dict) -> None:
    """One row per spawn in results/diagnostics/spawns.tsv - the per-spawn ledger a time audit needs.

    The driver's decision lines carried no clock and the agent's own RESULT line only its self-reported
    duration, so where a campaign's hours went (worker vs verifier vs dead waits) could not be
    reconstructed from its own logs. Append-only; a write failure never touches the loop."""
    header = ("start_utc\tend_utc\trole\tlabel\tstatus\telapsed_s\tturns\tagent_dur_s\t"
              "grace_s\tgrace_resolved\tcost_usd\tin_tokens\tcache_read\tcache_create\tout_tokens\tctx0_tokens\n")
    try:
        DIAG.mkdir(parents=True, exist_ok=True)
        p = DIAG / "spawns.tsv"
        if not p.is_file():
            p.write_text(header, encoding="utf-8")
        else:
            # An older ledger (no usage columns): the header is brought up to date; its earlier rows keep
            # their ten cells - a reader pads by column name, never by position past the tenth.
            old = p.read_text(encoding="utf-8")
            first = old.split("\n", 1)[0]
            if first.startswith("start_utc\t") and "cost_usd" not in first:
                p.write_text(header + old.split("\n", 1)[1] if "\n" in old else header, encoding="utf-8")

        def cell(v) -> str:
            if v is None or v == "":
                return ""
            return f"{v:.4f}" if isinstance(v, float) else str(v)
        with p.open("a", encoding="utf-8") as fh:
            fh.write("\t".join([start_utc, end_utc, _role_of(label), label, status, f"{elapsed_s:.0f}",
                                str(res.get("turns", "")), str(res.get("dur_s", "")),
                                f"{g['grace_s']:.0f}", str(g["resolved"]),
                                cell(res.get("cost_usd")), cell(res.get("in_tokens")), cell(res.get("cache_read")),
                                cell(res.get("cache_create")), cell(res.get("out_tokens")), cell(res.get("ctx0"))]) + "\n")
    except Exception:
        pass


_LIMIT_DEATH: dict = {}   # label -> the last spawn's limit-death record (set by _finish, read by the backoff)


def _spawn_with_backoff(prompt: str, model: str, label: str, k: dict, saved_probe=None,
                        effort: str = "") -> str:
    """_spawn_agent, relaunched after a usage-limit death instead of failing the unit.

    A spawn that the harness kills in its first turn within seconds (`ok=False turns=1 dur=1s`), or
    whose result names a usage/rate limit, is the environment refusing to serve - not the unit and not
    the campaign. Counting it as an operational or verification failure burned the retry on the next
    one-second death and halted the loop SYSTEMIC (three of three halts in one field campaign). So:
    wait, doubling from limit_wait_first_s, up to driver.limit_wait_max_min in total, relaunch the same
    prompt, and say so in the log; past the budget the death is returned as the failure it then is."""
    waited, wait_s = 0.0, max(0.0, k.get("limit_wait_first_s", 300.0))
    cap = max(0.0, k.get("limit_wait_max_s", 0.0))
    while True:
        st = _spawn_agent(prompt, model, label, k, saved_probe=saved_probe, effort=effort)
        death = _LIMIT_DEATH.pop(label, None)
        if not death or waited >= cap:
            return st
        this_wait = min(wait_s, cap - waited)
        print(f"[supervise] resource: {label} died in {death['elapsed']:.0f}s with {death['turns']} turn(s)"
              + (f" ({death['text']})" if death.get("text") else "")
              + f" - a usage/rate limit, not a unit failure; waiting {this_wait / 60:.1f} min before relaunching "
              f"(waited {waited / 60:.0f} of {cap / 60:.0f} min) utc={_utc_stamp()}")
        t0 = time.monotonic()
        while time.monotonic() - t0 < this_wait:
            _touch_driver_alive()
            time.sleep(min(30.0, max(0.05, this_wait - (time.monotonic() - t0))))
        waited += this_wait
        wait_s = min(wait_s * 2 or 1.0, cap)


def _spawn_agent(prompt: str, model: str, label: str, k: dict, saved_probe=None,
                 effort: str = "") -> str:
    """Launch one fresh-context agent from the campaign root and WATCH it to completion.

    Returns "ok" | "exit_nonzero" | "timeout_inactivity" | "timeout_absolute" | "spawn_error".
    Liveness (dead-worker detection ONLY - progress is the ledger's job): the agent counts alive while
    its stdout produces lines OR results/.run_heartbeat's mtime keeps changing; neither for
    k["inactivity_s"] -> kill. An agent with NO liveness source at all (a silent stub) falls back to the
    absolute wall-clock cap alone, by construction. All timing on time.monotonic() (clock-skew-proof;
    the heartbeat is only ever compared to its own previous value).
    POST-EXIT GRACE: if the process exits while the heartbeat is still fresh - a detached/backgrounded
    runner still solving - wait up to k["grace_s"] for
    `saved_probe` to come true or the heartbeat to go stale, instead of instantly failing validation.
    """
    try:
        _agent_instructions.check_chain(ROOT)
    except _agent_instructions.InstructionError as exc:
        _halt(f"supervise: HALT - {exc}")
    global _LAST_CODEX_OBSERVER
    stream = _stream_on(k)
    # The prompt travels over STDIN, never as an argv element: with the brief compiled in it runs to
    # tens of KB, and Windows caps a command line at 32 767 chars (a Codex spawn already used stdin).
    cmd = (AGENT_CMD + _permission_flags(k["permission_mode"])
           + _settings_flags(k.get("skill_listing", "names"), k.get("auto_memory", "off"))
           + _mcp_flags(k.get("mcp_servers", "none"))
           + (["--model", model] if model else []) + (["--effort", effort] if effort else [])
           + (STREAM_FLAGS if stream else []))
    codex_spec, codex_observer = (_codex_backend.prepare_spawn(
        ROOT, _AGENT_BACKEND, model, prompt, label, k["feed_chars"], effort)
        if _codex_backend.is_codex(_AGENT_BACKEND) else (None, None))
    _LAST_CODEX_OBSERVER = codex_observer
    t_spawn = time.monotonic()
    start_utc = _utc_stamp()
    _g = {"grace_s": 0.0, "resolved": ""}     # post-exit grace, if any, for the spawn ledger

    def _finish(final: str) -> str:
        # ONE exit path for every outcome: the driver's decision lines carried no clock, so where a
        # campaign's time went was unrecoverable from its own logs. Every spawn now ends with a stamped
        # line and a row in results/diagnostics/spawns.tsv (start, end, elapsed, turns, grace).
        elapsed = time.monotonic() - t_spawn
        res = _LAST_RESULT.pop(label, {})
        globals().setdefault("_LAST_DENIED", {})[label] = list(res.get("denied") or [])
        end_utc = _utc_stamp()
        print(f"[supervise] {label} done: status={final} elapsed={elapsed:.0f}s "
              f"turns={res.get('turns', '?')} agent_dur={res.get('dur_s', '?')}s"
              + (f" grace={_g['grace_s']:.0f}s resolved={_g['resolved']}" if _g["grace_s"] else "")
              + f" utc={end_utc}")
        _append_spawn_row(start_utc, end_utc, label, final, elapsed, res, _g)
        # A first-turn death within seconds, or the harness naming its limit, is a resource condition
        # the caller may wait out (_spawn_with_backoff) - recorded here, decided there.
        try:
            turns = int(res.get("turns", 0) or 0)
        except (TypeError, ValueError):
            turns = 0
        text = str(res.get("text") or "")
        if final != "ok" or res.get("error"):
            if (res.get("error") and turns <= 1 and elapsed <= k.get("limit_death_s", 15.0)) \
                    or ("usage limit" in text.lower() or "rate limit" in text.lower()):
                _LIMIT_DEATH[label] = {"elapsed": elapsed, "turns": turns, "text": text[:120]}
        return final

    print(f"[supervise] spawning {label} (model={model or 'default'}, effort={effort or 'default'}, "
          f"cap={k['absolute_s'] / 3600:.1f}h, "
          f"inactivity window={k['inactivity_s'] / 60:.0f}min, "
          f"stream={'jsonl' if codex_spec else ('on' if stream else 'off')}) utc={start_utc}")
    HEARTBEAT.unlink(missing_ok=True)   # a stale heartbeat from an earlier run must not fake liveness
    env = _codex_backend.spawn_env(os.environ, bool(codex_spec))  # also tells Codex experiment children which prompt was delivered
    env["PHYSKIT_ROLE"] = _role_of(label)   # spawned, not attended: the config/epoch guards key on this
    env["PHYSKIT_PROMPT_STDIN"] = "1"       # the prompt arrives on stdin (a custom AGENT_CMD reads it there)
    delivered = codex_spec.prompt if codex_spec else prompt
    env["PHYSKIT_SPAWN_PROMPT_SHA256"] = _hashlib.sha256(delivered.encode("utf-8")).hexdigest()
    try:
        if codex_spec:
            proc = _codex_backend.start(codex_spec, ROOT, env)
        else:
            proc = subprocess.Popen(cmd, cwd=ROOT, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True, encoding="utf-8",
                                    errors="replace", bufsize=1)

            def _feed_stdin(p=proc, text=prompt):
                # Off the watch thread: a prompt larger than the pipe buffer blocks until the agent
                # reads it, and the agent may write stdout first - a same-thread write would deadlock.
                try:
                    if getattr(p, "stdin", None) is not None:
                        p.stdin.write(text)
                        p.stdin.close()
                except (OSError, ValueError):
                    pass
            threading.Thread(target=_feed_stdin, daemon=True).start()
    except OSError as exc:
        print(f"[supervise] SPAWN ERROR for {label}: {exc}")
        return _finish("spawn_error")
    _LIVE_PROC["proc"] = proc
    lines: _LineQueue = _LineQueue()

    def _reader():
        try:
            for raw in proc.stdout:
                lines.put(raw)
        except Exception:
            pass
        finally:
            if codex_observer:
                codex_observer.reader_eof = True

    threading.Thread(target=_reader, daemon=True).start()

    start = time.monotonic()
    last_activity = None          # None until ANY liveness source appears
    last_hb_mtime = None
    last_hb_change = None
    next_alive = 0.0
    status = None
    while status is None:
        if time.monotonic() >= next_alive:                      # keep the Stop-hook stand-down fresh
            _touch_driver_alive()
            next_alive = time.monotonic() + 30
        try:
            raw = lines.get(timeout=1.0)
        except _QEmpty:
            raw = None
        if raw is not None:
            rendered = (codex_observer.observe(raw, display=k["stream"] != "off") if codex_observer
                        else _render_stream_event(raw, label, k["feed_chars"]))
            if rendered:
                try:
                    print(rendered)
                except UnicodeEncodeError:
                    # _make_console_lenient() normally prevents this; if stdout could not be
                    # reconfigured, drop to a transliteration rather than losing the loop.
                    enc = getattr(sys.stdout, "encoding", None) or "ascii"
                    print(rendered.encode(enc, "replace").decode(enc, "replace"))
            last_activity = time.monotonic()
        try:
            hb = HEARTBEAT.stat().st_mtime
        except OSError:
            hb = None
        if hb is not None and hb != last_hb_mtime:              # mtime CHANGE = liveness, never age
            last_hb_mtime = hb
            last_hb_change = time.monotonic()
            last_activity = last_hb_change
        if proc.poll() is not None:
            if raw is None and lines.empty() and (not codex_observer or codex_observer.reader_eof):
                status = "exited"                               # fully drained - judge below
            continue
        now = time.monotonic()
        if now - start > k["absolute_s"]:
            print(f"[supervise] {label} TIMED OUT (absolute cap {k['absolute_s'] / 3600:.1f}h) - "
                  "killing the process tree")
            _kill_tree(proc)
            status = "timeout_absolute"
        elif last_activity is not None and now - last_activity > k["inactivity_s"]:
            print(f"[supervise] {label} INACTIVE for {k['inactivity_s'] / 60:.0f} min (no output, no "
                  "heartbeat) - a dead worker, killing the process tree")
            _kill_tree(proc)
            status = "timeout_inactivity"
    _LIVE_PROC["proc"] = None
    if status != "exited":
        return _finish(status)
    # ---- POST-EXIT detached-runner grace ----
    if (saved_probe is not None and last_hb_change is not None
            and time.monotonic() - last_hb_change <= k["hb_stale_s"] and not saved_probe()):
        poll_s = max(1.0, min(10.0, k["grace_s"] / 10))
        t0 = time.monotonic()
        deadline = t0 + k["grace_s"]
        print(f"[supervise] {label} exited but the heartbeat is FRESH - a detached runner may still be "
              f"solving; waiting up to {k['grace_s'] / 60:.0f} min for the save-set (grace) "
              f"utc={_utc_stamp()}")
        while time.monotonic() < deadline:
            if saved_probe():
                break
            try:
                hb = HEARTBEAT.stat().st_mtime
            except OSError:
                hb = None
            if hb is not None and hb != last_hb_mtime:
                last_hb_mtime = hb
                last_hb_change = time.monotonic()
            # A detached runner that is still solving beats every HB_TICK_S; after the worker's exit,
            # two silent ticks mean it is not there. The in-flight stale window (hb_stale_s) was the
            # bound before, and every grace wait measured ended on it, seven times in eight for nothing.
            if time.monotonic() - last_hb_change > min(k["hb_stale_s"], 2 * HB_TICK_S):
                break
            _touch_driver_alive()
            time.sleep(poll_s)
        _g["grace_s"] = time.monotonic() - t0
        _g["resolved"] = bool(saved_probe())
        print(f"[supervise] detached-runner grace ended after {_g['grace_s']:.0f}s "
              f"(resolved={_g['resolved']}) utc={_utc_stamp()}")
    if codex_observer and not codex_observer.successful(proc.returncode):
        print(f"[supervise] {label} Codex protocol failed (exit={proc.returncode}, "
              f"thread_id={codex_observer.thread_id or '?'}, completed={codex_observer.completed}, "
              f"turn_failed={codex_observer.failed})")
        return _finish("exit_nonzero")
    return _finish("ok" if proc.returncode == 0 else "exit_nonzero")


def _read_state() -> dict:
    """results/driver_state.json, strictly: ABSENT -> seeded from the retired results/queue.json when one is
    still on disk (an upgraded campaign keeps its counters), else fresh; EXISTS-BUT-UNPARSEABLE -> HARD
    HALT (integrity). The state is the driver's only memory of what it accepted and what verification it
    owes - a corrupt file must never be mistaken for an empty one."""
    default = {"accepted_units": 0, "last_accept_utc": None, "accepted": [], "pending_verification": [],
               "consecutive_operational_failures": 0}
    if not STATE.is_file():
        legacy = _read_json(QUEUE_LEGACY, None) if QUEUE_LEGACY.is_file() else None
        if isinstance(legacy, dict):
            seeded = dict(default)
            seeded["accepted_units"] = int(legacy.get("accepted_units", 0) or 0)
            seeded["last_accept_utc"] = legacy.get("last_accept_utc")
            seeded["pending_verification"] = [e for e in (legacy.get("pending_verification") or [])
                                              if isinstance(e, dict)]
            print(f"[supervise] results/driver_state.json seeded from the retired results/queue.json "
                  f"(accepted_units={seeded['accepted_units']}, pending verification "
                  f"{len(seeded['pending_verification'])}); the queue itself is not read again - its open "
                  "ideas belong in the JOURNAL (upgrade_campaign.py --retire-queue moves them)")
            return seeded
        return default
    try:
        q = json.loads(STATE.read_text(encoding="utf-8-sig"))   # BOM-tolerant (hand-edits on Windows)
        assert isinstance(q, dict), "not a JSON object"
        for key, val in default.items():
            q.setdefault(key, val)
        return q
    except Exception as exc:
        _halt(f"supervise: HALT - results/driver_state.json exists but cannot be parsed ({exc}). INTEGRITY: "
              "repair the JSON by hand before relaunching; do NOT delete it - it holds the accept counters "
              "and the verification owed.")


def _write_state(q: dict) -> None:
    """The SOLE write of results/driver_state.json - the driver is its only writer. Through a temp file +
    os.replace so every write is ATOMIC (POSIX and Windows): a concurrent reader can never observe a
    half-written file, which is the torn read that would otherwise trip _read_state's integrity halt."""
    tmp = STATE.parent / f".driver_state.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(q, indent=2), encoding="utf-8")
    os.replace(tmp, STATE)


def _config_for_stem(stem: str) -> Path | None:
    """The config (relative to ROOT) whose exp_name is `stem`: configs/<stem>.json by convention, else the
    first configs/*.json that declares it."""
    direct = ROOT / "configs" / f"{stem}.json"
    if direct.is_file():
        return Path("configs") / f"{stem}.json"
    for p in sorted((ROOT / "configs").glob("*.json")):
        if p.name.startswith("_"):
            continue
        if _exp_stem(Path("configs") / p.name) == stem:
            return Path("configs") / p.name
    return None


def _units_saved_since(t0: float) -> list[tuple[str, Path]]:
    """The units a spawn left behind: every results/result_<NN>.json written since `t0` whose config can
    be found and whose save-set validates (`_unit_saved`, JOURNAL included). [(stem, config_path), ...]
    in id order. A worker chooses its own unit, so the driver learns what ran from the record, never
    from an assignment."""
    out = []
    try:
        files = sorted(RESULTS.glob("result_*.json"))
    except OSError:
        return out
    for f in files:
        try:
            if f.stat().st_mtime < t0 - 1:
                continue
            stem = str((json.loads(f.read_text(encoding="utf-8-sig")) or {}).get("exp_name") or "").strip()
        except (OSError, ValueError):
            continue
        cfg = _config_for_stem(stem) if stem else None
        if cfg is not None and _unit_saved(cfg, since=t0):
            out.append((stem, cfg))
    return out


def _new_units_since(t0: float) -> list[tuple[str, Path]]:
    """_units_saved_since without the units already accepted. A fast unit's result file can fall inside
    the next spawn's one-second mtime tolerance; counted again, it read as a new save and hid that
    spawn's STOP judgement behind an idempotent re-accept."""
    done = set(_read_state().get("accepted") or [])
    return [u for u in _units_saved_since(t0) if u[0] not in done]


def _journal_next_line() -> str:
    """The JOURNAL's `**NEXT:**` line, stripped of its marker, or ""."""
    try:
        for line in JOURNAL.read_text(encoding="utf-8-sig").splitlines():
            if line.strip().startswith("**NEXT:**"):
                return line.strip()[len("**NEXT:**"):].strip()
    except OSError:
        pass
    return ""


def _journal_says_stop(t0: float) -> str:
    """The worker's stopping judgement: a JOURNAL written since `t0` whose NEXT line starts with STOP.
    Returns the reason (the rest of the line) or ""."""
    if not _journal_updated_since(t0):
        return ""
    nxt = _journal_next_line()
    if re.match(r"(?i)^stop\b", nxt):
        return nxt[4:].lstrip(" :-—") or "(no reason given)"
    return ""


def _note_followups(stems: list[str]) -> None:
    """A REFUTED or INCONCLUSIVE verdict with a follow-up becomes an inbox note for the next worker (the
    driver's one authored note; the worker decides what to do with it - there is no queue to merge into)."""
    for s in stems:
        vf = _find_verdict_file(s)
        v = (_read_json(vf, {}) or {}) if vf else {}
        verdict = str(v.get("verdict", "")).strip().upper()
        follow = str(v.get("follow_up") or v.get("follow-up") or "").strip()
        if verdict not in ("REFUTED", "INCONCLUSIVE"):
            continue
        try:
            INBOX.mkdir(parents=True, exist_ok=True)
            (INBOX / f"verifier_{s}.md").write_text(
                f"Verifier ({_utc_stamp()}): {s} is {verdict} (results/verdicts/{vf.name if vf else '?'})."
                + (f" Follow-up it names: {follow}" if follow else " It names no follow-up.")
                + " Weigh it when choosing your unit; a refuted result is not built on.\n", encoding="utf-8")
            print(f"[supervise] verdict {verdict} for {s}: follow-up relayed to the next worker as an inbox note")
        except OSError as exc:
            print(f"[supervise] could not leave the verifier's follow-up note for {s} ({exc})")


def _drain_inbox(max_chars: int) -> str:
    """Collect unarchived user notes (results/inbox/*.md|*.txt) for VERBATIM relay into the next spawn's
    prompt, then archive them to results/inbox/archive/<stamp>_<name>. The driver never parses or acts
    on note content - notes are data relayed to a judgment agent (the worker), which must
    acknowledge them in the journal. Oldest first; whole notes only up to the cap (a note that doesn't
    fit is DEFERRED to the next spawn, never truncated across the boundary; a single note larger than
    the cap is injected truncated with an explicit marker - its full text is safe in the archive).
    Injected by string CONCATENATION after .format(), so braces in note text cannot crash the driver."""
    try:
        files = sorted((f for f in list(INBOX.glob("*.md")) + list(INBOX.glob("*.txt")) if f.is_file()),
                       key=lambda f: f.stat().st_mtime)
    except OSError:
        return ""
    blocks, total = [], 0
    for f in files:
        try:
            text = f.read_text(encoding="utf-8-sig", errors="replace")
            received = _dt.datetime.fromtimestamp(f.stat().st_mtime, _dt.timezone.utc).strftime("%Y-%m-%d %H:%MZ")
        except OSError:
            continue
        if blocks and total + len(text) > max_chars:
            break                       # defer the rest to the NEXT spawn - never drop a note
        clipped = text if len(text) <= max_chars else (
            text[:max_chars] + f"\n[driver: truncated at {max_chars} chars - full text in results/inbox/archive/]")
        try:
            INBOX_ARCHIVE.mkdir(parents=True, exist_ok=True)
            f.replace(INBOX_ARCHIVE / f"{_utc_stamp()}_{f.name}")
        except OSError:
            continue                    # cannot archive -> do not inject (it would re-fire every spawn)
        blocks.append(f"--- note: {f.name} (received {received}) ---\n{clipped}")
        total += len(clipped)
        print(f"[supervise] inbox: relaying {f.name} ({len(text)} chars) into the next spawn")
    if not blocks:
        return ""
    return ("\n\n==== USER NOTES relayed by the driver (verbatim; weigh as user input) ====\n"
            + "\n\n".join(blocks)
            + "\n==== end USER NOTES ====")


def preflight(smoke: bool = False) -> list[str]:
    """Launch checks for supervisor mode - run automatically at --supervise start and standalone via
    --preflight. Instruction drift halts before any other probe; otherwise this collects and reports ALL
    failures (never first-fail), each with its fix. Refusing a launch is cheaper than a night of discovery.
    `smoke` additionally does ONE real agent spawn (costs one model call; opt-in)."""
    fails: list[str] = []

    def ok(msg):
        print(f"preflight OK: {msg}")

    def bad(msg):
        fails.append(msg)
        print(f"preflight FAIL: {msg}")

    try:
        instruction_fingerprint = _agent_instructions.check_chain(ROOT)
        if instruction_fingerprint:
            ok(f"Claude/Codex instruction twins agree ({instruction_fingerprint[:12]})")
    except _agent_instructions.InstructionError as exc:
        bad(str(exc))
        return fails

    # 1. agent CLI resolves and answers
    if _codex_backend.is_codex(_AGENT_BACKEND):
        ok(f"agent CLI: {_AGENT_BACKEND.executable} ({_AGENT_BACKEND.version}); backend=codex")
    else:
        exe = shutil.which(AGENT_CMD[0])
        if exe is None:
            bad(f"agent CLI '{AGENT_CMD[0]}' not found on PATH. Fix: install the claude CLI (or set "
                "AUTORESEARCH_AGENT_CMD to the command to use).")
        else:
            try:
                proc = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30)
                if proc.returncode == 0:
                    out = (proc.stdout or "").strip().splitlines()
                    ok(f"agent CLI: {exe} ({out[0] if out else 'responds'})")
                else:
                    print(f"preflight note: '{AGENT_CMD[0]} --version' exited {proc.returncode} - a custom "
                          "AUTORESEARCH_AGENT_CMD may not implement it; continuing.")
            except (subprocess.TimeoutExpired, OSError) as exc:
                bad(f"agent CLI '{exe}' did not answer --version ({exc}). Fix: check the install "
                    "('claude --version' in a fresh terminal), or set AUTORESEARCH_AGENT_CMD.")

    # 2. loop.json parses and carries every key the driver dereferences without a default
    try:
        raw = LOOPCFG.read_text(encoding="utf-8-sig")
    except OSError as exc:
        raw = None
        bad(f"configs/loop.json unreadable ({exc}). Fix: new-campaign generates it; restore it from a "
            "results/snapshots/ copy or the kit template.")
    if raw is not None:
        if "{{" in raw:
            bad("configs/loop.json still contains {{...}} template placeholders. Fix: fill the loop "
                "knobs for this campaign - each knob's meaning is in the file's own '_doc' field.")
        try:
            lc = json.loads(raw)
            missing = []
            for name, keys in (("worker.iteration_timeout_hours", ("worker", "iteration_timeout_hours")),):
                node = lc
                try:
                    for kk in keys:
                        node = node[kk]
                    float(node)
                except Exception:
                    missing.append(name)
            if missing:
                bad("configs/loop.json is missing numeric key(s) the driver requires: "
                    + ", ".join(missing) + ". Fix: add them (the kit template shows the schema).")
            else:
                ok("loop.json: effective driver knobs " + json.dumps(_driver_knobs(lc)))
                for problem in _spawn_isolation_problems(_driver_knobs(lc)):
                    bad(problem)
                launch_problems = []
                if _AGENT_BACKEND is not None:
                    launch_problems = _codex_backend.model_errors(lc, _AGENT_BACKEND)
                    for problem in launch_problems: bad(problem)
                if _AGENT_BACKEND is not None and not launch_problems:
                    role_settings = []
                    for role in ("worker", "verifier"):
                        section = lc.get(role) if role == "worker" else _verifier_section(lc)
                        section = section or {}
                        model = _codex_backend.model_for(section, _AGENT_BACKEND) or "default/inherited"
                        effort = _codex_backend.effort_for(section, _AGENT_BACKEND) or "default/inherited"
                        role_settings.append(f"{role}(model={model}, effort={effort})")
                    ok(f"launch settings: backend={_AGENT_BACKEND.name}; " + "; ".join(role_settings))
                for problem in (_verifier_policy().strategy_errors(lc, _AGENT_BACKEND.name)
                                if _AGENT_BACKEND is not None else []): bad(problem)
            props = _campaign_props(lc)
            prop_problems = campaign_props_problems(props)
            for problem in prop_problems:
                bad(problem)
            if not prop_problems:
                bounds = getattr(metric, "PLAUSIBILITY_BOUNDS", None)
                note = (f"campaign: plausible_range={tuple(bounds) if bounds else 'unset'} "
                        f"noise_model={props['noise_model']} "
                        + f"metric_revision={props['metric_revision']}")
                if not bounds:
                    note += (" (plausible range unset - set metric.PLAUSIBILITY_BOUNDS; until then the "
                             "implementation-error check reports 'unavailable')")
                if props["noise_model"] == "stochastic" and props["noise_floor"] is None:
                    note += " (noise_floor unset - the noise-floor check reports 'unavailable')"
                if props["noise_model"] == "deterministic" and props["tolerance"] is None:
                    note += " (tolerance unset - the tolerance check reports 'unavailable')"
                ok(note)
                vprob, vnotes = verify_problems(lc)
                for problem in vprob:
                    bad(problem)
                for vn in vnotes:
                    ok("NOTE: " + vn)
                if not vprob:
                    ok("verify: " + _rows_line(_verify_rows(lc)))
                    # The suite runs at preflight (the `setup` home) so its every-set is MEASURED before
                    # the first unit: an over-budget set is refused here, by name, where fixing it is cheap.
                    suite_status = check_correctness_suite(props["metric_version"], select="all",
                                                           why="preflight", props=props)
                    st_now = _read_json(CORRECTNESS_STATE, None)
                    st_now = st_now if isinstance(st_now, dict) else {}
                    budget = _suite_budget_s(lc)
                    if st_now.get("protocol") == 1:
                        rows_now = _verify_rows(lc)["rows"]
                        cost, members = _every_cost(st_now, rows_now)
                        if cost > budget:
                            checks_now = st_now.get("checks") or {}
                            named = ", ".join(f"{n} {w:.1f}s ({(checks_now.get(n) or {}).get('row') or 'invariants'})"
                                              for n, w in members[:6])
                            if rows_now.get("machinery") == "every":
                                # A declaration alone changes nothing here: this preset fires machinery every unit.
                                fix = ("Fix: under this preset the machinery row fires every unit too, so declaring "
                                       "a check machinery does not remove it from the every-set - choose a preset "
                                       "whose machinery row runs on code change (heavy), declare a per-result "
                                       "check @check(row='gates') (promotion time), or make the slow ones cheaper.")
                            else:
                                fix = ("Fix: declare the slow ones @check(row='machinery') (they then run at setup "
                                       "/ on code change) or 'gates' (at promotion time), or make them cheaper.")
                            bad(f"correctness suite every-set is over budget: {cost:.1f}s > {budget:.1f}s "
                                f"({SUITE_BUDGET_FRACTION:g} x unit_cost.typical_wall_clock_s, floor "
                                f"{SUITE_BUDGET_FLOOR_S:g}s) - " + named + ". " + fix
                                + " Mid-campaign the runner would demote them, loudly; at launch you choose.")
                        else:
                            ok(f"correctness suite: {suite_status}; every-set {cost:.1f}s of {budget:.1f}s "
                               f"budget ({len(members)} check(s) per unit)")
                    elif st_now.get("protocol") == "legacy":
                        w = st_now.get("wall_s")
                        ok(f"correctness suite: {suite_status} in {float(w or 0):.1f}s (legacy suite: no "
                           f"per-check cost, so the {budget:.1f}s budget cannot be metered; migrate it to a "
                           "CHECKS list with @check rows)")
                    else:
                        ok(f"correctness suite: {suite_status}")
                if props["metric_revision"] != "cautious":
                    # Loud by design: the one launch-time fact the user must not miss. Every revision the
                    # loop enacts lands as a PENDING epoch in campaign.metric_epochs; nothing in this mode
                    # is silent, but nothing waits for the user either.
                    ok(f"NOTICE: metric_revision={props['metric_revision']} - the loop's agents may revise "
                       "the FROZEN metric WITHOUT asking first (the metric-epoch design). Each revision is "
                       "declared as a pending epoch in configs/loop.json campaign.metric_epochs for YOUR "
                       "ratification; campaign-status lists them.")
                epoch_problems = epoch_gate(props)
                for problem in epoch_problems:
                    bad("metric epoch: " + problem)
                if not epoch_problems and props["metric_version"]:
                    decl = _epoch_declaration(props) or {}
                    ok(f"metric epoch: {props['metric_version']} ({decl.get('kind', '?')}, "
                       f"{decl.get('status', '?')}" + (", the implicit first epoch" if decl.get("implicit") else "")
                       + ("; scorer hash bound" if _scorer_bindings().get(props["metric_version"])
                          else "; the scorer hash binds on the first experiment") + ")")
        except json.JSONDecodeError as exc:
            bad(f"configs/loop.json is not valid JSON ({exc}). Fix: repair it (check trailing commas).")

    # 3. the driver's state file parses (absent is fine - the first launch creates it); a retired
    #    queue.json still on disk is named, so its open ideas are not silently forgotten
    if STATE.is_file():
        try:
            ss = json.loads(STATE.read_text(encoding="utf-8-sig"))
            assert isinstance(ss, dict), "not a JSON object"
            ok(f"driver_state.json: {int(ss.get('accepted_units', 0) or 0)} accepted, "
               f"{len(ss.get('pending_verification') or [])} awaiting verification")
        except Exception as exc:
            bad(f"results/driver_state.json is corrupt ({exc}). Fix: repair the JSON by hand - it holds the "
                "accept counters and the verification owed; do not delete it.")
    if QUEUE_LEGACY.is_file():
        print("preflight note: results/queue.json is the retired queue - the driver no longer "
              "reads it; run `python <plugin>/skills/new-campaign/scripts/upgrade_campaign.py --retire-queue` "
              "to archive it and move its open ideas into the JOURNAL's 'What to try next'.")

    # 3b. the brief a worker would receive NOW: its size is paid on every spawn, so a bloated journal
    #     window or a truncated section is named here, before the night is spent on it.
    try:
        build_prompt("worker")
        stats = _LAST_BRIEF.get("worker") or []
        total = sum(n for _, n, _ in stats)
        truncated = [t for t, _, tr in stats if tr]
        line = _brief_line("worker")
        role_chars = next((n for t, n, _ in stats if t == "WORKER ROLE"), 0)
        if role_chars > BRIEF_ROLE_WARN_CHARS:
            print(f"preflight WARN: roles/worker.md is {role_chars / 1024:.1f} KB - the contract is delivered "
                  f"whole on every spawn and is meant to stay under ~{BRIEF_ROLE_WARN_CHARS // 1000} KB; move "
                  "reference material to roles/REFERENCE.md (opened by section, never delivered); the launch proceeds.")
        journal_chars = next((n for t, n, _ in stats if t.startswith("JOURNAL")), 0)
        if journal_chars > BRIEF_JOURNAL_WARN_CHARS:
            print(f"preflight WARN: results/JOURNAL.md is {journal_chars / 1024:.1f} KB - it is delivered whole "
                  f"on every spawn and nothing cuts it; past ~{BRIEF_JOURNAL_WARN_CHARS // 1000} KB, ask whether "
                  "it is carrying history the ledger and the logbook already hold; the launch proceeds.")
        if truncated or total > BRIEF_WARN_CHARS:
            print(f"preflight WARN: {line} - "
                  + (f"truncated: {', '.join(truncated)}; " if truncated else "")
                  + (f"over {BRIEF_WARN_CHARS // 1000}k chars; " if total > BRIEF_WARN_CHARS else "")
                  + "every spawn pays for this. Fix: keep results/JOURNAL.md brief, the config template "
                  "short and campaign.md's contract sections lean; the launch proceeds.")
        elif journal_chars <= BRIEF_JOURNAL_WARN_CHARS:
            ok(line)
    except Exception as exc:                                   # never block a launch on the report itself
        print(f"preflight note: could not size the worker brief ({exc}); continuing.")

    # 4. the campaign tree this driver assumes
    # The agent-facing documents are checked SEPARATELY, not as one "the contract" entry: a preflight
    # that passes while roles/worker.md is missing launches a worker with no procedure. Each spawn
    # prompt names the file, so each must exist before the driver may spawn anything.
    for rel, why in (("results", "the ledger root"),
                     ("results/scoreboard.tsv", "the results ledger"),
                     ("campaign.md", "the campaign definition every worker re-reads"),
                     ("roles/worker.md", "the contract the spawned worker executes"),
                     ("roles/verifier.md", "the contract the spawned verifier executes"),
                     ("roles/capstone.md", "the contract the end-of-loop claim audit executes"),
                     ("roles/REFERENCE.md", "the reference the contract points at (never delivered)"),
                     ("configs/_template.json", "the config template the worker writes its unit from"),
                     ("scripts/metric.py", "the FROZEN scorer"),
                     ("configs", "the experiment-config directory")):
        if not (ROOT / rel).exists():
            bad(f"{rel} is missing ({why}). Fix: launch from the campaign root of a scaffolded campaign "
                "(new-campaign generates this tree).")

    # 4a. the delivered context: every spawn carries the project's Standing constraints by value, so a
    # launch without them would run the whole night on prompts missing the constraints the project
    # recorded - the recorded-but-unread failure, mechanized. Refuse instead.
    if _md_section(_orientation_file(), "Standing constraints") is None:
        bad("../../PROJECT.md is missing or has no '## Standing constraints' section (also tried the "
            "pre-consolidation ../../PROJECT_ORIENTATION.md) - that section is delivered into every "
            "spawned worker prompt. Fix: author it (new-project generates it; an older "
            "project layout migrates via the kit's docs/MIGRATING.md).")

    # 4b. disk budget: a launch that cannot hold a few units of artifacts will fail mid-night
    free_mb = _free_disk_mb()
    per_unit = _unit_disk_mb(_read_json(LOOPCFG, {}) or {})
    if free_mb is None:
        print("preflight note: could not read free disk space - the disk-budget check is inactive.")
    elif per_unit <= 0:
        print(f"preflight note: {free_mb / 1024:.1f} GB free; this campaign has no per-unit footprint "
              "estimate (configs/loop.json unit_cost.typical_disk_mb), so the disk-budget check is "
              "inactive. Set it from the artifact plan (roles/worker.md, 'The save-set') to arm it.")
    elif free_mb < _disk_floor_mb(per_unit):
        bad(f"free disk is {free_mb / 1024:.2f} GB - below this campaign's floor of "
            f"{_disk_floor_mb(per_unit) / 1024:.2f} GB ({DISK_FLOOR_UNITS} units x {_mb(per_unit)} MB/unit). "
            "Fix: free space, move the campaign to a larger volume, or shrink the per-experiment artifact "
            "set (campaign.md §Decision record, the retention entry) before launching.")
    else:
        runway = free_mb / per_unit
        line = (f"disk: {free_mb / 1024:.1f} GB free = "
                f"{'999+' if runway > 999 else f'~{runway:.0f}'} more units at {_mb(per_unit)} MB/unit")
        if runway < DISK_WARN_UNITS:
            print(f"preflight note: {line} - a short runway. Decide the retention plan now "
                  "(campaign.md §Decision record, the retention entry), not at 3 a.m. when the disk fills.")
        else:
            ok(line)

    # 5. the FROZEN scorer's self-test (same authority as the per-experiment gate)
    msg = metric_selftest_message()
    if msg:
        bad(msg.replace("\n", " "))
    else:
        ok("metric selftest passes")

    # 5b. the campaign's OWN experiment code. The scorer above is probed; these three were not, so a
    # freshly scaffolded campaign passed preflight and was told it was "ready for --supervise" while every
    # unit was guaranteed to fail. Worse than the wasted launch: N identical failures halt the loop as
    # SYSTEMIC, which blames the environment for code that was simply never written.
    stubs = unimplemented_hooks()
    if stubs:
        bad("campaign hooks are still the generated stubs (or missing): "
            + ", ".join(n if n.endswith(("MISSING", ")")) else f"{n}()" for n in stubs)
            + ". Fix: implement them in scripts/experiment.py - they are this campaign's physics "
              "(the experiment dispatcher, the lever contract, the target loader) - then re-run. "
              "Until they are written every experiment fails identically.")
    else:
        ok("campaign hooks implemented (validate_method, run_experiment, load_target)")

    # 6. correctness suite - informational only (a non-green blocks promotion, not the run)
    if (not (ROOT / "tests" / "correctness_checks.py").is_file()
            and not (ROOT / "tests" / "CORRECTNESS_NA.md").is_file()):
        print("preflight note: no correctness suite and no tests/CORRECTNESS_NA.md - runs proceed, but "
              "promotion stays blocked until one exists.")

    # 7. an unresolved ESCALATE halts the driver immediately - surface it now
    if ESCALATE.is_file():
        bad("results/ESCALATE.md present - the driver halts on it at launch. Fix: resolve the fork it "
            "records, then delete the file.")
    # 7b. a leftover STOP sentinel makes the launch a silent no-op - surface it now
    stop = next((p for p in (RESULTS / "STOP", RESULTS / "STOP.txt") if p.exists()), None)
    if stop is not None:
        bad(f"results/{stop.name} present (the graceful-stop sentinel) - the driver would stop "
            "immediately. Fix: delete the file to run the loop.")

    # 8. opt-in smoke spawn (one real model call)
    if smoke and not fails:
        try:
            _agent_instructions.check_chain(ROOT)
            smoke_prompt = "Reply with exactly OK and end the turn."
            if _codex_backend.is_codex(_AGENT_BACKEND):
                proc, rendered, smoke_ok = _codex_backend.smoke(
                    ROOT, _AGENT_BACKEND, dict(os.environ, AUTORESEARCH_SUPERVISED="1"))
                for line in rendered:
                    print(line)
            else:
                try:   # the same knobs the real spawns read; a broken loop.json was reported above
                    sk = _driver_knobs(json.loads(LOOPCFG.read_text(encoding="utf-8-sig")))
                except Exception:
                    sk = _driver_knobs({})
                cmd = (AGENT_CMD
                       + _permission_flags(os.environ.get("AUTORESEARCH_PERMISSION_MODE") or "auto")
                       + _settings_flags(sk["skill_listing"], sk["auto_memory"])
                       + _mcp_flags(sk["mcp_servers"])
                       + [smoke_prompt])
                proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=300,
                                      env=dict(os.environ, AUTORESEARCH_SUPERVISED="1"))
                smoke_ok = proc.returncode == 0
            if smoke_ok:
                ok("smoke spawn completed")
            else:
                bad(f"smoke spawn {'protocol incomplete' if _codex_backend.is_codex(_AGENT_BACKEND) and proc.returncode == 0 else f'exited {proc.returncode}'}. Fix: run the agent CLI by hand from this "
                    "directory and read its output.")
        except Exception as exc:
            bad(f"smoke spawn failed ({exc}). Fix: verify the agent CLI runs headless from this directory.")
    return fails


def _supervise_unlocked(smoke: bool = False):
    """The loop driver. Deterministic; judgment lives in the worker agents it spawns."""
    log = DriverLog(DIAG / f"supervise_{_utc_stamp()}.log")
    sys.stdout = log
    launch_cmd = _AGENT_BACKEND.executable if _codex_backend.is_codex(_AGENT_BACKEND) else " ".join(AGENT_CMD)
    backend_tag = " backend=codex" if _codex_backend.is_codex(_AGENT_BACKEND) else ""
    print(f"[supervise] ==== launch {_utc_stamp()} ==== root={ROOT}{backend_tag} agent_cmd={launch_cmd}")
    try:
        INBOX.mkdir(parents=True, exist_ok=True)   # the steering mailbox exists from launch, visibly
    except OSError:
        pass
    loop_cfg = _read_json(LOOPCFG, None)
    if not loop_cfg:
        _halt("supervise: HALT - configs/loop.json missing or unreadable - new-campaign generates it; "
              "the loop knobs are per-campaign (unit cost), not defaults.")
    fails = preflight(smoke=smoke)
    if fails:
        _halt(f"supervise: HALT - preflight failed ({len(fails)} issue(s), each with its fix above). "
              "Refusing the launch is cheaper than discovering these unit by unit overnight. "
              "Standalone check: python scripts/run_campaign.py --preflight")
    w, p = loop_cfg["worker"], _verifier_section(loop_cfg)
    k = _driver_knobs(loop_cfg)
    k["absolute_s"] = float(w["iteration_timeout_hours"]) * 3600
    props = _campaign_props(loop_cfg)
    cfg_mtime = LOOPCFG.stat().st_mtime
    consec_fail = int(_read_state().get("consecutive_operational_failures") or 0)
    consec_vfail = 0
    seen_demotions: set = set()     # suite checks metered out of the every-set, as last logged

    try:
        while True:
            _touch_driver_alive()
            stop = next((p for p in (RESULTS / "STOP", RESULTS / "STOP.txt") if p.exists()), None)
            if stop is not None:
                # The human's graceful stop, honoured at the CAMPAIGN level (CLAUDE.md HARD GATE 5).
                # We are at the loop top, so the last unit is fully recorded - exit clean, not an error.
                # Recorded in loop_stops.log too: every stop leaves a record (CORE, "Running unattended").
                try:
                    with open(RESULTS / "loop_stops.log", "a", encoding="utf-8") as f:
                        f.write(f"{_dt.datetime.now(_dt.timezone.utc).isoformat()}\tDRIVER_STOP\t"
                                f"{stop.name}\n")
                except OSError:
                    pass
                print(f"[supervise] STOP - results/{stop.name} present: graceful stop honoured. The "
                      "completed unit is recorded; delete the file and relaunch to resume.")
                _service_capstone(k, _codex_backend.model_for(p, _AGENT_BACKEND),
                                  _codex_backend.effort_for(p, _AGENT_BACKEND), f"STOP ({stop.name})")
                return
            if ESCALATE.is_file():
                _halt(f"supervise: HALT - {ESCALATE} present (a genuine fork awaits the user). "
                      "Resolve it, delete the file, and relaunch.")
            free_mb, per_unit = _free_disk_mb(), _unit_disk_mb(loop_cfg)
            if free_mb is not None and per_unit > 0 and free_mb < _disk_floor_mb(per_unit):
                # Stopping cleanly beats writing half an artifact set: a disk that fills mid-unit
                # corrupts the save-set the whole ledger rests on. This is the resource analogue of an
                # integrity halt - the last completed unit is fully recorded.
                _halt(f"supervise: HALT - free disk is down to {free_mb / 1024:.2f} GB, below this "
                      f"campaign's floor of {_disk_floor_mb(per_unit) / 1024:.2f} GB "
                      f"({DISK_FLOOR_UNITS} units x {_mb(per_unit)} MB/unit). Stopping BEFORE a unit "
                      "writes a partial save-set. Free space or apply the retention plan "
                      "(campaign.md §Decision record, the retention entry), then relaunch - the loop resumes where it is.")
            if LOOPCFG.stat().st_mtime != cfg_mtime:
                old_loop_cfg = loop_cfg
                loop_cfg = _read_json(LOOPCFG, loop_cfg)
                w, p = loop_cfg["worker"], _verifier_section(loop_cfg)
                k = _driver_knobs(loop_cfg)
                k["absolute_s"] = float(w["iteration_timeout_hours"]) * 3600
                old_props, props = props, _campaign_props(loop_cfg)
                cfg_mtime = LOOPCFG.stat().st_mtime
                print("[supervise] configs/loop.json changed - reloaded (logged): " + json.dumps(k))
                # The campaign PROPERTIES are setup-time declarations, so a flip mid-run is an event the
                # record must show - the driver knobs above were logged, the properties were not. The
                # metric_revision dial especially: it is changed only from an attended session (the
                # config guard refuses a spawned role), so this line is how a flip is seen at all.
                def _epochs_summary(block) -> str:
                    return "{" + ", ".join(f"{k}: {v.get('status', '?') if isinstance(v, dict) else '?'}"
                                           for k, v in (block or {}).items()) + "}"
                for key in ("metric_revision", "metric_version", "data_version",
                            "noise_model", "metric_epochs"):
                    if old_props.get(key) != props.get(key):
                        before, after = old_props.get(key), props.get(key)
                        if key == "metric_epochs":
                            before, after = _epochs_summary(before), _epochs_summary(after)
                        print(f"[supervise] campaign.{key}: {before!r} -> {after!r} "
                              f"(utc {_utc_stamp()}; edited outside the driver - the user, an attended "
                              "session, or an agent opening an epoch)")
                ov, nv = _verify_rows(old_loop_cfg), _verify_rows(loop_cfg)
                if (ov["preset"], ov["source"]) != (nv["preset"], nv["source"]):
                    # The preset is the user's choice of how much verification the campaign buys; a
                    # mid-campaign change is legitimate and must be visible in the record, never silent.
                    print(f"[supervise] verify.preset: {ov['preset']!r} -> {nv['preset']!r} "
                          f"({_rows_line(nv)}; utc {_utc_stamp()}; edited outside the driver)")

            # A demotion is made inside a worker's runner; the driver log is where it must be seen.
            _st_d = _read_json(CORRECTNESS_STATE, None)
            _dem = dict((_st_d or {}).get("demotions") or {}) if isinstance(_st_d, dict) else {}
            for _name in sorted(set(_dem) - set(seen_demotions)):
                _d = _dem[_name] if isinstance(_dem[_name], dict) else {}
                print(f"[supervise] suite demotions changed: {_name} {_d.get('from', 'every')}->"
                      f"{_d.get('to', 'promotion')} ({float(_d.get('wall_s') or 0):.1f}s vs "
                      f"{float(_d.get('budget_s') or 0):.1f}s budget) - it still runs for every promotion "
                      f"candidate; restore it by deleting its demotions entry in "
                      f"results/correctness_state.json utc={_utc_stamp()}")
            seen_demotions = set(_dem)

            q = _read_state()
            if _verification_strategy(loop_cfg) == "driver-direct":
                consec_vfail = _service_due(k, _codex_backend.model_for(p, _AGENT_BACKEND), consec_vfail)
                q = _read_state()
                if _verification_backlog(q):
                    continue

            # ---- one fresh-context worker per unit; the worker chooses the unit; retry, then count ----
            notes = _drain_inbox(k["inbox_max_chars"])   # drained ONCE per unit; reused on the retry
            peer_due = [e for e in (q.get("peer_due") or []) if isinstance(e, dict) and e.get("exp")]
            prompt = build_prompt("worker", notes=notes, peer=peer_due)
            print(f"[supervise] {_brief_line('worker')}")
            t_spawn_wall = time.time()       # the JOURNAL must be written anew after this to count as saved

            def _unit_resolved(t0=t_spawn_wall) -> bool:
                """Grace probe: the spawn counts resolved once a unit's save-set exists OR the worker wrote
                its STOP judgement into the new JOURNAL."""
                return bool(_new_units_since(t0)) or bool(_journal_says_stop(t0))

            st = "unknown"
            saved: list = []
            stop_reason = ""
            contract_met = ""          # the worker met its exit contract without a unit: no retry
            retries = int(w.get("retries", 1))
            for attempt in range(1 + retries):
                # The previous JOURNAL is archived and the working file removed: the brief carries it, and
                # the worker writes the new one as a fresh file (one Write, no read, no splice).
                _archive_journal(clear=True)
                st = _spawn_with_backoff(prompt, _codex_backend.model_for(w, _AGENT_BACKEND), "worker", k,
                                  saved_probe=_unit_resolved,
                                  effort=_codex_backend.effort_for(w, _AGENT_BACKEND))
                saved = _units_saved_since(t_spawn_wall)
                stop_reason = _journal_says_stop(t_spawn_wall)
                if saved or stop_reason:
                    break
                denied = [d for d in (globals().get("_LAST_DENIED") or {}).pop("worker", [])
                          if d in ("Write", "Edit", "MultiEdit", "Bash", "PowerShell", "NotebookEdit")]
                if denied:
                    # The permission mode refused the worker its tools (CLI 2.1.267 denies a headless
                    # `auto` spawn its Write and Bash - the measurement pass after the queue's retirement lost every arm
                    # to it). Not a unit failure and not the environment's: the mode. Halt with the fix.
                    _write_state(q)
                    _halt(f"supervise: HALT - the worker's tool calls were DENIED by the permission mode "
                          f"({', '.join(denied)}; mode={k['permission_mode']}). No unit can run this way. Fix: "
                          "set configs/loop.json driver.permission_mode to \"bypassPermissions\" (or export "
                          "AUTORESEARCH_PERMISSION_MODE=bypassPermissions) and relaunch - the campaign root, the "
                          "guard hook and the runner's gates are the sandbox; the headless classifier is not.")
                if ESCALATE.is_file():
                    contract_met = "ESCALATE.md"
                elif _journal_updated_since(t_spawn_wall):
                    contract_met = "a new results/JOURNAL.md"
                if contract_met:
                    # The worker did its job and found no unit it could run (a blocker it escalated, a
                    # judgement it wrote into the JOURNAL): a second spawn against the same state would
                    # meet the same wall (the measurement pass's live arm spent $10 on the retry). No retry.
                    print(f"[supervise] no unit saved, but the worker met its exit contract ({contract_met}) - "
                          "not retried; the loop top decides")
                    break
                print(f"[supervise] no unit saved (attempt {attempt + 1}): status={st} - "
                      + ("retrying" if attempt < retries else "out of retries"))

            if peer_due:
                _stamp_peer_checks(peer_due, t_spawn_wall)
                q = _read_state()
            if not JOURNAL.is_file() and _restore_journal():
                print("[supervise] the worker left no new results/JOURNAL.md - the archived one is restored "
                      "(the unit is incomplete: the working memory was not brought up to date)")

            # ---- accept / stop / count (liveness = accepted units per unit time) ----
            q = _read_state()
            if saved and all(stem in (q.get("accepted") or []) for stem, _ in saved):
                # Only units counted on an earlier pass (a fast unit's result can fall inside the next
                # spawn's one-second mtime tolerance): announce them and judge the spawn by what else it
                # left - a STOP judgement must not hide behind an idempotent re-accept.
                for stem, _ in saved:
                    print(f"[supervise] unit {stem} already accepted - not re-counted (idempotent)")
                saved = []
                if _journal_updated_since(t_spawn_wall) and not stop_reason:
                    contract_met = contract_met or "a new results/JOURNAL.md"
            if saved:
                consec_fail = 0
                for stem, cfg_path in saved:
                    if stem in (q.get("accepted") or []):
                        # IDEMPOTENT ACCEPT: a unit counted on an earlier pass is never counted twice.
                        print(f"[supervise] unit {stem} already accepted - not re-counted (idempotent)")
                        continue
                    if _codex_backend.is_codex(_AGENT_BACKEND):
                        if provenance_error := _codex_backend.stamp_worker_snapshot(
                                ROOT, cfg_path, _LAST_CODEX_OBSERVER):
                            print(f"[supervise] Codex provenance WARNING: {provenance_error}")
                    q.setdefault("accepted", []).append(stem)
                    q["accepted_units"] = int(q.get("accepted_units", 0)) + 1
                    q["last_accept_utc"] = _dt.datetime.now(_dt.timezone.utc).isoformat()
                    print(f"[supervise] accepted unit #{q['accepted_units']}: {stem} ({cfg_path}) "
                          f"utc={_utc_stamp()}")
                    # The ONE check this result is owed (decided at record time into its checks
                    # artifact), and what this unit settles for the new bests awaiting survival before it.
                    # Persisted, so a check owed by an interrupted run is serviced on relaunch.
                    _route_checks(q, stem, cfg_path)
                q["consecutive_operational_failures"] = consec_fail
                _write_state(q)
            elif stop_reason:
                # DONE: the worker judged the campaign's question answered, or no unit worth running. A
                # stopping decision for the user - the claim audit runs first, so the record is read as
                # finished only after the campaign-scale checks (CLAUDE.md HARD GATE 5).
                q["consecutive_operational_failures"] = 0
                _write_state(q)
                try:
                    with open(RESULTS / "loop_stops.log", "a", encoding="utf-8") as f:
                        f.write(f"{_dt.datetime.now(_dt.timezone.utc).isoformat()}\tWORKER_STOP\t{stop_reason}\n")
                except OSError:
                    pass
                print(f"[supervise] the worker judged the campaign done: {stop_reason} utc={_utc_stamp()}")
                _service_capstone(k, _codex_backend.model_for(p, _AGENT_BACKEND),
                                  _codex_backend.effort_for(p, _AGENT_BACKEND), "worker STOP")
                _halt(f"supervise: HALT - the worker wrote NEXT: STOP - {stop_reason}. The campaign's own "
                      "judgement is that it is done or stuck; this is a stopping decision for the user "
                      "(an unfalsified 'done' is INCONCLUSIVE - CLAUDE.md HARD GATE 5). Read the JOURNAL; "
                      "relaunch to continue.")
            elif contract_met:
                # Not an operational failure: the worker exited as the contract says, with nothing to run.
                # An ESCALATE halts at the loop top; a JOURNAL without a unit lets the next spawn re-judge.
                consec_fail = 0
                q["consecutive_operational_failures"] = 0
                _write_state(q)
                print(f"[supervise] spawn ended without a unit ({contract_met} written) utc={_utc_stamp()}")
            else:
                # OPERATIONAL failure: counted and CONTINUE - degrade-loud. Only N in a row is systemic.
                consec_fail += 1
                q["consecutive_operational_failures"] = consec_fail
                _write_state(q)
                print(f"[supervise] OPERATIONAL failure #{consec_fail}/{k['max_consecutive_failures']}: "
                      f"no unit saved and no STOP judgement (last status: {st}) - the loop continues "
                      "(degrade-loud)")
                if consec_fail >= k["max_consecutive_failures"]:
                    _halt(f"supervise: HALT - {consec_fail} consecutive operational failures is SYSTEMIC "
                          "(the environment, not the units): check the agent CLI, credentials, and disk; "
                          "read the driver log, then relaunch.")

            # ---- verify-after: service what the preset owes (also drains backlog left by a preset flip) ----
            if q.get("pending_verification") or []:
                consec_vfail = _service_due(k, _codex_backend.model_for(p, _AGENT_BACKEND), consec_vfail)
    except KeyboardInterrupt:
        proc = _LIVE_PROC.get("proc")
        if proc is not None and proc.poll() is None:
            _kill_tree(proc)
        print("[supervise] interrupted (Ctrl-C) - live agent killed; nothing is counted for this spawn "
              "(relaunch continues). For a graceful end-of-unit stop, create results/STOP instead.")
        sys.exit(130)
    finally:
        DRIVER_ALIVE.unlink(missing_ok=True)   # a crashed/exited driver must re-arm the Stop hook
        sys.stdout = log.close()


def supervise(smoke: bool = False):
    """Own the campaign, then run the otherwise-unchanged deterministic supervisor."""
    try:
        lock = _supervisor_lock.acquire(
            RESULTS / ".supervisor.lock",
            backend=("codex" if _codex_backend.is_codex(_AGENT_BACKEND) else _supervisor_lock.backend_label(AGENT_CMD[0])),
        )
    except _supervisor_lock.SupervisorLockError as exc:
        _halt(f"supervise: HALT - {exc}")
    try:
        return _supervise_unlocked(smoke=smoke)
    finally:
        lock.release()


def _exp_stem(config_path: Path) -> str:
    """The exp_name a config declares, or "" if unreadable - the stem every artifact is keyed by.
    BOM-tolerant, since a config may have been hand-edited on Windows."""
    try:
        return json.loads((ROOT / config_path).read_text(encoding="utf-8-sig"))["exp_name"]
    except Exception:
        return ""


def _unit_saved_missing(config_path: Path, since: float | None = None) -> list[str]:
    """Which parts of the save-set a worker must leave behind are ABSENT (the checkpoint contract's hard
    core): the result JSON, the snapshot directory, the logbook entry with its Analysis, and - when
    `since` (the spawn's start) is given - a results/JOURNAL.md touched after it: the working memory is
    owed like the artifacts. Named, so a failure record says what was missing."""
    stem = _exp_stem(config_path)
    exp_id = exp_id_for(stem) if stem else ""
    if not exp_id:
        return ["a nameable exp id"]       # an unnameable unit cannot have left a well-named save-set
    missing = []
    if not (RESULTS / f"result_{exp_id}.json").is_file():
        missing.append(f"results/result_{exp_id}.json")
    if not (SNAPSHOTS / stem).is_dir():
        missing.append(f"results/snapshots/{stem}/")
    text = LOGBOOK.read_text(encoding="utf-8", errors="replace")
    if stem not in text:
        missing.append("the logbook entry")
    elif _logbook_field(text, exp_id, "Analysis") == "":
        # The one narrative slot the worker owes (NEXT is the other, and it is cheap to leave a line).
        # Refusing absence, never length: an Analysis that names every failed check in three lines is
        # complete; an empty one is a result nobody read.
        missing.append("the logbook Analysis slot (blank)")
    if since is not None and not _journal_updated_since(since):
        missing.append("results/JOURNAL.md written anew (the previous one is archived and in the brief; "
                       "write the whole file, with its **NEXT:** line)")
    return missing


def _unit_saved(config_path: Path, since: float | None = None) -> bool:
    """Structural validation of what a worker must leave behind (the checkpoint contract's hard core)."""
    return not _unit_saved_missing(config_path, since)


# ---- driver-scheduled verification (the preset says what each unit is owed; the driver spawns the
# ---- verifier and decides its depth; the worker never grades its own work) -------------------------

def _find_verdict_file(stem: str) -> Path | None:
    """The verdict artifact for one experiment, matched by SUBJECT: the file is named for the exp id or
    slug, or its JSON carries the matching exp_id. Filename first (cheap), content second."""
    eid = exp_id_for(stem)
    if not VERDICTS.is_dir():
        return None
    for p in sorted(VERDICTS.glob("*.json")):
        if p.stem == stem or (eid and exp_id_for(p.stem) == eid):
            return p
    for p in sorted(VERDICTS.glob("*.json")):
        try:
            v = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if eid and exp_id_for(str(v.get("exp_id", "")).strip()) == eid:
            return p
    return None


def _stamp_verified(stem: str) -> None:
    """Fill the scoreboard row's `verified` cell from the verdict artifact - mechanical consumption.

    The artifact is the evidence; the column is the view of it, and leaving the stamp to agent
    diligence is how rows acted as current-best with a blank `verified` (the hygiene failure
    campaign-status flags). Fills a BLANK cell only: an already-recorded value is never overwritten -
    a mismatch between column and artifact is campaign-status's audit to surface, not this function's
    to hide. The `verified` column is the one cell of the append-only ledger DESIGNED to be filled
    after its row ("blank until run"), so this is completion, not history-editing."""
    vf = _find_verdict_file(stem)
    if vf is None:
        return
    try:
        verdict = str(json.loads(vf.read_text(encoding="utf-8")).get("verdict", "")).strip().upper()
    except Exception:
        return
    if not verdict:
        return
    eid = exp_id_for(stem)
    try:
        lines = SCOREBOARD.read_text(encoding="utf-8").splitlines()
        header_i = next(i for i, L in enumerate(lines) if L and not L.startswith("#"))
        cols = lines[header_i].split("\t")
        vcol = next((i for i, c in enumerate(cols) if c.strip().lower() == "verified"), None)
        if vcol is None:
            return
        for i in range(header_i + 1, len(lines)):
            cells = lines[i].split("\t")
            if cells and cells[0].strip() == eid:
                while len(cells) < len(cols):
                    cells.append("")
                if not cells[vcol].strip():
                    cells[vcol] = verdict
                    lines[i] = "\t".join(cells)
                    SCOREBOARD.write_text("\n".join(lines) + "\n", encoding="utf-8")
                    print(f"[supervise] stamped scoreboard verified={verdict} for exp {eid} "
                          f"(from {vf.name})")
                return
    except Exception as exc:
        print(f"[supervise] note: could not stamp verified for {stem} ({exc}) - the verdict artifact "
              "is the record either way")


def _route_checks(q: dict, stem: str, cfg_path) -> None:
    """At accept time. First, what this unit settles for the new bests awaiting survival: a
    scored unit that is itself a new best beat them - their changes are covered by its check, so they get
    none of their own; a scored unit that is not a new best let them SURVIVE - each is now owed its
    independent check (a peer check by the next worker, or the driver's verifier). Then this unit's own
    check: a new best under a survivor preset waits; an every-result independent check is owed now; a
    self-verify was the worker's, inside its unit (its record was held to it). Mutates `q`."""
    ck = _read_json(CHECKS / f"checks_{exp_id_for(stem)}.json", None)
    if not isinstance(ck, dict) or not isinstance((ck.get("verification") or {}).get("owed"), dict):
        # No record of what it is owed (no checks artifact - a unit saved without the runner): fail safe -
        # the preset's independent check, at once; nothing to settle for the bests awaiting survival.
        ind = str(_verify_rows(_read_json(LOOPCFG, {}) or {})["rows"].get("independent") or "off")
        hyp0 = str((_read_json(ROOT / cfg_path, {}) or {}).get("_hypothesis") or "")
        e0 = {"config": str(cfg_path).replace("\\", "/"), "hypothesis": hyp0, "exp": stem}
        if _codex_backend.is_codex(_AGENT_BACKEND):
            e0.update(worker_backend="codex", worker_thread_id=(
                _LAST_CODEX_OBSERVER.thread_id if _LAST_CODEX_OBSERVER else ""))
        if ":" in ind:
            _owe_independent(q, dict(e0, check=ind.split(":", 1)[1]), "no checks artifact - owed at once")
        else:
            print(f"[supervise] {stem}: no checks artifact and no independent check in this preset - nothing "
                  f"owed utc={_utc_stamp()}")
        return
    ver = ck.get("verification") or {}
    owed = ver.get("owed") or {}
    new_best = bool(ver.get("new_best"))
    scored = (ck.get("metric") or {}).get("value") is not None
    hyp = str((_read_json(ROOT / cfg_path, {}) or {}).get("_hypothesis") or "")
    base = {"config": str(cfg_path).replace("\\", "/"), "hypothesis": hyp}
    if _codex_backend.is_codex(_AGENT_BACKEND):
        base.update(worker_backend="codex", worker_thread_id=(
            _LAST_CODEX_OBSERVER.thread_id if _LAST_CODEX_OBSERVER else ""))
    if scored:
        for e in [e for e in (q.get("awaiting_survival") or []) if e.get("exp") != stem]:
            if new_best:
                print(f"[supervise] {e['exp']} was beaten by {stem} before its {e.get('check')} check - no check "
                      f"of its own; {stem}'s check covers its changes utc={_utc_stamp()}")
            else:
                _owe_independent(q, e, f"survived {stem}")
        q["awaiting_survival"] = [e for e in (q.get("awaiting_survival") or []) if e.get("exp") == stem]
    contest = ver.get("contest") if isinstance(ver.get("contest"), dict) else None
    if contest and str(contest.get("status") or "pending") == "pending":
        # A CONTESTED gate outcome: the worker disputed its own result's pass or refusal and does not
        # decide it. The independent check is owed NOW, whatever the preset (a worker's explicit dispute
        # is the one trigger every preset honours), it supersedes any survivor wait, and the pointer
        # waits for the verdict (the guard refuses a promotion write while the contest is pending).
        q["awaiting_survival"] = [e for e in (q.get("awaiting_survival") or []) if e.get("exp") != stem]
        _owe_independent(q, dict(base, exp=stem, check="verifier", contest=contest),
                         f"contested gate outcome ({contest.get('disputes') or 'pass'})")
        return
    chk, when = owed.get("check"), owed.get("when")
    if chk in ("peer", "verifier") and when == "survival":
        q.setdefault("awaiting_survival", []).append(dict(base, exp=stem, check=chk))
        print(f"[supervise] {stem} is a new best: its {chk} check waits until the next unit does not beat it "
              f"utc={_utc_stamp()}")
    elif chk in ("peer", "verifier"):
        _owe_independent(q, dict(base, exp=stem, check=chk), "every result")
    else:
        print(f"[supervise] {stem}: " + (f"a self-verify was owed - recorded in the unit (label "
                                         f"{ck.get('label', 'unverified')})" if chk == "self-verify" else
                                         f"no check owed ({owed.get('why') or 'no verification record'})")
              + f" utc={_utc_stamp()}")


def _owe_independent(q: dict, e: dict, why: str) -> None:
    """Owe one independent check now: a peer check rides into the next worker's VALUES; a verifier check
    joins pending_verification, which the driver services before more science."""
    if e.get("check") == "peer":
        if not any(d.get("exp") == e["exp"] for d in q.get("peer_due") or []):
            q.setdefault("peer_due", []).append(dict(e, why=why))
        print(f"[supervise] peer check owed for {e['exp']} ({why}): the next worker runs it first "
              f"utc={_utc_stamp()}")
        return
    if not any(d.get("exp") == e["exp"] for d in q.get("pending_verification") or []):
        q.setdefault("pending_verification", []).append(
            {k: v for k, v in dict(e, row="verifier", trigger=why, owed_ts=time.time()).items() if k != "check"})
    print(f"[supervise] verifier check owed for {e['exp']} ({why}) utc={_utc_stamp()}")


def _stamp_peer_checks(due: list, t_spawn: float) -> None:
    """After a worker spawn that was owed peer checks: stamp each verdict it wrote (written during THIS
    spawn - a file from before it, such as one the producing worker wrote about its own result, never
    counts), clear what landed, and leave what did not for the next worker, loudly."""
    q = _read_state()
    left = []
    for e in q.get("peer_due") or []:
        if e.get("exp") not in {d.get("exp") for d in due}:
            left.append(e)
            continue
        vf = _find_verdict_file(e["exp"])
        if vf is not None and vf.stat().st_mtime >= t_spawn:
            _stamp_verified(e["exp"])
            _stamp_label(e["exp"], dict(e, check="peer"))
            _note_followups([e["exp"]])
            print(f"[supervise] peer check on record for {e['exp']}: {vf.name} utc={_utc_stamp()}")
        else:
            left.append(e)
            print(f"[supervise] the worker wrote no peer verdict for {e['exp']} - owed again to the next worker "
                  f"utc={_utc_stamp()}")
    q["peer_due"] = left
    _write_state(q)


def _check_line(group: list, extras: dict) -> str:
    """What the verifier is checking and why, as a prompt VALUE (never through the template string).

    A CONTESTED result carries the worker's charge in the same line: the claim the verifier grades is the
    recorded gate outcome, the charge is the first attack to run, and the check is blinded whatever the
    preset - the charge must be judged on the artifacts, never on the narrative that produced it."""
    why = "; ".join(sorted({str(e.get("trigger") or "") for e in group if e.get("trigger")}))
    line = ("\nThis is the result's ONE independent check: " + (why or "owed by the preset")
            + ". Refute it by whatever route the claim calls for - re-score the saved artifact in a fresh "
              "process, re-derive, probe what changed; re-run a search only when the claim is about the "
              "search. Write \"kind\": \"verifier\" in each verdict.")
    contests = [e.get("contest") for e in group if isinstance(e.get("contest"), dict)]
    if extras.get("blinded") or contests:
        line += (" Blinded: do not read results/JOURNAL.md or the logbook narrative - the ledger and the "
                 "artifacts only.")
    for c in contests:
        disputes = str(c.get("disputes") or "pass")
        line += (f"\nCONTEST ({disputes}). The worker that recorded this result DISPUTES its gate outcome"
                 + (f" - {_one_line(str(c.get('gate')))}" if c.get("gate") else "")
                 + " - and does not decide it; you do. The charge, as filed: \""
                 + _one_line(str(c.get("claim") or "")) + "\". Evidence the charge names: "
                 + (", ".join(str(p) for p in (c.get("evidence") or [])) or "(none named)")
                 + ". The claim you grade is the RECORDED OUTCOME (a " + disputes
                 + "), and the charge is the first attack to run against it. CONFIRMED = the outcome stands "
                   "and the charge fails; REFUTED = the charge holds and the outcome is overturned; "
                   "PROVISIONAL / QUESTIONABLE ASSUMPTION / INCONCLUSIVE = the charge is not established, so "
                   "the recorded outcome stands with your verdict as its label (the worker's doubt is on the "
                   "record, not a veto). Judge the charge on the artifacts it names and the ledger - not on "
                   "campaign.md's landmine rows and not on the worker's reasoning. Write \"contest\": true "
                   "in the verdict.")
    return line


def _stamp_label(stem: str, entry: dict) -> None:
    """After a verdict lands: the checks artifact's `verification.agent` block and the label every
    exported claim carries (<VERDICT>/<kind>: peer or verifier). The verdict artifact is the evidence;
    the label is the machine-derived view of it, never softened. A REFUTED best rolls the RECOMMENDED
    pointer back; a label that moved is carried into RECOMMENDED.json."""
    vf = _find_verdict_file(stem)
    eid = exp_id_for(stem)
    art = CHECKS / f"checks_{eid}.json" if eid else None
    if vf is None or not art or not art.is_file():
        return
    try:
        v = json.loads(vf.read_text(encoding="utf-8"))
        ck = json.loads(art.read_text(encoding="utf-8"))
    except Exception:
        return
    verdict = str(v.get("verdict", "")).strip().upper()
    if not verdict:
        return
    kind = "peer" if (entry.get("check") == "peer" or str(v.get("kind") or "").lower() == "peer") else "verifier"
    ck.setdefault("verification", {})["agent"] = {
        "kind": kind, "trigger": entry.get("trigger") or entry.get("why"), "verdict": verdict,
        "refuter": v.get("refuter"), "session": entry.get("session"), "verdict_file": vf.name,
        "utc": _utc_stamp()}
    ck["label"] = f"{verdict}/{kind}"
    tmp = art.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(ck, indent=2), encoding="utf-8")
    os.replace(tmp, art)
    # The logbook's runner-owned lines follow the artifacts; a line a verifier or the agent wrote by
    # hand (anything past `pending` / `self-checked` / `self-verified`, a Status past `open`) is left.
    _set_logbook_field(stem, "Verification", f"{ck['label']} ({vf.name})",
                       only_if_prefix=("", "pending", "unverified", "self-checked", "self-verified"))
    _set_logbook_field(stem, "Status", "confirmed" if verdict == "CONFIRMED" else verdict,
                       only_if_prefix=("open",))
    _recommended_follows(stem, ck["label"])


def _recommended_subject(rec: dict) -> str:
    """The experiment a RECOMMENDED.json names: `_promoted_from` (the template's key), else the stem of its
    `config` path, else an `exp_name` that is an experiment's (a worker that wrote the pointer as a copy
    of the promoted config names it there)."""
    named = str(rec.get("_promoted_from") or "").strip()
    if not named and rec.get("config"):
        named = Path(str(rec.get("config"))).stem
    if not named and str(rec.get("exp_name") or "").strip() not in ("", "RECOMMENDED"):
        named = str(rec.get("exp_name")).strip()
    return named


def _recommended_follows(stem: str, label: str) -> None:
    """RECOMMENDED.json follows the true best at once, with its current label: when a check
    lands on the promoted experiment the driver carries the new label in; when it REFUTES it, the pointer
    rolls back to the best result not refuted, with that result's label. The driver's own write - the
    guard polices agents' promotion writes, and this one is mechanical."""
    rec_path = ROOT / "configs" / "RECOMMENDED.json"
    rec = _read_json(rec_path, None)
    if not isinstance(rec, dict) or _recommended_subject(rec) != stem:
        return
    if not _is_refuted(label):
        rec["verification_label"] = label
        _write_text_atomic(rec_path, json.dumps(rec, indent=2) + "\n")
        print(f"[supervise] RECOMMENDED.json ({stem}) now carries label {label} utc={_utc_stamp()}")
        return
    inc = _incumbent(_prior_results(""), _campaign_props())
    cfg = _read_json(ROOT / "configs" / f"{inc['exp_name']}.json", None) if inc else None
    if inc is None or not isinstance(cfg, dict):
        print(f"[supervise] RECOMMENDED.json names {stem}, which was REFUTED, and no unrefuted result has a "
              f"config to roll back to - the pointer is left and flagged here; fix it by hand "
              f"utc={_utc_stamp()}")
        return
    new = dict(cfg, exp_name="RECOMMENDED", _promoted_from=inc["exp_name"],
               _metric_version=inc.get("metric_version"),
               _rolled_back=f"{stem} was REFUTED ({label}) on {_utc_stamp()}; the pointer rolled back to the "
                            "best result not refuted",
               verification_label=inc.get("label") or "unverified")
    _write_text_atomic(rec_path, json.dumps(new, indent=2) + "\n")
    print(f"[supervise] RECOMMENDED.json rolled back from {stem} (REFUTED) to {inc['exp_name']} "
          f"({new['verification_label']}) utc={_utc_stamp()}")


def _verification_backlog(q: dict) -> list[list[dict]]:
    """Groups from driver_state.json's pending_verification that are ready - every entry, as soon as it is
    owed, one spawn per unit (there are no blocks without a queue: a "block" trigger from an older preset
    table verifies the unit at once, and the verifier's label is the unit's exp name)."""
    return [[e] for e in (q.get("pending_verification") or []) if isinstance(e, dict)]


def _service_verification(k: dict, model: str, vfail: int, effort: str = "") -> int:
    """Spawn the verifier for every completed block awaiting verification; stamp and clear on success.

    Runs every loop iteration (pending_verification is persisted in driver_state.json, so verification
    owed by a crashed or interrupted run is serviced on relaunch - never lost). Verification is control
    flow, not agent virtue: an entry is not cleared until its verdict artifact exists.
    Failures degrade LOUD like worker failures - the entries stay pending and are retried next
    iteration - and N in a row is SYSTEMIC: a campaign whose verification preset (configs/loop.json
    verify.preset) owes these units an independent check must not keep accumulating unverified science.
    Returns the updated consecutive-verification-failure count."""
    q = _read_state()
    failed_units: list = []            # one verification failure per SERVICE PASS, however many units it covers
    for group in _verification_backlog(q):
        exps = [e.get("exp", "") for e in group if e.get("exp")]
        if not exps:                                   # unnameable entries cannot be verified; drop them
            bad_cfgs = {e.get("config") for e in group}
            q2 = _read_state()
            q2["pending_verification"] = [e for e in (q2.get("pending_verification") or [])
                                          if e.get("config") not in bad_cfgs]
            _write_state(q2)
            continue
        owed_at = {e.get("exp"): float(e.get("owed_ts") or 0) for e in group}

        def _fresh(stem: str) -> bool:
            # Only a verdict written AFTER the check was owed counts: a file the producing worker wrote
            # about its own result is not the independent check.
            vf = _find_verdict_file(stem)
            return vf is not None and vf.stat().st_mtime >= owed_at.get(stem, 0.0)

        missing = [s for s in exps if not _fresh(s)]
        if missing:
            hyp = next((e.get("hypothesis") for e in group if e.get("hypothesis")), "")
            label = exps[0] if len(exps) == 1 else f"{exps[0]}+{len(exps) - 1}"
            loop_cfg = _read_json(LOOPCFG, {}) or {}
            vr = _verify_rows(loop_cfg)
            print(f"[supervise] verification due for {label}: {', '.join(missing)} "
                  f"({group[0].get('trigger') or 'owed'}) utc={_utc_stamp()}")
            # The intensive rows include the scripted ones: whatever promotion-time checks have not yet
            # run for these experiments run now, recorded against them, before an agent is spent.
            try:
                props_v = _campaign_props(loop_cfg)
                for s in missing:
                    d = _due_checks(_read_json(CORRECTNESS_STATE, None), vr["rows"], props_v,
                                    candidate=True, core_moved=False)
                    if d["due"] and not d["first"]:
                        check_correctness_suite(props_v["metric_version"], select=",".join(d["due"]),
                                                ran_for=s, why="verifier", props=props_v)
            except Exception as exc:
                print(f"[supervise] note: promotion-time checks before verification skipped ({exc})")
            mode = _check_line(group, vr["extras"])
            prompt = build_prompt("verifier", exps=", ".join(missing), hypothesis=str(hyp or ""), mode=mode)

            def _verdicts_probe(ms=tuple(missing)) -> bool:
                return all(_fresh(s) for s in ms)

            retries = int(k.get("verifier_retries", k.get("planner_retries", 1)))
            for attempt in range(1 + retries):
                before = list(missing)
                st = _spawn_with_backoff(prompt, model, f"verifier[{label}]", k, saved_probe=_verdicts_probe,
                                  effort=effort)
                missing = [s for s in exps if not _fresh(s)]
                if not missing:
                    break
                wrote = [s for s in before if s not in missing]
                again = " - retrying" if attempt < retries else ""
                if st == "ok" and not wrote:
                    # The characteristic shape: the verifier launched its refuters in the background,
                    # reported them running, and ended its turn - ok, and nothing on disk.
                    print(f"[supervise] verifier attempt {attempt + 1} returned ok but wrote NO verdict "
                          f"artifact (0 of {len(before)}: {', '.join(before)}) - a refuter launched in "
                          f"the background and abandoned is the usual cause{again}")
                else:
                    print(f"[supervise] verifier attempt {attempt + 1} left verdicts missing for "
                          f"{', '.join(missing)} (status={st}, wrote {len(wrote)} of {len(before)}){again}")
                if attempt < retries:
                    # The retry is told what the last attempt failed to deliver - a driver-authored note,
                    # not user steering (the verifier stays isolated from the inbox).
                    prompt = build_prompt("verifier", exps=", ".join(missing), hypothesis=str(hyp or ""),
                                          mode=mode,
                                          retry_note=f"attempt {attempt + 1} ended with status={st} and "
                                                     f"these verdicts still missing: {', '.join(missing)}")
        if missing:
            failed_units += missing
            print(f"[supervise] verification of {', '.join(missing)} did not land - the entry stays in "
                  "pending_verification and is retried next iteration (degrade-loud)")
            continue
        refuted = []
        for s in exps:
            _stamp_verified(s)
            entry_s = next((e for e in group if e.get("exp") == s), group[0])
            _stamp_label(s, entry_s)
            _contest_resolve(s, entry_s)
            vf = _find_verdict_file(s)
            v = (_read_json(vf, {}) or {}) if vf else {}
            if str(v.get("verdict", "")).strip().upper() == "REFUTED":
                refuted.append(s)
        done_cfgs = {e.get("config") for e in group}
        q2 = _read_state()
        q2["pending_verification"] = [e for e in (q2.get("pending_verification") or [])
                                      if e.get("config") not in done_cfgs]
        _write_state(q2)
        _note_followups(exps)          # REFUTED / INCONCLUSIVE follow-ups reach the next worker as a note
        print(f"[supervise] verification complete: {', '.join(exps)} - verdict(s) on record and stamped"
              + (f"; REFUTED: {', '.join(refuted)}" if refuted else "") + f" utc={_utc_stamp()}")
    if failed_units:
        vfail += 1
        print(f"[supervise] VERIFICATION failure #{vfail}/{k['max_consecutive_failures']}: "
              f"{', '.join(failed_units)} still unverified - entries stay in pending_verification and "
              "are retried next iteration (degrade-loud)")
        if vfail >= k["max_consecutive_failures"]:
            _halt(f"supervise: HALT - {vfail} consecutive verification failures is SYSTEMIC. This "
                  "campaign's verification preset (configs/loop.json verify.preset) owes an independent "
                  "check for these units, so the loop must not keep producing science nothing "
                  "verifies: check the agent CLI and the driver log, then relaunch - pending "
                  "verification resumes first.")
        return vfail
    return 0


def _verification_strategy(loop_cfg: dict) -> str:
    policy = _verifier_policy()
    if errors := policy.strategy_errors(loop_cfg, _AGENT_BACKEND.name):
        _halt("supervise: HALT - " + "; ".join(errors))
    return policy.strategy(loop_cfg, _AGENT_BACKEND.name)


def _direct_verifier_spawn(prompt, model, label, k, saved_probe):
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    effort = _codex_backend.effort_for(loop_cfg.get("worker") or {}, _AGENT_BACKEND)
    status = _spawn_agent(prompt, model, label, k, saved_probe=saved_probe, effort=effort)
    return status, (_LAST_CODEX_OBSERVER.thread_id if _LAST_CODEX_OBSERVER else "")


def _service_due(k: dict, model: str, vfail: int) -> int:
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    if _verification_strategy(loop_cfg) != "driver-direct":
        effort = _codex_backend.effort_for(_verifier_section(loop_cfg), _AGENT_BACKEND)
        return _service_verification(k, model, vfail, effort)
    policy, q = _verifier_policy(), _read_state()
    if problem := policy.pending_problem(q):
        _halt("supervise: HALT - invalid Codex verification debt: " + problem)
    model = _codex_backend.model_for(loop_cfg.get("worker") or {}, _AGENT_BACKEND)
    extras = _verify_rows(loop_cfg)["extras"]

    def _stamp_both(stem: str) -> None:
        _stamp_verified(stem)
        entry = next((e for e in (q.get("pending_verification") or []) if e.get("exp") == stem), {})
        _stamp_label(stem, entry)
        _contest_resolve(stem, entry)

    return policy.service(
        ROOT, _verification_backlog(q), k, model, vfail,
        build_prompt=build_prompt, spawn=_direct_verifier_spawn, stamp=_stamp_both,
        exp_id_for=exp_id_for, read_queue=_read_state, write_queue=_write_state,
        log=print, halt=_halt, mode_line=lambda g: _check_line(g, extras))


def _set_metric_revision(mode: str) -> None:
    """`--set-metric-revision MODE`: the attended-session way to move the dial without hand-editing JSON.

    Refused under PHYSKIT_ROLE (a driver-spawned role inherits the marker; the dial is the user's). The
    change is recorded three ways without the user writing a word: this line, the driver's hot-reload
    log line if a loop is running, and the value stamped into every later snapshot manifest."""
    mode = str(mode).strip().lower()
    role = os.environ.get("PHYSKIT_ROLE", "").strip()
    if role:
        sys.exit(f"REFUSED: PHYSKIT_ROLE={role} - a driver-spawned role may not change campaign."
                 "metric_revision. That dial is the user's decision (the metric-epoch design): it is set from an attended "
                 "session. If you believe the mode should change, say so in results/ESCALATE.md.")
    probe = _campaign_props()
    if probe.get("_unreadable"):
        sys.exit("CAMPAIGN PROPERTIES: " + probe["_unreadable"])
    problems = [p for p in campaign_props_problems(dict(probe, metric_revision=mode)) if "metric_revision" in p]
    if problems:
        sys.exit("REFUSED: " + problems[0])
    cfg = _read_json(LOOPCFG, None)
    before = str((cfg.get("campaign") or {}).get("metric_revision") or "cautious").strip().lower()
    cfg.setdefault("campaign", {})["metric_revision"] = mode
    tmp = LOOPCFG.parent / f".loop.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    os.replace(tmp, LOOPCFG)
    print(f"campaign.metric_revision: {before} -> {mode} (configs/loop.json; utc {_utc_stamp()})")
    if mode != "cautious":
        print("NOTICE: the loop's agents may now revise the FROZEN metric without asking first. Each revision "
              "is declared as a PENDING epoch in configs/loop.json campaign.metric_epochs for your ratification; "
              "campaign-status lists them.")
    else:
        print("From here on a metric revision raises results/ESCALATE.md and the loop waits for you.")


def _one_line(text: str) -> str:
    """A logbook field or a ledger cell is ONE line: whitespace runs (newlines included) collapse."""
    return " ".join(str(text or "").split())


def _record_cli(exp: str, analysis: str, next_line: str, note: str, finding: str, replace: bool) -> int:
    """`--record EXP [--analysis TEXT|@FILE] [--next LINE] [--ledger-note TEXT] [--finding LINE] [--replace]`:
    the worker's record, placed by the runner. The two logbook slots it owes and the ledger's narrative
    cells - one command, validated the way the guard validates, idempotent (re-run replaces), touching
    nothing else. The worker never opens
    the logbook or the ledger to write them, so neither is ever read to be written."""
    cfg_path = exp if exp.endswith(".json") else ""
    stem = Path(exp).stem if cfg_path else exp
    eid = exp_id_for(stem)
    if not eid:
        print(f"--record: cannot derive an experiment id from {exp!r} (use the exp name, its id, or its config path)")
        return 2
    wrote, problems = [], []
    if analysis or next_line or note or finding:
        text = LOGBOOK.read_text(encoding="utf-8", errors="replace") if LOGBOOK.is_file() else ""
        if _logbook_field(text, eid, "Analysis") is None:
            print(f"--record: no logbook entry for {stem} ({eid}) - the runner writes it when the experiment "
                  "runs; record after the run")
            return 2
    if analysis:
        body = analysis
        if body.startswith("@"):
            try:
                body = (ROOT / body[1:]).read_text(encoding="utf-8")
            except OSError as exc:
                print(f"--record: cannot read --analysis file {body[1:]!r} ({exc})")
                return 2
        body = _one_line(body)
        if not body:
            problems.append("Analysis is blank - a unit whose Analysis is blank is not saved")
        else:
            _set_logbook_field(stem, "Analysis", body, only_if_prefix=None)
            wrote.append(f"logbook Analysis ({len(body)} chars)")
    if next_line:
        _set_logbook_field(stem, "NEXT", _one_line(next_line), only_if_prefix=None)
        wrote.append("logbook NEXT")
    if note:
        cell = _one_line(note)
        if len(cell) > NOTE_CAP:
            problems.append(f"the ledger note holds at most {NOTE_CAP} characters ({len(cell)} given, "
                            f"{len(cell) - NOTE_CAP} over): the narrative belongs in the Analysis, and "
                            "anything larger in results/JOURNAL.md")
        elif _set_scoreboard_cell(eid, ("note", "notes"), cell):
            wrote.append(f"ledger note ({len(cell)} chars)")
    if finding:
        cell = _one_line(finding)
        if len(cell) > FINDING_CAP:
            problems.append(f"a finding is one line of at most {FINDING_CAP} characters ({len(cell)} given, "
                            f"{len(cell) - FINDING_CAP} over)")
        elif "verdicts/" not in cell and "unverified" not in cell.lower():
            problems.append("a finding cites its verdict artifact by path (results/verdicts/<id>.json) or says "
                            "`unverified` - a claim with neither is an open question for results/JOURNAL.md, "
                            "not a finding")
        else:
            existing = _scoreboard_cell(eid, ("finding",))
            if existing and not replace:
                problems.append(f"{eid} already carries a finding ({existing[:80]!r}); pass --replace to "
                                "overwrite it (the earlier text stays in results/journal_archive/ and the logbook)")
            elif _set_scoreboard_cell(eid, ("finding",), cell):
                wrote.append(f"ledger finding ({len(cell)} chars)")
    for p in problems:
        print(f"--record: REFUSED - {p}")
    if wrote:
        print(f"record -> {stem} ({eid}): " + "; ".join(wrote))
    if not wrote and not problems:
        print("--record: nothing to record - give --analysis, --next, --ledger-note or --finding")
        return 2
    return 1 if problems else 0


# ---- side-document entries the RUNNER places (TA-6) ----
# The Peng-96 turn audit: a worker spent up to seven calls a unit finding WHERE an entry goes (a landmine
# row in campaign.md, a discovery in PROJECT.md) and then spliced it with a Bash + Python string replace
# that no Write/Edit hook sees. The runner owns the anchor and applies the entry's rule; a gotcha has no
# key - it goes in the JOURNAL's Traps and tooling (PROJECT.md's gotchas are GUARDED, the user's).
LANDMINE_CELL_CAP = 300


def _label_of(exp: str) -> str:
    stem = Path(exp).stem if exp.endswith(".json") else exp
    eid = exp_id_for(stem)
    res = _read_json(RESULTS / f"result_{eid}.json", None) if eid else None
    return str(res.get("exp_name")) if isinstance(res, dict) and res.get("exp_name") else stem


def _write_text_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8", newline="") as fh:
        fh.write(text)
    os.replace(tmp, path)


def _section_bounds(lines: list, heading: str) -> tuple:
    """(heading index, end index) of the `## <heading>...` section in a list of lines, else (None, None)."""
    h = next((i for i, L in enumerate(lines) if L.startswith("## " + heading)), None)
    if h is None:
        return None, None
    end = next((i for i in range(h + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return h, end


def _append_landmine(label: str, item) -> tuple:
    """(done, problem): one row appended to campaign.md §Known landmines. The source cell is this unit's
    label, so the row meets 'a row without a source does not ship' by construction; a re-run that
    carries the same row adds nothing."""
    keys = ("trigger", "landmine", "do_instead")
    if not isinstance(item, dict):
        return None, "landmine must be an object {trigger, landmine, do_instead}"
    cells = [_one_line(str(item.get(k) or item.get(k.replace("_", " ")) or "")).replace("|", "\\|") for k in keys]
    if not all(cells):
        return None, "landmine needs trigger, landmine and do_instead, each a line"
    long = [k for k, c in zip(keys, cells) if len(c) > LANDMINE_CELL_CAP]
    if long:
        return None, (f"landmine cell(s) over {LANDMINE_CELL_CAP} characters ({', '.join(long)}): a row is a "
                      "line; the story belongs in the Analysis")
    path = ROOT / "campaign.md"
    text = path.read_text(encoding="utf-8")
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(keepends=True)
    h, end = _section_bounds(lines, "Known landmines")
    rows = [i for i in range(h, end) if lines[i].lstrip().startswith("|")] if h is not None else []
    if len(rows) < 2:
        return None, "campaign.md has no §Known landmines table (the kit's campaign template shows it)"
    row = f"| {cells[0]} | {cells[1]} | {cells[2]} | {label} |"
    if any(lines[i].strip() == row for i in rows):
        return f"landmine row already in campaign.md ({cells[0][:60]})", None
    if not lines[rows[-1]].endswith(("\n", "\r")):
        lines[rows[-1]] += nl
    lines.insert(rows[-1] + 1, row + nl)
    _write_text_atomic(path, "".join(lines))
    return f"landmine row -> campaign.md §Known landmines ({cells[0][:60]})", None


def _append_discovery(label: str, item) -> tuple:
    """(done, problem): an entry appended to the project's §Updates from discoveries - only when the
    cited verdict clears the bar the guard puts on the project ledger, through the guard's OWN functions
    (scripts/guard_promotion.py: _check_verdict, correctness_blocks_promotion, green_is_stale), never a
    re-derived copy: CONFIRMED, a graduating kill tier if any, a named independent refuter, and this
    campaign's correctness suite green on the code on disk. A preset that runs no verifier has no verdict
    to cite, so the finding stays in the ledger as unverified."""
    if not isinstance(item, dict):
        return None, "discovery must be an object {title, text, verdict}"
    title = _one_line(str(item.get("title") or ""))
    body = str(item.get("text") or "").strip()
    cite = str(item.get("verdict") or "").strip()
    if not (title and body and cite):
        return None, "discovery needs title, text (the effect, its equations, references) and verdict"
    name = (re.findall(r"verdicts[/\\]([\w\-.]+\.json)", cite) or [Path(cite).name])[0]
    vpath = RESULTS / "verdicts" / name
    if not vpath.is_file():
        return None, (f"discovery: there is no results/verdicts/{name} - a finding enters PROJECT.md only after "
                      "verify CONFIRMED it; until then it is the ledger's finding cell, marked unverified")
    try:
        import guard_promotion as _guard
        reason = (_guard._check_verdict(vpath, name) or _guard.correctness_blocks_promotion(ROOT)
                  or ("the correctness green was recorded against different FROZEN/core code than is on disk - "
                      "re-run the suite first" if _guard.green_is_stale(ROOT) else None))
    except Exception as exc:
        reason = f"the gate in scripts/guard_promotion.py could not validate it ({type(exc).__name__}: {exc})"
    if reason:
        return None, f"discovery: {reason}"
    proj = _orientation_file()
    if not proj.is_file():
        return None, f"discovery: no project file at {proj}"
    try:
        rel = ROOT.resolve().relative_to(proj.resolve().parent).as_posix()
    except ValueError:
        rel = ROOT.name
    cite_path = f"{rel}/results/verdicts/{name}"
    text = proj.read_text(encoding="utf-8")
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(keepends=True)
    h, end = _section_bounds(lines, "Updates from discoveries")
    if h is None:
        return None, f"discovery: {proj.name} has no '## Updates from discoveries' section"
    section = "".join(lines[h:end])
    if cite_path in section and title in section:
        return f"discovery already in {proj.name} ({title[:60]})", None
    refuter = _one_line(str((_read_json(vpath, {}) or {}).get("refuter") or ""))
    keep = [L for L in lines[h:end] if L.strip() != "_— none yet —_"]
    while keep and not keep[-1].strip():
        keep.pop()
    date = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%d")
    entry = [nl, f"### {date} — {title}  ({label}){nl}", body.replace("\r\n", "\n").replace("\n", nl) + nl,
             f"Verdict: `{cite_path}` (CONFIRMED; refuter {refuter}).{nl}", nl]
    _write_text_atomic(proj, "".join(lines[:h] + keep + entry + lines[end:]))
    return f"discovery -> {proj.name} §Updates from discoveries ({title[:60]})", None


SELF_VERIFY_OUTCOMES = ("holds", "refuted", "inconclusive")


def _self_verify_problem(exp: str, sv) -> str | None:
    """Why the record's `self_verify` block does not fit the ONE check this result is owed, or
    None. Owed a self-verify: the block must be there, with what was tried and an outcome. Owed an
    independent check: the block must NOT be there - that check is the result's one check, and a result is
    never verified twice. Owed nothing: nothing formal is recorded; what the worker noticed goes in the
    analysis."""
    ck = _read_json(CHECKS / f"checks_{exp_id_for(exp)}.json", None)
    owed = (((ck or {}).get("verification") or {}).get("owed") or {}) if isinstance(ck, dict) else {}
    check = owed.get("check")
    if check == "self-verify":
        if not isinstance(sv, dict):
            return ("this result is owed a SELF-VERIFY (" + str(owed.get("why") or "") + ") - run the verify "
                    "protocol on it in this session (roles/worker.md, your preset's section) and add "
                    '"self_verify": {"ran": ["name=pass|fail|skip:detail", ...], "outcome": "holds|refuted|'
                    'inconclusive", "note": "..."} to the record file')
        probs = []
        if not [x for x in sv.get("ran") or [] if str(x).strip()]:
            probs.append("self_verify.ran lists nothing - name each refutation attempt and its outcome")
        if str(sv.get("outcome") or "").strip().lower() not in SELF_VERIFY_OUTCOMES:
            probs.append("self_verify.outcome must be one of " + " | ".join(SELF_VERIFY_OUTCOMES))
        return "; ".join(probs) or None
    if isinstance(sv, dict):
        if check in ("peer", "verifier"):
            return (f"this result's one check is the {check} check ({owed.get('why')}) - a result is never "
                    "verified twice; drop the self_verify block")
        return ("no self-verify is owed for this result under this preset (" + str(owed.get("why") or "")
                + ") - drop the self_verify block; what you checked or noticed goes in the analysis")
    return None


def _self_verify_record(exp: str, sv: dict) -> int:
    """Write the worker's self-verify into results/checks_<NN>.json `self_verify` and raise the label:
    `self-verified` when it held, `self-refuted` when it did not - never independent."""
    eid = exp_id_for(exp)
    art = CHECKS / f"checks_{eid}.json"
    ck = _read_json(art, None)
    if not isinstance(ck, dict):
        print(f"--record: no results/checks_{eid}.json for {exp!r}")
        return 2
    outcome = str(sv.get("outcome") or "").strip().lower()
    ck["self_verify"] = {"status": "recorded", "utc": _utc_stamp(), "outcome": outcome,
                         "ran": [str(x) for x in sv.get("ran") or []], "note": str(sv.get("note") or "").strip()}
    if not _counts_as_check(ck.get("label") or "", "independent"):
        if outcome == "holds":
            ck["label"] = "self-verified"
        elif outcome == "refuted":
            ck["label"] = "self-refuted"
    tmp = art.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(ck, indent=2), encoding="utf-8")
    os.replace(tmp, art)
    _set_logbook_field(exp, "Verification", f"{ck['label']} - self-verify {outcome} (results/{art.name})",
                       only_if_prefix=("", "pending", "self-checked", "unverified"))
    print(f"self-verify recorded -> results/{art.name}: {outcome}; label={ck['label']}")
    return 0


# ---- a CONTEST: the worker disputes its own result's gate outcome, and does not decide it -----------
# The failure this answers (the V_B- level-structure test campaign, exp017 / exp019): two results met every
# written promotion condition and were set aside by the worker's judgement, recorded as "refused", with no
# decision-record entry and no second opinion - the same context that produced the doubt confirmed it. A
# set-aside is a claim like any other. The record file's `contest` key files the objection as a falsifiable charge with the artifacts
# it rests on; the driver spawns an INDEPENDENT verifier for it whatever the preset (blinded, artifacts
# only); the pointer waits (the guard refuses a promotion write while the contest is pending); and the
# recorded outcome stands unless the verdict is REFUTED - a doubt the verifier cannot establish is on the
# record, not a veto. A contested pass that stands is promoted by the driver with the verdict's label.

CONTEST_CLAIM_MIN = 40      # chars: a charge is a sentence with a falsifier in it, not a word


def _contest_problem(exp: str, contest, sv) -> str | None:
    """Why the record's `contest` block cannot be filed, or None. A contest disputes the gate outcome
    RECORDED for this result - a pass the worker does not believe, or a refusal it does not accept - so it
    is held to the shape of a claim: a falsifiable charge, what it disputes, and the artifacts it rests
    on, each on disk under the campaign. Its verifier is the result's one check, so a self_verify block
    beside it is refused (never twice); a contest already resolved is not re-opened by a re-run."""
    if not isinstance(contest, dict):
        return "contest must be an object {claim, disputes, gate, evidence}"
    problems = []
    claim = _one_line(str(contest.get("claim") or ""))
    if len(claim) < CONTEST_CLAIM_MIN:
        problems.append("contest.claim must state the objection as a falsifiable charge - what the verifier "
                        "should find if you are right, and what would show you wrong - not a doubt")
    disputes = str(contest.get("disputes") or "pass").strip().lower()
    if disputes not in CONTEST_DISPUTES:
        problems.append("contest.disputes must be 'pass' (a gate this result passed that you do not believe) "
                        "or 'refusal' (a gate that refused it, wrongly)")
    ev = contest.get("evidence")
    if not isinstance(ev, list) or not ev:
        problems.append("contest.evidence must list at least one artifact under the campaign (results/...) "
                        "the charge rests on - the verifier judges the charge on those, not on your reasoning")
    else:
        for p in ev:
            rel = str(p).replace("\\", "/")
            try:
                fp = (ROOT / rel).resolve()
                fp.relative_to(ROOT.resolve())
            except (OSError, ValueError):
                problems.append(f"contest.evidence path escapes the campaign: {p}")
                continue
            if not fp.is_file():
                problems.append(f"contest.evidence names a file that does not exist: {p}")
    stem = _label_of(exp)
    eid = exp_id_for(stem)
    if not eid or not (CHECKS / f"checks_{eid}.json").is_file():
        problems.append(f"no results/checks_{eid or '<NN>'}.json for {exp!r} - a contest disputes a RECORDED gate "
                        "outcome; the unit runs first")
    if isinstance(sv, dict):
        problems.append("a contested result's one check is the driver's independent verifier - drop the "
                        "self_verify block (a result is never verified twice)")
    existing = _read_json(CONTESTS / f"{stem}.json", None)
    if isinstance(existing, dict) and str(existing.get("status") or "pending") != "pending":
        problems.append(f"the contest on {stem} is already resolved ({existing.get('verdict')}; "
                        f"results/contests/{stem}.json) - a resolved contest is not re-opened; a new objection "
                        "is a new unit's claim")
    return "; ".join(problems) or None


def _contest_record(exp: str, contest: dict) -> int:
    """File the contest: results/contests/<stem>.json (pending), the checks artifact's
    `verification.contest` and its `owed` re-pointed at the verifier (the preset's own answer kept as
    `owed_by_preset`), the logbook's Disputes line. The driver reads the artifact at accept time and owes
    the independent check at once; the guard reads the contest file and refuses a promotion write."""
    stem = _label_of(exp)
    eid = exp_id_for(stem)
    art = CHECKS / f"checks_{eid}.json"
    ck = _read_json(art, None)
    if not isinstance(ck, dict):
        print(f"--record: no results/checks_{eid}.json for {exp!r}")
        return 2
    disputes = str(contest.get("disputes") or "pass").strip().lower()
    claim = _one_line(str(contest.get("claim") or ""))
    entry = {"exp": stem, "exp_id": eid, "claim": claim, "disputes": disputes,
             "gate": _one_line(str(contest.get("gate") or "")),
             "evidence": [str(p).replace("\\", "/") for p in contest.get("evidence") or []],
             "filed_utc": _utc_stamp(), "status": "pending"}
    CONTESTS.mkdir(parents=True, exist_ok=True)
    _write_text_atomic(CONTESTS / f"{stem}.json", json.dumps(entry, indent=2) + "\n")
    ver = ck.setdefault("verification", {})
    if isinstance(ver.get("owed"), dict) and "owed_by_preset" not in ver:
        ver["owed_by_preset"] = ver["owed"]
    ver["owed"] = {"check": "verifier", "when": "now",
                   "why": f"contested gate outcome ({disputes}) - the worker disputes it and does not decide it; "
                          "the driver's independent verifier does"}
    ver["contest"] = dict(entry, file=f"results/contests/{stem}.json")
    tmp = art.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(ck, indent=2), encoding="utf-8")
    os.replace(tmp, art)
    _set_logbook_field(stem, "Disputes & responses",
                       f"Concern (the worker's own contest, {disputes}): {claim[:240]} -- Response: pending the "
                       f"driver's independent verifier (results/contests/{stem}.json)", only_if_prefix=("",))
    print(f"contest recorded -> results/contests/{stem}.json ({disputes}): the driver spawns an independent "
          "verifier for the charge and the pointer waits for its verdict - do NOT write configs/RECOMMENDED.json "
          "for this result; the recorded outcome stands unless the verdict is REFUTED")
    return 0


def _promote_pointer(stem: str, label: str, why: str) -> bool:
    """The driver's own promotion write, the twin of _recommended_follows's rollback: RECOMMENDED.json from
    the experiment's config, carrying its label and the reason. The guard polices AGENTS' writes; this one
    is mechanical, so it applies the guard's own promotion bar itself (the correctness suite, its staleness,
    the epoch) and refuses loudly rather than promote past it - the next worker then decides with the
    verdict in hand."""
    cfg = _read_json(ROOT / "configs" / f"{stem}.json", None)
    if not isinstance(cfg, dict):
        print(f"[supervise] cannot promote {stem}: configs/{stem}.json is missing or unreadable utc={_utc_stamp()}")
        return False
    try:
        import guard_promotion as _guard
        preset = _verify_rows(_read_json(LOOPCFG, {}) or {})["preset"]
        reason = (_guard.correctness_blocks_promotion(ROOT, relaxed=preset in ("none", "minimal"))
                  or ("the correctness green was recorded against different FROZEN/core code than is on disk - "
                      "re-run the suite first" if _guard.green_is_stale(ROOT) else None)
                  or _guard.epoch_blocks_promotion(ROOT))
    except Exception as exc:
        reason = f"the promotion gate could not be evaluated ({type(exc).__name__}: {exc})"
    if reason:
        print(f"[supervise] {stem} is NOT promoted by the driver: {reason} utc={_utc_stamp()}")
        return False
    res = _read_json(RESULTS / f"result_{exp_id_for(stem)}.json", {}) or {}
    rec_path = ROOT / "configs" / "RECOMMENDED.json"
    new = dict(cfg, exp_name="RECOMMENDED", _promoted_from=stem,
               _metric_version=res.get("metric_version") or cfg.get("_metric_version"),
               _promoted_by_driver=why, verification_label=label)
    _write_text_atomic(rec_path, json.dumps(new, indent=2) + "\n")
    print(f"[supervise] RECOMMENDED.json -> {stem} ({label}): {why} utc={_utc_stamp()}")
    return True


def _contest_resolve(stem: str, entry: dict | None = None) -> None:
    """After a verdict lands on a CONTESTED result: close the contest, carry the outcome into the checks
    artifact and the logbook, act on it, and relay it. The recorded outcome stands unless the verdict is
    REFUTED. A contested PASS that stands is promoted by the driver with the verdict's label (the worker
    did not decide it; the verifier did); an overturned pass is not promoted and carries its refuted label.
    An overturned REFUSAL is not promoted by the driver - the other promotion conditions are the worker's
    to re-check - so the next worker gets the verdict as a note and decides. A no-op for an uncontested
    result or a contest already closed."""
    cf = CONTESTS / f"{stem}.json"
    c = _read_json(cf, None)
    if not isinstance(c, dict) or str(c.get("status") or "pending") != "pending":
        return
    vf = _find_verdict_file(stem)
    v = (_read_json(vf, {}) or {}) if vf else {}
    verdict = str(v.get("verdict", "")).strip().upper()
    if vf is None or not verdict:
        return
    eid = exp_id_for(stem)
    art = CHECKS / f"checks_{eid}.json"
    ck = _read_json(art, None) or {}
    label = str(ck.get("label") or f"{verdict}/verifier")
    disputes = str(c.get("disputes") or "pass")
    overturned = verdict == "REFUTED"
    promoted = False
    if disputes == "pass":
        if overturned:
            outcome = f"the contested pass is OVERTURNED ({label}): not promoted; the result carries its refuted label"
        else:
            promoted = _promote_pointer(stem, label, f"a contested pass that stood: verdict {verdict} "
                                                     f"(results/verdicts/{vf.name}), {_utc_stamp()}")
            outcome = (f"the contested pass STANDS ({label}): "
                       + (f"promoted by the driver, configs/RECOMMENDED.json -> {stem}" if promoted else
                          "NOT promoted by the driver (the promotion gate blocked it; the driver log says why) - "
                          "the next worker decides"))
    elif overturned:
        outcome = (f"the contested refusal is OVERTURNED ({label}): the next worker decides the promotion - "
                   "write the pointer if every promotion condition now holds")
    else:
        outcome = f"the contested refusal STANDS ({label})"
    c.update(status="resolved", verdict=verdict, label=label, verdict_file=vf.name, resolved_utc=_utc_stamp(),
             outcome=outcome, promoted=promoted)
    _write_text_atomic(cf, json.dumps(c, indent=2) + "\n")
    if isinstance(ck.get("verification"), dict) and isinstance(ck["verification"].get("contest"), dict):
        ck["verification"]["contest"].update(status="resolved", verdict=verdict, outcome=outcome, promoted=promoted)
        tmp = art.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(ck, indent=2), encoding="utf-8")
        os.replace(tmp, art)
    _set_logbook_field(stem, "Disputes & responses",
                       f"Concern (the worker's own contest, {disputes}): {str(c.get('claim') or '')[:240]} -- "
                       f"Response (independent verifier, results/verdicts/{vf.name}): {verdict}; {outcome}",
                       only_if_prefix=("Concern (the worker's own contest",))
    try:
        INBOX.mkdir(parents=True, exist_ok=True)
        (INBOX / f"contest_{stem}.md").write_text(
            f"Driver ({_utc_stamp()}): the contest on {stem} ({disputes}) is resolved - verdict {verdict} "
            f"(results/verdicts/{vf.name}). {outcome}."
            + (f" Verifier summary: {_one_line(str(v.get('summary')))}" if v.get("summary") else "")
            + (f" Follow-up it names: {_one_line(str(v.get('follow_up')))}" if v.get("follow_up") else "")
            + "\n", encoding="utf-8")
    except OSError as exc:
        print(f"[supervise] could not leave the contest note for {stem} ({exc})")
    print(f"[supervise] contest on {stem} ({disputes}) resolved by verdict {verdict}: {outcome} utc={_utc_stamp()}")


def _record_from_file(exp: str, path: str, flags: dict) -> int:
    """`--record EXP --from-file record.json`: the WHOLE record in one file - {"analysis", "next",
    "ledger_note", "finding", "replace", "self_check": {"ran", "changes", "estimate", "note"},
    "self_verify": {"ran", "outcome", "note"} (only when the result is owed one - the card says),
    "landmine": {"trigger", "landmine", "do_instead"}, "discovery": {"title", "text", "verdict"}} (the last
    two may be lists), "contest": {"claim", "disputes", "gate", "evidence"} (a dispute of this result's
    recorded gate outcome: the driver's independent verifier decides it, the pointer waits) - every key
    optional, flags on the command line win. The JOURNAL is not in it: the worker writes results/JOURNAL.md
    anew as a file. Three turns for the record: the record file, the command, the new JOURNAL."""
    try:
        rec = json.loads((ROOT / path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        print(f"--record --from-file {path!r}: cannot read it as JSON ({exc})")
        return 2
    if not isinstance(rec, dict):
        print("--record --from-file: the file must hold one JSON object")
        return 2
    sv = rec.get("self_verify")
    contest = rec.get("contest")
    # A contest makes the driver's verifier the result's one check, so the self-verify rule yields to it.
    problem = _contest_problem(exp, contest, sv) if contest is not None else _self_verify_problem(exp, sv)
    if problem:
        # Refused BEFORE anything is written, so the corrected file records in one go.
        print(f"--record: REFUSED - {problem}")
        return 2
    rc = 0
    sc = rec.get("self_check")
    if isinstance(sc, dict):
        r = _self_check_cli(exp, [str(x) for x in sc.get("ran") or []], [str(x) for x in sc.get("changes") or []],
                            str(sc.get("estimate") or ""), str(sc.get("note") or ""))
        rc = max(rc, r)
    if isinstance(sv, dict):
        rc = max(rc, _self_verify_record(exp, sv))
    if contest is not None:
        rc = max(rc, _contest_record(exp, contest))
    r = _record_cli(exp, flags.get("analysis") or str(rec.get("analysis") or ""),
                    flags.get("next") or str(rec.get("next") or ""),
                    flags.get("ledger_note") or str(rec.get("ledger_note") or ""),
                    flags.get("finding") or str(rec.get("finding") or ""),
                    bool(flags.get("replace") or rec.get("replace")))
    if r == 2 and not (rec.get("analysis") or rec.get("next") or rec.get("ledger_note") or rec.get("finding")
                       or flags.get("analysis") or flags.get("next")):
        r = 0                                            # nothing owed to the logbook in this file is not an error
    rc = max(rc, r)
    label = _label_of(exp)
    for key, place in (("landmine", _append_landmine), ("discovery", _append_discovery)):
        items = rec.get(key)
        for item in (items if isinstance(items, list) else [items] if items else []):
            done, problem = place(label, item)
            if problem:
                print(f"--record: REFUSED - {problem}")
                rc = max(rc, 1)
            else:
                print(f"record -> {done}")
    if rec.get("propose") or rec.get("decline"):
        print("--record: there is no queue to propose to or decline from - a follow-up idea goes "
              "in the JOURNAL's 'What to try next and why'; a unit not worth running is simply not run")
        rc = max(rc, 1)
    if rec.get("journal"):
        print("--record: the JOURNAL is not part of the record file - write results/JOURNAL.md anew with the "
              "Write tool (the previous one is in your brief and in results/journal_archive/)")
        rc = max(rc, 1)
    return rc


def _show_cli(exp: str) -> int:
    """`--show EXP`: one logbook entry, printed - the way to read an old detail without opening the file."""
    eid = exp_id_for(exp)
    text = LOGBOOK.read_text(encoding="utf-8", errors="replace") if LOGBOOK.is_file() else ""
    head, out, on = f"## {eid} - ", [], False
    for line in text.splitlines():
        if line.startswith("## "):
            on = bool(eid) and line.startswith(head)
        if on:
            out.append(line)
    if not out:
        print(f"--show: no logbook entry for {exp!r}")
        return 2
    print("\n".join(out))
    return 0


_CARD_SKIP = {"utc", "solve_wall_clock_s", "outside_apriori_range", "runner_produced", "is_evaluation"}


def _numeric_fields(d: dict, prefix: str = "") -> dict:
    """Every numeric scalar in a result JSON (top level and one dict deep, e.g. the guardrail's values)."""
    out = {}
    for k, v in (d or {}).items():
        if k.startswith("_") or k in _CARD_SKIP or k in ("config", "apriori", "theta"):
            continue
        if isinstance(v, bool):
            continue
        if isinstance(v, (int, float)) and np.isfinite(v):
            out[prefix + k] = float(v)
        elif isinstance(v, dict) and not prefix:
            out.update(_numeric_fields(v, prefix=k + "."))
    return out


def _card_comparisons(res: dict, eid: str) -> list[str]:
    """The comparisons the analyses make, computed once: every numeric field of this result against the
    INCUMBENT (the best prior under this metric version) and against the PREVIOUS unit (the newest prior
    result), as `this | incumbent (delta) | previous (delta)`. Per-condition splits, a chi-square, a
    lifetime, a census count - whatever the campaign records numerically - so nobody re-derives them."""
    try:
        props = _campaign_props()
        priors = _prior_results(eid)
        inc = _incumbent(priors, props)
        prev = max(priors, key=lambda r: str((_read_json(RESULTS / f"result_{r['id']}.json", {}) or {}).get("utc", ""))) if priors else None
    except Exception as exc:
        return [f"comparisons: not computed ({type(exc).__name__}: {exc})"]
    if not inc and not prev:
        return []
    mine = _numeric_fields(res)
    ref = {}
    for tag, r in (("incumbent", inc), ("previous", prev)):
        if r is not None:
            rj = _read_json(RESULTS / f"result_{r['id']}.json", {}) or {}
            ref[tag] = (r["exp_name"], _numeric_fields(rj))
    if not ref:
        return []
    head = "comparisons: this" + "".join(f" | {tag} {name}" for tag, (name, _) in ref.items() if name)
    out = [head]
    for k, v in mine.items():
        cells = [f"{k}: {v:.6g}"]
        any_ref = False
        for tag, (name, vals) in ref.items():
            if k in vals:
                any_ref = True
                d = v - vals[k]
                cells.append(f"{vals[k]:.6g} ({d:+.4g})")
            else:
                cells.append("-")
        if any_ref:
            out.append(" | ".join(cells))
    return out[:28]


# ---- the artifact digest: the SHAPE of every file a unit wrote, so nobody prints keys to learn it ----
# The Peng-96 turn audit (TA-1): ~5 calls a unit went to `print(list(d.keys()))`, `head -c`, `z.files`
# over artifacts - three in four of them an EARLIER unit's (verdicts, checks, records, candidate files,
# screens, diagnostic scripts) - because no brief carried their shape. The runner writes the shape once.
DIGEST_BRIEF_CAP = 4_000        # chars of the previous units' digest delivered in the worker's brief
DIGEST_CARD_LINES = 12          # files listed in the card's "artifacts this unit wrote" block
DIGEST_UNIT_FILES = 40          # files digested per unit (the rest are counted, --digest lists them all)
DIGEST_PARSE_MAX_BYTES = 20_000_000


def _digest_scalar(v) -> str:
    if isinstance(v, bool) or v is None:
        return str(v)
    if isinstance(v, (int, float)):
        r = repr(v)
        return r if len(r) <= 14 else type(v).__name__
    if isinstance(v, str):
        return repr(v) if len(v) <= 28 else f"str({len(v)})"
    return type(v).__name__


def _digest_shape(v, depth: int = 0) -> str:
    """A value's shape: dict keys (one level down), list length and its first item's keys, short
    scalars by value - the answer to `print(list(d.keys()))` and `len(d[k])`, never the data."""
    if isinstance(v, dict):
        items = list(v.items())
        if depth >= 1:
            names = ",".join(str(k) for k, _ in items[:10])
            return "{" + names + (f",+{len(items) - 10}" if len(items) > 10 else "") + "}"
        parts = [f"{k}{_digest_shape(x, depth + 1)}" if isinstance(x, (dict, list)) else f"{k}={_digest_scalar(x)}"
                 for k, x in items[:18]]
        return "{" + ", ".join(parts) + (f", +{len(items) - 18} keys" if len(items) > 18 else "") + "}"
    if isinstance(v, list):
        head = v[0] if v else None
        inner = (_digest_shape(head, 1) if isinstance(head, dict)
                 else f" of {type(head).__name__}" if head is not None else "")
        return f"[{len(v)}]{inner}"
    return _digest_scalar(v)


def _digest_file(p: Path) -> str:
    """One line: path (size): shape. JSON/JSONL by keys, .npz by array shape and dtype, TSV/CSV by header
    and row count, a Python script by its docstring's first line; anything else by size."""
    try:
        rel = p.relative_to(ROOT).as_posix()
    except ValueError:
        rel = str(p)
    try:
        size = p.stat().st_size
    except OSError:
        return f"{rel}: (missing)"
    head = f"{rel} ({size / 1024:.1f} KB)"
    suf = p.suffix.lower()
    try:
        if suf == ".json" and size <= DIGEST_PARSE_MAX_BYTES:
            v = json.loads(p.read_text(encoding="utf-8-sig"))
            body = _digest_shape(v)
            if "verdicts" in p.parts and isinstance(v, dict):   # a verdict is read for its values
                for k in ("caveats", "follow_up"):
                    x = v.get(k)
                    first = x[0] if isinstance(x, list) and x else x
                    if first:
                        body += f"; {k}: {_one_line(str(first))[:140]}"
        elif suf == ".jsonl" and size <= DIGEST_PARSE_MAX_BYTES:
            lines = [L for L in p.read_text(encoding="utf-8", errors="replace").splitlines() if L.strip()]
            first = json.loads(lines[0]) if lines else {}
            body = f"{len(lines)} record(s), each {_digest_shape(first, 1) if isinstance(first, dict) else type(first).__name__}"
        elif suf == ".npz":
            with np.load(p, allow_pickle=False) as z:
                body = ", ".join(f"{k}{tuple(z[k].shape)} {z[k].dtype}" for k in list(z.files)[:12])
        elif suf in (".tsv", ".csv"):
            rows = [L for L in p.read_text(encoding="utf-8", errors="replace").splitlines()
                    if L.strip() and not L.startswith("#")]
            cols = rows[0].split("\t" if suf == ".tsv" else ",") if rows else []
            body = f"{max(len(rows) - 1, 0)} row(s) x {len(cols)} col(s): {', '.join(c.strip() for c in cols[:14])}"
        elif suf == ".py":
            import ast as _ast
            doc = (_ast.get_docstring(_ast.parse(p.read_text(encoding="utf-8"))) or "").strip().splitlines()
            body = doc[0] if doc else "(no docstring)"
        else:
            return head
    except Exception as exc:
        body = f"(not read: {type(exc).__name__})"
    return f"{head}: {body}"


def _unit_artifacts(eid: str, label: str) -> list[Path]:
    """The files one unit wrote, found by the save-set's naming - its label, or its id in a file or
    directory name - under results/ (never the snapshots, which are copies) and diagnostic scripts under
    scripts/. Kit artifacts first, then verdicts, data, diagnostics, scripts, images."""
    if not eid:
        return []
    n = str(int(eid)) if eid.isdigit() else re.escape(eid)
    pat = re.compile(rf"(?<![0-9a-z])exp0*{n}(?![0-9])|{re.escape(label)}", re.I)
    out = [p for p in (RESULTS / f"result_{eid}.json", CHECKS / f"checks_{eid}.json",
                       ROOT / "configs" / f"{label}.json") if p.is_file()]
    out += sorted(p for p in RESULTS.glob("record_*.json")
                  if p.stem.split("_", 1)[-1].isdigit() and eid.isdigit() and int(p.stem.split("_", 1)[-1]) == int(eid))
    for base in (RESULTS / "verdicts", RESULTS / "data", RESULTS / "diagnostics", ROOT / "scripts", RESULTS / "images"):
        if not base.is_dir():
            continue
        hits = [p for p in base.rglob("*") if p.is_file() and "__pycache__" not in p.parts
                and pat.search(p.relative_to(base).as_posix())]
        out += sorted(h for h in hits if h not in out)
    return out


def _recent_units(n: int = 2) -> list[tuple[str, str]]:
    """The newest n recorded units as (id, label), by their result's utc."""
    rows = []
    for p in RESULTS.glob("result_*.json"):
        r = _read_json(p, None)
        if isinstance(r, dict) and r.get("exp_name"):
            rows.append((str(r.get("utc") or ""), p.stem.split("_", 1)[-1], str(r["exp_name"])))
    return [(eid, label) for _, eid, label in sorted(rows, reverse=True)[:n]]


def _digest_lines(eid: str, label: str, limit: int | None = DIGEST_UNIT_FILES) -> list[str]:
    arts = _unit_artifacts(eid, label)
    lines = [_digest_file(p) for p in (arts if limit is None else arts[:limit])]
    if limit is not None and len(arts) > limit:
        lines.append(f"(+{len(arts) - limit} more file(s): python scripts/run_campaign.py --digest {label})")
    return lines


def _digest_cli(exp: str) -> int:
    """`--digest EXP`: the shape of every file one unit wrote - what to open, and what is inside it."""
    stem = Path(exp).stem if exp.endswith(".json") else exp
    eid = exp_id_for(stem)
    res = _read_json(RESULTS / f"result_{eid}.json", None) if eid else None
    label = str(res.get("exp_name")) if isinstance(res, dict) and res.get("exp_name") else stem
    lines = _digest_lines(eid, label, limit=None)
    if not lines:
        print(f"--digest: no artifacts found for {exp!r}")
        return 2
    print(f"=== DIGEST {eid} {label} ({len(lines)} file(s)) ===")
    print("\n".join(lines))
    return 0


def _save_set_line(exp: str) -> str:
    """What the unit's save-set holds right now - printed after --record, so no worker lists the tree
    to confirm what landed (the Peng-96 turn audit, TA-7: every post-record `ls` found nothing wrong)."""
    stem = Path(exp).stem if exp.endswith(".json") else exp
    eid = exp_id_for(stem)
    res = _read_json(RESULTS / f"result_{eid}.json", None) if eid else None
    label = str(res.get("exp_name")) if isinstance(res, dict) and res.get("exp_name") else stem
    snap = RESULTS / "snapshots" / label
    nsnap = sum(1 for p in snap.rglob("*") if p.is_file()) if snap.is_dir() else 0
    lb = LOGBOOK.read_text(encoding="utf-8", errors="replace") if LOGBOOK.is_file() else ""
    jr = RESULTS / "JOURNAL.md"
    arts = _unit_artifacts(eid, label)
    figs = [p for p in arts if p.parent == RESULTS / "images" or RESULTS / "images" in p.parents]
    data = [p for p in arts if RESULTS / "data" in p.parents]
    bits = [f"result_{eid}.json " + ("ok" if (RESULTS / f"result_{eid}.json").is_file() else "MISSING"),
            f"checks_{eid}.json " + ("ok" if (CHECKS / f"checks_{eid}.json").is_file() else "MISSING"),
            f"snapshot {label}/ " + (f"ok ({nsnap} files)" if nsnap else "MISSING"),
            "logbook entry " + ("ok" if f"## {eid} - " in lb else "MISSING"),
            "JOURNAL.md " + (f"present ({jr.stat().st_size / 1024:.1f} KB)" if jr.is_file() else "not yet written (step 10)"),
            "images: " + (", ".join(f"{p.name} ({p.stat().st_size / 1024:.0f} KB)" for p in figs[:8]) or "none"),
            "data: " + (", ".join(f"{p.name} ({p.stat().st_size / 1024:.0f} KB)" for p in data[:8]) or "none")]
    return "save-set: " + " | ".join(bits)


def _card(exp: str) -> str:
    """The result card: what the analysis of one experiment needs to know, in one bounded block - printed
    at the end of every run and by `--card EXP`. Read once, never rebuilt from the artifacts with
    one-liners. The campaign adds its own numbers through experiment.py campaign_card_fields(result, checks)."""
    eid = exp_id_for(exp)
    res = _read_json(RESULTS / f"result_{eid}.json", None) if eid else None
    if not isinstance(res, dict):
        return f"card: no results/result_{eid or '?'}.json for {exp!r} - run the experiment first"
    ck = _read_json(CHECKS / f"checks_{eid}.json", None)
    ck = ck if isinstance(ck, dict) else {}
    checks = ck.get("checks") or {}
    stem = str(res.get("exp_name") or exp)
    lines = [f"=== CARD {eid} {stem} ==="]
    score = res.get("{{PRIMARY_METRIC}}")
    head = f"{{PRIMARY_METRIC}} = {'null (a zero-evaluation unit)' if score is None else score}"
    try:
        inc = _incumbent(_prior_results(eid), _campaign_props())
        if inc is not None and score is not None:
            delta = float(score) - float(inc["score"])
            better = metric._better(float(score), float(inc["score"]))
            head += (f"  |  incumbent {inc['exp_name']} = {inc['score']:.6g}  delta {delta:+.6g} "
                     f"({'better' if better else 'not better'})")
    except Exception as exc:                        # the card must never fail on the comparison
        head += f"  |  (incumbent comparison not computed: {type(exc).__name__})"
    lines.append(head)
    if res.get("guardrail") is not None:
        lines.append(f"guardrail: {res.get('guardrail')}")
    pr = checks.get("plausible_range") or checks.get("hard_bounds") or {}
    if pr:
        lines.append(f"plausible range: {pr.get('status', '?')} - {pr.get('detail', '')}")
    if res.get("solve_wall_clock_s") is not None:
        lines.append(f"solve: {res.get('solve_wall_clock_s')} s")
    fails = [n for n, c in checks.items() if isinstance(c, dict) and c.get("status") == "fail"]
    unav = [n for n, c in checks.items() if isinstance(c, dict) and c.get("status") == "unavailable"]
    lines.append(f"label: {ck.get('label', 'unverified')}  |  checks: {len(checks)} "
                 f"({len(fails)} fail, {len(unav)} unavailable)")
    for n in fails:
        lines.append(f"  FAIL {n}: {checks[n].get('detail', '')}")
    for n in unav:
        c = checks[n]
        lines.append(f"  unavailable {n}: {c.get('detail', '')}" + (f" (needs: {c['needs']})" if c.get("needs") else ""))
    sc = ck.get("self_check")
    if isinstance(sc, dict):
        lines.append(f"self-check: {len(sc.get('ran') or [])} check(s); {len(sc.get('changes_considered') or [])} "
                     f"change(s) considered, {len(sc.get('changes_unconsidered') or [])} not")
    ver = ck.get("verification") or {}
    owed = ver.get("owed") or {}
    if owed:
        lines.append(f"verification (preset {ver.get('preset')}): new best {'yes' if ver.get('new_best') else 'no'}"
                     f"; owed: " + (f"{owed.get('check')} ({owed.get('when')}) - {owed.get('why')}"
                                    if owed.get("check") else str(owed.get("why") or "nothing")))
    ch = ck.get("changes") or {}
    if isinstance(ch, dict) and ch:
        files = ", ".join(f["path"] for f in ch.get("files") or []) or "none"
        keys = ", ".join(f"{c['key']} {c['old']} -> {c['new']}" for c in ch.get("config_keys") or []) or "none"
        lines.append(f"changed since {ch.get('since') or '-'}: code {files}; config keys {keys}")
    lines += _card_comparisons(res, eid)
    try:
        extra = _seam("campaign_card_fields", lambda result, checks: {})(res, ck) or {}
    except Exception as exc:
        extra = {"campaign_card_fields": f"raised {type(exc).__name__}: {exc}"}
    for k, v in extra.items():
        lines.append(f"{k}: {v}")
    arts = _digest_lines(eid, stem, limit=DIGEST_CARD_LINES)
    if arts:
        lines.append(f"artifacts this unit wrote (their shape; --digest {stem} lists every one):")
        lines += ["  " + a for a in arts]
    lines.append(f"record: write results/record_{eid}.json (analysis, next, ledger_note, finding, self_check, "
                 + ("self_verify, " if owed.get("check") == "self-verify" else "")
                 + f"landmine, discovery) then python scripts/run_campaign.py --record {stem} --from-file "
                 f"results/record_{eid}.json")
    if len(lines) > 80:                      # the record instruction is the card's last line: never cut it
        lines = lines[:79] + lines[-1:]
    return "\n".join(str(L)[:400] for L in lines)


def _self_check_cli(exp: str, ran: list, changes: list, estimate: str, note: str) -> int:
    """`--self-check EXP --ran name=pass|fail|skip[:detail] ... [--change "what=>expected=>observed"] ...
    [--estimate X] [--note "..."]`: the worker records the checks it ran on its own result, directed at
    what the unit changed, into results/checks_<NN>.json `self_check`. The runner writes it (validated,
    atomically, touching no other key) so a self-check is an auditable artifact rather than prose: a
    label a reviewer or the claim audit can read - never independent verification."""
    eid = exp_id_for(exp)
    art = CHECKS / f"checks_{eid}.json" if eid else None
    if not art or not art.is_file():
        print(f"--self-check: no results/checks_{eid or '?'}.json for {exp!r} - record the experiment first")
        return 2
    # Validate every field first and report ALL problems at once - a record with several format issues
    # rejects once, not one round-trip per issue (TA-3).
    problems, entries, considered = [], [], []
    for item in ran or []:
        head, _, detail = item.partition(":")
        name, sep, outcome = head.partition("=")
        outcome = outcome.strip().lower()
        if not sep or not name.strip() or outcome not in ("pass", "fail", "skip"):
            problems.append(f"--ran {item!r} must look like name=pass|fail|skip[:detail]")
        else:
            entries.append({"name": name.strip(), "outcome": outcome, "detail": detail.strip()})
    for item in changes or []:
        parts = [p.strip() for p in item.split("=>")]
        if len(parts) != 3 or not parts[0]:
            problems.append(f"--change {item!r} must look like "
                            "\"<what changed>=><expected effect on the result>=><what was observed>\"")
        else:
            considered.append({"change": parts[0], "expected_effect": parts[1], "observed": parts[2]})
    est = None
    if estimate:
        try:
            est = float(estimate)
        except ValueError:
            problems.append(f"--estimate {estimate!r} is not a number")
    try:
        ck = json.loads(art.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"--self-check: cannot read {art.name}: {exc}")
        return 2
    if problems:
        print(f"--self-check: REFUSED - {len(problems)} problem(s); fix all and re-run:")
        for p in problems:
            print(f"  - {p}")
        return 2
    pr = (ck.get("checks") or {}).get("plausible_range") or {}
    plausible = {"bounds": pr.get("bounds"), "observed": (ck.get("metric") or {}).get("value"),
                 "within": {"pass": True, "fail": False}.get(pr.get("status"))}
    changed = ([c["path"] for c in ((ck.get("changes") or {}).get("files") or [])]
               + [c["key"] for c in ((ck.get("changes") or {}).get("config_keys") or [])])
    named = [c["change"] for c in considered]
    unconsidered = [c for c in changed if not any(c in n or n in c for n in named)]
    ck["self_check"] = {"status": "recorded", "utc": _utc_stamp(), "ran": entries, "plausible": plausible,
                        "estimate": est, "changes_considered": considered,
                        "changes_unconsidered": unconsidered, "reconciled": (note or "").strip()}
    if ck.get("label") in (None, "unverified"):
        ck["label"] = "self-checked"      # a self-check is a label, never independent verification
    tmp = art.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(ck, indent=2), encoding="utf-8")
    os.replace(tmp, art)
    _set_logbook_field(exp, "Verification",
                       f"{ck['label']} - {len(entries)} check(s), {len(considered)} of "
                       f"{len(considered) + len(unconsidered)} recorded change(s) considered (results/{art.name})",
                       only_if_prefix=("", "pending", "self-checked"))
    print(f"self-check recorded -> results/{art.name}: {len(entries)} check(s), {len(considered)} change(s) "
          "considered" + (f"; {len(unconsidered)} recorded change(s) NOT considered: {', '.join(unconsidered)}"
                          " - say what you expected each to do" if unconsidered else "")
          + f"; label={ck['label']}")
    return 0


def _print_diff(exp: str, since: str | None) -> int:
    """`--diff EXP [--since EXP]`: the full change record behind results/checks_<NN>.json `changes` - a
    unified diff of the two snapshots' scripts plus the config keys that moved (the same text the verifier
    gets inlined). Read-only."""
    text = _diff_text(exp, since)
    print(text)
    return 2 if text.startswith("(") else 0


def _run_suite_cli(select: str, for_exp: str) -> int:
    """`--run-suite SELECT [--for EXP]`: the suite on demand, recorded like any other run. 'due' asks
    the preset what is owed (treating EXP, when given, as a promotion candidate); a row name selects
    that row; anything else is check names. The run's ran_for stamp is what the promotion guard reads
    when a promotion-time check must have run for THAT experiment."""
    props = _campaign_props()
    loop_cfg = _read_json(LOOPCFG, {}) or {}
    state = _read_json(CORRECTNESS_STATE, None)
    state = state if isinstance(state, dict) else None
    known = (state or {}).get("checks") or {}
    sel = select.strip()
    low = sel.lower()
    if low == "all":
        names = "all"
    elif low == "due":
        d = _due_checks(state, _verify_rows(loop_cfg)["rows"], props, candidate=bool(for_exp), core_moved=False)
        pre = _due_checks(state, _verify_rows(loop_cfg)["rows"], props, candidate=None, core_moved=False)
        names = "all" if d["first"] else (",".join(dict.fromkeys(pre["due"] + d["due"])) or "-")
        print(_suite_line("manual", {"due": [n for n in dict.fromkeys(pre["due"] + d["due"])],
                                     "why": {**pre["why"], **d["why"]},
                                     "skipped": {k: v for k, v in {**pre["skipped"], **d["skipped"]}.items()
                                                 if k not in pre["due"] and k not in d["due"]},
                                     "first": d["first"]}, len(known)))
    elif low in SUITE_ROWS:
        picked = [n for n, e in known.items() if (e.get("row") or "invariants") == low]
        if not picked and not known:
            names = "all"          # nothing recorded yet: run everything and learn the rows
        elif not picked:
            print(f"--run-suite: no check in row {low!r} (known rows: "
                  f"{sorted({e.get('row') or 'invariants' for e in known.values()})})")
            return 2
        else:
            names = ",".join(picked)
    else:
        names = sel
    status = check_correctness_suite(props["metric_version"], select=names, ran_for=for_exp,
                                     why="manual", props=props)
    return {"green": 0, "red": 1, "empty": 2}.get(status, 3)


def main():
    global _AGENT_BACKEND
    _make_console_lenient()   # before ANY print: a model-authored glyph must never end a run
    ap = argparse.ArgumentParser(description="Experiment runner for {{CAMPAIGN_TITLE}}")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--config", type=Path, help="run one experiment from this config")
    g.add_argument("--baseline", action="store_true", help="run experiment 000 (the floor gate)")
    g.add_argument("--supervise", action="store_true",
                   help="run the orchestrated loop: a fresh worker agent per unit, which the worker chooses")
    g.add_argument("--preflight", action="store_true",
                   help="run the supervisor launch checks (agent CLI, loop.json, queue.json, metric "
                        "selftest) and exit - no spend")
    g.add_argument("--show-prompt", choices=("worker", "verifier", "capstone"), metavar="ROLE",
                   help="print the literal prompt this driver would spawn ROLE with, plus its size "
                        "and hash, then exit. Reads nothing, spends nothing, changes nothing")
    g.add_argument("--set-metric-revision", metavar="MODE",
                   help="set configs/loop.json campaign.metric_revision (cautious | autonomous) from an "
                        "ATTENDED session and exit. Refused inside a driver-spawned role: the dial is the "
                        "user's decision (the metric-epoch design)")
    g.add_argument("--diff", metavar="EXP",
                   help="print what experiment EXP changed (code, as a unified diff of the snapshots; "
                        "config keys) against the unit its checks artifact names, or --since EXP. "
                        "Reads the frozen snapshots only; spends nothing")
    ap.add_argument("--since", metavar="EXP", help="with --diff: the experiment to compare against")
    g.add_argument("--run-suite", metavar="SELECT",
                   help="run the correctness suite now: 'all', 'due', a row (invariants | machinery | gates), "
                        "or comma-separated check names; with --for EXP the per-result gates get that "
                        "experiment and the run is recorded against it (what a promotion needs). Spends "
                        "only suite time")
    ap.add_argument("--for", dest="for_exp", metavar="EXP", help="with --run-suite: the experiment to run for")
    g.add_argument("--self-check", metavar="EXP",
                   help="record the checks you ran on your own result for EXP into results/checks_<NN>.json "
                        "(with --ran name=pass|fail|skip[:detail] ..., --change \"what=>expected=>observed\" "
                        "..., --estimate X, --note \"...\"). A label, never independent verification")
    ap.add_argument("--ran", action="append", metavar="NAME=OUTCOME[:DETAIL]", help="with --self-check")
    ap.add_argument("--change", action="append", metavar="WHAT=>EXPECTED=>OBSERVED", help="with --self-check")
    ap.add_argument("--estimate", metavar="X", help="with --self-check: your a-priori point estimate")
    ap.add_argument("--note", metavar="TEXT", help="with --self-check: one line reconciling your estimate and the result")
    ap.add_argument("--from-file", metavar="JSON", help="with --self-check: a JSON file {\"ran\": [...], \"changes\": "
                    "[...], \"estimate\": X, \"note\": \"...\"} instead of (or in addition to) the flags - a long "
                    "self-check is one file, not a shell quoting exercise")
    g.add_argument("--record", metavar="EXP",
                   help="place the record you owe for EXP (the exp name, its id, or its config path) - the "
                        "logbook Analysis and NEXT, the ledger's note and finding cells "
                        "proposal - validated and idempotent; you never open the logbook or the ledger")
    ap.add_argument("--analysis", metavar="TEXT|@FILE", help="with --record: the Analysis paragraph (or @path)")
    ap.add_argument("--next", dest="next_line", metavar="LINE", help="with --record: the NEXT line")
    ap.add_argument("--ledger-note", metavar="TEXT", help=f"with --record: the ledger's note cell (at most {NOTE_CAP} chars)")
    ap.add_argument("--finding", metavar="LINE", help="with --record: the ledger's finding cell (one line citing its verdict)")
    ap.add_argument("--replace", action="store_true", help="with --record --finding: overwrite an existing finding")
    ap.add_argument("--record-file", dest="record_file", metavar="JSON",
                    help="with --record: the WHOLE record as one JSON file - analysis, next, ledger_note, finding, "
                         "self_check {ran, changes, estimate, note}, landmine {trigger, landmine, do_instead}, "
                         "discovery {title, text, verdict}, contest {claim, disputes, gate, evidence} (a dispute "
                         "of this result's gate outcome: the driver spawns an independent verifier and the "
                         "pointer waits) - every key optional; "
                         "flags on the command line win. The JOURNAL is a file you write, not a key")

    g.add_argument("--card", metavar="EXP",
                   help="print the result card for EXP (the comparison the analysis needs, in one block; "
                        "also printed at the end of every --config run)")
    g.add_argument("--show", metavar="EXP", help="print one logbook entry (an old detail without opening the file)")
    g.add_argument("--digest", metavar="EXP",
                   help="print the shape of every file EXP wrote (keys, lengths, array shapes, columns) - what "
                        "to open, and what is inside it, without printing keys by hand")
    g.add_argument("--suite-worker", action="store_true",
                   help="internal: run the correctness suite's CHECKS in-process for check_correctness_suite "
                        "(selection, report path and experiment come from PHYSKIT_SUITE_* env vars)")
    ap.add_argument("--smoke", action="store_true",
                    help="with --preflight/--supervise: also do ONE real agent spawn (costs a model call)")
    ap.add_argument("--backend", choices=_codex_backend.BACKENDS,
                    help="supervisor agent backend (CLI overrides loop.json and AUTORESEARCH_BACKEND)")
    ap.add_argument("--selftest", action="store_true",
                    help="(deprecated: the metric self-test + correctness suite now run automatically before every experiment)")
    args = ap.parse_args()

    if args.set_metric_revision:
        _set_metric_revision(args.set_metric_revision)
        return

    if args.diff:
        sys.exit(_print_diff(args.diff, args.since))

    if args.suite_worker:
        sys.exit(_suite_worker(os.environ.get("PHYSKIT_SUITE_SELECT", ""),
                               os.environ.get("PHYSKIT_SUITE_REPORT", ""),
                               os.environ.get("PHYSKIT_SUITE_EXP", "")))

    if args.run_suite:
        sys.exit(_run_suite_cli(args.run_suite, args.for_exp or ""))

    if args.self_check:
        ran, changes, estimate, note = list(args.ran or []), list(args.change or []), args.estimate or "", args.note or ""
        if args.from_file:                 # the flags' content as one JSON file (many --change items are awkward in a shell)
            try:
                sc = json.loads((ROOT / args.from_file).read_text(encoding="utf-8"))
            except (OSError, ValueError) as exc:
                sys.exit(f"--self-check --from-file {args.from_file!r}: cannot read it as JSON ({exc})")
            ran += [str(x) for x in sc.get("ran") or []]
            changes += [str(x) for x in sc.get("changes") or []]
            estimate = estimate or str(sc.get("estimate") or "")
            note = note or str(sc.get("note") or "")
        sys.exit(_self_check_cli(args.self_check, ran, changes, estimate, note))

    if args.record:
        if args.record_file or args.from_file:
            rc = _record_from_file(args.record, args.record_file or args.from_file, {
                "analysis": args.analysis or "", "next": args.next_line or "", "ledger_note": args.ledger_note or "",
                "finding": args.finding or "", "replace": bool(args.replace)})
        else:
            rc = _record_cli(args.record, args.analysis or "", args.next_line or "", args.ledger_note or "",
                             args.finding or "", bool(args.replace))
        if rc < 2:                         # the confirmation: what the save-set holds now (TA-7)
            print(_save_set_line(args.record))
        sys.exit(rc)


    if args.card:
        print(_card(args.card))
        return

    if args.show:
        sys.exit(_show_cli(args.show))

    if args.digest:
        sys.exit(_digest_cli(args.digest))

    if args.preflight or args.supervise or args.show_prompt:
        _AGENT_BACKEND = _codex_backend.configure_or_exit(LOOPCFG, args.backend)

    if args.show_prompt:
        # The prompt to STDOUT and the metadata to STDERR, so the setup review gate can capture one
        # without the other. Size is REPORTED, never capped: the plan is explicit that capacity was
        # never the binding constraint here, so growth should be visible rather than enforced.
        # The worker prompt is the same for every spawn (the worker chooses its unit) - what the driver
        # would spawn, so a probe or a review sees the real thing.
        text = build_prompt(args.show_prompt)
        direct_preview = (args.show_prompt == "verifier" and _codex_backend.is_codex(_AGENT_BACKEND)
                          and _verification_strategy(_read_json(LOOPCFG, {}) or {}) == "driver-direct")
        if direct_preview: text = _verifier_policy().direct_prompt(text, "driver-nonce-preview")
        if _codex_backend.is_codex(_AGENT_BACKEND):
            text = _codex_backend.adapt_prompt(text)
        print(text)
        digest = _hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
        print(f"\n--- {args.show_prompt} prompt: {len(text)} chars ({len(text)/1024:.1f} KB) "
              f"· sha256:{digest} ---", file=sys.stderr)
        instruction_name = "AGENTS.md" if _codex_backend.is_codex(_AGENT_BACKEND) else "CLAUDE.md"
        prompt_kind = ("a direct-verifier shape preview; the live nonce differs" if direct_preview
                       else "the literal spawn string")
        print(f"--- this is {prompt_kind}. {instruction_name} auto-loads on top of it; the brief "
              "(the role file first - the contract - then the standing constraints and the role's delivered "
              "context, listed next) is compiled into it above. ---", file=sys.stderr)
        if args.show_prompt in _LAST_BRIEF:
            print(f"--- {_brief_line(args.show_prompt)} ---", file=sys.stderr)
        return

    if args.preflight:
        fails = preflight(smoke=args.smoke)
        if fails:
            sys.exit(f"preflight: {len(fails)} issue(s) found - each line above names its fix.")
        print("preflight: all checks passed - ready for --supervise.")
        return

    if args.supervise:
        supervise(smoke=args.smoke)   # the driver only orchestrates; each worker's run fires the gates below
        return

    # FROZEN-infrastructure gates, automatic before every experiment (no longer opt-in via --selftest):
    # Cheapest refusal first: a typo in a campaign property is a string comparison, and it must not cost
    # the correctness suite's 600 s timeout to discover.
    t_run = time.monotonic()               # the per-unit timing record starts with the gates
    run_start_iso = _dt.datetime.now(_dt.timezone.utc).isoformat()
    props = _campaign_props()              # what KIND of campaign this is (configs/loop.json "campaign")
    problems = campaign_props_problems(props)
    if problems:
        sys.exit("CAMPAIGN PROPERTIES: configs/loop.json is not usable as written:\n  - "
                 + "\n  - ".join(problems))
    vprob, _ = verify_problems(_read_json(LOOPCFG, {}) or {})   # the preset, before any spend
    if vprob:
        sys.exit("VERIFY PRESET: configs/loop.json is not usable as written:\n  - " + "\n  - ".join(vprob))

    require_metric_selftest()      # hard-fail unless the scorer passes its self-test
    for problem in epoch_gate(props):   # the scorer on disk IS the declared epoch's (the metric-epoch design)
        sys.exit("METRIC EPOCH: " + problem)
    # The suite, as the preset schedules it: cheap invariants every unit; machinery checks at setup /
    # when their code moved / every unit; gates after the solve. A FROZEN-core change makes everything
    # due, so a green still certifies the core on disk. Records + binds the epoch's scorer hash; only
    # an affirmative GREEN green-lights promotion.
    _state0 = _read_json(CORRECTNESS_STATE, None)
    _lcfg = _read_json(LOOPCFG, {}) or {}
    _rows = _verify_rows(_lcfg)["rows"]
    _core_moved = (isinstance(_state0, dict) and bool(_state0.get("core_hash"))
                   and _state0.get("core_hash") != frozen_core.core_hash(ROOT))
    _due = _due_checks(_state0 if isinstance(_state0, dict) else None, _rows, props,
                       candidate=None, core_moved=_core_moved)
    _SUITE_LAST["experiment"] = _due
    print(_suite_line("experiment", _due, len(((_state0 or {}) if isinstance(_state0, dict) else {}).get("checks") or {})))
    # A moved core includes an edited suite file: the recorded check list may be stale, so the run is a
    # full one (which also learns new checks and drops removed ones), not a selection by old names.
    check_correctness_suite(props["metric_version"], props=props, why="experiment",
                            select="all" if (_due["first"] or _core_moved) else (",".join(_due["due"]) or "-"))
    _SUITE_LAST["budget"] = _meter_suite(_rows, _lcfg)   # the every-set against its measured budget
    gates_s = time.monotonic() - t_run
    _beat("gates")                 # liveness trace begins (dead-worker detection; progress = the ledger)

    if args.baseline:
        # The simplest defensible baseline (campaign.md §Decision record ED-000 - the floor, run at setup): experiment.py's
        # baseline_config() where the campaign defines one; the bare stub otherwise.
        cfg = _seam("baseline_config", lambda: {"exp_name": "exp000_baseline", "_comment": "baseline gate"})()
    else:
        cfg = load_config(args.config)

    stem = cfg["exp_name"]
    sys.stdout = _Tee(DIAG / f"{stem}_{_utc_stamp()}.log")
    print(f"=== {stem} :: {{CAMPAIGN_TITLE}} ===")

    check_deliverable_gate(cfg)   # SPEND GATE: a zero-evaluation unit names its deliverable first

    t_snap = time.monotonic()
    snapshot_experiment(cfg, args.config if not args.baseline else None, props)
    print(f"snapshot -> results/snapshots/{stem}/")
    snapshot_s = time.monotonic() - t_snap
    _beat("snapshot")

    _exp().validate_method(cfg)   # hard-fail before spending an evaluation on an unwired/unrecognized lever
    target = _exp().load_target(cfg)
    _beat("solve_start")
    ticker = _HeartbeatTicker()   # beats every HB_TICK_S so a long solve doesn't look dead mid-run
    ticker.start()
    t_solve = time.monotonic()
    try:
        prediction = _exp().run_experiment(cfg)
    finally:
        ticker.stop()
    solve_s = time.monotonic() - t_solve   # the measured unit cost, recorded with the result
    _beat("solve_done")
    evaluate_and_record(cfg, prediction, target, props, timing={
        "start_iso": run_start_iso, "t_run": t_run, "gates_s": round(gates_s, 3),
        "suite_s": _SUITE_TIMING.get("wall_s"), "snapshot_s": round(snapshot_s, 3),
        "solve_s": round(solve_s, 6)})   # microseconds: an analytic toy solve must not round to zero
    print(_card(stem))                     # the analysis reads THIS once; it never rebuilds it from the artifacts


if __name__ == "__main__":
    main()
