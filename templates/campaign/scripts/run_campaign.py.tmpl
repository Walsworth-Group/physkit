"""run_campaign.py — the experiment runner for {{CAMPAIGN_TITLE}}.

Runs ONE experiment from a config and writes the full reproducible record. This file is MUTABLE — add
forwards / decoders / preprocessors / search strategies here; it is the plumbing, not the FROZEN
scoring math (that lives in scripts/metric.py).

Usage:
    python scripts/run_campaign.py --baseline                       # experiment 000 (the floor gate)
    python scripts/run_campaign.py --config configs/exp007_foo.json # one experiment

Every run MUST leave behind, for reproducibility:
    configs/exp<NN>_<slug>.json  ·  a results/scoreboard.tsv row  ·  results/result_<NN>.json
    ·  at least one figure in results/images/  ·  a tee'd log in results/diagnostics/
    ·  a reproducibility snapshot in results/snapshots/exp<NN>_<slug>/ (the config + a copy of scripts/)
    ·  an entry appended to results/logbook.md (this script appends the FACTS automatically; the agent
       completes the narrative slots — Analysis / Verification / NEXT — afterward)
A result is not "saved" until it has a scoreboard row, a result_<NN>.json, its figure, AND its snapshot.
"""
from __future__ import annotations

import argparse
import datetime as _dt
import json
import shutil
import sys
from pathlib import Path

import numpy as np

import metric  # the FROZEN scorer (compute_metric, selftest)

ROOT = Path(__file__).resolve().parent.parent
RESULTS = ROOT / "results"
DIAG = RESULTS / "diagnostics"
IMAGES = RESULTS / "images"
SCOREBOARD = RESULTS / "scoreboard.tsv"
SNAPSHOTS = RESULTS / "snapshots"
LOGBOOK = RESULTS / "logbook.md"


class _Tee:
    """Mirror stdout to a per-run log so a result never lives only in the console."""

    def __init__(self, log_path: Path):
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self._log = open(log_path, "w", encoding="utf-8")
        self._stdout = sys.stdout

    def write(self, s):  # noqa: D401
        self._stdout.write(s)
        self._log.write(s)

    def flush(self):
        self._stdout.flush()
        self._log.flush()


def _utc_stamp() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def load_config(path: Path) -> dict:
    """Load and lightly validate an experiment config (the reproducible record)."""
    cfg = json.loads(Path(path).read_text(encoding="utf-8"))
    assert "exp_name" in cfg, "config is missing 'exp_name'"
    return cfg


def snapshot_experiment(cfg: dict, config_path: Path | None = None) -> Path:
    """Preserve everything needed to reproduce this experiment even after the code/config later change.

    BASELINE requirement, every experiment (see docs/protocols/artifacts.md): copy the mutable code
    (scripts/) and the config into results/snapshots/<exp_name>/, plus a manifest with the command line
    and key library versions. A shared script edited later would otherwise make this experiment
    irreproducible.
    """
    dst = SNAPSHOTS / cfg["exp_name"]
    dst.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / "scripts", dst / "scripts",
                    ignore=shutil.ignore_patterns("__pycache__"), dirs_exist_ok=True)
    if config_path is not None:
        shutil.copy2(config_path, dst / "config.json")
    else:
        (dst / "config.json").write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    (dst / "manifest.txt").write_text(
        f"argv: {' '.join(sys.argv)}\npython: {sys.version.split()[0]}\nnumpy: {np.__version__}\n"
        f"utc: {_utc_stamp()}\n",
        encoding="utf-8",
    )
    return dst


