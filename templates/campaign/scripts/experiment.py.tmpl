def campaign_comparand(result: dict) -> bool:
    """May this recorded row (results/result_<NN>.json) become the incumbent? The runner already excludes a
    zero-evaluation unit and a row whose payload said `comparand: false`; this is the campaign's own rule
    for rows recorded before that flag existed (a floor row with no fitted parameters, say). True = a
    model's score."""
    return True


