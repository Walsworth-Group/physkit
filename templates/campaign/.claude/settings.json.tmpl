{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CLAUDE_PROJECT_DIR/scripts/guard_promotion.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CLAUDE_PROJECT_DIR/scripts/loop_heartbeat.py\""
          }
        ]
      }
    ]
  }
}
